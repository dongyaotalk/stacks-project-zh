{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stacks-project-zh.invalid/schema/run-manifest.schema.json",
  "title": "Translation model run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "run_kind",
    "task_id",
    "source_commit",
    "unit_ids",
    "harness",
    "model",
    "inputs",
    "created_at",
    "replayable"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "run_kind": {"enum": ["translation", "revision", "comparison", "historical-import"]},
    "task_id": {"type": "string", "minLength": 1},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "unit_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "adapter_version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "adapter_version": {"type": "string", "minLength": 1}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "provider",
        "requested_id",
        "resolved_id",
        "snapshot",
        "identity_confidence"
      ],
      "properties": {
        "record_id": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1},
        "requested_id": {"type": ["string", "null"]},
        "resolved_id": {"type": ["string", "null"]},
        "snapshot": {"type": ["string", "null"]},
        "identity_confidence": {
          "enum": ["runtime-resolved", "owner-confirmed", "declared", "unknown"]
        }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt_version", "policy_revision", "glossary_revision"],
      "properties": {
        "prompt_version": {"type": "string", "minLength": 1},
        "policy_revision": {"type": "string", "minLength": 1},
        "glossary_revision": {"type": "string", "minLength": 1},
        "context_hashes": {
          "type": "array",
          "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "uniqueItems": true
        },
        "settings": {"type": "object"}
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "replayable": {"type": "boolean"},
    "status": {"enum": ["recorded", "retired", "superseded"]},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
