al rings is faithfully flat.\n<STRUCT_0002>", "source_text_hash": "sha256:3c8b6373245d61b7c65467d4c32818621a5c06184b785090809d5601693dc274", "unit_id": "inventory:algebra:00HR:lemma/0001"}}}, {"context_id": "reference:algebra-lemma-map-between-etale", "hash": "sha256:f09de024ec13db2866fe203fc8577195f516c7beb985b683c13820daced82eda", "value": {"kind": "locked-English-reference", "location": {"byte_end": 1447752, "byte_start": 1447606, "file": "algebra.tex", "fragment_hash": "sha256:5dc4ba72a1bd4e72ac66b53502fc7a3af34af63410f79bbfcdf1a43f41a1fffc", "line_end": 39511, "line_start": 39507}, "owner_tag": "00U7", "parent_tag": "00U0", "requested_label": "algebra-lemma-map-between-etale", "requested_tag": "00U7", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "algebra", "node_kind": "lemma", "parent_tag": "00U0", "placeholders": {"ACCENT_0001": "\\'e", "ACCENT_0002": "\\'e", "LOCKED_0001": "\\label{lemma-map-between-etale}", "MATH_0001": "$R \\to S$", "MATH_0002": "$R \\to S'$", "MATH_0003": "$R$", "MATH_0004": "$S' \\to S$", "STRUCT_0001": "\\begin{lemma}", "STRUCT_0002": "\\end{lemma}"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:2a21054f016800db44f7f0475a7f8d0a4f531df01c47eb1085da713b1ff98369", "source_status": "CURRENT", "source_structure_hash": "sha256:d6373d80195d9c58d9d84a0dc3ae7e2aa500919a296e6ecd16adc4460f43759c", "source_text": "<STRUCT_0001>\n<LOCKED_0001>\nLet <MATH_0001> and <MATH_0002> be <ACCENT_0001>tale.\nThen any <MATH_0003>-algebra map <MATH_0004> is <ACCENT_0002>tale.\n<STRUCT_0002>", "source_text_hash": "sha256:e0034d55e94f8181f5c6cc2d8691a055ddfc4809aab686abd2117bd17eed9a44", "unit_id": "inventory:algebra:00U7:lemma/0001"}}}, {"context_id": "reference:algebra-section-etale", "hash": "sha256:bce9638f45ed7b965f71360aaa94ab4b9ca84992d3f31feb93e09482f2c46437", "value": {"kind": "locked-Engl