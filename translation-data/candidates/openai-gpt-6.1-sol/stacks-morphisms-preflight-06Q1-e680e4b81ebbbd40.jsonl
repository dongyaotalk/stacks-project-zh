uasi-separated）的。\n<STRUCT_0004>\n", "translation_hash": "sha256:9cf0dd88fd9461f381846edc73d6ed0d271240d47366be3adc9a68d5f6d5ee83", "unit_id": "tag:06Q2:statement", "unknown_terms": [{"context": "定义中的代数叠之间的映射；所提供词表无已批准词条。", "source_term": "morphism", "target_term": "态射"}, {"context": "所定义态射的源与目标所属的对象；所提供词表无已批准词条。", "source_term": "algebraic stacks", "target_term": "代数叠"}, {"context": "本定义第一项所定义并在第二项中使用的性质；所提供词表无已批准词条。", "source_term": "locally of finite presentation", "target_term": "局部有限表示"}, {"context": "所引用引理中各条件之间的逻辑关系；所提供词表无已批准词条。", "source_term": "equivalent", "target_term": "等价"}, {"context": "本定义第二项所定义的态射性质；所提供词表无已批准词条。", "source_term": "of finite presentation", "target_term": "有限表示"}, {"context": "有限表示态射所须满足的条件；所提供词表无已批准词条。", "source_term": "quasi-compact", "target_term": "拟紧"}, {"context": "有限表示态射所须满足的条件；所提供词表无已批准词条。", "source_term": "quasi-separated", "target_term": "拟分离"}]}
