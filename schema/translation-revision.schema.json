{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stacks-project-zh.invalid/schema/translation-revision.schema.json",
  "title": "Published translation revision record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "revision_id",
    "unit_id",
    "source_commit",
    "source_text_hash",
    "translation",
    "translation_hash",
    "origin_run_id",
    "selection_id",
    "selected_by",
    "created_at",
    "reason",
    "supersedes_revision_id",
    "review_ids",
    "risk_level",
    "stage",
    "source_status",
    "qa_status",
    "term_status",
    "publication_status",
    "status"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "revision_id": {"type": "string", "minLength": 1},
    "unit_id": {"type": "string", "minLength": 1},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_text_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "translation": {"type": "string", "minLength": 1},
    "translation_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "origin_run_id": {"type": "string", "minLength": 1},
    "selection_id": {"type": "string", "minLength": 1},
    "selected_by": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "reason": {"type": "string", "minLength": 1},
    "supersedes_revision_id": {"type": ["string", "null"]},
    "review_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "risk_level": {"enum": ["R0", "R1", "R2", "R3"]},
    "stage": {"enum": ["LANGUAGE_REVIEWED", "MATH_REVIEWED", "PUBLISHED"]},
    "source_status": {"const": "CURRENT"},
    "qa_status": {"const": "PASS"},
    "term_status": {"const": "CLEAR"},
    "publication_status": {"enum": ["INTERNAL", "RELEASED"]},
    "status": {"enum": ["current", "superseded", "retired"]}
  }
}
