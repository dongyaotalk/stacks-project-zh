{"chapter": "sites-cohomology", "node_kind": "paragraph", "parent_tag": "0FPP", "placeholders": {"MATH_0001": "$D(\\mathcal{O})$", "REF_0001": "\\ref{example-dual-derived}", "REF_0002": "\\ref{lemma-left-dual-derived}", "STRUCT_0001": "\\noindent"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R2", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:9c94a0b3ca30078e5465e847dcf98ae4f0d7130b173198e1f265b1e21e63b4ab", "source_status": "CURRENT", "source_structure_hash": "sha256:1483630594d60d297fe446c4f67c4a543da3a33a7ffc6dd9ca2b0dfb99eb347e", "source_text": "\n\n<STRUCT_0001>\nIn this section we characterize the dualizable objects of\nthe category of complexes and of the derived category.\nIn particular, we will see that an object of <MATH_0001>\nhas a dual if and only if it is perfect (this follows from\nExample <REF_0001> and\nLemma <REF_0002>).\n\n", "source_text_hash": "sha256:b1d70f8d14b27d577968a3fc9b6f348dba001353d73c840f733f6527f49b8d91", "unit_id": "tag:0FPP:prose-0001"}
{"chapter": "sites-cohomology", "node_kind": "lemma", "parent_tag": "0FPP", "placeholders": {"MATH_0001": "$(\\mathcal{C}, \\mathcal{O})$", "MATH_0002": "$\\mathcal{O}$", "MATH_0003": "$\\mathcal{F}^\\bullet \\otimes \\mathcal{G}^\\bullet =\n\\text{Tot}(\\mathcal{F}^\\bullet \\otimes_\\mathcal{O} \\mathcal{G}^\\bullet)$"}, "render": {"prefix": "\\begin{lemma}\n\\label{lemma-symmetric-monoidal-cat-complexes}\n", "suffix": "\\end{lemma}"}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:5a9ac7adb30ba96ea5312181a17f1b658f013e6d800501ed4012bd15d87a82dd", "source_status": "CURRENT", "source_structure_hash": "sha256:646856c60699354e5355d362926dc4b1fc4d62e71d39ca8e579d51e6faf08bd1", "source_text": "Let <MATH_0001> be a ringed site. The category of complexes\nof <MATH_0002>-modules with tensor product defined by\n<MATH_0003>\nis a symmetric monoidal category.\n", "source_text_hash": "sha256:2187ddf8e5b71e97a015503e1990787ee9747f25dc2b13081a4f08164ac5c872", "unit_id": "tag:0FPQ:statement"}
