abel{lemma-representable}", "MATH_0001": "$\\tau \\in \\{Zariski, \\etale, smooth, syntomic, fppf\\}$", "MATH_0002": "$F', G' : (\\Sch/S)_\\tau^{opp} \\to \\textit{Sets}$", "MATH_0003": "$a' : F' \\to G'$", "MATH_0004": "$a : F \\to G$", "MATH_0005": "$a' : F' \\to G'$", "MATH_0006": "$(\\textit{Noetherian}/S)_\\tau$", "MATH_0007": "$a'$", "MATH_0008": "$V$", "MATH_0009": "$(\\textit{Noetherian}/S)_\\tau$", "MATH_0010": "$V \\to G$", "MATH_0011": "$F \\times_G V : (\\textit{Noetherian}/S)_\\tau^{opp} \\to \\textit{Sets}$", "MATH_0012": "$V$", "MATH_0013": "$S$", "MATH_0014": "$S$", "REF_0001": "\\ref{categories-definition-representable-morphism}", "STRUCT_0001": "\\begin{lemma}", "STRUCT_0002": "\\begin{enumerate}", "STRUCT_0003": "\\item", "STRUCT_0004": "\\item", "STRUCT_0005": "\\item", "STRUCT_0006": "\\end{enumerate}", "STRUCT_0007": "\\end{lemma}"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:5f855731bdfb5a6fcaf4655b6285b59652581b3a7aabb0ffc92cd1e5a9eb80da", "source_status": "CURRENT", "source_structure_hash": "sha256:51c4687eb03fbc184b8e9fa3a8e6ecc28a68677fed554fc68dd8b10240fbe2c5", "source_text": "<STRUCT_0001>\n<LOCKED_0001>\nLet <MATH_0001>.\nLet <MATH_0002> be limit preserving\nand sheaves. Let <MATH_0003> be a transformation of functors.\nDenote <MATH_0004> the restriction of <MATH_0005> to\n<MATH_0006>. The following are equivalent\n<STRUCT_0002>\n<STRUCT_0003> <MATH_0007> is representable (as a transformation of functors, see\nCategories, Definition <REF_0001>), and\n<STRUCT_0004> for every object <MATH_0008> of <MATH_0009>\nand every map <MATH_0010> the fibre product\n<MATH_0011>\nis a representable functor, and\n<STRUCT_0005> same as in (2) but only for <MATH_0012> affine finite type over <MATH_0013>\nmapping into an affine open of <MATH_0014>.\n<STRUCT_0006>\n<STRUCT_0007>", "source_text_hash": "sha256:b6baf712b39136e230ec4b4