a/0001"}}}, {"context_id": "locked-English-reference:derived:inventory:derived:013H:definition/0001:derived-definition-complexes-notation", "hash": "sha256:2337308217791804770e75b9e14ea720154bac7193272e602e8e667f96fec2ca", "value": {"kind": "locked-English-reference", "location": {"byte_end": 88488, "byte_start": 87252, "file": "derived.tex", "fragment_hash": "sha256:e764bbf261678479ba036c4776060b9b28d98abe2ba8be348844161a1f394f0b", "line_end": 2446, "line_start": 2420}, "owner_tag": "013H", "parent_tag": "05RN", "requested_label": "derived-definition-complexes-notation", "requested_tag": "013H", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "derived", "node_kind": "definition", "parent_tag": "05RN", "placeholders": {"LOCKED_0001": "\\label{definition-complexes-notation}", "MATH_0001": "$\\mathcal{A}$", "MATH_0002": "$\\text{Comp}(\\mathcal{A}) = \\text{CoCh}(\\mathcal{A})$", "MATH_0003": "$K^\\bullet$", "MATH_0004": "$K^n = 0$", "MATH_0005": "$n \\ll 0$", "MATH_0006": "$K^\\bullet$", "MATH_0007": "$K^n = 0$", "MATH_0008": "$n \\gg 0$", "MATH_0009": "$K^\\bullet$", "MATH_0010": "$K^n = 0$", "MATH_0011": "$|n| \\gg 0$", "MATH_0012": "$\\text{Comp}^{+}(\\mathcal{A})$", "MATH_0013": "$\\text{Comp}^{-}(\\mathcal{A})$", "MATH_0014": "$\\text{Comp}^b(\\mathcal{A})$", "MATH_0015": "$\\text{Comp}(\\mathcal{A})$", "MATH_0016": "$K(\\mathcal{A})$", "MATH_0017": "$\\text{Comp}(\\mathcal{A})$", "MATH_0018": "$K^{+}(\\mathcal{A})$", "MATH_0019": "$K^{-}(\\mathcal{A})$", "MATH_0020": "$K^b(\\mathcal{A})$", "MATH_0021": "$K(\\mathcal{A})$", "MATH_0022": "$\\mathcal{A}$", "REF_0001": "\\ref{homology-lemma-compose-homotopy-cochain}", "SPACE_0001": "\\ ", "SPACE_0002": "\\ ", "SPACE_0003": "\\ ", "SPACE_0004": "\\ ", "STRUCT_0001": "\\begin{definition}", "STRUCT_0002": "\\begin{enumerate}", "STRUCT_0003": "\\item", "STRUCT_0004": "\\item", "STRUCT_0005": "\\item", "STRUCT_0006": "\\item", "STRUCT_0007": "\\item", "STRUCT_0008": "\\item", "STRUCT_0009": "\\item", "STRUCT_0010": "\\end{enumerate}", "STRUCT_0011": "\\end{definition}", "TEXTITCLOSE_0001": "}", "TEXTITCLOSE_0002": "}", "TEXTITCLOSE_0003": "}", "TEXTITCLOSE_0004": "}", "TEXTITOPEN_0001": "{\\it ", "TEXTITOPEN_0002": "{\\it ", "TEXTITOPEN_0003": "{\\it ", "TEXTITOPEN_0004": "{\\it "}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:66e6183fdeefd95d3623bf3c0535276090c583697c5febe7d839cc8001f2c60c", "source_status": "CURRENT", "source_structure_hash": "sha256:76b58ecf6fb26427f54305db8e3421f34f765793cc01121ec9a82b0b8f928a48", "source_text": "<STRUCT_0001>\n<LOCKED_0001>\nLet <MATH_0001> be an additive category.\n<STRUCT_0002>\n<STRUCT_0003> We set <MATH_0002>\nbe the <TEXTITOPEN_0001>category of (cochain) complexes<TEXTITCLOSE_0001>.\n<STRUCT_0004> A complex <MATH_0003> is said to be\n<TEXTITOPEN_0002>bounded below<TEXTITCLOSE_0002> if <MATH_0004> for all <MATH_0005>.\n<STRUCT_0005> A complex <MATH_0006> is said to be\n<TEXTITOPEN_0003>bounded above<TEXTITCLOSE_0003> if <MATH_0007> for all <MATH_0008>.\n<STRUCT_0006> A complex <MATH_0009> is said to be\n<TEXTITOPEN_0004>bounded<TEXTITCLOSE_0004> if <MATH_0010> for all <MATH_0011>.\n<STRUCT_0007> We let\n<MATH_0012>, <MATH_0013>,\nresp.<SPACE_0001><MATH_0014> be the full subcategory\nof <MATH_0015> whose objects are the complexes\nwhich are bounded below, bounded above, resp.<SPACE_0002>bounded.\n<STRUCT_0008> We let <MATH_0016> be the category with the same objects\nas <MATH_0017> but as morphisms homotopy classes of\nmaps of complexes (see\nHomology, Lemma <REF_0001>).\n<STRUCT_0009> We let <MATH_0018>, <MATH_0019>,\nresp.<SPACE_0003><MATH_0020> be the full subcategory of <MATH_0021>\nwhose objects are bounded below, bounded above, resp.<SPACE_0004>bounded\ncomplexes of <MATH_0022>.\n<STRUCT_0010>\n<STRUCT_0011>", "source_text_hash": "sha256:c6e15c3a4ea6cce2007b99a57342f5e57d