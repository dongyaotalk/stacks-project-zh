{"chapter": "morphisms", "node_kind": "section_title", "parent_tag": "01RY", "placeholders": {}, "render": {"prefix": "\\section{", "suffix": "}\n\\label{section-surjective}"}, "risk_level": "R1", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:b553f2977e941d956066e61fa1f8a6f16c73a429afcd79498e45e52cc320a7aa", "source_text": "Surjective morphisms", "source_text_hash": "sha256:1299eda6d79324aa50ace98fa9a3e4b9567487228f039142c1f5f4cc44c89e1d", "unit_id": "tag:01RY:title"}
{"chapter": "morphisms", "node_kind": "definition", "parent_tag": "01RY", "placeholders": {"TEXTITCLOSE_0001": "}", "TEXTITOPEN_0001": "{\\it "}, "render": {"prefix": "\\begin{definition}\n\\label{definition-surjective}\n", "suffix": "\\end{definition}"}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:381553106418d4ac58baa36fc46a4b0e5453808a5c0c3c81e6940446930b4880", "source_text": "A morphism of schemes is said to be <TEXTITOPEN_0001>surjective<TEXTITCLOSE_0001>\nif it is surjective on underlying topological\nspaces.\n", "source_text_hash": "sha256:ad1c394a42a143a055b423755ebb681292d3b44a24e000f99e48e50968baa5a4", "unit_id": "tag:01RZ:statement"}
{"chapter": "morphisms", "node_kind": "lemma", "parent_tag": "01RY", "placeholders": {}, "render": {"prefix": "\\begin{lemma}\n\\label{lemma-composition-surjective}\n", "suffix": "\\end{lemma}"}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:2b0f49782c726af9b64f4ac4e6708d4e7c2d9daca6cb21faac93ae94a61ec234", "source_text": "The composition of surjective morphisms is surjective.\n", "source_text_hash": "sha256:4dd4fe35ca16f2c73e3e366b1f2912c07a5b5b2a6386e2f44bd252c2338c7567", "unit_id": "tag:01S0:statement"}
