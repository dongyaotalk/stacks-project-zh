af217a13149945e3bb3e6fe472785fbd", "source_text_hash": "sha256:aa21158d101bc092c25ba1fa968f99c027960e44441a3822cd142141559a23b3", "unit_id": "tag:04S9:prose-0001"}, "style_guide_path": "config/style-guide.md", "turn_id": "01a15496-87f2-7e92-9369-d95a870cdd7b", "unit_id": "tag:04S9:prose-0001"}, "context_hash": "sha256:ab8c72c3d06b6f1fb98d90e1f72f458282beb73921335b40250b05ebe590015d", "created_at": "2026-10-19T14:37:32.511072+00:00", "glossary_revision": "git:e7a1627e7bce13592b8c07d43974a815ba27c0d5", "harness_id": "codex", "harness_version": "0.163.0-alpha.10.2", "model_id": "gpt-6.1-sol", "model_identity_confidence": "declared", "model_lane": "openai-gpt-6.1-sol", "model_record_id": "openai:gpt-6.1-sol:declared", "model_snapshot": null, "notes": [], "prompt_version": "translator-v2", "publication_status": "CANDIDATE", "qa_status": "PASS", "reasoning_effort": "high", "run_id": "run-20261019-categories-remaining-p017-gpt61sol", "schema_version": 2, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_status": "CURRENT", "source_text_hash": "sha256:aa21158d101bc092c25ba1fa968f99c027960e44441a3822cd142141559a23b3", "stage": "STRUCTURE_OK", "term_occurrences": [{"source_term": "set", "target_term": "集合"}, {"source_term": "equivalence relation", "target_term": "等价关系"}, {"source_term": "setoid", "target_term": "集合胚"}, {"source_term": "Transitivity", "target_term": "传递性"}, {"source_term": "compose", "target_term": "复合"}, {"source_term": "morphisms", "target_term": "态射"}, {"source_term": "setoid", "target_term": "集合胚"}, {"source_term": "category", "target_term": "范畴"}, {"source_term": "objects", "target_term": "对象"}, {"source_term": "equivalence relation", "target_term": "等价关系"}, {"source_term": "isomorphism", "target_term": "同构"}, {"source_term": "category", "target_term": "范畴"}, {"source_term": "isomorphism", "target_term": "同构"}, {"source_term": "equivalence", "target_term": "等价"}, {"source_term": "Discrete", "target_term": "离散的"}, {"source_term": "categories", "target_term": "范畴"}, {"source_term": "setoids", "target_term": "集合胚"}, {"source_term": "setoid", "target_term": "集合胚"}, {"source_term": "canonical", "target_term": "典范的"}, {"source_term": "equivalent", "target_term": "等价"}, {"source_term": "discrete", "target_term": "离散的"}, {"source_term": "category", "target_term": "范畴"}, {"source_term": "isomorphism classes", "target_term": "同构类"}, {"source_term": "set", "target_term": "集合"}, {"source_term": "identity morphisms", "target_term": "恒等态射"}, {"source_term": "equivalence relation", "target_term": "等价关系"}, {"source_term": "sets", "target_term": "集合"}, {"source_term": "equivalence relation", "target_term": "等价关系"}, {"source_term": "quotient", "target_term": "商"}], "term_status": "DECISION_REQUIRED", "translation": "\n\n<STRUCT_0001>\n若<MATH_0001>是集合（set），带有等价关系（equivalence relation）<MATH_0002>，则可如下构造集合胚（setoid）<MATH_0003>：令<MATH_0004>及<MATH_0005>，除非<MATH_0006>，在后一情形置<MATH_0007>。<MATH_0008>的传递性（Transitivity）意味着可以复合（compose）态射（morphisms）。反过来，任意集合胚（setoid）范畴（category）在其对象（objects）上定义等价关系（equivalence relation）（同构（isomorphism）），使得通过刚描述的过程，可以恢复这个范畴（category）（在唯一同构（isomorphism）的意义下，而非等价（equivalence））。\n\n<STRUCT_0002><STRUCT_0003>\n离散的（Discrete）范畴（categories）是集合胚（setoids）。对任意集合胚（setoid）<MATH_0009>，有典范的（canonical）过程，构造与它等价（equivalent）的离散的（discrete）范畴（category），即将<MATH_0010>替换为同构类（isomorphism classes）的集合（set）（并添加恒等态射（identity morphisms））。用带有等价关系（equivalence relation）的集合（sets）来表述，这对应于对该等价关系（equivalence relation）取商（quotient）。\n\n", "translation_hash": "sha256:75333ea26da6c07995a3aaef09d6731e10ffcf2c2552d0e684febb7bc78dc378", "unit_id": "tag:04S9:prose-0001", "unknown_terms": [{"context": "给定集合与同构类集合；待决。", "source_term": "set", "target_term": "集合"}, {"context": "等价关系的集合表述；待决。", "source_term": "sets", "target_term": "集合"}, {"context": "构造集合胚及取商所用关系；待决。", "source_term": "equivalence relation", "target_term": "等价关系"}, {"context": "构造及恢复的集合胚；待决。", "source_term": "setoid", "target_term": "集合胚"}, {"context": "离散范畴满足的性质；待决。", "source_term": "setoids", "target_term": "集合胚"}, {"context": "用来定义复合的关系性质；待决。", "source_term": "Transitivity", "target_term": "传递性"}, {"context": "态射的复合运算；待决。", "source_term": "compose", "target_term": "复合"}, {"context": "所复合的态射；待决。", "source_term": "morphisms", "target_term": "态射"}, {"context": "集合胚范畴及构造、恢复的范畴；待决。", "source_term": "category", "target_term": "范畴"}, {"context": "离散范畴；待决。", "source_term": "categories", "target_term": "范畴"}, {"context": "等价关系的载体；待决。", "source_term": "objects", "target_term": "对象"}, {"context": "对象关系及恢复的唯一同构；待决。", "source_term": "isomorphism", "target_term": "同构"}, {"context": "明确区别于唯一同构的关系；待决。", "source_term": "equivalence", "target_term": "等价"}, {"context": "句首的离散性；待决。", "source_term": "Discrete", "target_term": "离散的"}, {"context": "典范构造所得范畴的离散性；待决。", "source_term": "discrete", "target_term": "离散的"}, {"context": "构造离散范畴的过程；待决。", "source_term": "canonical", "target_term": "典范的"}, {"context": "所得离散范畴与原范畴之间的关系；待决。", "source_term": "equivalent", "target_term": "等价"}, {"context": "离散范畴的对象；待决。", "source_term": "isomorphism classes", "target_term": "同构类"}, {"context": "添加的态射；待决。", "source_term": "identity morphisms", "target_term": "恒等态射"}, {"context": "按等价关系取商；待决。", "source_term": "quotient", "target_term": "商"}]}
