{"chapter": "morphisms", "node_kind": "lemma", "parent_tag": "01U2", "placeholders": {"MATH_0001": "$X \\to Y \\to Z$", "MATH_0002": "$\\mathcal{F}$", "MATH_0003": "$\\mathcal{O}_X$", "MATH_0004": "$x \\in X$", "MATH_0005": "$y$", "MATH_0006": "$Y$", "MATH_0007": "$\\mathcal{F}$", "MATH_0008": "$Y$", "MATH_0009": "$x$", "MATH_0010": "$Y$", "MATH_0011": "$Z$", "MATH_0012": "$y$", "MATH_0013": "$\\mathcal{F}$", "MATH_0014": "$Z$", "MATH_0015": "$x$"}, "render": {"prefix": "\\begin{lemma}\n\\label{lemma-composition-module-flat}\n", "suffix": "\\end{lemma}"}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:79e9ee156265d336c4d753eddfcd28de1063bb8bbc3f512e48bdee405fd7fa15", "source_status": "CURRENT", "source_structure_hash": "sha256:2f540b101d37d65803e2625cc8b7142a32088319ee3528c828542d3755eb2f64", "source_text": "Let <MATH_0001> be morphisms of schemes. Let <MATH_0002> be a\nquasi-coherent <MATH_0003>-module. Let <MATH_0004> with image <MATH_0005> in <MATH_0006>.\nIf <MATH_0007> is flat over <MATH_0008> at <MATH_0009>, and <MATH_0010> is flat over <MATH_0011> at\n<MATH_0012>, then <MATH_0013> is flat over <MATH_0014> at <MATH_0015>.\n", "source_text_hash": "sha256:6b0938d6157f39dd707b68f4acf1ee882e50af0ec40b380d7fd88a5ccad6c4d6", "unit_id": "tag:01U6:statement"}
