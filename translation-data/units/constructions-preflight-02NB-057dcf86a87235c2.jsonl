\n}\n$$", "STRUCT_0004": "\\item", "STRUCT_0005": "\\end{enumerate}"}, "render": {"prefix": "\\begin{lemma}\n\\label{lemma-twisting-and-proj}\n", "suffix": "\\end{lemma}"}, "source_text_hash": "sha256:da280ab6775beb27928ebe4ca87c395ea9bcbd2369d82ddc3aec1d9061910a93", "source_structure_hash": "sha256:dff62d151843f3ba84062fab5e9153b0fdfa6aff0c95c86818ee423fc81cc243", "source_math_hash": "sha256:6c16f1c1ff09bede92f51c16b0b3464c66ec7e410084f1a51dc9b0a81efc7ea5"}
