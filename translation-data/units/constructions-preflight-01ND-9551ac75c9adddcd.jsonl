{"chapter": "constructions", "node_kind": "paragraph", "parent_tag": "01ND", "placeholders": {"REF_0001": "\\ref{divisors-lemma-closed-subscheme-proj}", "STRUCT_0001": "\\noindent"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R2", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:5b4f6c875c914c099ee57f6643b76f5492f21ab09de5842e29b4aaf1504e5dc9", "source_text": "\n\n<STRUCT_0001>\nThe following two lemmas are special cases of more general results later, but\nperhaps it makes sense to prove these directly here now. The first one is\na special case of Divisors, Lemma <REF_0001>.\n\n", "source_text_hash": "sha256:cb4cfd7eeeabc24bc3b8f9750987d53b8ed9cf5e30d1fc3f4859a08b015b2e87", "unit_id": "tag:01ND:prose-0003"}
