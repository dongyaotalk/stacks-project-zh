010>（其证明采取了稍有不同的方法）结合《景上的上同调（Cohomology on Sites）》引理 <REF_0011> 得出。\n","allowed_english":["p","fpqc","Čech"],"term_occurrences":[{"source_term":"site","target_term":"景"},{"source_term":"object","target_term":"对象"},{"source_term":"sheaf property","target_term":"层性质"},{"source_term":"affine","target_term":"仿射的"},{"source_term":"fpqc covering","target_term":"fpqc 覆盖"},{"source_term":"covering","target_term":"覆盖"},{"source_term":"spectral sequence","target_term":"谱序列"},{"source_term":"cohomology","target_term":"上同调"},{"source_term":"class","target_term":"类"},{"source_term":"covering","target_term":"覆盖"},{"source_term":"covering","target_term":"覆盖"},{"source_term":"module","target_term":"模"},{"source_term":"<GROUPOPEN_0001><ACCENT_0001><GROUPCLOSE_0001>ech complex","target_term":"Čech 复形"},{"source_term":"complex","target_term":"复形"},{"source_term":"fpqc covering","target_term":"fpqc 覆盖"},{"source_term":"covering","target_term":"覆盖"},{"source_term":"spectral sequence","target_term":"谱序列"},{"source_term":"intersections","target_term":"交"},{"source_term":"affine","target_term":"仿射的"},{"source_term":"cohomology groups","target_term":"上同调群"},{"source_term":"morphism","target_term":"态射"},{"source_term":"covering","target_term":"覆盖"},{"source_term":"<GROUPOPEN_0002><ACCENT_0002><GROUPCLOSE_0002>ech cohomology","target_term":"Čech 上同调"},{"source_term":"class","target_term":"类"},{"source_term":"separated","target_term":"分离的"},{"source_term":"affine open","target_term":"仿射开"},{"source_term":"covering","target_term":"覆盖"},{"source_term":"family","target_term":"族"},{"source_term":"fpqc covering","target_term":"fpqc 覆盖"},{"source_term":"intersections","target_term":"交"},{"source_term":"affine","target_term":"仿射的"},{"source_term":"separated","target_term":"分离的"},{"source_term":"spectral sequence","target_term":"谱序列"},{"source_term":"row","target_term":"行"},{"source_term":"rows","target_term":"行"},{"source_term":"scheme theory","target_term":"概形理论"},{"source_term":"Cohomology of Schem