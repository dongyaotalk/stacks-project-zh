89e805fe57c2b0b91848bf891ec05", "source_label": "spaces-descent-lemma-descent-data-sheaves", "usage": "spaces-source-frames", "usage_source": {"after": "\\\\", "before": "X", "environments": ["matrix"]}}, "command": "text", "policy_entry": "spaces-wave-eb98ab1a6f99", "slot_byte_span": {"end": 268, "start": 253}, "slot_id": "math/0001/text/0007", "source": " such that each"}, {"boundary_placeholders": ["MATHSEG_0008", "MATHSEG_0009"], "classification_witness": {"anchor": {"file": "spaces-descent.tex", "kind": "lemma", "matches": [{"command_byte_span": {"end": 132790, "start": 132761}, "command_hash": "sha256:7a7e79387d93ea97217b0a5c9c198dbc56fe665a73fcea9403eed0846bbe95fb", "container_byte_span": {"end": 133261, "start": 132203}, "container_hash": "sha256:12782b213b106e200d0d408da4de49cef431e9981f58e7b13a89a59b6075a5e0"}], "ordinal": 1, "owner_label": "spaces-descent-lemma-descent-data-sheaves", "owner_tag": "0ADT", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14"}, "policy_hash": "sha256:8041478908b37ecdcc8c1acf80b37d1345e89e805fe57c2b0b91848bf891ec05", "source_label": "spaces-descent-lemma-descent-data-sheaves", "usage": "spaces-source-frames", "usage_source": {"after": "\n\\end{matrix}", "before": "F", "environments": ["matrix"]}}, "command": "text", "policy_entry": "spaces-wave-d9ce201a8b65", "slot_byte_span": {"end": 314, "start": 292}, "slot_id": "math/0001/text/0008", "source": " is an algebraic space"}], "source": "$$\n\\left\\{\n\\begin{matrix}\n\\text{descent data }(V_i, \\varphi_{ij})\\\\\n\\text{relative to }\\{X_i \\to X\\}\n\\end{matrix}\n\\right\\}\n\\leftrightarrow\n\\left\\{\n\\begin{matrix}\n\\text{sheaves }F\\text{ on }(\\Sch/S)_{fppf}\\text{ endowed}\\\\\n\\text{with a map }F \\to X\\text{ such that each}\\\\\nX_i \\times_X F\\text{ is an algebraic space}\n\\end{matrix}\n\\right\\}.\n$$", "source_byte_span": {"end": 613, "start": 272}, "source_hash": "sha256:53de19d1a11de52a4018325ad561b17b1247a684d874f0956c0e570e46ffcf39"}], "node_kind": "lemma", "parent_tag": "0ADS", "placeholders": {"FOOTNOTECLOSE_0001": "}", "FOOTNOTEOPEN_0001": "\\footnote{", "MATHSEG_0001": "$$\n\\left\\{\n\\begin{matrix}\n\\text{", "MATHSEG_0002": "}(V_i, \\varphi_{ij})\\\\\n\\text{", "MATHSEG_0003": "}\\{X_i \\to X\\}\n\\end{matrix}\n\\right\\}\n\\leftrightarrow\n\\left\\{\n\\begin{matrix}\n\\text{", "MATHSEG_0004": "}F\\text{", "MATHSEG_0005": "}(\\Sch/S)_{fppf}\\text{", "MATHSEG_0006": "}\\\\\n\\text{", "MATHSEG_0007": "}F \\to X\\text{", "MATHSEG_0008": "}\\\\\nX_i \\times_X F\\text{", "MATHSEG_0009": "}\n\\end{matrix}\n\\right\\}.\n$$", "MATH_0001": "$S$", "MATH_0002": "$\\{X_i \\to X\\}_{i \\in I}$", "MATH_0003": "$S$", "MATH_0004": "$X_i \\times_X F$", "MATH_0005": "$V_i$", "MATH_0006": "$F$", "MATH_0007": "$I$", "MATH_0008": "$(X_i, \\varphi_{ij})$", "REF_0001": "\\ref{spaces-topologies-definition-fppf-covering}", "REF_0002": "\\ref{bootstrap-lemma-descend-algebraic-space}", "STRUCT_0001": "\\begin{enumerate}", "STRUCT_0002": "\\item", "STRUCT_0003": "\\item", "STRUCT_0004": "\\end{enumerate}"}, "render": {"prefix": "\\begin{lemma}\n\\label{lemma-descent-data-sheaves}\n", "suffix": "\\end{lemma}"}, "risk_level": "R3", "schema_version": 2, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:9b486d1953f3ab09da1932be92e8e361e93386677dd4e69f5c26875bb1a4cf83", "source_math_skeleton_hash": "sha256:c901712e6fc8a0b74b68077c463183201d4793874428b71e72ad073ab640fda8", "source_status": "CURRENT", "source_structure_hash": "sha256:af146d55c512112035c5dbae041838cac7f16ade2e7aa50e372e45c0e7e80576", "source_text": "Let <MATH_0001> be a scheme. Let <MATH_0002> be an fppf\ncovering of algebraic spaces over <MATH_0003> (Topologies on Spaces,\nDefinition <REF_0001>).\nThere is an equivalence of categories\n<MATHSEG_0001>descent data <MATHSEG_0002>relative to <MATHSEG_0003>sheaves <MATHSEG_0004> on <MATHSEG_0005> endowed<MATHSEG_0006>with a map <MATHSEG_0007> such that each<MATHSEG_0008> is an algebraic space<MATHSEG_0009>\nMoreover,\n<STRUCT_0001>\n<STRUCT_0002> the algebraic space <MATH_0004> on the right hand side\ncorresponds to <MATH_0005> on the left hand side, and\n<STRUCT_0003> the sheaf <MATH_0006> is an algebraic space<FOOTNOTEOPEN_0001>We will see\nlater that this is always the case if <MATH_0007> is not too large, see\nBootstrap, Lemma <REF_0002>.<FOOTNOTECLOSE_0001>\nif and only if the\ncorresponding descent datum <MATH_0008> is effective.\n<STRUCT_0004>\n", "source_text_hash": "sha256:c434e4e512172d1b917239cecd66be6c7bfdf26d259bf3ad243fc1ff04ad144f", "unit_id": "tag:0ADT:statement"}
