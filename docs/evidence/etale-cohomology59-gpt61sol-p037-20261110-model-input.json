          "node_kind": "definition",
          "risk_level": "R3",
          "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14",
          "source_text": "<STRUCT_0001>\n<LOCKED_0001>\nLet <MATH_0001> be a connected scheme. Let <MATH_0002> be a geometric point\nof <MATH_0003>. The <TEXTITOPEN_0001>fundamental group<TEXTITCLOSE_0001> of <MATH_0004> with\n<TEXTITOPEN_0002>base point<TEXTITCLOSE_0002> <MATH_0005> is the group\n<MATH_0006>\nof automorphisms of the fibre functor\n<MATH_0007>\nendowed with its canonical profinite topology from\nLemma <REF_0001>.\n<STRUCT_0002>",
          "source_status": "CURRENT",
          "placeholders": {
            "STRUCT_0001": "\\begin{definition}",
            "LOCKED_0001": "\\label{definition-fundamental-group}",
            "MATH_0001": "$X$",
            "MATH_0002": "$\\overline{x}$",
            "MATH_0003": "$X$",
            "TEXTITOPEN_0001": "{\\it ",
            "TEXTITCLOSE_0001": "}",
            "MATH_0004": "$X$",
            "TEXTITOPEN_0002": "{\\it ",
            "TEXTITCLOSE_0002": "}",
            "MATH_0005": "$\\overline{x}$",
            "MATH_0006": "$$\n\\pi_1(X, \\overline{x}) = \\text{Aut}(F_{\\overline{x}})\n$$",
            "MATH_0007": "$F_{\\overline{x}} : \\textit{F\\'Et}_X \\to \\textit{Sets}$",
            "REF_0001": "\\ref{lemma-aut-inverse-limit}",
            "STRUCT_0002": "\\end{definition}"
