{"unit_id":"tag:07A6:statement","translation":"设 <MATH_0001> 为赋环拓扑斯的态射（morphism of ringed topoi）。上文定义的函子（functor）<MATH_0002> 和引理 <REF_0001> 中定义的函子（functor）<MATH_0003> 互为伴随（adjoint）：\n<MATH_0004>\n关于 <MATH_0005> 及 <MATH_0006> 具有双函子性（bifunctorially）。\n","allowed_english":[],"term_occurrences":[{"source_term":"morphism of ringed topoi","target_term":"赋环拓扑斯的态射"},{"source_term":"functor","target_term":"函子"},{"source_term":"functor","target_term":"函子"},{"source_term":"adjoint","target_term":"伴随"},{"source_term":"bifunctorially","target_term":"双函子性"}],"unknown_terms":[{"source_term":"morphism of ringed topoi","target_term":"赋环拓扑斯的态射","context":"伴随函子对应的态射"},{"source_term":"functor","target_term":"函子","context":"导出拉回与直像"},{"source_term":"adjoint","target_term":"伴随","context":"函子伴随性"},{"source_term":"bifunctorially","target_term":"双函子性","context":"伴随同构的双函子性"}],"notes":[]}
