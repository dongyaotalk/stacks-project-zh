{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stacks-project-zh.invalid/schema/derivation-archive.schema.json",
  "title": "Immutable derived output archive",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "prior_derivation_id",
    "successor_derivation_id",
    "source_commit",
    "created_at",
    "origin_commit",
    "record",
    "files"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "prior_derivation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "successor_derivation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "origin_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "hash"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output_units",
        "output_candidates"
      ],
      "properties": {
        "output_units": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "hash"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "output_candidates": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "hash"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        }
      }
    }
  }
}
