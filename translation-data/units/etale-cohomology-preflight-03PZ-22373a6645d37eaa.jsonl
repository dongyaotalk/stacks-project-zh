{"chapter": "etale-cohomology", "node_kind": "paragraph", "parent_tag": "03PZ", "placeholders": {"ACCENT_0001": "\\'e", "REF_0001": "\\ref{topologies-section-etale}", "STRUCT_0001": "\\noindent"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R2", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:0e78b9367beed6d0270160323bd0f0463dee25c38802ae9f33e96a4f5b6f2388", "source_text": "\n\n<STRUCT_0001>\nIn this section we briefly discuss pullback of sheaves on the small\n<ACCENT_0001>tale sites. The precise construction of this is in\nTopologies, Section <REF_0001>.\n\n", "source_text_hash": "sha256:4f0dea16519f96699c44aa8e58485ebbe574702e52a536010315d9b59f14fce5", "unit_id": "tag:03PZ:prose-0001"}
