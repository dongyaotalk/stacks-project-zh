% Chinese-safe companion to the untouched reference svind.ist. makeindex is
% byte-oriented and cannot form meaningful alphabetic group headings for
% UTF-8 Chinese entries, so the Chinese build disables only those headings.
headings_flag 0
delim_0 "\\idxquad "
delim_1 "\\idxquad "
delim_2 "\\idxquad "
