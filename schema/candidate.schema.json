{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stacks-project-zh.invalid/schema/candidate.schema.json",
  "title": "Stacks Project Chinese model candidate (schema v2)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "unit_id",
    "source_commit",
    "source_text_hash",
    "model_id",
    "model_lane",
    "harness_id",
    "harness_version",
    "model_record_id",
    "model_snapshot",
    "model_identity_confidence",
    "run_id",
    "reasoning_effort",
    "prompt_version",
    "glossary_revision",
    "context",
    "context_hash",
    "translation",
    "allowed_english",
    "term_occurrences",
    "unknown_terms",
    "notes",
    "stage",
    "source_status",
    "qa_status",
    "term_status",
    "publication_status",
    "created_at",
    "translation_hash"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "unit_id": {"type": "string", "minLength": 1},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_text_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "model_id": {"type": "string", "minLength": 1},
    "model_lane": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "harness_id": {"type": "string", "minLength": 1},
    "harness_version": {"type": "string", "minLength": 1},
    "model_record_id": {"type": "string", "minLength": 1},
    "model_snapshot": {"type": ["string", "null"]},
    "model_identity_confidence": {
      "enum": ["runtime-resolved", "owner-confirmed", "declared", "unknown"]
    },
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "reasoning_effort": {"type": "string", "minLength": 1},
    "prompt_version": {"type": "string", "minLength": 1},
    "glossary_revision": {"type": "string", "minLength": 1},
    "context": {"type": "object"},
    "context_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "translation": {"type": "string", "minLength": 1},
    "allowed_english": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "term_occurrences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_term", "target_term"],
        "properties": {
          "source_term": {"type": "string", "minLength": 1},
          "target_term": {"type": "string", "minLength": 1}
        }
      }
    },
    "unknown_terms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_term", "target_term", "context"],
        "properties": {
          "source_term": {"type": "string", "minLength": 1},
          "target_term": {"type": "string", "minLength": 1},
          "context": {"type": "string", "minLength": 1}
        }
      }
    },
    "notes": {"type": "array", "items": {"type": "string"}},
    "stage": {"enum": ["AI_DRAFT", "STRUCTURE_OK", "TERM_OK", "CRITIC_OK"]},
    "source_status": {"enum": ["CURRENT", "STALE_TEXT", "STALE_MATH", "PARTIAL_STALE", "RETIRED"]},
    "qa_status": {"enum": ["NOT_RUN", "PASS", "FAIL"]},
    "term_status": {"enum": ["CLEAR", "DECISION_REQUIRED"]},
    "publication_status": {"enum": ["INTERNAL", "CANDIDATE"]},
    "created_at": {"type": "string", "minLength": 1},
    "translation_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "review_claims": {"type": "array", "maxItems": 0}
  }
}
