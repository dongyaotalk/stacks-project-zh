{"chapter": "criteria", "node_kind": "paragraph", "parent_tag": "06CT", "placeholders": {"MATH_0001": "$S$", "MATH_0002": "$p : \\mathcal{X} \\to \\mathcal{Y}$", "MATH_0003": "$1$", "MATH_0004": "$(\\Sch/S)_{fppf}$", "MATH_0005": "$p$", "MATH_0006": "$U = \\lim_{i \\in I} U_i$", "MATH_0007": "$U_i$", "MATH_0008": "$S$", "MATH_0009": "$y_i$", "MATH_0010": "$\\mathcal{Y}$", "MATH_0011": "$U_i$", "MATH_0012": "$i$", "MATH_0013": "$x$", "MATH_0014": "$\\mathcal{X}$", "MATH_0015": "$U$", "MATH_0016": "$\\gamma : p(x) \\to y_i|_U$", "MATH_0017": "$i' \\geq i$", "MATH_0018": "$x_{i'}$", "MATH_0019": "$\\mathcal{X}$", "MATH_0020": "$U_{i'}$", "MATH_0021": "$\\beta : x_{i'}|_U \\to x$", "MATH_0022": "$\\gamma_{i'} : p(x_{i'}) \\to y_i|_{U_{i'}}$", "MATH_0023": "\\begin{equation}\n\\label{equation-limit-preserving}\n\\vcenter{\n\\xymatrix{\np(x_{i'}|_U) \\ar[d]_{p(\\beta)} \\ar[rr]_{\\gamma_{i'}|_U} & &\n(y_i|_{U_{i'}})|_U \\ar@{=}[d] \\\\\np(x) \\ar[rr]^\\gamma & & y_i|_U\n}\n}\n\\end{equation}", "MATH_0024": "$(i', x_{i'}, \\beta, \\gamma_{i'})$", "REF_0001": "\\ref{spaces-limits-lemma-characterize-relative-limit-preserving}", "STRUCT_0001": "\\noindent", "STRUCT_0002": "\\begin{enumerate}", "STRUCT_0003": "\\item", "STRUCT_0004": "\\item", "STRUCT_0005": "\\item", "STRUCT_0006": "\\item", "STRUCT_0007": "\\end{enumerate}", "TEXTITCLOSE_0001": "}", "TEXTITCLOSE_0002": "}", "TEXTITOPEN_0001": "{\\it ", "TEXTITOPEN_0002": "{\\it "}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R2", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:20a1c82dd7129d8266e176f4b9d81bb1dbee4de5b7a95fd8a7da628bf19893a2", "source_status": "CURRENT", "source_structure_hash": "sha256:906e936a7b04b0a17264671acbae8c7d5b15b44c927528e0696ab8c031029ae6", "source_text": "\n\n<STRUCT_0001>\nLet <MATH_0001> be a scheme. Let <MATH_0002> be a <MATH_0003>-morphism\nof categories fibred in groupoids over <MATH_0004>. We will say that\n<MATH_0005>