<STRUCT_0003> the ring map <MATH_0002> is smooth,\n<STRUCT_0004> the <MATH_0003>-module <MATH_0004> is free on\n<MATH_0005>,\n<STRUCT_0005> the <MATH_0006>-module <MATH_0007> is free on the classes of <MATH_0008>,\n<STRUCT_0006> for any <MATH_0009> the ring map <MATH_0010> is standard smooth,\n<STRUCT_0007> for any ring map <MATH_0011> the base change\n<MATH_0012> is standard smooth,\n<STRUCT_0008> if <MATH_0013> maps to an invertible element in <MATH_0014>, then\n<MATH_0015> is standard smooth, and\n<STRUCT_0009> the ring <MATH_0016> is a relative global complete intersection over <MATH_0017>.\n<STRUCT_0010>\n<STRUCT_0011>", "source_text_hash": "sha256:b156cef10fc3e435b8d317c5faaed79af33ae02686f7b39fcec08a4d379282e7", "unit_id": "inventory:algebra:00T7:lemma/0001"}}}, {"context_id": "locked-English-reference:etale:inventory:etale:024P:theorem/0001:etale-theorem-unramified-equivalence", "hash": "sha256:fa8761ed98d08eadf25f0d223aaa2c24385c670e192dbbcd91197b9c6da79aba", "value": {"kind": "locked-English-reference", "location": {"byte_end": 11314, "byte_start": 10453, "file": "etale.tex", "fragment_hash": "sha256:afae40baf1fe1b5071068cd9024d6112a1b4549ee4bb9922a1db682cc9e2b275", "line_end": 300, "line_start": 276}, "owner_tag": "024P", "parent_tag": "024O", "requested_label": "etale-theorem-unramified-equivalence", "requested_tag": "024P", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "etale", "node_kind": "theorem", "parent_tag": "024O", "placeholders": {"LOCKED_0001": "\\label{theorem-unramified-equivalence}", "MATH_0001": "$Y$", "MATH_0002": "$f : X \\to Y$", "MATH_0003": "$x$", "MATH_0004": "$X$", "MATH_0005": "$f$", "MATH_0006": "$x$", "MATH_0007": "$\\Omega_{X/Y, x}$", "MATH_0008": "$x$", "MATH_0009": "$U$", "MATH_0010": "$x$", "MATH_0011": "$V$", "MATH_0012": "$f(x)$", "MATH_0013": "$$\n\\xymatrix{\nU \\ar[rr]_i \\ar[rd] & & \\mathbf{A}^n_V \\ar[ld] \\\\\n& V\n}\n$$", "MATH_0014": "$i$", "MATH_0015": "$\\mathcal{I}$", "M