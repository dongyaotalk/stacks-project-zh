{"unit_id":"tag:0214:prose-0006","translation":"\n\n<STRUCT_0001>\n大仿射（affine）平展（<ACCENT_0001>tale）景（site）、小（small）平展（<ACCENT_0002>tale）景（site）和小（small）仿射（affine）平展（<ACCENT_0003>tale）景（site）确实是景（sites），这一点尚不完全清楚。现在验证。\n\n","allowed_english":[],"term_occurrences":[{"source_term":"affine","target_term":"仿射"},{"source_term":"<ACCENT_0001>tale","target_term":"平展"},{"source_term":"site","target_term":"景"},{"source_term":"small","target_term":"小"},{"source_term":"<ACCENT_0002>tale","target_term":"平展"},{"source_term":"site","target_term":"景"},{"source_term":"small","target_term":"小"},{"source_term":"affine","target_term":"仿射"},{"source_term":"<ACCENT_0003>tale","target_term":"平展"},{"source_term":"site","target_term":"景"},{"source_term":"sites","target_term":"景"}],"unknown_terms":[{"source_term":"affine","target_term":"仿射","context":"景的仿射限定，待决"},{"source_term":"<ACCENT_0001>tale","target_term":"平展","context":"大仿射景限定，待决"},{"source_term":"site","target_term":"景","context":"待验证结构，待决"},{"source_term":"small","target_term":"小","context":"小景限定，待决"},{"source_term":"<ACCENT_0002>tale","target_term":"平展","context":"小景限定，待决"},{"source_term":"<ACCENT_0003>tale","target_term":"平展","context":"小仿射景限定，待决"},{"source_term":"sites","target_term":"景","context":"公理要求，待决"}],"notes":[]}
