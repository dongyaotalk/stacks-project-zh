        "kind": "locked-English-reference",
        "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14",
        "source_unit": {
          "schema_version": 1,
          "unit_id": "inventory:topologies:021R:definition/0001",
          "parent_tag": "021L",
          "chapter": "topologies",
          "node_kind": "definition",
          "risk_level": "R3",
          "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14",
          "source_text": "<STRUCT_0001>\n<LOCKED_0001>\nA <TEXTITOPEN_0001>big fppf site<TEXTITCLOSE_0001> is any site <MATH_0001> as in\nSites, Definition <REF_0001> constructed as follows:\n<STRUCT_0002>\n<STRUCT_0003> Choose any set of schemes <MATH_0002>, and any set of fppf coverings\n<MATH_0003> among these schemes.\n<STRUCT_0004> As underlying category take any category <MATH_0004>\nconstructed as in Sets, Lemma <REF_0002>\nstarting with the set <MATH_0005>.\n<STRUCT_0005> Choose any set of coverings as in\nSets, Lemma <REF_0003> starting with the\ncategory <MATH_0006> and the class of fppf coverings,\nand the set <MATH_0007> chosen above.\n<STRUCT_0006>\n<STRUCT_0007>",
          "source_status": "CURRENT",
          "placeholders": {
            "STRUCT_0001": "\\begin{definition}",
            "LOCKED_0001": "\\label{definition-big-fppf-site}",
            "TEXTITOPEN_0001": "{\\it ",
            "TEXTITCLOSE_0001": "}",
            "MATH_0001": "$\\Sch_{fppf}$",
            "REF_0001": "\\ref{sites-definition-site}",
            "STRUCT_0002": "\\begin{enumerate}",
            "STRUCT_0003": "\\item",
            "MATH_0002": "$S_0$",
            "MATH_0003": "$\\text{Cov}_0$",
            "STRUCT_0004": "\\item",
            "MATH_0004": "$\\Sch_\\alpha$",
            "REF_0002": "\\ref{sets-lemma-construct-category}",
            "MATH_0005": "$S_0$",
            "STRUCT_0005": "\\item",
            "REF_0003": "\\ref{sets-lemma-coverings-site}",
            "MATH_0006": "$\\Sch_\\alpha$",
            "MATH_0007": "$\\text{Cov}_0$",
            "STRUCT_0006": "\\end{enumerate}",
            "STRUCT_0007": "\\end{definition}"
          },
          "render": {
            "prefix": "",
            "suffix": ""
          },
