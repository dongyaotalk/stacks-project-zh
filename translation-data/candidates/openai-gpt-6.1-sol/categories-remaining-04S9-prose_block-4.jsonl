维化"}, {"context": "被刻画的纤维化条件；待决。", "source_term": "setoids", "target_term": "集合胚"}, {"context": "刻画中的群胚纤维化条件；待决。", "source_term": "groupoids", "target_term": "群胚"}, {"context": "与集合纤维化范畴之间的等价关系；待决。", "source_term": "equivalent", "target_term": "等价"}, {"context": "比较目标及第二句的集合纤维化条件；待决。", "source_term": "sets", "target_term": "集合"}, {"context": "集合纤维化范畴间的等价；待决。", "source_term": "equivalence of categories", "target_term": "范畴等价"}, {"context": "上述等价实际具有的性质；待决。", "source_term": "isomorphism", "target_term": "同构"}]}
