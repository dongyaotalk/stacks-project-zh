{"chapter": "sites", "node_kind": "paragraph", "parent_tag": "04I8", "placeholders": {"STRUCT_0001": "\\noindent"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R2", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:9bf0a514c2d34424760749283c6c44fd0336cf72c6f01f0c71e01c25ec9c23bc", "source_text": "\n\n<STRUCT_0001>\nAt this point we can localize a site, we know how to relocalize,\nand we can localize a morphism of sites at an object of the site downstairs.\nIf we combine these then we get the following kind of diagram.\n\n", "source_text_hash": "sha256:3d9ad095d9ca9ccf4c5c8f31aacb29a870f60ab598533adbaeedad080f5ce9f1", "unit_id": "tag:04I8:prose-0003"}
{"chapter": "sites", "node_kind": "lemma", "parent_tag": "04I8", "placeholders": {"MATH_0001": "$f : \\mathcal{C} \\to \\mathcal{D}$", "MATH_0002": "$u : \\mathcal{D} \\to \\mathcal{C}$", "MATH_0003": "$V \\in \\Ob(\\mathcal{D})$", "MATH_0004": "$U \\in \\Ob(\\mathcal{C})$", "MATH_0005": "$c : U \\to u(V)$", "MATH_0006": "$\\mathcal{C}$", "MATH_0007": "$$\n\\xymatrix{\n\\Sh(\\mathcal{C}/U) \\ar[r]_{j_U} \\ar[d]_{f_c} &\n\\Sh(\\mathcal{C}) \\ar[d]^f \\\\\n\\Sh(\\mathcal{D}/V) \\ar[r]^{j_V} &\n\\Sh(\\mathcal{D}).\n}\n$$", "MATH_0008": "$f_c = f' \\circ j_{U/u(V)}$", "MATH_0009": "$f' : \\Sh(\\mathcal{C}/u(V)) \\to \\Sh(\\mathcal{D}/V)$", "MATH_0010": "$j_{U/u(V)} : \\Sh(\\mathcal{C}/U) \\to \\Sh(\\mathcal{C}/u(V))$", "MATH_0011": "$\\Sh(\\mathcal{C}/U) = \\Sh(\\mathcal{C})/h_U^\\#$", "MATH_0012": "$\\Sh(\\mathcal{D}/V) = \\Sh(\\mathcal{D})/h_V^\\#$", "MATH_0013": "$(f_c)^{-1}$", "MATH_0014": "$$\n(f_c)^{-1}(\\mathcal{H} \\xrightarrow{\\varphi} h_V^\\#)\n=\n(f^{-1}\\mathcal{H} \\times_{f^{-1}\\varphi, h_{u(V)}^\\#, c} h_U^\\#\n\\rightarrow h_U^\\#).\n$$", "MATH_0015": "$b : V' \\to V$", "MATH_0016": "$a : U' \\to U$", "MATH_0017": "$c' : U' \\to u(V')$", "MATH_0018": "$$\n\\xymatrix{\nU' \\ar[r]_-{c'} \\ar[d]_a & u(V') \\ar[d]^{u(b)} \\\\\nU \\ar[r]^-c & u(V)\n}\n$$", "MATH_0019": "$$\n\\xymatrix{\n\\Sh(\\mathcal{C}/U') \\ar[r]_{j_{U'/U}} \\ar[d]_{f_{c'}} &\n\\Sh(\\mathcal{C}/U) \\ar[d]^{f_c} \\\\\n\\Sh(\\mathcal{D}/V') \\ar[r]^{j_{V'/V}} &\n\\Sh(\\mathcal{D}/V).\n}\n$$", "REF_0001": "\\ref{lemma-localize-morphism}", "REF_0002": "\\ref{lemma-relocalize}", "REF_0003": "\\ref{lemma-essential-image-j-shriek}"}, "render": {"prefix": "\\begin{lemma}\n\\label{lemma-relocalize-morphism}\n", "suffix": "\\end{lemma}"}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:498184ec84142f0ddf2a7346063f8f48747a8a615a7672671596a9bd3ddab101", "source_status": "CURRENT", "source_structure_hash": "sha256:5fa37