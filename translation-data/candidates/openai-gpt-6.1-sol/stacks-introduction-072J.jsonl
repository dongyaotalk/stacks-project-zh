72I", "placeholders": {"STRUCT_0001": "\\noindent"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R1", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:ce86f7d3c5d83d2b9ff887e3a834b4be7871352df270413e95705bed2d2d133b", "source_text": "<STRUCT_0001>\nWe give an informal introduction to algebraic stacks. The goal is to\nquickly introduce a simple language which you can use to think\nabout local and global properties of your favorite moduli problem.\nHaving done this it should be possible to ask yourself well-posed questions\nabout moduli problems and to start solving them, whilst assuming a general\ntheory exists. If you end up with an interesting result,\nyou can go back to the general theory in the other parts of the stacks\nproject and fill in the gaps as needed.", "source_text_hash": "sha256:66edc30a12e5c5ff54e0eef4fc658a039e705a7e843e8e179f85f96e56c7cb17", "unit_id": "inventory:stacks-introduction:072I:paragraph/0001"}}}, {"context_id": "neighbor:inventory:stacks-introduction:072I:section_title/0001", "hash": "sha256:a186e269c78f51666421d575a6dd2889269e9458d98d25622aaa013c9e657d1d", "value": {"kind": "locked-English-neighbor", "location": {"byte_end": 221, "byte_start": 168, "file": "stacks-introduction.tex", "fragment_hash": "sha256:f8453f82d0da137e5f552b84a3a4b1dd8f52855f4404c66293439f1480ec698b", "line_end": 20, "line_start": 19}, "owner_tag": "072I", "parent_tag": "072I", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "stacks-introduction", "node_kind": "section_title", "parent_tag": "072I", "placeholders": {"LOCKED_0001": "\\label{section-introduction}", "TEXTCLOSE_0001": "}", "TEXTOPEN_0001": "\\section{"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R1", "schema_version": 1, "source_commit": "a04446e57ec1fbc25