{"chapter": "sites", "node_kind": "paragraph", "parent_tag": "00W1", "placeholders": {"STRUCT_0001": "\\noindent"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R2", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:7013008b7dbaa7c3ba94b406de0149cddf21bed360bbc46e62d10adffe6eac67", "source_text": "\n\n<STRUCT_0001>\nThe next two lemmas imply that the colimits above are colimits\nover a directed set.\n\n", "source_text_hash": "sha256:e82411ff1d774182cd5fb352288b72dbf39bf238f2461295008a05858db4f044", "unit_id": "tag:00W1:prose-0004"}
