            "MATH_0002": "$\\text{Gal}_{\\kappa(s)}$",
            "REF_0001": "\\ref{pione-definition-G-set-continuous}",
            "MATH_0003": "$$\n\\Sh(S_\\etale) \\longrightarrow\n\\text{Gal}_{\\kappa(s)}\\textit{-Sets},\n\\quad\n\\mathcal{F} \\longmapsto \\mathcal{F}_{\\overline{s}}\n$$"
          },
          "render": {
