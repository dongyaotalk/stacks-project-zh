8745}, "command_hash": "sha256:97893f74344afda6dfa8b249c5c1a2d9d528604035279105e4eb4b9b2cd63a2c", "container_byte_span": {"end": 289070, "start": 288192}, "container_hash": "sha256:56ffecd616d4f9f463decab016de174eafc896fdb970ce085b3ae43a5bc00b83"}], "ordinal": 1, "owner_label": "categories-lemma-2-category-fibred-sets", "owner_tag": "02Y2", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14"}, "policy_hash": "sha256:84965b2ff4ccdfd321eb2ab22179b01a8fe73dcdbc0c32c99889594abec4a73e", "source_label": "categories-lemma-2-category-fibred-sets", "usage": "matrix-row-prefix", "usage_source": {"after": "\\mathcal{C}\n\\end{matrix}", "before": "\\\\\n", "environments": ["matrix"]}}, "command": "text", "policy_entry": "categories-remaining-fibred-sets", "slot_byte_span": {"end": 217, "start": 197}, "slot_id": "math/0001/text/0004", "source": "fibred in sets over "}], "source": "$$\n\\left\\{\n\\begin{matrix}\n\\text{the category of presheaves}\\\\\n\\text{of sets over }\\mathcal{C}\n\\end{matrix}\n\\right\\}\n\\leftrightarrow\n\\left\\{\n\\begin{matrix}\n\\text{the category of categories}\\\\\n\\text{fibred in sets over }\\mathcal{C}\n\\end{matrix}\n\\right\\}\n$$", "source_byte_span": {"end": 352, "start": 98}, "source_hash": "sha256:5ef6770e5d1d79046c0885b6dcd322d727d54bdfbccd50b04e99b89e9d4f59a0"}], "node_kind": "lemma", "parent_tag": "042Y", "placeholders": {"MATHSEG_0001": "$$\n\\left\\{\n\\begin{matrix}\n\\text{", "MATHSEG_0002": "}\\\\\n\\text{", "MATHSEG_0003": "}\\mathcal{C}\n\\end{matrix}\n\\right\\}\n\\leftrightarrow\n\\left\\{\n\\begin{matrix}\n\\text{", "MATHSEG_0004": "}\\\\\n\\text{", "MATHSEG_0005": "}\\mathcal{C}\n\\end{matrix}\n\\right\\}\n$$", "MATH_0001": "$\\mathcal{C}$", "REF_0001": "\\ref{categories-lemma-2-category-fibred-sets}"}, "render": {"prefix": "\\begin{lemma}\n\\label{lemma-when-stack-in-sets}\n", "suffix": "\\end{lemma}"}, "risk_level": "R3", "schema_version": 2, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:ed8e2438e4e17d71666c5a75ec64d94927cbed1b19ac3ae6b84895c93cd4de95", "source_math_skeleton_hash": "sha256:f60935aa2e911266efaeeca231aab87d167e52f67ce4d36465a3a0aa7b8380b7", "source_status": "CURRENT", "source_structure_hash": "sha256:f2cecffac5a53ade13ac8c36b511c7bd01559e5460e00ceb2082dc88af00db32", "source_text": "Let <MATH_0001> be a site. Under the equivalence\n<MATHSEG_0001>the category of presheaves<MATHSEG_0002>of sets over <MATHSEG_0003>the category of categories<MATHSEG_0004>fibred in sets over <MATHSEG_0005>\nof\nCategories, Lemma <REF_0001>\nthe stacks in sets correspond precisely to the sheaves.\n", "source_text_hash": "sha256:17965ea0132f4427eb34fb01b758d83f1e4836c36887c2958d3c50fdc7ec86d3", "unit_id": "tag:0430:statement"}
{"chapter": "stacks", "node_kind": "proof", "parent_tag": "042Y", "placeholders": {}, "render": {"prefix": "\\begin{proof}\n", "suffix": "\\end{proof}"}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:7b255fc76bb0bbe9c4def579cbae2f7d7790541c026b4afecc55a9702cd2e61b", "source_text": "Omitted. Hint: Show that effectivity of descent corresponds exactly to\nthe sheaf condition.\n", "source_text_hash": "sha256:740790d431aec231a876a1b077024fac0e3fcc9e244d58bfa70afdf8ea7345f5", "unit_id": "tag:0430:proof"}
