_tag": "05WM", "requested_label": "more-morphisms-lemma-dominate-fppf-finite", "requested_tag": "0CP0", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "more-morphisms", "node_kind": "lemma", "parent_tag": "05WM", "placeholders": {"LOCKED_0001": "\\label{lemma-dominate-fppf-finite}", "MATH_0001": "$S$", "MATH_0002": "$\\{S_i \\to S\\}_{i \\in I}$", "MATH_0003": "$S' \\to S$", "MATH_0004": "$S' = \\bigcup U'_\\alpha$", "MATH_0005": "$\\alpha$", "MATH_0006": "$U'_\\alpha \\to S$", "MATH_0007": "$S_i \\to S$", "MATH_0008": "$i$", "STRUCT_0001": "\\begin{lemma}", "STRUCT_0002": "\\end{lemma}"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:02098ae946572681e9c74696e4611cfe633bb365406bfd2534b6353154d5a02a", "source_status": "CURRENT", "source_structure_hash": "sha256:164179dfc8e1f83c1a9842e2a5ab7fb4ff07af239452129ca35f2ff96471a916", "source_text": "<STRUCT_0001>\n<LOCKED_0001>\nLet <MATH_0001> be a quasi-compact and quasi-separated scheme.\nLet <MATH_0002> be an fppf covering.\nThen there exists a surjective finite morphism <MATH_0003>\nof finite presentation and an\nopen covering <MATH_0004> such that for each <MATH_0005> the\nmorphism <MATH_0006> factors through <MATH_0007> for some <MATH_0008>.\n<STRUCT_0002>", "source_text_hash": "sha256:7edd79a856ab3489f108cf3a4d6b8b9651ccd94f878963484525b1b8e8d636a5", "unit_id": "inventory:more-morphisms:0CP0:lemma/0001"}}}], "input_freeze": {"hash": "sha256:600d10b13860e6603350cb653f362717645ae8810f9b29eae3ab433e178399bf", "path": "translation-data/source-adoption-inputs/etale-cohomology59-gpt61sol-p087-20261110.json"}, "model_output": {"hash": "sha256:a68adb3943dd6f864a2b5d6f9d162e36d0e3087adcc5a180a5dfabaafe90266b", "path": "docs/evidence/etale-cohomology59-gpt61sol-p087-20261110-raw-02.jsonl", "record_hash": "sha256:41fc1341b1f58356e0edb612538f3578cb600fa31f5b20aa6102eaaae9d45af4"}, "neighbor_unit_ids": [], "policy_revision": "git:5400f3d19bf86fc59807e8dfa3d69d4429910ad3", "prior_generations": [], "prompt_version": "translator-v2", "source_adoption_id": "etale-cohomology59-gpt61sol-p087-20261110", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "style_guide_path": "config/style-guide.md", "turn_id": "01a1c5f8-657f-7a10-81cc-1fc9cfd42bc5", "unit_id": "tag:0GF2:proof"}, "context_hash": "sha256:251c00c9afdbc30bd7b693d707f6e65386f7cd8b1eb20015bcd8f546bbbf6472", "created_at": "2026-11-11T00:00:05.243665+00:00", "glossary_revision": "git:5400f3d19bf86fc59807e8dfa3d69d4429910ad3", "harness_id": "codex", "harness_version": "0.167.0", "model_id": "gpt-6.1-sol", "model_identity_confidence": "declared", "model_lane": "openai-gpt-6.1-sol", "model_record_id": "openai:gpt-6.1-sol:declared", "model_snapshot": null, "notes": [], "prompt_version": "translator-v2", "publication_status": "CANDIDATE", "qa_status": "PASS", "reasoning_effort": "high", "run_id": "run-etale-cohomology59-gpt61sol-p087-20261110", "schema_version": 2, "source_adoption_id": "etale-cohomology59-gpt61sol-p087-20261110", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_status": "CURRENT", "source_text_hash": "sha256:0d1ca9e2502fe3bf75ef6646627b406ccd13969a750326b106051f6bc741d8db", "stage": "STRUCTURE_OK", "term_occurrences": [{"source_term": "quasi-inverse", "target_term": "拟逆"}, {"source_term": "functor", "target_term": "函子"}, {"source_term": "isomorphism", "target_term": "同构"}, {"source_term": "affine", "target_term": "仿射"}, {"source_term": "finite", "target_term": "有限"}, {"source_term": "surjective", "target_term": "满射"}, {"source_term": "morphism", "target_term": "态射"}, {"source_term": "covering", "target_term": "开覆盖"}, {"source_term": "Morphisms", "target_term": "态射"}, {"source_term": "base change", "target_term": "基变换"}, {"source_term": "sections", "target_term": "截面"}, {"source_term": "section", "target_term": "截面"}], "term_status": "DECISION_REQUIRED", "translation": "完全如引理<REF_0001>的证明，我们断言一个拟逆（quasi-inverse）由函子（functor）给出，它将<MATH_0001>送到<MATH_0002>，要证明这一点，只需说明<MATH_0003>为同构（isomorphism）。这可局部检查，因此可以且确实假定<MATH_0004>仿射（affine）。于是能找到有限（finite）满射（surjective）态射（morphism）<MATH_0005>，使得存在开覆盖（covering）<MATH_0006>，使<MATH_0007>经<MATH_0008>分解。见态射（Morphisms）进阶引理<REF_0002>。应用引理<REF_0003>，可见只需在将<MATH_0009>替换为<MATH_0010>，将<MATH_0011>和<MATH_0012>替换为其基变换（base change）后证明引理。故可假定<MATH_0013>在 Zariski 局部有截面（sections）。当然，利用问题在<MATH_0014>上是局部的，归约到存在截面（section）的情形，即引理<REF_0004>。\n", "translation_hash": "sha256:9853a6d691b177f98231b2523e05f35566c489eef7d83e620d00edfcd8233011", "unit_id": "tag:0GF2:proof", "unknown_terms": [{"context": "词表尚未批准", "source_term": "quasi-inverse", "target_term": "拟逆"}, {"context": "词表尚未批准", "source_term": "functor", "target_term": "函子"}, {"context": "词表尚未批准", "source_term": "isomorphism", "target_term": "同构"}, {"context": "词表尚未批准", "source_term": "affine", "target_term": "仿射"}, {"context": "词表尚未批准", "source_term": "finite", "target_term": "有限"}, {"context": "词表尚未批准", "source_term": "surjective", "target_term": "满射"}, {"context": "词表尚未批准", "source_term": "morphism", "target_term": "态射"}, {"context": "开覆盖中的 covering；词表尚未批准", "source_term": "covering", "target_term": "开覆盖"}, {"context": "词表尚未批准", "source_term": "Morphisms", "target_term": "态射"}, {"context": "词表尚未批准", "source_term": "base change", "target_term": "基变换"}, {"context": "词表尚未批准", "source_term": "sections", "target_term": "截面"}, {"context": "词表尚未批准", "source_term": "section", "target_term": "截面"}]}
