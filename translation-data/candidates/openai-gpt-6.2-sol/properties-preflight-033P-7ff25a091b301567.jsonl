publication_status": "CANDIDATE", "qa_status": "PASS", "reasoning_effort": "high", "run_id": "run-p1-28-properties-d002", "schema_version": 2, "source_adoption_id": "p1-28-properties-d002", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_status": "CURRENT", "source_text_hash": "sha256:f2ba0c64ba8964801aa87a24d4831cd9a3b4a02890e56be8c01ffbda379d8e91", "stage": "STRUCTURE_OK", "term_occurrences": [{"source_term": "codimension", "target_term": "余维"}, {"source_term": "regular", "target_term": "正则"}, {"source_term": "irreducible", "target_term": "不可约"}, {"source_term": "closed", "target_term": "闭"}, {"source_term": "generic point", "target_term": "泛点"}, {"source_term": "generic point", "target_term": "泛点"}, {"source_term": "irreducible component", "target_term": "不可约分支"}, {"source_term": "local ring", "target_term": "局部环"}, {"source_term": "field", "target_term": "域"}, {"source_term": "Noetherian", "target_term": "诺特"}, {"source_term": "schemes", "target_term": "概形"}, {"source_term": "regular locus", "target_term": "正则点集"}], "term_status": "DECISION_REQUIRED", "translation": "\n\n<STRUCT_0001>\n“在余维（codimension）<MATH_0001>处正则（regular）”这一说法是有意义的，因为我们已经在第<REF_0001>节看到，若<MATH_0002>是不可约（irreducible）且闭（closed）的，其泛点（generic point）为<MATH_0003>，则<MATH_0004>。例如，条件<MATH_0005>意味着，凡泛点（generic point）<MATH_0006>所对应的是<MATH_0007>的某个不可约分支（irreducible component），局部环（local ring）<MATH_0008>就是一个域（field）。但对一般的诺特（Noetherian）概形（schemes），<MATH_0009>的正则点集（regular locus）可能表现不佳，因此必须谨慎。\n\n", "translation_hash": "sha256:00195b4f1a1d7e5d7e57fa331ef33b001a4dcb088478d6071edd8beca2c056c3", "unit_id": "tag:033P:prose-0002", "unknown_terms": [{"context": "用于表述所引述的正则性条件。", "source_term": "codimension", "target_term": "余维"}, {"context": "引述短语中所述的性质。", "source_term": "regular", "target_term": "正则"}, {"context": "修饰带有泛点的闭对象。", "source_term": "irreducible", "target_term": "不可约"}, {"context": "与不可约并列的条件。", "source_term": "closed", "target_term": "闭"}, {"context": "引用的结论中不可约闭对象的泛点。", "source_term": "generic point", "target_term": "泛点"}, {"context": "例子中不可约分支的泛点。", "source_term": "generic point", "target_term": "泛点"}, {"context": "例子中其泛点满足所述局部环条件的分支。", "source_term": "irreducible component", "target_term": "不可约分支"}, {"context": "例子中在所述泛点处的环。", "source_term": "local ring", "target_term": "局部环"}, {"context": "例子中局部环所属的代数对象类别。", "source_term": "field", "target_term": "域"}, {"context": "末句中概形的性质。", "source_term": "Noetherian", "target_term": "诺特"}, {"context": "末句讨论的一般诺特概形。", "source_term": "schemes", "target_term": "概形"}, {"context": "末句中由正则点构成的集合。", "source_term": "regular locus", "target_term": "正则点集"}]}
