{"chapter": "categories", "node_kind": "lemma", "parent_tag": "001Z", "placeholders": {"MATH_0001": "$\\mathcal{C}$", "MATH_0002": "$f : x \\to y$", "MATH_0003": "$y' \\to y$", "MATH_0004": "$\\mathcal{C}$", "MATH_0005": "$x' := x \\times_y y' \\to y'$"}, "render": {"prefix": "\\begin{lemma}\n\\label{categories-lemma-base-change-representable}\n", "suffix": "\n\\end{lemma}\n\n"}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:ce0ffe2f34290e446cb6a9cb99929242e23b1250b308e52cd2d76112adf80519", "source_status": "CURRENT", "source_structure_hash": "sha256:356143c04f757df9df5d757cdbda9eff2e9a6f452bb119cab92d9c7dae0553d8", "source_text": "Let <MATH_0001> be a category. Let <MATH_0002> be representable. Let <MATH_0003> be a morphism of <MATH_0004>. Then the morphism <MATH_0005> is representable also.", "source_text_hash": "sha256:0897f822a3694df2c575ad85943438964be62de8906fdd35eb413495f6690881", "unit_id": "tag:001Z:statement"}
