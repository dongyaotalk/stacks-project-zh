f7f921b656c0352232c7ec"}], "node_kind": "lemma", "parent_tag": "04R5", "placeholders": {"ACCENT_0001": "\\'e", "LOCKED_0001": "\\label{lemma-dimension-local-ring-fibre}", "MATHSEG_0001": "$$\n\\mathcal{P}_d((X, x) \\to (S, s)) =\n\\text{", "MATHSEG_0002": "}\n\\mathcal{O}_{X_s, x}\n\\text{", "MATHSEG_0003": "}d\n$$", "MATH_0001": "$d \\in \\{0, 1, 2, \\ldots, \\infty\\}$", "STRUCT_0001": "\\begin{lemma}", "STRUCT_0002": "\\end{lemma}"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R3", "schema_version": 2, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:31f2dbda3c0202e2ab45e730feb33d1f9f0ec8374731d48ef627dbd910420cd2", "source_math_skeleton_hash": "sha256:540987c0386108daf263729765926a8c193d9b72c09d848e2ba453f76ad9bd60", "source_status": "CURRENT", "source_structure_hash": "sha256:ff5018c61bf040e35965eb0a679be537fe1642b93464ddaf59cae30352cc6895", "source_text": "<STRUCT_0001>\n<LOCKED_0001>\nLet <MATH_0001>.\nThe property of morphisms of germs\n<MATHSEG_0001>the local ring <MATHSEG_0002> of the fibre has dimension <MATHSEG_0003>\nis <ACCENT_0001>tale local on the source-and-target.\n<STRUCT_0002>", "source_text_hash": "sha256:c6738a205796730a599ebe6a9b2dea3a3fbb7e753e483808d13297b830c53c74", "unit_id": "inventory:descent:04NJ:lemma/0001"}}}, {"context_id": "reference:morphisms-lemma-etale-over-field", "hash": "sha256:fc40d59fb4007de5b774dcbe8a8077515445db7a9a4d57671aa94fad595264d5", "value": {"kind": "locked-English-reference", "location": {"byte_end": 297788, "byte_start": 297199, "file": "morphisms.tex", "fragment_hash": "sha256:25ce1b8abba2bedcc751b5ad2adabccf76f797d3bfea75112f87c426d242f9e1", "line_end": 8190, "line_start": 8174}, "owner_tag": "02GL", "parent_tag": "02GH", "requested_label": "morphisms-lemma-etale-over-field", "requested_tag": "02GL", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "morphisms", "node_kind": "lemma", "parent_tag": "02GH", "placeholders": {"