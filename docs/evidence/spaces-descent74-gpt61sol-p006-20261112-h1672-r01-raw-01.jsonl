{"unit_id":"tag:0D3C:statement","translation":"令<MATH_0001>为概形（scheme）。令<MATH_0002>为<MATH_0003>上代数空间（algebraic spaces）的态射（morphism）。令<MATH_0004>为可逆的（invertible）<MATH_0005>模（module）。令<MATH_0006>为fpqc覆盖（fpqc covering）。令<MATH_0007>为<MATH_0008>的基变换（base change），并令<MATH_0009>为<MATH_0010>到<MATH_0011>的拉回（pullback）。以下条件等价（equivalent）\n<STRUCT_0001>\n<STRUCT_0002> <MATH_0012>在<MATH_0013>上是充沛的（ample），且\n<STRUCT_0003> 对每个<MATH_0014>，<MATH_0015>在<MATH_0016>上是充沛的（ample）。\n<STRUCT_0004>\n","allowed_english":[],"term_occurrences":[{"source_term":"scheme","target_term":"概形"},{"source_term":"algebraic spaces","target_term":"代数空间"},{"source_term":"morphism","target_term":"态射"},{"source_term":"invertible","target_term":"可逆的"},{"source_term":"module","target_term":"模"},{"source_term":"fpqc covering","target_term":"fpqc覆盖"},{"source_term":"base change","target_term":"基变换"},{"source_term":"pullback","target_term":"拉回"},{"source_term":"equivalent","target_term":"等价"},{"source_term":"ample","target_term":"充沛的"},{"source_term":"ample","target_term":"充沛的"}],"unknown_terms":[{"source_term":"scheme","target_term":"概形","context":"基底对象；待决。"},{"source_term":"algebraic spaces","target_term":"代数空间","context":"态射对象；待决。"},{"source_term":"morphism","target_term":"态射","context":"给定态射；待决。"},{"source_term":"invertible","target_term":"可逆的","context":"模性质；待决。"},{"source_term":"module","target_term":"模","context":"可逆模；待决。"},{"source_term":"fpqc covering","target_term":"fpqc覆盖","context":"下降覆盖；待决。"},{"source_term":"base change","target_term":"基变换","context":"拉回态射；待决。"},{"source_term":"pullback","target_term":"拉回","context":"可逆模拉回；待决。"},{"source_term":"equivalent","target_term":"等价","context":"条件关系；待决。"},{"source_term":"ample","target_term":"充沛的","context":"可逆模性质；待决。"}],"notes":[]}
