{"chapter": "morphisms", "node_kind": "lemma", "parent_tag": "01TZ", "placeholders": {"MATH_0001": "$k$", "MATH_0002": "$X$", "MATH_0003": "$k$", "MATH_0004": "$X \\to \\Spec(k)$"}, "render": {"prefix": "\\begin{lemma}\n\\label{lemma-scheme-over-field-universally-open}\n", "suffix": "\\end{lemma}"}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:ed9249290c97eeaaf594c2a9f82bc6c2b76fe2c5432ab0d9a7c9594f94872494", "source_status": "CURRENT", "source_structure_hash": "sha256:7a7ad38cbf33600d746becbec0dbc2d457248f9c67975233ceb35bb98ae304ab", "source_text": "Let <MATH_0001> be a field. Let <MATH_0002> be a scheme over <MATH_0003>.\nThe structure morphism <MATH_0004> is universally open.\n", "source_text_hash": "sha256:419d574439677bc8fa8434c34c152c1a3b5d2ed213f2ddc644fd275a8cd5dd4b", "unit_id": "tag:0383:statement"}
