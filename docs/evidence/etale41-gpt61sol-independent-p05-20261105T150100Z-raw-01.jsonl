{"unit_id":"tag:0256:statement","translation":"忠实平坦（faithfully flat）的拟紧（quasi-compact）态射（morphism）对于扎里斯基拓扑（topology）是商映射（quotient map）。\n","allowed_english":[],"term_occurrences":[{"source_term":"faithfully flat","target_term":"忠实平坦"},{"source_term":"quasi-compact","target_term":"拟紧"},{"source_term":"morphism","target_term":"态射"},{"source_term":"topology","target_term":"拓扑"},{"source_term":"quotient map","target_term":"商映射"}],"unknown_terms":[{"source_term":"faithfully flat","target_term":"忠实平坦","context":"态射的忠实平坦性，暂译待决。"},{"source_term":"quasi-compact","target_term":"拟紧","context":"态射的拟紧性，暂译待决。"},{"source_term":"morphism","target_term":"态射","context":"定理的几何映射，暂译待决。"},{"source_term":"topology","target_term":"拓扑","context":"扎里斯基拓扑，暂译待决。"},{"source_term":"quotient map","target_term":"商映射","context":"结论中的拓扑映射，暂译待决。"}],"notes":[]}
