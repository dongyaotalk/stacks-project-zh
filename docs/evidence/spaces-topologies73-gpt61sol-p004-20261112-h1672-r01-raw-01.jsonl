{"unit_id":"tag:03YC:prose-0004","translation":"\n\n<STRUCT_0001>\n作出上述定义后，通过局部化（localize）即可得到代数空间（algebraic space）的平展（<ACCENT_0001>tale）位点（site）。\n\n","allowed_english":[],"term_occurrences":[{"source_term":"localize","target_term":"局部化"},{"source_term":"algebraic space","target_term":"代数空间"},{"source_term":"<ACCENT_0001>tale","target_term":"平展"},{"source_term":"site","target_term":"位点"}],"unknown_terms":[{"source_term":"localize","target_term":"局部化","context":"构造相对位点；暂译待决。"},{"source_term":"algebraic space","target_term":"代数空间","context":"相对位点所属对象；暂译待决。"},{"source_term":"<ACCENT_0001>tale","target_term":"平展","context":"位点类型；暂译待决。"},{"source_term":"site","target_term":"位点","context":"局部化所得位点；暂译待决。"}],"notes":[]}
