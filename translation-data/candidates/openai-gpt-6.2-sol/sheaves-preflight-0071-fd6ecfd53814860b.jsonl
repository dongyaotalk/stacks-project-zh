b9a10cc9099dfb5f820bfc", "unit_id": "tag:0074:statement", "unknown_terms": [{"context": "给定空间所属的类型。", "source_term": "topological space", "target_term": "拓扑空间"}, {"context": "此处作名词，指给定拓扑空间中的开集。", "source_term": "open", "target_term": "开集"}, {"context": "在每个开集上考虑的代数结构。", "source_term": "algebra", "target_term": "代数"}, {"context": "定义该代数时对映射施加的条件。", "source_term": "continuous", "target_term": "连续"}, {"context": "使该构造成为预层的映射。", "source_term": "restriction mappings", "target_term": "限制映射"}, {"context": "由这些限制映射得到的结构。", "source_term": "presheaf", "target_term": "预层"}, {"context": "该预层的取值类型。", "source_term": "algebras", "target_term": "代数"}, {"context": "由所引的例得到的层性质。", "source_term": "sheaf", "target_term": "层"}, {"context": "应用所引的例时该层的取值类型。", "source_term": "sets", "target_term": "集合"}, {"context": "应用所引的引理后得到的结构。", "source_term": "sheaf", "target_term": "层"}, {"context": "应用所引的引理后该层的取值类型。", "source_term": "algebras", "target_term": "代数"}]}
