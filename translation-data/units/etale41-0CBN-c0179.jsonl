{"chapter": "etale", "node_kind": "paragraph", "parent_tag": "0CBN", "placeholders": {"STRUCT_0001": "\\noindent"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R2", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:23d84823a68d182445d1cfca3e1638ba6995754f9336d0e0b882aaba6e12f90b", "source_text": "\n\n<STRUCT_0001>\nHere is the definition of a normal crossings divisor.\n\n", "source_text_hash": "sha256:51e12507f1855e2c3170f8932383852254af761b0bfc013e1c97ff8cf477d382", "unit_id": "tag:0CBN:prose-0003"}
