{"chapter": "morphisms", "node_kind": "lemma", "parent_tag": "01S2", "placeholders": {}, "render": {"prefix": "\\begin{lemma}\n\\label{lemma-universally-injective-separated}\n", "suffix": "\\end{lemma}"}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:c3e804b7cf56d8fe07435b44dd34a93f740ca77f6a525d1f81f3dddeae467c87", "source_text": "A universally injective morphism is separated.\n", "source_text_hash": "sha256:857396af8ab15a0c0ccf0ea30c82a949484f73ba2270972e17d7a1f81ab4a2a4", "unit_id": "tag:05VE:statement"}
{"chapter": "morphisms", "node_kind": "proof", "parent_tag": "01S2", "placeholders": {"MATH_0001": "$X \\to S$", "MATH_0002": "$\\Delta_{X/S}$", "MATH_0003": "$X \\times_S X$", "REF_0001": "\\ref{lemma-universally-injective}", "REF_0002": "\\ref{schemes-definition-separated}"}, "render": {"prefix": "\\begin{proof}\n", "suffix": "\\end{proof}"}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:292102c8296fd04c9de85b261a1efd94d67f1d26d774a4dbbe8b8cd240734a75", "source_status": "CURRENT", "source_structure_hash": "sha256:2fc99460b8c0067452172195736cbb066ebb28374f79787602a024df29f208cf", "source_text": "Combine\nLemma <REF_0001>\nwith the remark that <MATH_0001> is separated if and only if the image\nof <MATH_0002> is closed in <MATH_0003>, see\nSchemes, Definition <REF_0002>\nand the discussion following it.\n", "source_text_hash": "sha256:4834745b5aaf96d25fc706e972f684d4ed05d2870b63397938e888427638122f", "unit_id": "tag:05VE:proof"}
{"chapter": "morphisms", "node_kind": "lemma", "parent_tag": "01S2", "placeholders": {}, "render": {"prefix": "\\begin{lemma}\n\\label{lemma-base-change-universally-injective}\n", "suffix": "\\end{lemma}"}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:d9263fd4ce3ca1a7d904a45967273385a56bf6b5db33b526c719738ac4a4ff98", "source_text": "A base change of a universally injective morphism is universally injective.\n", "source_text_hash": "sha256:5f65f8c18f6aa627801a99875d828b6df72ddc5f7f24fbddcede8dd37a514f12", "unit_id": "tag:0472:statement"}
{"chapter": "morphisms", "node_kind": "proof", "parent_tag": "01S2", "placeholders": {}, "render": {"prefix": "\\begin{proof}\n", "suffix": "\\end{proof}"}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:37f45c3fe13d07183dbc2cda4e6672c472b697c7d75b27afb421524f7ecba018", "source_text": "This is formal.\n", "source_text_hash": "sha256:d8e889e90e5a24bd8f3e4701746eb2d4ddad3ffa3b34b067aa0e87e25af5cb7d", "unit_id": "tag:0472:proof"}
{"chapter": "morphisms", "node_kind": "lemma", "parent_tag": "01S2", "placeholders": {}, "render": {"prefix": "\\begin{lemma}\n\\label{lemma-composition-universally-injective}\n", "suffix": "\\end{lemma}"}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:1e8c7986bdb64bdd20d2211653960d81e18a6bb56713e86fa1afd71b6e8b19f3", "source_text": "A composition of radicial morphisms is radicial, and so the same holds\nfor the equivalent condition of being universally injective.\n", "source_text_hash": "sha256:490297b79a5c74c844ef165f17af814f2c5a0c4a8e01af35949ad4b54aca7f1b", "unit_id": "tag:02V1:statement"}
{"chapter": "morphisms", "node_kind": "proof", "parent_tag": "01S2", "placeholders": {}, "render": {"prefix": "\\begin{proof}\n", "suffix": "\\end{proof}"}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:37f45c3fe13d07183dbc2cda4e6672c472b697c7d75b27afb421524f7ecba018", "source_text": "Omitted.\n", "source_text_hash": "sha256:872a8cfa74892c6e6464bd864d9f1c292f4f523caba3e51ac3dafbfc84db48f6", "unit_id": "tag:02V1:proof"}
