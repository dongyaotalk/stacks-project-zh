m": "local ring", "target_term": "局部环", "context": "第二类概形的基底"}, {"source_term": "locally of finite type", "target_term": "局部有限型", "context": "第二类概形在其基底上的条件"}, {"source_term": "scheme", "target_term": "概形", "context": "第二类所列对象"}, {"source_term": "locally of finite type", "target_term": "局部有限型", "context": "第三类概形在指定基底上的条件"}, {"source_term": "scheme", "target_term": "概形", "context": "第三类所列对象"}, {"source_term": "characteristic", "target_term": "特征", "context": "第四类所用基底环的特征为零"}, {"source_term": "Dedekind", "target_term": "戴德金", "context": "修饰作为第四类基底的环"}, {"source_term": "ring", "target_term": "环", "context": "第四类概形的基底"}, {"source_term": "locally of finite type", "target_term": "局部有限型", "context": "第四类概形在其基底上的条件"}, {"source_term": "scheme", "target_term": "概形", "context": "第四类所列对象"}], "notes": []}
{"unit_id": "tag:035B:proof", "translation": "由引理<REF_0001>，只需证明上述各环（rings）都是永田（Nagata）环（rings）。为此参见代数（Algebra）一章的命题<REF_0002>。\n", "allowed_english": [], "term_occurrences": [{"source_term": "rings", "target_term": "环"}, {"source_term": "Nagata", "target_term": "永田"}, {"source_term": "rings", "target_term": "环"}, {"source_term": "Algebra", "target_term": "代数"}], "unknown_terms": [{"source_term": "rings", "target_term": "环", "context": "陈述中用于构造各例的环"}, {"source_term": "Nagata", "target_term": "永田", "context": "只需对上述各环证明的性质"}, {"source_term": "rings", "target_term": "环", "context": "与永田性质一起构成所论的环类"}, {"source_term": "Algebra", "target_term": "代数", "context": "所引命题所在的章名"}], "notes": []}
