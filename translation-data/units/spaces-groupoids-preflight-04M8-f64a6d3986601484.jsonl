{"chapter": "spaces-groupoids", "node_kind": "paragraph", "parent_tag": "04M8", "placeholders": {"MATH_0001": "$\\mathit{Isom}$", "MATH_0002": "$2$", "STRUCT_0001": "\\noindent"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R2", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:50a6a390431be4bf66b7899cfb01f9d502a54727deaca98974e663ce95f92a76", "source_status": "CURRENT", "source_structure_hash": "sha256:48f4e21fa615fb8ffa31b144361c732d2442bfaff02f86dad98979051f41123b", "source_text": "\n\n<STRUCT_0001>\nIn this section we compute the <MATH_0001>-sheaves for a quotient stack\nand we deduce that the defining diagram of a quotient stack is a\n<MATH_0002>-fibre product.\n\n", "source_text_hash": "sha256:daf1ebc195fb2429788067f0ea486c3e4d2fc0a7f18a1a6b1f12f5637012ec9c", "unit_id": "tag:04M8:prose-0001"}
