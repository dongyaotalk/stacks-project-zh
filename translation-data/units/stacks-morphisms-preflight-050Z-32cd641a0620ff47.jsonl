inal": 1, "owner_label": "stacks-morphisms-section-noetherian", "owner_tag": "050Z", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14"}, "policy_hash": "sha256:9ad00686dd2253c6ab6248bc9019c435d094832baa3fbf1faeba8adf187ec4e5", "source_label": "stacks-morphisms-section-noetherian", "usage": "p0-locked-math-frame", "usage_source": {"after": "\n\\Delta", "before": "}", "environments": []}}, "command": "text", "policy_entry": "p0-frame-stacks-morphisms-05", "slot_byte_span": {"end": 90, "start": 66}, "slot_id": "math/0001/text/0002", "source": " locally Noetherian and "}, {"boundary_placeholders": ["MATHSEG_0003", "MATHSEG_0004"], "classification_witness": {"anchor": {"file": "stacks-morphisms.tex", "kind": "section", "matches": [{"command_byte_span": {"end": 73603, "start": 73582}, "command_hash": "sha256:019975a48fb50a0cb8f4d4a1abc4756d4243635ebe02549a3574f82953141bdc", "container_byte_span": {"end": 73734, "start": 73059}, "container_hash": "sha256:d0c0d58f419a329ff52e9b970fca80bddc6363a1384bae2c7e8c1d258d426410"}], "ordinal": 1, "owner_label": "stacks-morphisms-section-noetherian", "owner_tag": "050Z", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14"}, "policy_hash": "sha256:9ad00686dd2253c6ab6248bc9019c435d094832baa3fbf1faeba8adf187ec4e5", "source_label": "stacks-morphisms-section-noetherian", "usage": "p0-locked-math-frame", "usage_source": {"after": ".", "before": "}\n", "environments": []}}, "command": "text", "policy_entry": "p0-frame-stacks-morphisms-07", "slot_byte_span": {"end": 156, "start": 142}, "slot_id": "math/0001/text/0003", "source": " quasi-compact"}], "source": "$$\n\\mathcal{X}\\text{ Noetherian}\n\\Leftrightarrow\n\\mathcal{X}\\text{ locally Noetherian and }\n\\Delta_{p, 0}, \\Delta_{p, 1}, \\Delta_{p, 2}\n\\text{ quasi-compact}.\n$$", "source_byte_span": {"end": 550, "start": 389}, "source_hash": "sha256:740c0a24b40dbd02ad2686036645e9a7fb5a47c0738a3e2f2107a7f7fe0f26d2"}], "node_kind": "paragraph", "parent_tag": "050Z", "placeholders": {"MATHSEG_0001": "$$\n\\mathcal{X}\\text{", "MATHSEG_0002": "}\n\\Leftrightarrow\n\\mathcal{X}\\text{", "MATHSEG_0003": "}\n\\Delta_{p, 0}, \\Delta_{p, 1}, \\Delta_{p, 2}\n\\text{", "MATHSEG_0004": "}.\n$$", "MATH_0001": "$\\mathcal{X}$", "MATH_0002": "$p : \\mathcal{X} \\to \\Spec(\\mathbf{Z})$", "MATH_0003": "$\\mathcal{X}$", "MATH_0004": "$\\mathbf{Z}$", "REF_0001": "\\ref{section-higher-diagonals}", "STRUCT_0001": "\\noindent"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R3", "schema_version": 2, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:4937859bbc3a6aab1d12a26342e165fe6201502ef252056ce25869f8289da99e", "source_math_skeleton_hash": "sha256:e9693ce0a080abf43f1a915ade8e5ade7d17fdaa7f96c2042e4abfeb9b6b5e96", "source_status": "CURRENT", "source_structure_hash": "sha256:52284a7abe8b769ea8bd74bdbbe6cbc1ff903750d1316a68d3831ebd23f7a7cd", "source_text": "\n\n<STRUCT_0001>\nNote that a Noetherian algebraic stack <MATH_0001> is not just quasi-compact\nand locally Noetherian, but also quasi-separated. In the language of\nSection <REF_0001>\nif we denote <MATH_0002> the\n``absolute'' structure morphism (i.e., the structure morphism of\n<MATH_0003> viewed as an algebraic stack over <MATH_0004>), then\n<MATHSEG_0001> Noetherian<MATHSEG_0002> locally Noetherian and <MATHSEG_0003> quasi-compact<MATHSEG_0004>\nThis will later mean that an algebraic stack of finite type over a\nNoetherian algebraic stack is not automatically Noetherian.\n\n", "source_text_hash": "sha256:991bffae7b0bae0cf40fd4c498ad509b12fab4d24ebc22414e8fc9353ae014ed", "unit_id": "tag:050Z:prose-0002"}
