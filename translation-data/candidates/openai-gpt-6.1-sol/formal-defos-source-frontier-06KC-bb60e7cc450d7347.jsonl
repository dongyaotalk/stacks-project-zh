2807b14", "source_math_hash": "sha256:15a52a972b849bdba09a7203cb14d1df95f18287a8ff9a4e6756f7ea32b0d3c4", "source_status": "CURRENT", "source_structure_hash": "sha256:58ee77c05b4ccadc694d5d3a0c333537fd28bece8ec6157510110240ec09f885", "source_text": "<STRUCT_0001>\n<LOCKED_0001>\nFor a category <MATH_0001> we denote by <MATH_0002> the\ncategory of cofibered sets over <MATH_0003>. It is a <MATH_0004>-category\nisomorphic the category of functors <MATH_0005>.\nSee Remarks <REF_0001>\n(<REF_0002>).\nThe completion and restriction functors restrict to functors\n<MATH_0006> and\n<MATH_0007> which we denote by the same symbols.\nAs functors on the categories of cofibered sets, completion and restriction\nare adjoints in the usual 1-categorical sense: the same construction as in\nRemark <REF_0003> defines a functorial\nbijection\n<MATH_0008>\nfor <MATH_0009> and\n<MATH_0010>.\nAgain the map <MATH_0011> is an\nisomorphism.\n<STRUCT_0002>", "source_text_hash": "sha256:c346ef34fc7d2a2265d1c18207c811da3e3cdcfc94d90c42f9f2e723f1445c1f", "unit_id": "inventory:formal-defos:06HB:remark/0001"}}}], "input_freeze": {"hash": "sha256:8e3e2f0f5cdd3c2cddc2fb70fd6f10a1e9fb11adcdfb1f20df44e19c34ef07d2", "path": "translation-data/source-adoption-inputs/formal-defos90-gpt61sol-p048-20261117.json"}, "model_output": {"hash": "sha256:708b9edba15713714c74a028fa648ee0c450b293792bc489a15f376f4b2096ab", "path": "docs/evidence/formal-defos90-gpt61sol-p048-20261117-raw-01.jsonl", "record_hash": "sha256:91f51b96878c7468103179c0fcac9558c8efba49b57d293af9fa37680f9a3de7"}, "neighbor_unit_ids": [], "policy_revision": "git:9c104567d0e9b01c16c0bf5f5d0c71b3c1c5c028", "prior_generations": [], "prompt_version": "translator-v2", "source_adoption_id": "formal-defos90-gpt61sol-p048-20261117", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "style_guide_path": "config/style-guide.md", "turn_id": "01a1e4cd-25ac-7c40-b79c-c86891503420", "unit_id": "tag:06KC:prose-0002"}, "context_hash": "sha256:7bd9d54840f310ee855350f5281ef9090a506d837fcfb96ef3d4b86bc7f8a603", "created_at": "2026-11-16T16:43:31.838456+00:00", "glossary_revision": "git:9c104567d0e9b01c16c0bf5f5d0c71b3c1c5c028", "harness_id": "codex", "harness_version": "0.169.0", "model_id": "gpt-6.1-sol", "model_identity_confidence": "declared", "model_lane": "openai-gpt-6.1-sol", "model_record_id": "openai:gpt-6.1-sol:declared", "model_snapshot": null, "notes": [], "prompt_version": "translator-v2", "publication_status": "CANDIDATE", "qa_status": "PASS", "reasoning_effort": "high", "run_id": "run-formal-defos90-gpt61sol-p048-20261117", "schema_version": 2, "source_adoption_id": "formal-defos90-gpt61sol-p048-20261117", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_status": "CURRENT", "source_text_hash": "sha256:c437fa4bb5de694795ea95df1e633a581701fe3e1a8d2c8715d64704e7070724", "stage": "STRUCTURE_OK", "term_occurrences": [{"source_term": "groupoid in functors", "target_term": "函子中的群胚"}, {"source_term": "completions", "target_term": "完备化"}, {"source_term": "quintuple", "target_term": "五元组"}, {"source_term": "completion", "target_term": "完备化"}, {"source_term": "functor", "target_term": "函子"}, {"source_term": "right adjoint", "target_term": "右伴随"}, {"source_term": "limits", "target_term": "极限"}, {"source_term": "commutes", "target_term": "交换"}, {"source_term": "canonical isomorphism", "target_term": "典范同构"}, {"source_term": "functor", "target_term": "函子"}, {"source_term": "groupoid in functors", "target_term": "函子中的群胚"}, {"source_term": "identity", "target_term": "恒等"}, {"source_term": "inverse", "target_term": "逆"}, {"source_term": "morphisms", "target_term": "态射"}, {"source_term": "completions", "target_term": "完备化"}], "term_status": "DECISION_REQUIRED", "translation": "\n\n<STRUCT_0001>\n设<MATH_0001>是<MATH_0002>上函子中的群胚（groupoid in functors）。取完备化（completions），得到五元组（quintuple）<MATH_0003>。由注记<REF_0001>，完备化（completion）作为<MATH_0004>上的函子（functor）是右伴随（right adjoint），故它与极限（limits）交换（commutes）。特别地，有典范同构（canonical isomorphism）<MATH_0005>，因此可以将<MATH_0006>视为函子（functor）<MATH_0007>。于是<MATH_0008>是<MATH_0009>上函子中的群胚（groupoid in functors），其恒等（identity）和逆（inverse）态射（morphisms）是<MATH_0010>中相应态射的完备化（completions）。\n\n", "translation_hash": "sha256:97dbb34a3ae1a602a9770caf32b79f4b5fb3613431558d962856f61424891e79", "unit_id": "tag:06KC:prose-0002", "unknown_terms": [{"context": "空词表；函子中的群胚暂定。", "source_term": "groupoid in functors", "target_term": "函子中的群胚"}, {"context": "空词表；复数形式暂定。", "source_term": "completions", "target_term": "完备化"}, {"context": "空词表；群胚结构的五元组暂定。", "source_term": "quintuple", "target_term": "五元组"}, {"context": "空词表；函子完备化暂定。", "source_term": "completion", "target_term": "完备化"}, {"context": "空词表；函子暂定。", "source_term": "functor", "target_term": "函子"}, {"context": "空词表；右伴随暂定。", "source_term": "right adjoint", "target_term": "右伴随"}, {"context": "空词表；复数形式暂定。", "source_term": "limits", "target_term": "极限"}, {"context": "空词表；与极限交换暂定。", "source_term": "commutes", "target_term": "交换"}, {"context": "空词表；典范同构暂定。", "source_term": "canonical isomorphism", "target_term": "典范同构"}, {"context": "空词表；恒等态射的限定语暂定。", "source_term": "identity", "target_term": "恒等"}, {"context": "空词表；逆态射的限定语暂定。", "source_term": "inverse", "target_term": "逆"}, {"context": "空词表；复数形式暂定。", "source_term": "morphisms", "target_term": "态射"}]}
