{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stacks-project-zh.invalid/schema/chapter-template.schema.json",
  "title": "Stacks Project Chinese chapter translation task scaffold",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generator_version",
    "source_commit",
    "chapter",
    "chapter_ordinal",
    "source_title",
    "source_file",
    "source_sha256",
    "source_state",
    "sections"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "generator_version": {"const": "chapter-templates-v1"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "chapter": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "chapter_ordinal": {"type": "integer"},
    "source_title": {"type": "string", "minLength": 1},
    "source_file": {"type": "string", "pattern": "^[A-Za-z0-9._-]+\\.tex$"},
    "source_sha256": {
      "type": ["string", "null"],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source_state": {"enum": ["CURRENT", "SOURCE_UNAVAILABLE"]},
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ordinal",
          "source_title",
          "source_label",
          "parent_tag",
          "suggested_batch",
          "suggested_unit_file",
          "unit_files",
          "state"
        ],
        "properties": {
          "ordinal": {"type": "integer"},
          "source_title": {"type": "string", "minLength": 1},
          "source_label": {"type": "string", "minLength": 1},
          "parent_tag": {
            "type": ["string", "null"],
            "pattern": "^[0-9A-Z]+$"
          },
          "suggested_batch": {
            "type": ["string", "null"],
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "suggested_unit_file": {
            "type": ["string", "null"],
            "pattern": "^translation-data/units/[A-Za-z0-9._-]+\\.jsonl$"
          },
          "unit_files": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^translation-data/units/[A-Za-z0-9._-]+\\.jsonl$"
            }
          },
          "state": {
            "enum": ["READY", "UNPREPARED", "BLOCKED_NO_TAG"]
          }
        }
      }
    }
  }
}
