{"unit_id": "tag:0CN6:prose-0001", "translation": "\n\n<STRUCT_0001>\n本节刻画仿射概形（affine schemes）的普遍同胚（universal homeomorphisms）。\n\n", "allowed_english": [], "term_occurrences": [{"source_term": "affine schemes", "target_term": "仿射概形"}, {"source_term": "universal homeomorphisms", "target_term": "普遍同胚"}], "unknown_terms": [{"source_term": "affine schemes", "target_term": "仿射概形", "context": "本节所限的概形类别"}, {"source_term": "universal homeomorphisms", "target_term": "普遍同胚", "context": "本节要刻画的态射性质"}], "notes": []}
