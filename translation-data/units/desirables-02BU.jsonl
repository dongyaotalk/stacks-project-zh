{"chapter": "desirables", "node_kind": "paragraph", "parent_tag": "02BU", "placeholders": {"REF_0001": "\\ref{stacks-more-morphisms-theorem-chow-finite-type}", "REF_0002": "\\ref{stacks-more-morphisms-section-Noetherian-valuative-criterion}", "STRUCT_0001": "\\noindent"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R2", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:b5fb40f269f66702b535f7efd20ca3b9e206327d5b2d7320005cf2e1847219ff", "source_text": "<STRUCT_0001>\nThis proves two notions of proper are the same. The first part of this\nis now available in the form of Chow's lemma for algebraic stacks, see\nMore on Morphisms of Stacks, Theorem\n<REF_0001>.\nAs a consequence we show that it suffices to use DVR's\nin checking the valuative criterion for properness for\nalgebraic stacks in certain cases, see\nMore on Morphisms of Stacks, Section\n<REF_0002>.", "source_text_hash": "sha256:2fecdd6ce409365d3cf10a2ba2129fbb48bbe388a905acda5b93fee0d0061eb6", "unit_id": "tag:02BU:paragraph-0001"}
