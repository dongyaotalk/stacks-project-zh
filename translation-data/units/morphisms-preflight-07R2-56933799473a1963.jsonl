{"chapter": "morphisms", "node_kind": "paragraph", "parent_tag": "07R2", "placeholders": {"REF_0001": "\\ref{more-algebra-definition-J}", "STRUCT_0001": "\\noindent"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R2", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:9852dadd34b00d598b17f8a5ade3739bf4c63d3529b2a90cb3c7d03556d133f6", "source_text": "\n\n<STRUCT_0001>\nThis is the analogue of the corresponding notion for Noetherian\nrings, see More on Algebra, Definition <REF_0001>.\n\n", "source_text_hash": "sha256:222cd96b47763282046aac7f16762426e7779b6c4d984a0f584f28b7962cef8c", "unit_id": "tag:07R2:prose-0002"}
{"chapter": "morphisms", "node_kind": "lemma", "parent_tag": "07R2", "placeholders": {"MATH_0001": "$X$", "MATH_0002": "$X$", "MATH_0003": "$X$", "MATH_0004": "$\\Spec(R) = U \\subset X$", "MATH_0005": "$R$", "MATH_0006": "$S = \\bigcup U_i$", "MATH_0007": "$\\mathcal{O}(U_i)$", "MATH_0008": "$i$", "MATH_0009": "$X$", "STRUCT_0001": "\\begin{enumerate}", "STRUCT_0002": "\\item", "STRUCT_0003": "\\item", "STRUCT_0004": "\\item", "STRUCT_0005": "\\item", "STRUCT_0006": "\\end{enumerate}"}, "render": {"prefix": "\\begin{lemma}\n\\label{lemma-J}\n", "suffix": "\\end{lemma}"}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:df77cb9d5cb0828d2d45e95c71d55c9a0d0c58434f2d04b23b1030c38e4ccec3", "source_status": "CURRENT", "source_structure_hash": "sha256:f4f7a7b572a746a32ea47e31db7629601ad0f9daaa79658651832156f46e45f0", "source_text": "Let <MATH_0001> be a locally Noetherian scheme. The following are equivalent\n<STRUCT_0001>\n<STRUCT_0002> <MATH_0002> is J-2,\n<STRUCT_0003> there exists an open covering of <MATH_0003> all of whose members are\nJ-2 schemes,\n<STRUCT_0004> for every affine open <MATH_0004> the ring\n<MATH_0005> is J-2, and\n<STRUCT_0005> there exists an affine open covering <MATH_0006> such\nthat each <MATH_0007> is J-2 for all <MATH_0008>.\n<STRUCT_0006>\nMoreover, in this case any scheme locally of finite type over <MATH_0009>\nis J-2 as well.\n", "source_text_hash": "sha256:de05c95f1d41a9572b97c3bc813484114a646b7fe87695214a453754e13168f7", "unit_id": "tag:07R4:statement"}
