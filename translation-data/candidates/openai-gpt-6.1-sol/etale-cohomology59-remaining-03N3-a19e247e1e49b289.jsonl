d": "codex", "harness_version": "0.167.0", "model_id": "gpt-6.1-sol", "model_identity_confidence": "declared", "model_lane": "openai-gpt-6.1-sol", "model_record_id": "openai:gpt-6.1-sol:declared", "model_snapshot": null, "notes": [], "prompt_version": "translator-v2", "publication_status": "CANDIDATE", "qa_status": "PASS", "reasoning_effort": "high", "run_id": "run-etale-cohomology59-gpt61sol-p090-20261111", "schema_version": 2, "source_adoption_id": "etale-cohomology59-gpt61sol-p090-20261111", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_status": "CURRENT", "source_text_hash": "sha256:5910de90780fc1da8e878375b91adce30096202fd0c22835432bb9ea6a99b339", "stage": "STRUCTURE_OK", "term_occurrences": [{"source_term": "cohomology", "target_term": "上同调"}, {"source_term": "theory", "target_term": "理论"}, {"source_term": "topology", "target_term": "拓扑"}, {"source_term": "complex", "target_term": "复"}, {"source_term": "variety", "target_term": "代数簇"}, {"source_term": "constant", "target_term": "常值"}, {"source_term": "sheaf", "target_term": "层"}, {"source_term": "irreducible", "target_term": "不可约"}, {"source_term": "scheme", "target_term": "概形"}, {"source_term": "variety", "target_term": "代数簇"}, {"source_term": "nonempty open", "target_term": "非空开"}, {"source_term": "subsets", "target_term": "子集"}, {"source_term": "constant", "target_term": "常值"}, {"source_term": "sheaf", "target_term": "层"}, {"source_term": "restriction mappings", "target_term": "限制映射"}, {"source_term": "surjective", "target_term": "满射"}, {"source_term": "sheaf", "target_term": "层"}, {"source_term": "flasque", "target_term": "松弛"}, {"source_term": "higher", "target_term": "高阶"}, {"source_term": "cohomology groups", "target_term": "上同调群"}, {"source_term": "higher", "target_term": "高阶"}, {"source_term": "cohomology groups", "target_term": "上同调群"}, {"source_term": "topology", "target_term": "拓扑"}, {"source_term": "open", "target_term": "开"}, {"source_term": "sets", "target_term": "集"}, {"source_term": "higher", "target_term": "高阶"}, {"source_term": "cohomology", "target_term": "上同调"}, {"source_term": "smooth", "target_term": "光滑"}, {"source_term": "projective", "target_term": "射影"}, {"source_term": "complex", "target_term": "复"}, {"source_term": "variety", "target_term": "代数簇"}, {"source_term": "set", "target_term": "集合"}, {"source_term": "complex", "target_term": "复"}, {"source_term": "points", "target_term": "点"}, {"source_term": "algebraic geometry", "target_term": "代数几何"}, {"source_term": "positive characteristic", "target_term": "正特征"}], "term_status": "DECISION_REQUIRED", "translation": "\n\n<STRUCT_0001>\n这些讲义讨论另一种上同调（cohomology）理论（theory）。首先要指出的是，Zariski 拓扑（topology）并不完全令人满意。它未能给出我们期望的结果的主要原因之一是，若<MATH_0001>是复（complex）代数簇（variety），而<MATH_0002>是常值（constant）层（sheaf），则\n<MATHSEG_0001> 对所有 <MATHSEG_0002>\n其原因如下。在不可约（irreducible）概形（scheme）中（特别是在代数簇（variety）中），任意两个非空开（nonempty open）子集（subsets）都有交，因而常值（constant）层（sheaf）的限制映射（restriction mappings）是满射（surjective）。我们称该层（sheaf）是<TEXTITOPEN_0001>松弛（flasque）<TEXTITCLOSE_0001>的。在这种情况下，所有高阶（higher）<GROUPOPEN_0001><ACCENT_0001><GROUPCLOSE_0001>ech 上同调群（cohomology groups）都消失，所有高阶（higher）Zariski 上同调群（cohomology groups）也都消失。换言之，Zariski 拓扑（topology）中的开（open）集（sets）“不够多”，无法检测这种高阶（higher）上同调（cohomology）。\n\n<STRUCT_0002><STRUCT_0003>\n另一方面，若<MATH_0003>是光滑（smooth）的射影（projective）复（complex）代数簇（variety），则\n<MATHSEG_0003> 对于 <MATHSEG_0004>\n其中<MATH_0004>所表示的集合（set）由<MATH_0005>的复（complex）点（points）组成。若能在代数几何（algebraic geometry）中再现这一特征，就会很理想。特别是在正特征（positive characteristic）下。\n\n\n\n\n", "translation_hash": "sha256:f0214cf111166a90527a29c06b6768687779276236879f990e02854100a10082", "unit_id": "tag:03N3:prose-0001", "unknown_terms": [{"context": "讲义讨论的上同调；词表尚未批准。", "source_term": "cohomology", "target_term": "上同调"}, {"context": "上同调理论；词表尚未批准。", "source_term": "theory", "target_term": "理论"}, {"context": "Zariski拓扑；词表尚未批准。", "source_term": "topology", "target_term": "拓扑"}, {"context": "复代数簇及复点；词表尚未批准。", "source_term": "complex", "target_term": "复"}, {"context": "原文variety；词表尚未批准。", "source_term": "variety", "target_term": "代数簇"}, {"context": "常值层；词表尚未批准。", "source_term": "constant", "target_term": "常值"}, {"context": "原文sheaf；词表尚未批准。", "source_term": "sheaf", "target_term": "层"}, {"context": "不可约概形；词表尚未批准。", "source_term": "irreducible", "target_term": "不可约"}, {"context": "原文scheme；词表尚未批准。", "source_term": "scheme", "target_term": "概形"}, {"context": "非空开子集；词表尚未批准。", "source_term": "nonempty open", "target_term": "非空开"}, {"context": "相交的子集；词表尚未批准。", "source_term": "subsets", "target_term": "子集"}, {"context": "常值层的限制映射；词表尚未批准。", "source_term": "restriction mappings", "target_term": "限制映射"}, {"context": "限制映射为满射；词表尚未批准。", "source_term": "surjective", "target_term": "满射"}, {"context": "层的flasque性质；词表尚未批准。", "source_term": "flasque", "target_term": "松弛"}, {"context": "高阶上同调及其群；词表尚未批准。", "source_term": "higher", "target_term": "高阶"}, {"context": "Čech与Zariski上同调群；词表尚未批准。", "source_term": "cohomology groups", "target_term": "上同调群"}, {"context": "拓扑中的开集；词表尚未批准。", "source_term": "open", "target_term": "开"}, {"context": "原文复数sets；词表尚未批准。", "source_term": "sets", "target_term": "集"}, {"context": "光滑射影复代数簇；词表尚未批准。", "source_term": "smooth", "target_term": "光滑"}, {"context": "射影复代数簇；词表尚未批准。", "source_term": "projective", "target_term": "射影"}, {"context": "复点的集合；词表尚未批准。", "source_term": "set", "target_term": "集合"}, {"context": "代数簇的复点；词表尚未批准。", "source_term": "points", "target_term": "点"}, {"context": "再现所述特征的领域；词表尚未批准。", "source_term": "algebraic geometry", "target_term": "代数几何"}, {"context": "特别关注正特征情形；词表尚未批准。", "source_term": "positive characteristic", "target_term": "正特征"}]}
