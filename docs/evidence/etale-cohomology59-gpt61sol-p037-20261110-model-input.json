    {
      "context_id": "locked-English-reference:pione:inventory:pione:0BND:theorem/0001:pione-theorem-fundamental-group",
      "value": {
        "kind": "locked-English-reference",
        "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14",
