 that for a general scheme\n<MATH_0011> we have\n<MATH_0012>\nThese verifications are omitted.\n<STRUCT_0002>", "source_text_hash": "sha256:f4b3b83881ada99916e3a8c06c216f6adfd1bbd546d86ccf8bd58faffd515a30", "unit_id": "inventory:constructions:01NC:proof/0001"}}}, {"context_id": "sha256:2946b5ccddba3266340e9070d30a12e324dbdf3e01924bc685b890badf046d91", "hash": "sha256:2946b5ccddba3266340e9070d30a12e324dbdf3e01924bc685b890badf046d91", "value": {"kind": "locked-English-neighbor", "location": {"byte_end": 100656, "byte_start": 100423, "file": "constructions.tex", "fragment_hash": "sha256:ce8cf83eee889966201615a560170114298f849e37e91fedb22f33e8e9472d77", "line_end": 2782, "line_start": 2778}, "owner_tag": "01ND", "parent_tag": "01ND", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "constructions", "node_kind": "paragraph", "parent_tag": "01ND", "placeholders": {"MATH_0001": "$\\text{Proj}$", "STRUCT_0001": "\\noindent"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R1", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:0f784c56f4b1aa8c998b071dc920f1d53e65912dc68239b7ce1f5eeb2a2be0a2", "source_status": "CURRENT", "source_structure_hash": "sha256:b6868e3974c9a82d0f282c0f4f276d047f34f9b72337adb3e6b6eae8ea068d55", "source_text": "<STRUCT_0001>\nProjective space is one of the fundamental objects studied in\nalgebraic geometry. In this section we just give its construction\nas <MATH_0001> of a polynomial ring. Later we will discover many\nof its beautiful properties.", "source_text_hash": "sha256:b1619ee80aef35d5d9c19b8fc7503f8f3b5e11c73b764c9cb3b02b6406551403", "unit_id": "inventory:constructions:01ND:paragraph/0001"}}}], "input_freeze": {"hash": "sha256:cbee1edf3b67462725dd233a512211ae185b2f76bf83df1f5e579792ac185f1a", "path": "translation-data/source-adoption-inputs/p1-27-constructions-p026.json"}, "model_output": {"hash": "sha256:8d4bfdf246ca2fce9d123e1a2ad01c8ded