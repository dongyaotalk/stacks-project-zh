 be a category\nfibred in groupoids over <MATH_0003>. Let <MATH_0004> be a scheme locally\nof finite type over <MATH_0005>. Let <MATH_0006> be an object of <MATH_0007> over <MATH_0008>.\nAssume that <MATH_0009> is versal at every finite type point of <MATH_0010> and that\n<MATH_0011> satisfies (RS). Then <MATH_0012>\nsatisfies (<REF_0001>).\n<STRUCT_0002>", "source_text_hash": "sha256:2669caeb2acb5822bc67ac7e9d3cf4470e39cb4094b0bda7dba645d0dda01a0d", "unit_id": "inventory:artin:07XT:lemma/0001"}}}], "input_freeze": {"hash": "sha256:6a1563e9b308b80a468c1ada193938675158654420033d8f91a883b4fcb5efc4", "path": "translation-data/source-adoption-inputs/p0-98-artin-p035.json"}, "model_output": {"hash": "sha256:feb6b23c802075c92ad0be930402cce3df773fafc5fe8301e23a6bb434d3e4d9", "path": "docs/evidence/p0-98-artin-p035-raw-01.jsonl", "record_hash": "sha256:e915e0c33aa051d09bfa611047586eb9265df3766e4584d120769a9cac152c10"}, "neighbor_unit_ids": ["tag:07XP:prose-0003"], "policy_revision": "git:c4895b2b9bf3fca2cca824ee70162f0c2033d93d", "prior_generations": [], "prompt_version": "translator-v2", "source_adoption_id": "p0-98-artin-p035", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "style_guide_path": "config/style-guide.md", "turn_id": "01a2065c-a251-7800-ac28-81039b0805ac", "unit_id": "tag:07XR:statement"}, "context_hash": "sha256:332009d1b4d0114af49a09a3ece1f6c6f6224ebab972d465c372e9faa41d7a35", "created_at": "2026-11-23T03:04:26.545836+00:00", "glossary_revision": "git:c4895b2b9bf3fca2cca824ee70162f0c2033d93d", "harness_id": "codex", "harness_version": "0.171.0", "model_id": "gpt-6.1-sol", "model_identity_confidence": "declared", "model_lane": "openai-gpt-6.1-sol", "model_record_id": "openai:gpt-6.1-sol:declared", "model_snapshot": null, "notes": [], "prompt_version": "translator-v2", "publication_status": "CANDIDATE", "qa_status": "PASS", "reasoning_effort": "high", "run_id": "run-p0-98-artin-p035", "schema_version": 2, "source_adoption_id": "p0-98-artin-p035",