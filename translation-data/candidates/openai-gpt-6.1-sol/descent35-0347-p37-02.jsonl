:37:08.678866Z", "glossary_revision": "git:ca0402bd5fc3d901193977fa5a9e72da0267aed6", "harness_id": "codex", "harness_version": "0.166.0", "model_id": "gpt-6.1-sol", "model_identity_confidence": "declared", "model_lane": "openai-gpt-6.1-sol", "model_record_id": "openai:gpt-6.1-sol:declared", "model_snapshot": null, "notes": [], "prompt_version": "translator-v2", "publication_status": "CANDIDATE", "qa_status": "PASS", "reasoning_effort": "high", "run_id": "run-descent35-gpt61sol-p37-20261103T083708Z", "schema_version": 2, "source_adoption_id": "descent35-gpt61sol-p37-20261103T083708Z", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_status": "CURRENT", "source_text_hash": "sha256:b751f0933991a1a6514f2fc9191a980c40206275379f5fab7b99b338a462b0da", "stage": "STRUCTURE_OK", "term_occurrences": [{"source_term": "scheme", "target_term": "概形"}, {"source_term": "covering", "target_term": "覆盖"}, {"source_term": "property", "target_term": "性质"}, {"source_term": "scheme", "target_term": "概形"}, {"source_term": "property", "target_term": "性质"}, {"source_term": "scheme", "target_term": "概形"}, {"source_term": "surjective", "target_term": "满射"}, {"source_term": "flat", "target_term": "平坦"}, {"source_term": "morphism", "target_term": "态射"}, {"source_term": "reduced", "target_term": "既约"}, {"source_term": "scheme", "target_term": "概形"}, {"source_term": "reduced", "target_term": "既约的"}, {"source_term": "local rings", "target_term": "局部环"}, {"source_term": "Algebra", "target_term": "代数"}, {"source_term": "reduced", "target_term": "既约"}, {"source_term": "property", "target_term": "性质"}, {"source_term": "descends through flat surjective morphisms", "target_term": "经平坦满射态射下降"}, {"source_term": "Algebra", "target_term": "代数"}, {"source_term": "schemes", "target_term": "概形"}, {"source_term": "morphisms", "target_term": "态射"}, {"source_term": "properties", "target_term": "性质"}, {"source_term": "surjective", "target_term": "满射"}, {"source_term": "flat", "target_term": "平坦"}, {"source_term": "morphisms", "target_term": "态射"}, {"source_term": "reduced", "target_term": "既约"}, {"source_term": "morphism", "target_term": "态射"}, {"source_term": "reduced", "target_term": "既约"}, {"source_term": "property", "target_term": "性质"}, {"source_term": "flat", "target_term": "平坦"}, {"source_term": "morphisms", "target_term": "态射"}, {"source_term": "ascend", "target_term": "上升"}, {"source_term": "residue fields", "target_term": "剩余域"}, {"source_term": "infinite", "target_term": "无限"}, {"source_term": "property", "target_term": "性质"}, {"source_term": "flat", "target_term": "平坦"}, {"source_term": "morphisms", "target_term": "态射"}, {"source_term": "ascend", "target_term": "上升"}, {"source_term": "surjective", "target_term": "满射"}, {"source_term": "flat", "target_term": "平坦"}, {"source_term": "morphisms", "target_term": "态射"}, {"source_term": "descend", "target_term": "下降"}, {"source_term": "Algebra", "target_term": "代数"}, {"source_term": "property", "target_term": "性质"}, {"source_term": "local for the flat topology", "target_term": "对平坦拓扑是局部的"}, {"source_term": "flat", "target_term": "平坦"}, {"source_term": "morphisms", "target_term": "态射"}, {"source_term": "ascends", "target_term": "上升"}, {"source_term": "flat", "target_term": "平坦"}, {"source_term": "surjective", "target_term": "满射"}, {"source_term": "morphisms", "target_term": "态射"}, {"source_term": "descends", "target_term": "下降"}, {"source_term": "residue fields", "target_term": "剩余域"}, {"source_term": "characteristic", "target_term": "特征"}, {"source_term": "property", "target_term": "性质"}, {"source_term": "schemes", "target_term": "概形"}, {"source_term": "topologies", "target_term": "拓扑"}], "term_status": "DECISION_REQUIRED", "translation": "\n\n<STRUCT_0001>\n经常可以证明，一个概形（scheme）的覆盖（covering）的各个成员具有某种性质（property）。在许多情形下，这意味着该概形（scheme）也具有这一性质（property）。例如，若<MATH_0001>是概形（scheme），且<MATH_0002>是满射（surjective）平坦（flat）态射（morphism），使得<MATH_0003>是既约（reduced）概形（scheme），则<MATH_0004>是既约的（reduced）。通过考察局部环（local rings）并使用《代数（Algebra）》一章引理<REF_0001>，可以证明这一点。我们称既约（reduced）这一性质（property）<TEXTITOPEN_0001>经平坦满射态射下降（descends through flat surjective morphisms）<TEXTITCLOSE_0001>。这类结果中的一些汇集在《代数（Algebra）》一章第<REF_0002>节中；对于概形（schemes），则汇集在第<REF_0003>节中。有关态射（morphisms）的性质（properties）下降的一些类似结果见第<REF_0004>节。\n\n<STRUCT_0002><STRUCT_0003>\n另一方面，存在满射（surjective）平坦（flat）态射（morphisms）<MATH_0005>，其中<MATH_0006>既约（reduced）而<MATH_0007>不既约，例如态射（morphism）<MATH_0008>。因此，既约（reduced）这一性质（property）并不<TEXTITOPEN_0002>沿平坦（flat）态射（morphisms）上升（ascend）<TEXTITCLOSE_0002>。剩余域（residue fields）无限（infinite）这一性质（property）则确实沿平坦（flat）态射（morphisms）上升（ascend）（当然，它不沿满射（surjective）平坦（flat）态射（morphisms）下降（descend））。这类结果中的一些汇集在《代数（Algebra）》一章第<REF_0005>节中。\n\n<STRUCT_0004><STRUCT_0005>\n最后，我们称一个性质（property）<TEXTITOPEN_0003>对平坦拓扑是局部的（local for the flat topology）<TEXTITCLOSE_0003>，如果它沿平坦（flat）态射（morphisms）上升（ascends），并沿平坦（flat）满射（surjective）态射（morphisms）下降（descends）。一个有些平凡的例子是剩余域（residue fields）具有给定特征（characteristic）这一性质（property）。为更精确地表述，并将其与概形（schemes）上的各种拓扑（topologies）联系起来，我们给出以下形式定义。\n\n", "translation_hash": "sha256:0f6aa6f0e571f7d2ab402cf7af6ad4dbeaec0c6f533a4edef20eb7fdd08d01cd", "unit_id": "tag:0347:prose-0001", "unknown_terms": [{"context": "覆盖及既约性质的对象；尚待术语批准。", "source_term": "scheme", "target_term": "概形"}, {"context": "概形的覆盖族；尚待术语批准。", "source_term": "covering", "target_term": "覆盖"}, {"context": "讨论上升与下降的数学性质；尚待术语批准。", "source_term": "property", "target_term": "性质"}, {"context": "下降所沿态射的满射条件；尚待术语批准。", "source_term": "surjective", "target_term": "满射"}, {"context": "态射的平坦条件；尚待术语批准。", "source_term": "flat", "target_term": "平坦"}, {"context": "概形之间的态射；尚待术语批准。", "source_term": "morphism", "target_term": "态射"}, {"context": "概形的既约性质；尚待术语批准。", "source_term": "reduced", "target_term": "既约"}, {"context": "下降后概形的既约性质；尚待术语批准。", "source_term": "reduced", "target_term": "既约的"}, {"context": "验证既约性所使用的局部环；尚待术语批准。", "source_term": "local rings", "target_term": "局部环"}, {"context": "引用的章节标题；尚待术语批准。", "source_term": "Algebra", "target_term": "代数"}, {"context": "原文明确命名的性质下降关系；尚待术语批准。", "source_term": "descends through flat surjective morphisms", "target_term": "经平坦满射态射下降"}, {"context": "概形性质的下降；尚待术语批准。", "source_term": "schemes", "target_term": "概形"}, {"context": "性质上升或下降所沿的态射；尚待术语批准。", "source_term": "morphisms", "target_term": "态射"}, {"context": "态射的数学性质；尚待术语批准。", "source_term": "properties", "target_term": "性质"}, {"context": "性质沿平坦态射向源传递；尚待术语批准。", "source_term": "ascend", "target_term": "上升"}, {"context": "概形各点的剩余域；尚待术语批准。", "source_term": "residue fields", "target_term": "剩余域"}, {"context": "剩余域的无限性；尚待术语批准。", "source_term": "infinite", "target_term": "无限"}, {"context": "性质沿满射平坦态射向目标传递；尚待术语批准。", "source_term": "descend", "target_term": "下降"}, {"context": "原文明确命名的局部性条件；尚待术语批准。", "source_term": "local for the flat topology", "target_term": "对平坦拓扑是局部的"}, {"context": "局部性质的上升要求；尚待术语批准。", "source_term": "ascends", "target_term": "上升"}, {"context": "局部性质的下降要求；尚待术语批准。", "source_term": "descends", "target_term": "下降"}, {"context": "剩余域的给定特征；尚待术语批准。", "source_term": "characteristic", "target_term": "特征"}, {"context": "概形上的各种拓扑；尚待术语批准。", "source_term": "topologies", "target_term": "拓扑"}]}
