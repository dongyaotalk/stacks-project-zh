{"chapter": "descent", "node_kind": "proof", "parent_tag": "02VV", "placeholders": {"MATH_0001": "$f$", "MATH_0002": "$(V, \\varphi)$", "MATH_0003": "$(W, \\psi)$", "MATH_0004": "$X \\to S$", "MATH_0005": "$(V', \\varphi') = f^*(V, \\varphi)$", "MATH_0006": "$(W', \\psi') = f^*(W, \\psi)$", "MATH_0007": "$\\alpha' : V' \\to W'$", "MATH_0008": "$X'$", "MATH_0009": "$S$", "MATH_0010": "$\\alpha : V \\to W$", "MATH_0011": "$X$", "MATH_0012": "$S$", "MATH_0013": "$\\alpha'$", "MATH_0014": "$V'$", "MATH_0015": "$V$", "MATH_0016": "$f$", "MATH_0017": "$\\varphi'$", "MATH_0018": "$\\varphi$", "MATH_0019": "$f \\times f$", "MATH_0020": "$$\n\\xymatrix{\nV' \\times_S X' \\ar[r]_{\\varphi'} \\ar[d]_{\\alpha' \\times \\text{id}} &\nX' \\times_S V' \\ar[d]^{\\text{id} \\times \\alpha'} \\\\\nW' \\times_S X' \\ar[r]^{\\psi'} &\nX' \\times_S W'\n}\n$$", "MATH_0021": "$$\n\\xymatrix{\nV' \\times_V V' \\ar[r]^-{\\text{pr}_i} &\nV' \\ar[r]^{\\alpha'} &\nW' \\ar[r] &\nW\n}\n, \\quad i = 0, 1\n$$", "MATH_0022": "$v_0, v_1$", "MATH_0023": "$V'$", "MATH_0024": "$v \\in V$", "MATH_0025": "$x_i \\in X'$", "MATH_0026": "$v_i$", "MATH_0027": "$x$", "MATH_0028": "$X$", "MATH_0029": "$v$", "MATH_0030": "$X$", "MATH_0031": "$v_i = (x_i, v)$", "MATH_0032": "$V' = X' \\times_X V$", "MATH_0033": "$\\varphi(v, x) = (x, v')$", "MATH_0034": "$v'$", "MATH_0035": "$V$", "MATH_0036": "$\\varphi$", "MATH_0037": "$X \\times_S X$", "MATH_0038": "$v_i' = (x_i, v')$", "MATH_0039": "$V'$", "MATH_0040": "$\\varphi'$", "MATH_0041": "$\\varphi'(v_i, x_j) = (x_i, v'_j)$", "MATH_0042": "$w_i = \\alpha'(v_i)$", "MATH_0043": "$w'_i = \\alpha'(v_i')$", "MATH_0044": "$w_i = (x_i, u_i)$", "MATH_0045": "$u_i$", "MATH_0046": "$W$", "MATH_0047": "$w_i' = (x_i, u'_i)$", "MATH_0048": "$u_i'$", "MATH_0049": "$W$", "MATH_0050": "$u_0 = u_1$", "MATH_0051": "$\\psi'$", "MATH_0052": "$$\n((x_i, x_j), \\psi(u_i, x)) = ((x_i, x_j), (x, u'_j))\n$$", "MATH_0053": "$(X' \\times_S X') \\times_{X \\times_S X} (X \\times_S W)$", "MATH_