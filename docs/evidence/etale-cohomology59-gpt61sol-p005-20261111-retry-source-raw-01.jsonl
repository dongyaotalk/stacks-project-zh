{"unit_id": "tag:03NU:statement", "translation": "范畴（category），由阿贝尔层（abelian sheaves）组成，定义在景（site）上，是阿贝尔范畴（abelian category），并具有足够多的单射对象（injectives）。\n", "allowed_english": [], "term_occurrences": [{"source_term": "category", "target_term": "范畴"}, {"source_term": "abelian sheaves", "target_term": "阿贝尔层"}, {"source_term": "site", "target_term": "景"}, {"source_term": "abelian category", "target_term": "阿贝尔范畴"}, {"source_term": "injectives", "target_term": "单射对象"}], "unknown_terms": [{"source_term": "category", "target_term": "范畴", "context": "景、上同调及fpqc拓扑；译法待批准。"}, {"source_term": "abelian sheaves", "target_term": "阿贝尔层", "context": "景、上同调及fpqc拓扑；译法待批准。"}, {"source_term": "site", "target_term": "景", "context": "景、上同调及fpqc拓扑；译法待批准。"}, {"source_term": "abelian category", "target_term": "阿贝尔范畴", "context": "景、上同调及fpqc拓扑；译法待批准。"}, {"source_term": "injectives", "target_term": "单射对象", "context": "景、上同调及fpqc拓扑；译法待批准。"}], "notes": []}
