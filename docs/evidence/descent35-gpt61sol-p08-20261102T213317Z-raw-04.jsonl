{"unit_id":"tag:034B:prose-0001","translation":"\n\n<STRUCT_0001>\n本节找出概形（schemes）的若干性质，它们在fppf拓扑（topology）中于基底（base）上是局部（local）的。\n\n","allowed_english":["fppf"],"term_occurrences":[{"source_term":"schemes","target_term":"概形"},{"source_term":"topology","target_term":"拓扑"},{"source_term":"base","target_term":"基底"},{"source_term":"local","target_term":"局部"}],"unknown_terms":[{"source_term":"schemes","target_term":"概形","context":"本节研究其性质的对象。"},{"source_term":"topology","target_term":"拓扑","context":"fppf拓扑。"},{"source_term":"base","target_term":"基底","context":"概形性质的基底局部性。"},{"source_term":"local","target_term":"局部","context":"相对于fppf覆盖的局部性。"}],"notes":[]}
{"unit_id":"tag:034C:statement","translation":"性质<MATH_0001>“<MATH_0002>局部诺特（locally Noetherian）”是fppf拓扑（topology）中的局部（local）性质。\n","allowed_english":["fppf"],"term_occurrences":[{"source_term":"locally Noetherian","target_term":"局部诺特"},{"source_term":"topology","target_term":"拓扑"},{"source_term":"local","target_term":"局部"}],"unknown_terms":[{"source_term":"locally Noetherian","target_term":"局部诺特","context":"概形局部环的诺特性条件。"},{"source_term":"topology","target_term":"拓扑","context":"用于判定局部性的fppf拓扑。"},{"source_term":"local","target_term":"局部","context":"局部诺特性质的覆盖局部性。"}],"notes":[]}
{"unit_id":"tag:0368:statement","translation":"性质<MATH_0001>“<MATH_0002>为雅各布森（Jacobson）的”是fppf拓扑（topology）中的局部（local）性质。\n","allowed_english":["fppf"],"term_occurrences":[{"source_term":"Jacobson","target_term":"雅各布森"},{"source_term":"topology","target_term":"拓扑"},{"source_term":"local","target_term":"局部"}],"unknown_terms":[{"source_term":"Jacobson","target_term":"雅各布森","context":"概形的Jacobson性质，译法待决。"},{"source_term":"topology","target_term":"拓扑","context":"fppf拓扑。"},{"source_term":"local","target_term":"局部","context":"Jacobson性质的覆盖局部性。"}],"notes":[]}
