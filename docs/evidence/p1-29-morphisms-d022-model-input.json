            "MATH_0006": "$\\mathcal{O}_S(V) \\to \\mathcal{O}_X(U)$",
            "STRUCT_0005": "\\item",
            "MATH_0007": "$S = \\bigcup_{j \\in J} V_j$",
            "MATH_0008": "$f^{-1}(V_j) = \\bigcup_{i \\in I_j} U_i$",
            "MATH_0009": "$U_i \\to V_j$",
            "MATH_0010": "$j\\in J, i\\in I_j$",
            "STRUCT_0006": "\\item",
            "MATH_0011": "$S = \\bigcup_{j \\in J} V_j$",
            "MATH_0012": "$f^{-1}(V_j) = \\bigcup_{i \\in I_j} U_i$",
            "MATH_0013": "$\\mathcal{O}_S(V_j) \\to \\mathcal{O}_X(U_i)$",
            "MATH_0014": "$j\\in J, i\\in I_j$",
            "STRUCT_0007": "\\end{enumerate}",
            "MATH_0015": "$f$",
