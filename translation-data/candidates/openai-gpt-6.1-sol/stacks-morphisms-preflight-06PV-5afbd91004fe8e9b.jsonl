on <REF_0005>\nwhen the morphism is representable by algebraic spaces.", "source_text_hash": "sha256:c29f151ee81676e9e8ce49029651210a405748091663955dd9d1328ce88c1003", "unit_id": "inventory:stacks-morphisms:06PV:paragraph/0001"}}}, {"context_id": "sha256:97d7358dbd9b9a96c24287f79e96c00491c7489bbea6a0d61c67f526bd030835", "hash": "sha256:97d7358dbd9b9a96c24287f79e96c00491c7489bbea6a0d61c67f526bd030835", "value": {"kind": "locked-English-neighbor", "location": {"byte_end": 191735, "byte_start": 191636, "file": "stacks-morphisms.tex", "fragment_hash": "sha256:8421f015b8cb969534c0f349b393083bc562356d0ebe5894d3d6f2cd585e51e4", "line_end": 5152, "line_start": 5149}, "owner_tag": "06PX", "parent_tag": "06PV", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "stacks-morphisms", "node_kind": "lemma", "parent_tag": "06PV", "placeholders": {"LOCKED_0001": "\\label{lemma-composition-flat}", "STRUCT_0001": "\\begin{lemma}", "STRUCT_0002": "\\end{lemma}"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:cd3b76aea04dca52c0a0bd5392dcd015e48ca5d7879cb22da39911b6bb9d0bf0", "source_text": "<STRUCT_0001>\n<LOCKED_0001>\nThe composition of flat morphisms is flat.\n<STRUCT_0002>", "source_text_hash": "sha256:cf5011d45e7ac367faf71992c8ad5d3fa2997a4ebb7da34a12c2dbd9ed1d47da", "unit_id": "inventory:stacks-morphisms:06PX:lemma/0001"}}}, {"context_id": "sha256:24de6fd4aa179792367dfd0387f1894956af7b103d6c0f74b2d0f13e5860b7d3", "hash": "sha256:24de6fd4aa179792367dfd0387f1894956af7b103d6c0f74b2d0f13e5860b7d3", "value": {"kind": "locked-English-reference", "location": {"byte_end": 110543, "byte_start": 109279, "file": "stacks-morphisms.tex", "fragment_hash": "sha256:3d947fb3cd19e8423537311ed9adbf370b034046005b2686