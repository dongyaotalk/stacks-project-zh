{"chapter": "etale", "node_kind": "proof", "parent_tag": "025A", "placeholders": {"REF_0001": "\\ref{morphisms-lemma-etale-locally-standard-etale}", "REF_0002": "\\ref{varieties-lemma-geometric-structure-unramified}"}, "render": {"prefix": "\\begin{proof}\n", "suffix": "\\end{proof}"}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:973118c2faaf49ee5b8a87b11246a71b2ec05be89075e43a40b60eea62e8f144", "source_text": "This is equivalent to\nMorphisms, Lemma <REF_0001>\nalthough the statements differ slightly.\nSee also, Varieties, Lemma <REF_0002>\nfor a variant for unramified morphisms.\n", "source_text_hash": "sha256:88aa4a09991173658a07cf7150f6a04267ae9b519346fb3f8d05890c3a002534", "unit_id": "tag:025C:proof"}
