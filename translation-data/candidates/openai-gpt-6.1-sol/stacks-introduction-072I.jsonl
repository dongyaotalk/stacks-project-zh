b74", "value": {"kind": "locked-English-neighbor", "location": {"byte_end": 883, "byte_start": 752, "file": "stacks-introduction.tex", "fragment_hash": "sha256:9e68a928eadcccebecec26ce822f0f3c16cc2177fe3e507a08454c0f5730e0e6", "line_end": 34, "line_start": 32}, "owner_tag": "072I", "parent_tag": "072I", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "stacks-introduction", "node_kind": "paragraph", "parent_tag": "072I", "placeholders": {"REF_0001": "\\cite{KatzMazur}", "REF_0002": "\\cite{mumford_picard}", "STRUCT_0001": "\\medskip", "STRUCT_0002": "\\noindent"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R1", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:9048e9ef7270ded42ecdcf16727923b4dce7b6dfdbba0e45b141e50b7f073848", "source_text": "<STRUCT_0001><STRUCT_0002>\nThe point of view we take here is close to the point of view taken in\n<REF_0001> and <REF_0002>.", "source_text_hash": "sha256:7520f5d0d967cf8b95a6547c3899b1035115cf1ff01f64af16fbbfd7ebd1c78e", "unit_id": "inventory:stacks-introduction:072I:paragraph/0002"}}}, {"context_id": "neighbor:inventory:stacks-introduction:072J:paragraph/0001", "hash": "sha256:48b7b75cfe9f3bb87b4c3c6956e86a6e85091171fc4bb2fca3d5a4d619d58184", "value": {"kind": "locked-English-neighbor", "location": {"byte_end": 1122, "byte_start": 941, "file": "stacks-introduction.tex", "fragment_hash": "sha256:8c763f784daeb350d243aeb71111d18d98c57756065c99a897ccb22df15d5ab2", "line_end": 47, "line_start": 44}, "owner_tag": "072J", "parent_tag": "072J", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "stacks-introduction", "node_kind": "paragraph", "parent_tag": "072J", "placeholders": {"MATH_0001": "$S$", "MATH_0002": "$S$", "MATH_0003": "$(E, f, 0)$", "MATH_0004": "$E$", "MATH_0005": "$f : E \\to S$", "MATH_0006": "$0 : S \\to E$", "STRUCT_0001": "\\noindent", "TEXTITCLOSE_0001": "}", "TEXTITOPEN_0001": "{\\it "}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R1", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:95314c934be84f8f26da46fbc258d292d5a7e1ab4a69bfdb0b9ad264866240f9", "source_status": "CURRENT", "source_structure_hash": "sha256:3f7b0f6fa3d40ff755ac363c01206309b0c84403a8df7a74af386cfd6735f8a3", "source_text": "<STRUCT_0001>\nLet <MATH_0001> be a scheme. An <TEXTITOPEN_0001>elliptic curve<TEXTITCLOSE_0001> over <MATH_0002> is a triple\n<MATH_0003> where <MATH_0004> is a scheme and <MATH_0005> and <MATH_0006>\nare morphisms of schemes such that\n", "source_text_hash": "sha256:2c1aa761a24ae5a8fc5777bb4ee0320e2982748623b7706e41140e6ec36ebada", "unit_id": "inventory:stacks-introduction:072J:paragraph/0001"}}}, {"context_id": "neighbor:inventory:stacks-introduction:072K:section_title/0001", "hash": "sha256:750d359ac7b7c69685d3b815e50e59283271b716a1ac4ec588043625a7ea83c1", "value": {"kind": "locked-English-neighbor", "location": {"byte_end": 2634, "byte_start": 2550, "file": "stacks-introduction.tex", "fragment_hash": "sha256:42947db732a93ba875e9ef348d4111aa6e06cb817ce117651a54958f0a697879", "line_end": 82, "line_start": 81}, "owner_tag": "072K", "parent_tag": "072K", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "stacks-introduction", "node_kind": "section_title", "parent_tag": "072K", "placeholders": {"LOCKED_0001": "\\label{section-moduli-elliptic-curves}", "TEXTCLOSE_0001": "}", "TEXTOPEN_0001": "\\section{"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R1", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:b3c4cd8d3cd8882c162ecc7128d22fab69fa9cf1d5a6286af4c9c380d483e6be", "source_text": "<TEXTOPEN_0001>The moduli stack of elliptic curves<TEXTCLOSE_0001>\n<LOCKED_0001>", "source_text_hash": "sha256:d80ae491527348a2d602b9e815b087f5c83781b94796bbffafc9da8d0a44e055", "unit_id": "inventory:stacks-introduction:072K:section_title/0001"}}}], "input_freeze": {"hash": "sha256:d80d3cc830ea34f2c657b8e78e7cd2f43cb18a69d3c2b278936d7aeca0b0be45", "path": "translation-data/source-adoption-inputs/stacks-introduction-072i-072j-g001-20261021.json"}, "model_output": {"hash": "sha256:c60aa37571c84e9cb488c5529aec94bdac63940f1c55019ced53f1620046d0a7", "path": "docs/evidence/stacks-introduction-072i-072j-g001-20261021-raw.jsonl", "record_hash": "sha256:02aaad8cf68dc50a8647a662bcead68de9e9e9fbc756518f5abfe9dc3708b038"}, "neighbor_unit_ids": ["tag:072I:title"], "policy_revision": "git:a53e3edd47784658af30152aaf7ff3e5c6a3f3ac", "prior_generations": [], "prompt_version": "translator-v2", "source_adoption_id": "stacks-introduction-072i-072j-g001-20261021", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "style_guide_path": "config/style-guide.md", "turn_id": "01a15ed6-a655-7b11-af97-6475f24885fb", "unit_id": "tag:072I:prose-0001"}, "context_hash": "sha256:7c157cf2cc06ccdeeb2933a2dd7c32e7bbba69de1e2629b46454206740105a04", "created_at": "2026-10-21T14:29:03.020829Z", "glossary_revision": "git:a53e3edd47784658af30152aaf7ff3e5c6a3f3ac", "harness_id": "codex", "harness_version": "0.163.0-alpha.11", "model_id": "gpt-6.1-sol", "model_identity_confidence": "declared", "model_lane": "openai-gpt-6.1-sol", "model_record_id": "openai:gpt-6.1-sol:declared", "model_snapshot": null, "notes": [], "prompt_version": "translator-v2", "publication_status": "CANDIDATE", "qa_status": "PASS", "reasoning_effort": "high", "run_id": "run-stacks-introduction-072i-072j-g001-20261021", "schema_version": 2, "source_adoption_id": "stacks-introduction-072i-072j-g001-20261021", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_status": "CURRENT", "source_text_hash": "sha256:2bf0e90d5d34e9e22c9e49bf232d8c869f12e939cfdba59ee51a9874a69de8a6", "stage": "STRUCTURE_OK", "term_occurrences": [{"source_term": "algebraic stacks", "target_term": "代数栈"}, {"source_term": "moduli problem", "target_term": "模问题"}, {"source_term": "local", "target_term": "局部"}, {"source_term": "global", "target_term": "全局"}, {"source_term": "moduli problems", "target_term": "模问题"}, {"source_term": "stacks", "target_term": "栈"}], "term_status": "DECISION_REQUIRED", "translation": "\n\n<STRUCT_0001>\n我们对代数栈（algebraic stacks）作一个非正式的介绍。目的是迅速引入一种简单的语言，使你可以用它思考你所关心的模问题（moduli problem）的局部（local）和全局（global）性质。这样一来，在假定存在一般理论的前提下，你应当能够就模问题（moduli problems）向自己提出表述恰当的问题，并着手解决它们。如果最终得到一个有意思的结果，你可以回到栈（stacks）项目其他部分的一般理论中，按需补齐缺漏。\n\n<STRUCT_0002><STRUCT_0003>\n这里采用的观点接近<REF_0001>和<REF_0002>中所采用的观点。\n\n\n\n\n\n\n", "translation_hash": "sha256:56d70cb803663b2cc2b88001cdf823ba94d012cf3596b0a70b1f0bfaf5b9ea4b", "unit_id": "tag:072I:prose-0001", "unknown_terms": [{"context": "本处指本章介绍的代数栈；词表尚未批准此译法。", "source_term": "algebraic stacks", "target_term": "代数栈"}, {"context": "本处指读者所关心的单个模问题，暂用此译法。", "source_term": "moduli problem", "target_term": "模问题"}, {"context": "本处修饰模问题的性质，暂用局部。", "source_term": "local", "target_term": "局部"}, {"context": "本处与local并列修饰模问题的性质，暂用全局。", "source_term": "global", "target_term": "全局"}, {"context": "本处为模问题的复数形式，保留原英文词形。", "source_term": "moduli problems", "target_term": "模问题"}, {"context": "本处是项目专名stacks project的组成部分，暂译为栈项目；不是对数学概念或专名译法的批准。", "source_term": "stacks", "target_term": "栈"}]}
