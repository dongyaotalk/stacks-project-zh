{"chapter": "properties", "node_kind": "lemma", "parent_tag": "01OO", "placeholders": {"FOOTNOTECLOSE_0001": "}", "FOOTNOTEOPEN_0001": "\\footnote{", "MATH_0001": "$R$", "MATH_0002": "$R$", "MATH_0003": "$R$", "MATH_0004": "$R$", "MATH_0005": "$Z$", "REF_0001": "\\ref{algebra-definition-ring-CM}", "REF_0002": "\\ref{algebra-definition-regular}", "STRUCT_0001": "\\begin{enumerate}", "STRUCT_0002": "\\item", "STRUCT_0003": "\\item", "STRUCT_0004": "\\item", "STRUCT_0005": "\\item", "STRUCT_0006": "\\end{enumerate}"}, "render": {"prefix": "\\begin{lemma}\n\\label{lemma-properties-local}\n", "suffix": "\\end{lemma}"}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:ea108eecc9dce103c068c5cd4f773e0cc8e73559ecd2f3ae54f6b0225112068b", "source_status": "CURRENT", "source_structure_hash": "sha256:89c72a315e5e5f6c5b295966dac5038afa27aed20e51344ab094aa834b63df37", "source_text": "The following properties of a ring <MATH_0001> are local.\n<STRUCT_0001>\n<STRUCT_0002> (Cohen-Macaulay.)\nThe ring <MATH_0002> is Noetherian and CM, see\nAlgebra, Definition <REF_0001>.\n<STRUCT_0003> (Regular.)\nThe ring <MATH_0003> is Noetherian and regular, see\nAlgebra, Definition <REF_0002>.\n<STRUCT_0004> (Absolutely Noetherian.)\nThe ring <MATH_0004> is of finite type over <MATH_0005>.\n<STRUCT_0005> Add more here as needed.<FOOTNOTEOPEN_0001>But we only list those properties\nhere which we have not already dealt with separately somewhere else.<FOOTNOTECLOSE_0001>\n<STRUCT_0006>\n", "source_text_hash": "sha256:573ad3d587aea1a9a2fa17ad45d63347805458d86077bac3774cfee10efd03af", "unit_id": "tag:01OT:statement"}
