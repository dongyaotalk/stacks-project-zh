ructure_hash": "sha256:74c5bcb90290a4ab403b0b7bc3ddc1d6588ffff1d3d104303a6f8d06322e9811", "source_text_hash": "sha256:76399d2b658abb20e37dedc7c354879285d65949fec955ef7b9e8dcbb93cb093", "unit_id": "tag:0025:prose-0002"}, "style_guide_path": "config/style-guide.md", "turn_id": "01a15218-e3ec-7cd1-841b-0150e0cb043c", "unit_id": "tag:0025:prose-0002"}, "context_hash": "sha256:8a3733626340a4419b06fbde11e373c295b53e1f32fdac9ce0a5bf914edb7a70", "created_at": "2026-10-19T03:07:46.306482Z", "glossary_revision": "git:b33b9b37f1623d49d4030a11f1661dfc29fa2ce4", "harness_id": "codex", "harness_version": "0.163.0-alpha.10.2", "model_id": "gpt-6.1-sol", "model_identity_confidence": "declared", "model_lane": "openai-gpt-6.1-sol", "model_record_id": "openai:gpt-6.1-sol:declared", "model_snapshot": null, "notes": [], "prompt_version": "translator-v2", "publication_status": "CANDIDATE", "qa_status": "PASS", "reasoning_effort": "high", "run_id": "run-20261019-categories-remaining-p003-gpt61sol", "schema_version": 2, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_status": "CURRENT", "source_text_hash": "sha256:76399d2b658abb20e37dedc7c354879285d65949fec955ef7b9e8dcbb93cb093", "stage": "STRUCTURE_OK", "term_occurrences": [{"source_term": "triple", "target_term": "三元组"}, {"source_term": "isomorphism", "target_term": "同构"}, {"source_term": "uniqueness", "target_term": "唯一性"}, {"source_term": "pushout", "target_term": "推出"}, {"source_term": "opposite category", "target_term": "反范畴"}, {"source_term": "fibre product", "target_term": "纤维积"}, {"source_term": "uniqueness", "target_term": "唯一性"}], "term_status": "DECISION_REQUIRED", "translation": "\n\n<STRUCT_0001>\n可以通过直接论证，且并不困难地证明三元组（triple）<MATH_0001>（若它存在）在唯一同构（isomorphism）的意义下的唯一性（uniqueness）。另一种办法是把推出（pushout）看作反范畴（opposite category）中的纤维积（fibre product），从而由第<REF_0001>节的讨论直接得到这一唯一性（uniqueness）。\n\n", "translation_hash": "sha256:79cd1858c0087144b77627161e5c2f9944e423adf36f81f19aee27b98c41f50a", "unit_id": "tag:0025:prose-0002", "unknown_terms": [{"context": "推出对象及其两个结构态射；暂定译法。", "source_term": "triple", "target_term": "三元组"}, {"context": "推出的唯一性所用同构；词表无批准项。", "source_term": "isomorphism", "target_term": "同构"}, {"context": "唯一同构意义下的唯一性；暂定译法。", "source_term": "uniqueness", "target_term": "唯一性"}, {"context": "此处所讨论的推出；暂定译法。", "source_term": "pushout", "target_term": "推出"}, {"context": "反范畴中的纤维积；词表无批准项。", "source_term": "fibre product", "target_term": "纤维积"}, {"context": "用来解释对偶的范畴；词表无批准项。", "source_term": "opposite category", "target_term": "反范畴"}]}
