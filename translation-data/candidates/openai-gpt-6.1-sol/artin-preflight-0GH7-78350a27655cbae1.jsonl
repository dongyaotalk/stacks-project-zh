et_term": "闭浸入"}, {"source_term": "ideals", "target_term": "理想"}, {"source_term": "ideal", "target_term": "理想"}, {"source_term": "closed immersion", "target_term": "闭浸入"}, {"source_term": "map", "target_term": "映射"}, {"source_term": "ideal", "target_term": "理想"}, {"source_term": "adic", "target_term": "进"}, {"source_term": "completion", "target_term": "完备化"}, {"source_term": "ideal", "target_term": "理想"}, {"source_term": "Algebra", "target_term": "代数"}, {"source_term": "ideal", "target_term": "理想"}, {"source_term": "finite", "target_term": "有限"}, {"source_term": "algebra", "target_term": "代数"}, {"source_term": "commutes", "target_term": "可交换"}, {"source_term": "flat", "target_term": "平坦"}, {"source_term": "base change", "target_term": "基变换"}, {"source_term": "Cohomology of Spaces", "target_term": "空间的上同调"}, {"source_term": "ideals", "target_term": "理想"}, {"source_term": "spectrum", "target_term": "谱"}, {"source_term": "base change", "target_term": "基变换"}, {"source_term": "commutative diagram", "target_term": "交换图"}, {"source_term": "vertical arrow", "target_term": "竖直箭头"}, {"source_term": "vertical arrow", "target_term": "竖直箭头"}, {"source_term": "closed subsets", "target_term": "闭子集"}, {"source_term": "completion", "target_term": "完备化"}, {"source_term": "theorem on formal functions", "target_term": "形式函数定理"}, {"source_term": "Cohomology of Spaces", "target_term": "空间的上同调"}, {"source_term": "diagram", "target_term": "图"}, {"source_term": "maps", "target_term": "映到"}, {"source_term": "arrows", "target_term": "箭头"}, {"source_term": "composition", "target_term": "复合"}, {"source_term": "formal modification", "target_term": "形式修改"}, {"source_term": "étale", "target_term": "平展的"}, {"source_term": "surjective", "target_term": "满射的"}, {"source_term": "arrow", "target_term": "箭头"}, {"source_term": "closed immersion", "target_term": "闭浸入"}, {"source_term": "adic", "target_term": "进的"}, {"source_term": "monomorphism", "target_term": "单态射"}, {"source_term": "surjective", "target