{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stacks-project-zh.invalid/schema/pre-adoption-replay.schema.json",
  "title": "Complete provisional v4 replay before first Git adoption",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "tool_version", "replay_id", "current_derivation_id", "predecessor_correction_id", "successor_correction_id", "source_commit", "origin_commit", "created_at", "output_unit_ids", "files"],
  "properties": {
    "schema_version": {"const": 1},
    "tool_version": {"const": "pre-adoption-replay-v1"},
    "replay_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "current_derivation_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "predecessor_correction_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "successor_correction_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "origin_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "output_unit_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "files": {
      "type": "object", "additionalProperties": false, "required": ["derivation", "units", "candidates"],
      "properties": {
        "derivation": {"type": "object", "additionalProperties": false, "required": ["path", "hash"], "properties": {"path": {"type": "string", "minLength": 1}, "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
        "units": {"type": "object", "additionalProperties": false, "required": ["path", "hash"], "properties": {"path": {"type": "string", "minLength": 1}, "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
        "candidates": {"type": "object", "additionalProperties": false, "required": ["path", "hash"], "properties": {"path": {"type": "string", "minLength": 1}, "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}
      }
    }
  }
}
