    {
      "context_id": "locked-English-neighbor:etale-cohomology:inventory:etale-cohomology:04JL:remark/0001",
      "value": {
        "kind": "locked-English-neighbor",
        "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14",
        "source_unit": {
          "schema_version": 1,
          "unit_id": "inventory:etale-cohomology:04JL:remark/0001",
          "parent_tag": "03QW",
          "chapter": "etale-cohomology",
          "node_kind": "remark",
          "risk_level": "R3",
          "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14",
          "source_text": "<STRUCT_0001>\n<LOCKED_0001>\nAnother way to state the conclusion of\nTheorem <REF_0001> and\nFundamental Groups, Lemma <REF_0002>\nis to say that every sheaf on <MATH_0001> is representable\nby a scheme <MATH_0002> <ACCENT_0001>tale over <MATH_0003>.\nThis does not mean that every sheaf is representable in the sense of\nSites, Definition <REF_0003>.\nThe reason is that in our construction of <MATH_0004>\nwe chose a sufficiently large set of schemes <ACCENT_0002>tale over <MATH_0005>,\nwhereas sheaves on <MATH_0006> form a proper class.\n<STRUCT_0002>",
          "source_status": "CURRENT",
          "placeholders": {
            "STRUCT_0001": "\\begin{remark}",
            "LOCKED_0001": "\\label{remark-every-sheaf-representable}",
            "REF_0001": "\\ref{theorem-equivalence-sheaves-point}",
