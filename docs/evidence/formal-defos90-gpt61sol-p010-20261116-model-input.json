            "MATH_0009": "$$\n\\xymatrix{\ny \\ar[rr] \\ar[dr] & & z \\ar[dl] \\\\\n& x &\n}\n$$",
            "MATH_0010": "$\\mathcal{F}_x \\to \\mathcal{F}$",
            "MATH_0011": "$p_x : \\mathcal{F}_x \\to \\mathcal{C}_\\Lambda$",
            "MATH_0012": "$\\mathcal{F}_x \\to \\mathcal{F} \\xrightarrow{p} \\mathcal{C}_\\Lambda$",
            "MATH_0013": "$p_x : \\mathcal{F}_x \\to \\mathcal{C}_\\Lambda$",
            "MATH_0014": "$\\mathcal{C}_\\Lambda$",
            "MATH_0015": "$x \\in \\Ob(\\mathcal{F}(k))$",
            "STRUCT_0002": "\\end{remark}"
          },
