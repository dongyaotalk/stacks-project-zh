"STRUCT_0008":"\\noindent","MATH_0021":"$R$","MATH_0022":"$\\widetilde{L}(M)$","MATH_0023":"$R$","MATH_0024":"$M$"},"render":{"prefix":"\\begin{proof}\n","suffix":"\\end{proof}"},"source_text_hash":"sha256:eccc2f9b794c4c571af006ecf56b9edf9066cf06a07e40b43d73b633389aa1eb","source_structure_hash":"sha256:09a537b86c07131d8789354c62f5075a06224e821330761ad453acb4e5729fcc","source_math_hash":"sha256:1ac82b9c3d62caffb4b07ac176bd1b1e5678ff92930a04fed35effb7b0543eea"}
