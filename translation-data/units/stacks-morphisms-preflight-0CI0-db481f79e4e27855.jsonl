{"chapter": "stacks-morphisms", "node_kind": "lemma", "parent_tag": "0CI0", "placeholders": {}, "render": {"prefix": "\\begin{lemma}\n\\label{lemma-composition-universally-injective}\n", "suffix": "\\end{lemma}"}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:ed5d381c85b470a49d72e9e47942f5bff1ddfc1a087313d27f424950bf22f71d", "source_text": "The composition of a pair of universally injective morphisms of\nalgebraic stacks is universally injective.\n", "source_text_hash": "sha256:5a65640c76bd0846ecfbaadd62131220ef866d3d7322549618eff35ca83a694c", "unit_id": "tag:0CI4:statement"}
