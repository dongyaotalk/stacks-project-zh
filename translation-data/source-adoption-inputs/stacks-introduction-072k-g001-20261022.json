            "MATH_0006": "$$\n\\xymatrix{\nS \\ar[rr]_a \\ar[rd]_{(E, f, 0)} & & S' \\ar[ld]^{(E', F', 0')} \\\\\n& \\mathcal{M}_{1, 1}\n}\n$$",
            "TEXTBFOPEN_0002": "{\\bf ",
            "TEXTBFCLOSE_0002": "}",
            "MATH_0007": "$\\alpha : E \\to E'$",
            "MATH_0008": "$a : S \\to S'$",
            "MATH_0009": "$\\alpha$",
