alence）\n<MATH_0020>\n即\n<MATH_0021>\n（最后一个同构（isomorphism）见引理<REF_0003>及注<REF_0004>），这就证明了本引理。\n", "translation_hash": "sha256:609af06c4d6173d13489b7b1ce153cf7587471e22bbf5a24f59ef8f527d89ccd", "unit_id": "tag:02YA:proof", "unknown_terms": [{"context": "第一方向假设中的对角态射；待决。", "source_term": "diagonal", "target_term": "对角态射"}, {"context": "五次出现的可表性；待决。", "source_term": "representable", "target_term": "可表"}, {"context": "第一方向的纤维积；待决。", "source_term": "fibre product", "target_term": "纤维积"}, {"context": "表示所给图表的笛卡尔性；待决。", "source_term": "cartesian", "target_term": "笛卡尔的"}, {"context": "第二方向中的两个等价；待决。", "source_term": "equivalence", "target_term": "等价"}, {"context": "复合中使用的第二投影；待决。", "source_term": "projection", "target_term": "投影"}, {"context": "由第二投影得到的另一态射；待决。", "source_term": "morphism", "target_term": "态射"}, {"context": "最后一串公式中的同构；待决。", "source_term": "isomorphism", "target_term": "同构"}]}
