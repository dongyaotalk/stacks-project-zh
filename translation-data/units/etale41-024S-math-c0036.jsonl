G_0007"], "classification_witness": {"anchor": {"file": "etale.tex", "kind": "section", "matches": [{"command_byte_span": {"end": 19677, "start": 19652}, "command_hash": "sha256:b7b04a917db61850fbad3bcd438ffa813f7f97c45a8539d3d5a28140f0a41c6c", "container_byte_span": {"end": 19797, "start": 19254}, "container_hash": "sha256:fae43187c5e94f9a777d79c229de2ad0a1af215ea3acf6fdd343772cabfa5ca6"}], "ordinal": 1, "owner_label": "etale-section-topological-unramified", "owner_tag": "024S", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14"}, "policy_hash": "sha256:acf06b6ce535cbc1b73e5c23191282cb4d4ae2bada1e2793d6b76b4deff666d0", "source_label": "etale-section-topological-unramified", "usage": "etale-sections-correspondence", "usage_source": {"after": "\n\\end{matrix}", "before": "Y", "environments": ["matrix"]}}, "command": "text", "policy_entry": "etale-sections-isomorphism", "slot_byte_span": {"end": 180, "start": 162}, "slot_id": "math/0001/text/0006", "source": " is an isomorphism"}], "source": "$$\n\\text{sections of }f\n\\leftrightarrow\n\\left\\{\n\\begin{matrix}\n\\text{connected components }X'\\text{ of }X\\text{ such that}\\\\\n\\text{the induced map }X' \\to Y\\text{ is an isomorphism}\n\\end{matrix}\n\\right\\}\n$$", "source_byte_span": {"end": 448, "start": 242}, "source_hash": "sha256:be0f20d2e5f1a8b1deaeb54f1dcf67875693b5e9565ff63d489d250a8c80f3ee"}], "node_kind": "theorem", "parent_tag": "024S", "placeholders": {"MATHSEG_0001": "$$\n\\text{", "MATHSEG_0002": "}f\n\\leftrightarrow\n\\left\\{\n\\begin{matrix}\n\\text{", "MATHSEG_0003": "}X'\\text{", "MATHSEG_0004": "}X\\text{", "MATHSEG_0005": "}\\\\\n\\text{", "MATHSEG_0006": "}X' \\to Y\\text{", "MATHSEG_0007": "}\n\\end{matrix}\n\\right\\}\n$$", "MATH_0001": "$Y$", "MATH_0002": "$f : X \\to Y$", "MATH_0003": "$f$", "MATH_0004": "$x \\in X$", "MATH_0005": "$x$"}, "render": {"prefix": "\\begin{theorem}\n\\label{theorem-sections-unramified-maps}\n", "suffix": "\\end{theorem}"}, "risk_level": "R3", "schema_version": 2, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:a43b68f571fa6e23e630f2187ba72fd37863f461c7ce5276b845da18919959a0", "source_math_skeleton_hash": "sha256:afe0a97dc39113a395183da4115972269fa0be1aee09c4438b2e083902a3b366", "source_status": "CURRENT", "source_structure_hash": "sha256:0b27661d063fb0c7f8eb2a50c1a14d609303020dc83643bed3dde3e8937f77ad", "source_text": "Let <MATH_0001> be a connected scheme.\nLet <MATH_0002> be unramified and separated.\nEvery section of <MATH_0003> is an isomorphism onto a connected component.\nThere exists a bijective correspondence\n<MATHSEG_0001>sections of <MATHSEG_0002>connected components <MATHSEG_0003> of <MATHSEG_0004> such that<MATHSEG_0005>the induced map <MATHSEG_0006> is an isomorphism<MATHSEG_0007>\nIn particular, given <MATH_0004> there is at most one\nsection passing through <MATH_0005>.\n", "source_text_hash": "sha256:16ae70e0561d77b0683965a63608307a7e61b98510267fbe0f3657070b4abcdf", "unit_id": "tag:024U:statement"}
