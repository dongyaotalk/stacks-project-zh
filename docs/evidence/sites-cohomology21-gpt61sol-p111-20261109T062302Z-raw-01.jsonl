get_term":"余极限","context":"拉回复形的余极限"},{"source_term":"map","target_term":"映射","context":"复形映射"},{"source_term":"kernel","target_term":"核","context":"复形映射的核"},{"source_term":"short exact sequences","target_term":"短正合列","context":"核给出的序列"},{"source_term":"filtered colimit","target_term":"滤过余极限","context":"拉回复形的滤过余极限"}],"notes":["原文两次写 bounded below，而此前构造引用使用 bounded above；忠实保留下有界表述，将有界方向疑点记录为来源 remark，未改动公式或来源。"]}
{"unit_id":"tag:06YY:statement","translation":"设 <MATH_0001> 为赋环拓扑斯的态射（morphism of ringed topoi）。存在正合（exact）函子（functor）\n<MATH_0002>\n在三角范畴（triangulated categories）之间，使得 <MATH_0003> 对任意 K-平坦（K-flat）复形（complex）<MATH_0004>（其各项（terms）平坦（flat））成立，特别地，对任意由平坦（flat）的 <MATH_0005>-模（modules）组成的上有界（bounded above）复形（complex）成立。\n","allowed_english":[],"term_occurrences":[{"source_term":"morphism of ringed topoi","target_term":"赋环拓扑斯的态射"},{"source_term":"exact","target_term":"正合"},{"source_term":"functor","target_term":"函子"},{"source_term":"triangulated categories","target_term":"三角范畴"},{"source_term":"K-flat","target_term":"K-平坦"},{"source_term":"complex","target_term":"复形"},{"source_term":"terms","target_term":"项"},{"source_term":"flat","target_term":"平坦"},{"source_term":"flat","target_term":"平坦"},{"source_term":"modules","target_term":"模"},{"source_term":"bounded above","target_term":"上有界"},{"source_term":"complex","target_term":"复形"}],"unknown_terms":[{"source_term":"morphism of ringed topoi","target_term":"赋环拓扑斯的态射","context":"拉回对应的态射"},{"source_term":"exact","target_term":"正合","context":"三角函子性质"},{"source_term":"functor","target_term":"函子","context":"导出拉回函子"},{"source_term":"triangulated categories","target_term":"三角范畴","context":"函子两端"},{"source_term":"K-flat","target_term":"K-平坦","context":"计算导出拉回的复形"},{"source_term":"complex","target_term":"复形","context":"计算导出拉回的代表"},{"source_term":"terms","target_term":"项","context":"复形各项"},{"source_term":"flat","target_term":"平坦","context":"各项性质"},{"source_term":"modules","target_term":"模","context":"系数模"},{"source_term":"bounded above","target_term":"上有界","context":"特殊复形有界性"}],"notes":[]}
