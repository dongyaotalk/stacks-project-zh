{"chapter": "stacks-morphisms", "node_kind": "lemma", "parent_tag": "0CL9", "placeholders": {}, "render": {"prefix": "\\begin{lemma}\n\\label{lemma-closed-immersion-valuative-criteria}\n", "suffix": "\\end{lemma}"}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:8de3b6d6ca29cece61d7ed6abb9bbf197a07dce2db8454d3d3251b0429870176", "source_text": "A closed immersion of algebraic stacks satisfies both\nthe existence and uniqueness part of the valuative criterion.\n", "source_text_hash": "sha256:622024c7a557ab1df8caf86159c8ebb631a2197d2b8436302dc08abff4b51fb8", "unit_id": "tag:0CLP:statement"}
