"owner_tag": "008A", "parent_tag": "0088", "requested_label": "sheaves-lemma-adjointness-tensor-restrict", "requested_tag": "008A", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "sheaves", "node_kind": "lemma", "parent_tag": "0088", "placeholders": {"LOCKED_0001": "\\label{lemma-adjointness-tensor-restrict}", "MATH_0001": "$X$", "MATH_0002": "$\\mathcal{O}_1$", "MATH_0003": "$\\mathcal{O}_2$", "MATH_0004": "$\\mathcal{F}$", "MATH_0005": "$\\mathcal{G}$", "MATH_0006": "$$\n\\Hom_{\\mathcal{O}_1}(\\mathcal{G}, \\mathcal{F}_{\\mathcal{O}_1})\n=\n\\Hom_{\\mathcal{O}_2}(\n\\mathcal{O}_2 \\otimes_{\\mathcal{O}_1} \\mathcal{G},\n\\mathcal{F}\n)\n$$", "STRUCT_0001": "\\begin{lemma}", "STRUCT_0002": "\\end{lemma}"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:732bc43e8713eaa8a59349cddb6491b96b931542c217bcd2303dfdfe438a96b2", "source_status": "CURRENT", "source_structure_hash": "sha256:4c023830001e5957a378163317aeb8ad3eb9880e8f484de71b7160b78cfea3b7", "source_text": "<STRUCT_0001>\n<LOCKED_0001>\nWith <MATH_0001>, <MATH_0002>, <MATH_0003>, <MATH_0004> and\n<MATH_0005> as above there exists a canonical bijection\n<MATH_0006>\nIn other words, the restriction and change of rings functors\nare adjoint to each other.\n<STRUCT_0002>", "source_text_hash": "sha256:12ba63e3c7246a46f6a5e9824a1477e7f60cff1d1852c22be996fbb4c8a2f83d", "unit_id": "inventory:sheaves:008A:lemma/0001"}}}], "input_freeze": {"hash": "sha256:16bf3caa20e151ad9998e86c59240f419d8560be0f8f77f7e4e8922798d705b1", "path": "translation-data/source-adoption-inputs/p1-27-constructions-d000.json"}, "model_output": {"hash": "sha256:4a6df010e0815e33167dc6b2aeb746e08fcda60fe1e08ed3127684ba03e1ad47", "path": "docs/evidence/p1-27-constructions-d000-raw-01.jsonl", "record_hash": "sha256:ed3419e29271089fd00e1439baf708f23e0e6d3122c3b2ea6f7a25688e247ca4"}, "neighbor_