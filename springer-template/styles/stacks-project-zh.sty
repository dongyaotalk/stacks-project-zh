\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{styles/stacks-project-zh}[2026/08/24 Chinese Springer adapter for the Stacks Project]

\RequirePackage[UTF8,scheme=plain,fontset=fandol]{ctex}
\RequirePackage{stacks-project-macros}
\RequirePackage{makeidx}
\RequirePackage{etoolbox}
\RequirePackage{hyperref}

\hypersetup{
  pageanchor=true,
  breaklinks=true,
  unicode=true,
  colorlinks=true,
  linkcolor=blue,
  citecolor=red,
  urlcolor=teal,
  bookmarksnumbered=true,
  bookmarksopen=true,
  linktoc=all,
  plainpages=false,
  pdfstartview=Fit,
  pdfpagelayout=OneColumn,
  pdfborder={0 0 0}
}
\urlstyle{same}

\setlength{\parindent}{2em}
\setlength{\parskip}{0pt plus 1pt}
\emergencystretch=3em

\setsansfont{texgyreheros-regular.otf}[
  BoldFont=texgyreheros-bold.otf,
  ItalicFont=texgyreheros-italic.otf,
  BoldItalicFont=texgyreheros-bolditalic.otf]
\setmonofont{lmmonolt10-regular.otf}[
  BoldFont=lmmonolt10-bold.otf,
  ItalicFont=lmmonolt10-oblique.otf,
  BoldItalicFont=lmmonolt10-boldoblique.otf]

% The Stacks Project shares the subsection counter across theorem-like
% environments. Match the reference Springer book's equation numbering:
% equations reset within sections, independently of theorem numbers.
\makeatletter
\renewcommand{\theequation}{\thesection.\arabic{equation}}
\@addtoreset{equation}{section}
\makeatother

% Localize captions supplied by svmono.cls.
\renewcommand{\abstractname}{摘要}
\renewcommand{\ackname}{致谢}
\renewcommand{\andname}{和}
\renewcommand{\bibname}{参考文献}
\renewcommand{\appendixname}{附录}
\renewcommand{\contentsname}{目录}
\renewcommand{\corollaryname}{推论}
\renewcommand{\definitionname}{定义}
\renewcommand{\examplename}{例}
\renewcommand{\exercisename}{练习}
\renewcommand{\figurename}{图}
\renewcommand{\forewordname}{前言}
\renewcommand{\indexname}{索引}
\renewcommand{\lemmaname}{引理}
\renewcommand{\listfigurename}{插图目录}
\renewcommand{\listtablename}{表格目录}
\renewcommand{\partname}{部分}
\renewcommand{\prefacename}{序言}
\renewcommand{\problemname}{问题}
\renewcommand{\proofname}{证明}
\renewcommand{\propertyname}{性质}
\renewcommand{\propositionname}{命题}
\renewcommand{\questionname}{问题}
\renewcommand{\refname}{参考文献}
\renewcommand{\remarkname}{注记}
\renewcommand{\solutionname}{解答}
\renewcommand{\tablename}{表}
\renewcommand{\theoremname}{定理}

\theoremstyle{nonumberplain}
\theoremheaderfont{\bfseries}
\theorembodyfont{\upshape}
\theoremsymbol{\ensuremath{\square}}
\renewtheorem{proof}{证明}

% SVMono stores English captions in its environment definitions. Rebind them
% to the shared subsection counter while preserving the intended body fonts.
\makeatletter
\def\stacks@renameenv#1#2#3#4{%
  \expandafter\def\csname #1\endcsname{%
    \@spthm{subsection}{#2}{#3}{#4}}%
  \expandafter\def\csname end#1\endcsname{\@endtheorem}}
\stacks@renameenv{theorem}{定理}{\bfseries}{\itshape}
\stacks@renameenv{proposition}{命题}{\bfseries}{\itshape}
\stacks@renameenv{lemma}{引理}{\bfseries}{\itshape}
\stacks@renameenv{definition}{定义}{\bfseries}{\rmfamily}
\stacks@renameenv{example}{例}{\bfseries}{\rmfamily}
\stacks@renameenv{exercise}{练习}{\bfseries}{\rmfamily}
\stacks@renameenv{situation}{情形}{\bfseries}{\rmfamily}
\stacks@renameenv{remark}{注记}{\bfseries}{\rmfamily}
\stacks@renameenv{remarks}{注记}{\bfseries}{\rmfamily}
\makeatother

% SVMono's sample title page contains publisher attribution. This project uses
% the class only as a layout dependency and must not claim Springer publication.
\makeatletter
\patchcmd{\@maketitle}
  {{\Large \copyright\,Springer-Verlag\par}}
  {}
  {}
  {\PackageWarning{stacks-project-zh}{Could not remove the SVMono publisher line}}
\makeatother

\newcommand{\StacksTag}[1]{%
  \href{https://stacks.math.columbia.edu/tag/#1}{\texttt{Tag #1}}}

\endinput
