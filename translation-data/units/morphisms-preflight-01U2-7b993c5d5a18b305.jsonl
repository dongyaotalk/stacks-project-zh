{"chapter": "morphisms", "node_kind": "lemma", "parent_tag": "01U2", "placeholders": {"MATH_0001": "$f : X \\to S$", "MATH_0002": "$f$", "REF_0001": "\\ref{topology-definition-lift-specializations}"}, "render": {"prefix": "\\begin{lemma}\n\\label{lemma-generalizations-lift-flat}\n", "suffix": "\\end{lemma}"}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:e63dbfbe2ad52c1c241912aa27eee1ee9da5686f305457ba5026a9355dc49eb2", "source_status": "CURRENT", "source_structure_hash": "sha256:f278b3da6c0fcb517839ef4a888c2d48ed966218da19fd69bd8dd3142fe70d23", "source_text": "Let <MATH_0001> be a flat morphism of schemes.\nThen generalizations lift along <MATH_0002>, see\nTopology, Definition <REF_0001>.\n", "source_text_hash": "sha256:b408e163f46248376142240834e1f798e0641ba05369f962c2f018509d03cdc4", "unit_id": "tag:03HV:statement"}
