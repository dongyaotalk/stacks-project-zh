", "node_kind": "lemma", "parent_tag": "023P", "placeholders": {"LOCKED_0001": "\\label{lemma-fpqc-universal-effective-epimorphisms}", "MATH_0001": "$\\{T_i \\to T\\}$", "MATH_0002": "$\\{T_i \\to T\\}$", "REF_0001": "\\ref{topologies-definition-fpqc-covering}", "REF_0002": "\\ref{sites-definition-universal-effective-epimorphisms}", "REF_0003": "\\ref{topologies-definition-sheaf-property-fpqc}", "STRUCT_0001": "\\begin{lemma}", "STRUCT_0002": "\\end{lemma}"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:4bc0689659e741440c660741a2c907bc6d6f53d181a32315de55b4d3446b0516", "source_status": "CURRENT", "source_structure_hash": "sha256:0d21cbb80b4781d82adc424c78313eddb3ab61c0711d00b9f413a1079b122440", "source_text": "<STRUCT_0001>\n<LOCKED_0001>\nLet <MATH_0001> be an fpqc covering, see\nTopologies, Definition <REF_0001>.\nThen <MATH_0002> is a universal effective epimorphism\nin the category of schemes, see\nSites, Definition <REF_0002>.\nIn other words, every representable functor on the category of schemes\nsatisfies the sheaf condition for the fpqc topology, see\nTopologies, Definition <REF_0003>.\n<STRUCT_0002>", "source_text_hash": "sha256:a9b60668ecc3ffb12ac665112eb31d5f39c11ef6d9309aedebf66883e5f339c0", "unit_id": "inventory:descent:023Q:lemma/0001"}}}, {"context_id": "locked-English-reference:stacks-introduction:inventory:stacks-introduction:072I:section_title/0001:stacks-introduction-section-introduction", "hash": "sha256:6fff6e8d27255bfb90c2e738c2896e3f6986fd7d2812beb25c13c7067a4688ac", "value": {"kind": "locked-English-reference", "location": {"byte_end": 221, "byte_start": 168, "file": "stacks-introduction.tex", "fragment_hash": "sha256:f8453f82d0da137e5f552b84a3a4b1dd8f52855f4404c66293439f1480ec698b", "line_end": 20, "line_start": 19}, "owner_tag": "072I", "parent_tag": "072I", "requested_label": "stacks-introduction-section-introduction", "requested_tag": "072I", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "stacks-introduction", "node_kind": "section_title", "parent_tag": "072I", "placeholders": {"LOCKED_0001": "\\label{section-introduction}", "TEXTCLOSE_0001": "}", "TEXTOPEN_0001": "\\section{"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R1", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:de57af854103f20266634160a1284648b8e1c1148631f2981d95a8fb95ada926", "source_text": "<TEXTOPEN_0001>Why read this?<TEXTCLOSE_0001>\n<LOCKED_0001>", "source_text_hash": "sha256:24264e8be7e0f919ff28c70879928ae61e0b96995ca6b9cbf214f0fe14762fd6", "unit_id": "inventory:stacks-introduction:072I:section_title/0001"}}}, {"context_id": "locked-English-reference:topologies:inventory:topologies:021R:definition/0001:topologies-definition-big-fppf-site", "hash": "sha256:f961c141ef57f038b78fab1997e5f8a333c5327c313106a984185c6a854ad7e6", "value": {"kind": "locked-English-reference", "location": {"byte_end": 72214, "byte_start": 71528, "file": "topologies.tex", "fragment_hash": "sha256:ff44a30fc819256ac2f51a8be6810f14cebdc144dca7042e3c08fd2266dc2088", "line_end": 2012, "line_start": 1997}, "owner_tag": "021R", "parent_tag": "021L", "requested_label": "topologies-definition-big-fppf-site", "requested_tag": "021R", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "topologies", "node_kind": "definition", "parent_tag": "021L", "placeholders": {"LOCKED_0001": "\\label{definition-big-fppf-site}", "MATH_0001": "$\\Sch_{fppf}$", "MATH_0002": "$S_0$", "MATH_0003": "$\\text{Cov}_0$", "MATH_0004": "$\\Sch_\\alpha$", "MATH_0005": "$S_0$", "MATH_0006": "$\\Sch_\\alpha$", "MATH_0007": "$\\text{Cov}_0$", "REF_0001": "\\ref{sites-definition-site}", "REF_0002": "\\ref{sets-lemma-construct-category}", "REF_0003": "\\ref{sets-lemma-coverings-site}", "STRUCT_0001": "\\begin{definition}", "STRUCT_0002": "\\begin{enumerate}", "STRUCT_0003": "\\item", "STRUCT_0004": "\\item", "STRUCT_0005": "\\item", "STRUCT_0006": "\\end{enumerate}", "STRUCT_0007": "\\end{definition}", "TEXTITCLOSE_0001": "}", "TEXTITOPEN_0001": "{\\it "}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:7f9f7a1ee999e32633b0ec14a2cd14a015c4b805180fd4565d739a5e54773c11", "source_status": "CURRENT", "source_structure_hash": "sha256:345879841ef253496daee4a38dbacb879adf019ea2eeb46e3d66543853a5e6e6", "source_text": "<STRUCT_0001>\n<LOCKED_0001>\nA <TEXTITOPEN_0001>big fppf site<TEXTITCLOSE_0001> is any site <MATH_0001> as in\nSites, Definition <REF_0001> constructed as follows:\n<STRUCT_0002>\n<STRUCT_0003> Choose any set of schemes <MATH_0002>, and any set of fppf coverings\n<MATH_0003> among these schemes.\n<STRUCT_0004> As underlying category take any category <MATH_0004>\nconstructed as in Sets, Lemma <REF_0002>\nstarting with the set <MATH_0005>.\n<STRUCT_0005> Choose any set of coverings as in\nSets, Lemma <REF_0003> starting with the\ncategory <MATH_0006> and the class of fppf coverings,\nand the set <MATH_0007> chosen above.\n<STRUCT_0006>\n<STRUCT_0007>", "source_text_hash": "sha256:e0e274cae7f775d5f1b68ff4b7773af985739269766526a1f18ff8613283da40", "unit_id": "inventory:topologies:021R:definition/0001"}}}, {"context_id": "locked-English-reference:topologies:inventory:topologies:021S:definition/0001:topologies-definition-big-small-fppf", "hash": "sha256:1327f5e6c3f25f4c85918938cfa9a6c579115d1da5bc19feefeceb8901969ee7", "value": {"kind": "locked-English-reference", "location": {"byte_end": 75144, "byte_start": 74530, "file": "topologies.tex", "fragment_hash": "sha256:9607ea322abe9624dd2f28c452a81db0d02920cce5bc302be465a6d81aeb1cad", "line_end": 2083, "line_start": 2068}, "owner_tag": "021S", "parent_tag": "021L", "requested_label": "topologies-definition-big-small-fppf", "requested_tag": "021S", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "topologies", "node_kind": "definition", "parent_tag": "021L", "placeholders": {"LOCKED_0001": "\\label{definition-big-small-fppf}", "MATH_0001": "$S$", "MATH_0002": "$\\Sch_{fppf}$", "MATH_0003": "$S$", "MATH_0004": "$S$", "MATH_0005": "$(\\Sch/S)_{fppf}$", "MATH_0006": "$\\Sch_{fppf}/S$", "MATH_0007": "$S$", "MATH_0008": "$(\\textit{Aff}/S)_{fppf}$", "MATH_0009": "$(\\Sch/S)_{fppf}$", "MATH_0010": "$U/S$", "MATH_0011": "$(\\textit{Aff}/S)_{fppf}$", "MATH_0012": "$\\{U_i \\to U\\}$", "MATH_0013": "$(\\Sch/S)_{fppf}$", "REF_0001": "\\ref{sites-section-localize}", "STRUCT_0001": "\\begin{definition}", "STRUCT_0002": "\\begin{enumerate}", "STRUCT_0003": "\\item", "STRUCT_0004": "\\item", "STRUCT_0005": "\\end{enumerate}", "STRUCT_0006": "\\end{definition}", "TEXTITCLOSE_0001": "}", "TEXTITCLOSE_0002": "}", "TEXTITOPEN_0001": "{\\it ", "TEXTITOPEN_0002": "{\\it "}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:303ed10af359e4e22041ab6a07f9a09b0b58678dbe8ad93db077796cc9a5bbba", "source_status": "CURRENT", "source_structure_hash": "sha256:c750b8b0dae51f13b8452a2157a65bd0c535c37417fc3649701f620e131ae060", "source_text": "<STRUCT_0001>\n<LOCKED_0001>\nLet <MATH_0001> be a scheme. Let <MATH_0002> be a big fppf\nsite containing <MATH_0003>.\n<STRUCT_0002>\n<STRUCT_0003> The <TEXTITOPEN_0001>big fppf site of <MATH_0004><TEXTITCLOSE_0001>, denoted\n<MATH_0005>, is the site <MATH_0006>\nintroduced in Sites, Section <REF_0001>.\n<STRUCT_0004> The <TEXTITOPEN_0002>big affine fppf site of <MATH_0007><TEXTITCLOSE_0002>, denoted\n<MATH_0008>, is the full subcategory of\n<MATH_0009> whose objects are affine <MATH_0010>.\nA covering of <MATH_0011> is any covering\n<MATH_0012> of <MATH_0013> which is a\nstandard fppf covering.\n<STRUCT_0005>\n<STRUCT_0006>", "source_text_hash": "sha256:d5093960c76877136290937a733f5f4739df9bf4da8a7c0814d5fcadb17a3cf8", "unit_id": "inventory:topologies:021S:definition/0001"}}}], "input_freeze": {"hash": "sha256:9cb8914df64ced4f653eb169c7d0ec413d09ec3d2b08a4193302c005f287d4be", "path": "translation-data/source-adoption-inputs/algebraic94-gpt61sol-p014-20261115-t01a1dadf.json"}, "model_output": {"hash": "sha256:a2d8443fe4dc0ebe995f6cefe218cf8f00db3ff086b1d7cddd0b150543375430", "path": "docs/evidence/algebraic94-gpt61sol-p014-20261115-t01a1dadf-raw-01.jsonl", "record_hash": "sha256:fe31cbbdc0ef5637b7c0e7e23dc22cb4cdc560094accb2a71dde1d05b9d71f08"}, "neighbor_unit_ids": ["tag:026M:prose-0001"], "policy_revision": "git:8eab2c8fa9f57d5366d1f482eef57207fd749c2e", "prior_generations": [], "prompt_version": "translator-v2", "source_adoption_id": "algebraic94-gpt61sol-p014-20261115-t01a1dadf", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "style_guide_path": "config/style-guide.md", "turn_id": "01a1dadf-027a-7111-a553-9fcf7c010ad4", "unit_id": "tag:026M:title"}, "context_hash": "sha256:3cbecfd7930168f4f30fe6f29c421fad900d795a5b5917d66bc61bfaea6ca2ec", "created_at": "2026-11-14T16:28:21.272611+00:00", "glossary_revision": "git:8eab2c8fa9f57d5366d1f482eef57207fd749c2e", "harness_id": "codex", "harness_version": "0.169.0", "model_id": "gpt-6.1-sol", "model_identity_confidence": "declared", "model_lane": "openai-gpt-6.1-sol", "model_record_id": "openai:gpt-6.1-sol:declared", "model_snapshot": null, "notes": [], "prompt_version": "translator-v2", "publication_status": "CANDIDATE", "qa_status": "PASS", "reasoning_effort": "high", "run_id": "run-algebraic94-gpt61sol-p014-20261115-t01a1dadf", "schema_version": 2, "source_adoption_id": "algebraic94-gpt61sol-p014-20261115-t01a1dadf", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_status"