_byte_span": {"end": 252, "start": 231}, "slot_id": "math/0001/text/0007", "source": " of finite type over "}, {"boundary_placeholders": ["MATHSEG_0008", "MATHSEG_0009"], "classification_witness": {"anchor": {"file": "artin.tex", "kind": "section", "matches": [{"command_byte_span": {"end": 41942, "start": 41917}, "command_hash": "sha256:18d811777062a5cf33e000a3ac04305df060460c43f40499503f91ce2cf5162a", "container_byte_span": {"end": 41990, "start": 41601}, "container_hash": "sha256:1dd5d36fd99014b2b1f3df239c906d1614145da8b663d46cbcc00f99e3cce894"}], "ordinal": 1, "owner_label": "artin-section-formal-objects", "owner_tag": "07X3", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14"}, "policy_hash": "sha256:9ad00686dd2253c6ab6248bc9019c435d094832baa3fbf1faeba8adf187ec4e5", "source_label": "artin-section-formal-objects", "usage": "p0-locked-math-frame", "usage_source": {"after": "\\mathcal", "before": "\\begin{matrix}\n", "environments": ["equation", "matrix"]}}, "command": "text", "policy_entry": "p0-frame-artin-24", "slot_byte_span": {"end": 340, "start": 322}, "slot_id": "math/0001/text/0008", "source": "formal objects of "}], "source": "\\begin{equation}\n\\label{equation-approximation}\n\\left\\{\n\\begin{matrix}\n\\text{objects }x\\text{ of }\\mathcal{X} \\text{ such that }p(x) = \\Spec(R) \\\\\n\\text{where }R\\text{ is Noetherian complete local}\\\\\n\\text{with }R/\\mathfrak m\\text{ of finite type over }S\n\\end{matrix}\n\\right\\}\n\\longrightarrow\n\\left\\{\n\\begin{matrix}\n\\text{formal objects of }\\mathcal{X}\n\\end{matrix}\n\\right\\}\n\\end{equation}", "source_byte_span": {"end": 1023, "start": 634}, "source_hash": "sha256:1dd5d36fd99014b2b1f3df239c906d1614145da8b663d46cbcc00f99e3cce894"}], "node_kind": "paragraph", "parent_tag": "07X3", "placeholders": {"MATHSEG_0001": "\\begin{equation}\n\\label{equation-approximation}\n\\left\\{\n\\begin{matrix}\n\\text{", "MATHSEG_0002": "}x\\text{", "MATHSEG_0003": "}\\mathcal{X} \\text{", "MATHSEG_0004": "}p(x) = \\Spec(R) \\\\\n\\text{", "MATHSEG_0005": "}R\\text{", "MATHSEG_0006": "}\\\\\n\\text{", "MATHSEG_0007": "}R/\\mathfrak m\\text{", "MATHSEG_0008": "}S\n\\end{matrix}\n\\right\\}\n\\longrightarrow\n\\left\\{\n\\begin{matrix}\n\\text{", "MATHSEG_0009": "}\\mathcal{X}\n\\end{matrix}\n\\right\\}\n\\end{equation}", "MATH_0001": "$S$", "MATH_0002": "$p : \\mathcal{X} \\to (\\Sch/S)_{fppf}$", "MATH_0003": "$x$", "MATH_0004": "$\\mathcal{X}$", "MATH_0005": "$R$", "MATH_0006": "$R$", "MATH_0007": "$S$", "MATH_0008": "$S$", "MATH_0009": "$\\xi_n = x|_{\\Spec(R/\\mathfrak m^n)}$", "MATH_0010": "$\\xi_1 \\to \\xi_2 \\to \\ldots$", "MATH_0011": "$\\xi = (R, \\xi_n, \\xi_n \\to \\xi_{n + 1})$", "MATH_0012": "$\\mathcal{X}$", "MATH_0013": "$x$", "MATH_0014": "$\\mathcal{X}$", "MATH_0015": "$\\mathcal{X}$", "REF_0001": "\\ref{definition-formal-objects}", "STRUCT_0001": "\\noindent"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R3", "schema_version": 2, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:b7c859e557e723ffbe844653824c69b8c3681e576648ac123fcf952ad98b716c", "source_math_skeleton_hash": "sha256:6a15344f5b209a95aca6c154c47fcf540e1cdba127c9cdae3f9d67c5e332e09f", "source_status": "CURRENT", "source_structure_hash": "sha256:d24e9fa213a8cbe2be1fe9ceb321de850de86a385e8ebae10889f3fb0abda18a", "source_text": "\n\n<STRUCT_0001>\nLet <MATH_0001> be a locally Noetherian scheme. Let\n<MATH_0002> be a category fibred in groupoids.\nSuppose that <MATH_0003> is an object of <MATH_0004> over <MATH_0005>, where <MATH_0006> is a\nNoetherian complete local <MATH_0007>-algebra with residue field of finite type\nover <MATH_0008>. Then we can consider the system of restrictions\n<MATH_0009> endowed with the natural morphisms\n<MATH_0010> coming from transitivity of restriction.\nThus <MATH_0011> is a formal object of\n<MATH_0012>. This construction is functorial in the object <MATH_0013>.\nThus we obtain a functor\n<MATHSEG_0001>objects <MATHSEG_0002> of <MATHSEG_0003> such that <MATHSEG_0004>where <MATHSEG_0005> is Noetherian complete local<MATHSEG_0006>with <MATHSEG_0007> of finite type over <MATHSEG_0008>formal objects of <MATHSEG_0009>\nTo be precise the left hand side is the full subcategory of <MATH_0014>\nconsisting of objects as indicated and the right hand side is the category\nof formal objects of <MATH_0015> as in\nDefinition <REF_0001>.\n\n", "source_text_hash": "sha256:e38ac71771d8dfcb25ed6932d87013756738b57ccda1992a866c50edd936947d", "unit_id": "tag:07X3:prose-0004"}
