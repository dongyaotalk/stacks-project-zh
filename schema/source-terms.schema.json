{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source-side mathematical vocabulary detection scope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_commit", "terms", "nonmathematical_declarations"],
  "properties": {
    "schema_version": {"const": 1},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "nonmathematical_declarations": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "nonmathematical_chapters": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["chapter", "reason", "title_evidence"],
        "properties": {
          "chapter": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "title_evidence": {
            "type": "object", "additionalProperties": false,
            "required": ["unit_id", "source_title", "source_tex_hash"],
            "properties": {
              "unit_id": {"type": "string", "minLength": 1},
              "source_title": {"type": "string", "minLength": 1},
              "source_tex_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
            }
          }
        }
      }
    },
    "nonmathematical_occurrences": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["chapter", "unit_id", "source_term", "source_tex_hash", "occurrence_index", "reason"],
        "properties": {
          "chapter": {"type": "string", "minLength": 1},
          "unit_id": {"type": "string", "minLength": 1},
          "source_term": {"type": "string", "minLength": 1},
          "source_tex_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "occurrence_index": {"type": "integer"},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "terms": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "forms", "chapters", "evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "forms": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "chapters": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "evidence": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "chapter",
                    "unit_id",
                    "source_term",
                    "source_tex_hash"
                  ],
                  "properties": {
                    "chapter": {
                      "type": "string",
                      "minLength": 1
                    },
                    "unit_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "source_tex_hash": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    },
                    "source_term": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "chapter",
                    "source_term",
                    "source_commit",
                    "selector",
                    "fragment_hash"
                  ],
                  "properties": {
                    "kind": {
                      "const": "locked-source-container"
                    },
                    "chapter": {
                      "type": "string",
                      "minLength": 1
                    },
                    "source_term": {
                      "type": "string",
                      "minLength": 1
                    },
                    "source_commit": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{40}$"
                    },
                    "selector": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "file",
                        "owner_tag",
                        "owner_label",
                        "parent_tag",
                        "kind",
                        "ordinal"
                      ],
                      "properties": {
                        "file": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9_-]+\\.tex$"
                        },
                        "owner_tag": {
                          "type": "string",
                          "pattern": "^[0-9A-Z]{4}$"
                        },
                        "parent_tag": {
                          "type": "string",
                          "pattern": "^[0-9A-Z]{4}$"
                        },
                        "kind": {
                          "type": "string",
                          "minLength": 1
                        },
                        "ordinal": {
                          "type": "integer"
                        },
                        "owner_label": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9_.:+-]+$"
                        }
                      }
                    },
                    "fragment_hash": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
