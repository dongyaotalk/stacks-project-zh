, "model_output": {"hash": "sha256:f6de5897af0d60c17bd047bac666649771e90372004127b84e18dd6d85ba7238", "path": "docs/evidence/p1-06-sheaves-d000-raw-01.jsonl", "record_hash": "sha256:b682f6d6fc0b95aa43d0a5cf5bba50d76e366c80f4174895f8e73c609dd14183"}, "neighbor_unit_ids": [], "policy_revision": "git:0cd5a696ed1fb6b267587570250073149a81bf7f", "prior_generations": [], "prompt_version": "translator-v2", "source_adoption_id": "p1-06-sheaves-d000", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "style_guide_path": "config/style-guide.md", "turn_id": "01a219d6-af88-7712-a6ce-6ecbaa71b161", "unit_id": "tag:006U:statement"}, "context_hash": "sha256:52a1994e6c8ecd224225734689762fd79b8d65b967806c382156ba26c3eb213c", "created_at": "2026-11-26T21:50:31.707Z", "glossary_revision": "git:0cd5a696ed1fb6b267587570250073149a81bf7f", "harness_id": "codex", "harness_version": "0.172.0", "model_id": "gpt-6.2-sol", "model_identity_confidence": "declared", "model_lane": "openai-gpt-6.2-sol", "model_record_id": "openai:gpt-6.2-sol:declared", "model_snapshot": null, "notes": [], "prompt_version": "translator-v2", "publication_status": "CANDIDATE", "qa_status": "PASS", "reasoning_effort": "high", "run_id": "run-p1-06-sheaves-d000", "schema_version": 2, "source_adoption_id": "p1-06-sheaves-d000", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_status": "CURRENT", "source_text_hash": "sha256:29b52768d6d140e5953275362f82c6558d8484c5b775946a5b59689c448d7861", "stage": "STRUCTURE_OK", "term_occurrences": [{"source_term": "set", "target_term": "集合"}, {"source_term": "sheaf", "target_term": "层"}, {"source_term": "empty", "target_term": "空"}, {"source_term": "set", "target_term": "集合"}, {"source_term": "sections", "target_term": "截面"}, {"source_term": "empty", "target_term": "空"}, {"source_term": "set", "target_term": "集合"}, {"source_term": "empty", "target_term": "空"}, {"source_term": "open", "target_term": "开"}, {"source_term": "covering", "target_term": "覆盖"}, {"source_term": "sections", "target_term": "截面"}, {"source_term": "element", "target_term": "元素"}, {"source_term": "empty", "target_term": "空"}, {"source_term": "product", "target_term": "积"}, {"source_term": "final object", "target_term": "终对象"}, {"source_term": "category", "target_term": "范畴"}, {"source_term": "sheaf", "target_term": "层"}, {"source_term": "final object", "target_term": "终对象"}, {"source_term": "sheaf", "target_term": "层"}, {"source_term": "sets", "target_term": "集合"}, {"source_term": "singleton", "target_term": "单点集"}, {"source_term": "open", "target_term": "开"}, {"source_term": "disjoint", "target_term": "不相交"}, {"source_term": "fibre product", "target_term": "纤维积"}, {"source_term": "final object", "target_term": "终对象"}, {"source_term": "product", "target_term": "积"}], "term_status": "DECISION_REQUIRED", "translation": "对于是否有必要说明这样一个集合（set），即一个层（sheaf）在空（empty）集合（set）<MATH_0001>上的全体截面（sections），人们总有些疑惑。\n这是有必要的，而且只要正确理解定义，就会发现我们已经作了说明。具体来说，注意空（empty）集合（set）由空（empty）的开（open）覆盖（covering）所覆盖，因此上面定义中的“截面（sections）族<MATH_0002>”实际上构成一个元素（element），它属于空（empty）积（product），而后者是终对象（final object），所论的范畴（category）就是该层（sheaf）的取值范畴。换言之，只要正确理解定义，就自然可以推出<MATHSEG_0001>一个终对象（final object）<MATHSEG_0002>，而若该层（sheaf）取值于集合（sets），它就是单点集（singleton）。如果不喜欢这个论证，也可以直接要求<MATH_0003>。\n\n<STRUCT_0001><STRUCT_0002>\n特别地，这一条件将保证，若<MATH_0004>是开（open）的且<TEXTITOPEN_0001>不相交（disjoint）<TEXTITCLOSE_0001>，则\n<MATH_0005>\n（因为纤维积（fibre product）在底为终对象（final object）时就是积（product）。）\n", "translation_hash": "sha256:586772830b010383e4c156c202be144c6b8f449a3d786d3868dd40e433f487e3", "unit_id": "tag:006U:statement", "unknown_terms": [{"context": "由层在空集上的全体截面组成", "source_term": "set", "target_term": "集合"}, {"context": "考察其在空集上的截面", "source_term": "sheaf", "target_term": "层"}, {"context": "修饰所考察的集合", "source_term": "empty", "target_term": "空"}, {"context": "与空合用，指截面所对应的开集", "source_term": "set", "target_term": "集合"}, {"context": "构成所考察集合的对象", "source_term": "sections", "target_term": "截面"}, {"context": "修饰被覆盖的集合", "source_term": "empty", "target_term": "空"}, {"context": "与空合用，指被覆盖的对象", "source_term": "set", "target_term": "集合"}, {"context": "修饰不含成员的开覆盖", "source_term": "empty", "target_term": "空"}, {"context": "限定覆盖由开集组成", "source_term": "open", "target_term": "开"}, {"context": "覆盖空集的族", "source_term": "covering", "target_term": "覆盖"}, {"context": "定义中所取的一族对象", "source_term": "sections", "target_term": "截面"}, {"context": "截面族构成的积中成员", "source_term": "element", "target_term": "元素"}, {"context": "修饰空指标族的积", "source_term": "empty", "target_term": "空"}, {"context": "以空族为指标的范畴积", "source_term": "product", "target_term": "积"}, {"context": "空积在取值范畴中的性质", "source_term": "final object", "target_term": "终对象"}, {"context": "层的取值所在", "source_term": "category", "target_term": "范畴"}, {"context": "在所论范畴中取值", "source_term": "sheaf", "target_term": "层"}, {"context": "定义所推出的空集处取值性质", "source_term": "final object", "target_term": "终对象"}, {"context": "此处限定其取值于集合", "source_term": "sheaf", "target_term": "层"}, {"context": "所考察的层的取值对象", "source_term": "sets", "target_term": "集合"}, {"context": "集合范畴中的终对象", "source_term": "singleton", "target_term": "单点集"}, {"context": "断言所取集合为开集", "source_term": "open", "target_term": "开"}, {"context": "所取开集之间的关系", "source_term": "disjoint", "target_term": "不相交"}, {"context": "以终对象为底的范畴构造", "source_term": "fibre product", "target_term": "纤维积"}, {"context": "充当纤维积的底", "source_term": "final object", "target_term": "终对象"}, {"context": "上述纤维积在该条件下给出的构造", "source_term": "product", "target_term": "积"}]}
