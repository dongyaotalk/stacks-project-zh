{"allowed_english": [], "context": {"approved_glossary_entries": [], "generation_contexts": [{"context_id": "sha256:f9ea016ee3ac3d11cfc16b1dc0a5946026cd28471625b3176cae795db0948b13", "hash": "sha256:f9ea016ee3ac3d11cfc16b1dc0a5946026cd28471625b3176cae795db0948b13", "value": {"kind": "locked-English-neighbor", "location": {"byte_end": 28017, "byte_start": 27672, "file": "sheaves.tex", "fragment_hash": "sha256:87091300c15af9a8056453b7e124a9d5d739c135d441b5a5fa9c1de169185768", "line_end": 819, "line_start": 813}, "owner_tag": "0071", "parent_tag": "0071", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "sheaves", "node_kind": "paragraph", "parent_tag": "0071", "placeholders": {"STRUCT_0001": "\\noindent", "TEXTITCLOSE_0001": "}", "TEXTITOPEN_0001": "{\\it "}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R1", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:ccb30960a8204b3fd9cbe9b354a16785b20c879fbcdc340b5519b3ea66ae2bda", "source_text": "<STRUCT_0001>\nThe lemma in particular applies to\n<TEXTITOPEN_0001>sheaves of groups, rings, algebras over a fixed ring, modules\nover a fixed ring, vector spaces over a fixed field, <TEXTITCLOSE_0001> etc.\nIn other words, these are presheaves of groups, rings,\nmodules over a fixed ring, vector spaces over a fixed field, etc\nsuch that the underlying presheaf of sets is a sheaf.", "source_text_hash": "sha256:cb7fc643708468eb0e39a1beb7edf99af32e46a4cbe2de728e3ad97d9f53a356", "unit_id": "inventory:sheaves:0071:paragraph/0003"}}}, {"context_id": "sha256:e649ff73c719274c6637e2db8620981559adbb315a9f941540ccb633a5e458e8", "hash": "sha256:e649ff73c719274c6637e2db8620981559adbb315a9f941540ccb633a5e458e8", "value": {"kind": "locked-English-neighbor", "location": {"byte_end": 29609, "byte_start": 28526, "fil