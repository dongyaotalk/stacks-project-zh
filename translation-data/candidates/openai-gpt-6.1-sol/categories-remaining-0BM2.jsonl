ve", "target_term": "左乘性的"}, {"context": "给定左乘性系统；暂无批准项。", "source_term": "system", "target_term": "系统"}, {"context": "系统中的态射；暂无批准项。", "source_term": "morphisms", "target_term": "态射"}, {"context": "所给态射与局部化中的态射；暂无批准项。", "source_term": "morphism", "target_term": "态射"}, {"context": "分式的代表对；暂定译法。", "source_term": "pair", "target_term": "对"}, {"context": "符号所表示的分式类；暂无批准项。", "source_term": "equivalence class", "target_term": "等价类"}]}
