term": "邻域"}, {"context": "由满足覆盖条件的概形组成的满子范畴。", "source_term": "full subcategory", "target_term": "满子范畴"}, {"context": "构成满子范畴的概形。", "source_term": "schemes", "target_term": "概形"}, {"context": "覆盖中的仿射开子概形。", "source_term": "affine open", "target_term": "仿射开"}, {"context": "概形所具有的仿射开覆盖。", "source_term": "covering", "target_term": "覆盖"}, {"context": "给定基上存在的对象。", "source_term": "object", "target_term": "对象"}, {"context": "对象在指定点处具有的通用性。", "source_term": "versal", "target_term": "通用"}, {"context": "对象不具有通用性的其他点。", "source_term": "point", "target_term": "点"}]}
