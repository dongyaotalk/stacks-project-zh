{"unit_id": "tag:01NF:statement", "translation": "概形（scheme）<MATH_0001>称为<TEXTITOPEN_0001>射影（projective）<MATH_0002>维空间（space）（在<MATH_0003>上）<TEXTITCLOSE_0001>。\n它的基变换（base change）<MATH_0004>（到概形（scheme）<MATH_0005>）称为<TEXTITOPEN_0002>射影（projective）<MATH_0006>维空间（space）（在<MATH_0007>上）<TEXTITCLOSE_0002>。若<MATH_0008>是一个环（ring），则到<MATH_0009>的基变换（base change）记作<MATH_0010>，称为<TEXTITOPEN_0003>射影（projective）<MATH_0011>维空间（space）（在<MATH_0012>上）<TEXTITCLOSE_0003>。\n", "allowed_english": [], "term_occurrences": [{"source_term": "scheme", "target_term": "概形"}, {"source_term": "projective", "target_term": "射影"}, {"source_term": "space", "target_term": "空间"}, {"source_term": "base change", "target_term": "基变换"}, {"source_term": "scheme", "target_term": "概形"}, {"source_term": "projective", "target_term": "射影"}, {"source_term": "space", "target_term": "空间"}, {"source_term": "ring", "target_term": "环"}, {"source_term": "base change", "target_term": "基变换"}, {"source_term": "projective", "target_term": "射影"}, {"source_term": "space", "target_term": "空间"}], "unknown_terms": [{"source_term": "scheme", "target_term": "概形", "context": "指本定义开头命名的概形。"}, {"source_term": "projective", "target_term": "射影", "context": "修饰定义开头的空间。"}, {"source_term": "space", "target_term": "空间", "context": "指本定义开头命名的射影空间。"}, {"source_term": "base change", "target_term": "基变换", "context": "指到给定概形的基变换。"}, {"source_term": "scheme", "target_term": "概形", "context": "指基变换所到的概形。"}, {"source_term": "projective", "target_term": "射影", "context": "修饰给定概形上的空间。"}, {"source_term": "space", "target_term": "空间", "context": "指给定概形上的射影空间。"}, {"source_term": "ring", "target_term": "环", "context": "指最后一句中给定的环。"}, {"source_term": "base change", "target_term": "基变换", "context": "指最后一句中另行记号的基变换。"}, {"source_term": "projective", "target_term": "射影", "context": "修饰给定环上的空间。"}, {"source_term": "space", "target_term": "空间", "context": "指给定环上的射影空间。"}], "notes": []}
