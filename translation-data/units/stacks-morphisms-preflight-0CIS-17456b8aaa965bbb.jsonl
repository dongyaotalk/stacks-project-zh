{"chapter": "stacks-morphisms", "node_kind": "proof", "parent_tag": "0CIS", "placeholders": {"REF_0001": "\\ref{remark-etale-smooth-composition}", "REF_0002": "\\ref{spaces-morphisms-lemma-composition-unramified}"}, "render": {"prefix": "\\begin{proof}\n", "suffix": "\\end{proof}"}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:45fc30b65717c24450de0dad0c65d427d8ec5b7f62c13b562811725985a39b16", "source_text": "Combine Remark <REF_0001>\nwith\nMorphisms of Spaces, Lemma <REF_0002>.\n", "source_text_hash": "sha256:3919a1746cb8a6f4a3d82ccafc798474d2639a7314627c37549337f2e0b52144", "unit_id": "tag:0CIU:proof"}
