{"chapter": "morphisms", "node_kind": "paragraph", "parent_tag": "056H", "placeholders": {"STRUCT_0001": "\\noindent"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R2", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:ee20331ba935e5f529ee2b705d2d776083fd5d6bafe53c7ca4d5bc3017fcd2e9", "source_text": "\n\n<STRUCT_0001>\nFor finite type quasi-coherent modules the support is closed,\ncan be checked on fibres, and commutes with base change.\n\n", "source_text_hash": "sha256:764880b6ad4c987450d73ad9375633f82c79909c596ca015905631745e434e1c", "unit_id": "tag:056H:prose-0002"}
