{"chapter": "spaces-descent", "node_kind": "paragraph", "parent_tag": "0CFY", "placeholders": {"ACCENT_0001": "\\'e", "ACCENT_0002": "\\'e", "MATH_0001": "$\\mathcal{P}$", "STRUCT_0001": "\\noindent"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R2", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:98b408d197bd1dfc6f0f069eeeec76d9844170c00754143420c417eac5c31f14", "source_status": "CURRENT", "source_structure_hash": "sha256:896e399153ad4a5559988f28295983dbf967e7873ea3e6a4b887956900118280", "source_text": "\n\n<STRUCT_0001>\nThe above serves as our definition. In the lemmas below we will show that\nthis is equivalent to <MATH_0001> being <ACCENT_0001>tale local on the target,\nsmooth local on the source, and stable under post-composing by\n<ACCENT_0002>tale morphisms.\n\n", "source_text_hash": "sha256:f6974cf71a6b18d3765512f2dfa83b34b671ddad883e9ff40855d61e9edf0e6e", "unit_id": "tag:0CFY:prose-0002"}
