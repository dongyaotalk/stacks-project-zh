15> to <MATH_0016>.\n<STRUCT_0007>\n", "source_text_hash": "sha256:c022ee6102dd753e918b3ff7c3bd9db5a9468cbc661fad5762c55fcc796c6044", "unit_id": "tag:00ZH:statement"}
