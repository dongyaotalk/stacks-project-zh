{"chapter": "categories", "node_kind": "definition", "parent_tag": "001T", "placeholders": {"MATH_0001": "$\\mathcal{C}$", "MATH_0002": "$x \\times y$", "MATH_0003": "$x, y \\in \\Ob(\\mathcal{C})$", "TEXTIT_0001": "{\\it has products of pairs of objects}"}, "render": {"prefix": "\\begin{definition}\n\\label{categories-definition-has-products-of-pairs}\n", "suffix": "\n\\end{definition}\n\n"}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:f992f637101cbeb027b53af415744ed92756e34af06eff3436d8c56c785af255", "source_status": "CURRENT", "source_structure_hash": "sha256:e7564dfef19df9327eef5dcb559387ea3c14efb6e4839fc3146a4c7ce766922a", "source_text": "We say the category <MATH_0001> <TEXTIT_0001> if a product <MATH_0002> exists for any <MATH_0003>.", "source_text_hash": "sha256:81614e193f202668f9fd9457288ce7a7535d228aa68779f3b05066d928bfd9fe", "unit_id": "tag:001T:statement"}
{"chapter": "categories", "node_kind": "paragraph", "parent_tag": "001T", "placeholders": {"TEXT_0001": "``having products''", "TEXT_0002": "``having finite products''"}, "render": {"prefix": "\\noindent\n", "suffix": "\n\n"}, "risk_level": "R2", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:500c8301b3891eefc3a226fb291966e6791c99dc27d52960d819fd6c20ce21ab", "source_text": "We use this terminology to distinguish this notion from the notion of <TEXT_0001> or <TEXT_0002> which usually means something else (in particular it always implies there exists a final object).", "source_text_hash": "sha256:6c24f00d8a2fd62d9659e8f8ffd403468e00f05b43c6bd75a29018f405e7eab4", "unit_id": "tag:001T:p001"}
