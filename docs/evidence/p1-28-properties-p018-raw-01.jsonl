{"unit_id": "tag:09MP:statement", "translation": "设<MATH_0001>为概形（scheme）。若<MATH_0002>上存在一个丰沛（ample）的可逆（invertible）层（sheaf），则<MATH_0003>是分离的（separated）。\n", "allowed_english": [], "term_occurrences": [{"source_term": "scheme", "target_term": "概形"}, {"source_term": "ample", "target_term": "丰沛"}, {"source_term": "invertible", "target_term": "可逆"}, {"source_term": "sheaf", "target_term": "层"}, {"source_term": "separated", "target_term": "分离的"}], "unknown_terms": [{"source_term": "scheme", "target_term": "概形", "context": "引理所讨论的对象。"}, {"source_term": "ample", "target_term": "丰沛", "context": "假设所给可逆层具有丰沛性。"}, {"source_term": "invertible", "target_term": "可逆", "context": "限定所假设存在的层。"}, {"source_term": "sheaf", "target_term": "层", "context": "假设中存在的丰沛可逆层。"}, {"source_term": "separated", "target_term": "分离的", "context": "结论中的概形性质。"}], "notes": []}
