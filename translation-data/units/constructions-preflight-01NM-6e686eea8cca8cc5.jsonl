{"schema_version": 1, "unit_id": "tag:01NQ:statement", "parent_tag": "01NM", "chapter": "constructions", "node_kind": "lemma", "risk_level": "R3", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_text": "In Situation <REF_0001>.\nThere exists a morphism of schemes\n<MATH_0001>\nwith the following properties:\n<STRUCT_0001>\n<STRUCT_0002> for every affine open <MATH_0002> there exists an isomorphism\n<MATH_0003> with <MATH_0004>, and\n<STRUCT_0003> for <MATH_0005> affine open the composition\n<MATH_0006>\nwith <MATH_0007>, <MATH_0008>\nis the open immersion of Lemma <REF_0002> above.\n<STRUCT_0004>\n", "source_status": "CURRENT", "placeholders": {"REF_0001": "\\ref{situation-relative-proj}", "MATH_0001": "$$\n\\pi : \\underline{\\text{Proj}}_S(\\mathcal{A}) \\longrightarrow S\n$$", "STRUCT_0001": "\\begin{enumerate}", "STRUCT_0002": "\\item", "MATH_0002": "$U \\subset S$", "MATH_0003": "$i_U : \\pi^{-1}(U) \\to \\text{Proj}(A)$", "MATH_0004": "$A = \\mathcal{A}(U)$", "STRUCT_0003": "\\item", "MATH_0005": "$U \\subset U' \\subset S$", "MATH_0006": "$$\n\\xymatrix{\n\\text{Proj}(A) \\ar[r]^{i_U^{-1}} &\n\\pi^{-1}(U) \\ar[rr]^{inclusion} & &\n\\pi^{-1}(U') \\ar[r]^{i_{U'}} &\n\\text{Proj}(A')\n}\n$$", "MATH_0007": "$A = \\mathcal{A}(U)$", "MATH_0008": "$A' = \\mathcal{A}(U')$", "REF_0002": "\\ref{lemma-proj-inclusion}", "STRUCT_0004": "\\end{enumerate}"}, "render": {"prefix": "\\begin{lemma}\n\\label{lemma-glue-relative-proj}\n", "suffix": "\\end{lemma}"}, "source_text_hash": "sha256:314c5d71edf54e50236cffdfcf0f43990a040200384b84893276c8ed22cd5d18", "source_structure_hash": "sha256:0ab4bd16996c16ac5dc4de1ea7d0091cc40668aca4b942746b9b6505fa4b0159", "source_math_hash": "sha256:98456824a389238e40bdd55959419a1595b2d80b9168fd7a28de9a1a3d7eb2f3"}
