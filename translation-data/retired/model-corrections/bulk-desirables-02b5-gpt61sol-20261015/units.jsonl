{"chapter": "desirables", "node_kind": "paragraph", "parent_tag": "02B5", "placeholders": {"STRUCT_0001": "\\noindent", "STRUCT_0002": "\\medskip", "STRUCT_0003": "\\noindent"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R2", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:4bfb2499a1c6caeb46063b05fd6bdf901636967c3fa5fecb2ff456dd2c796cf1", "source_text": "\n\n<STRUCT_0001>\nThis is basically just a list of things that we want to put in the stacks\nproject. As we add material to the Stacks project continuously this is always\nsomewhat behind the current state of the Stacks project. In fact, it may have\nbeen a mistake to try and list things we should add, because it seems\nimpossible to keep it up to date.\n\n<STRUCT_0002><STRUCT_0003>\nLast updated: Thursday, August 31, 2017.\n\n\n", "source_text_hash": "sha256:3d191aa54802ed85d9e653b98cf400ba58670fbe6e6b0aea95f1bf3c0af6cbfa", "unit_id": "tag:02B5:prose-0001"}
