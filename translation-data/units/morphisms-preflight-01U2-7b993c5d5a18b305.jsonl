{"chapter": "morphisms", "node_kind": "lemma", "parent_tag": "01U2", "placeholders": {}, "render": {"prefix": "\\begin{lemma}\n\\label{lemma-composition-flat}\n", "suffix": "\\end{lemma}"}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:5da91580ffd843a95464929b3172ff01eac59dec1fccd27ed7bcd918c1350870", "source_text": "The composition of flat morphisms is flat.\n", "source_text_hash": "sha256:1cef9b5636167763759bac6e58fd08ed733a3d6d6e3faac26fee58c85f9d5eef", "unit_id": "tag:01U7:statement"}
