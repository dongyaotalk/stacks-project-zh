074>。由于<MATH_0075>是仿射的（affine），它是分离的（separated），见《概形（Schemes）》引理（Lemma）<REF_0007>，从而得到<MATH_0076>。\n", "allowed_english": [], "term_occurrences": [{"source_term": "quasi-separated", "target_term": "拟分离的"}, {"source_term": "covering", "target_term": "覆盖"}, {"source_term": "affine opens", "target_term": "仿射开集"}, {"source_term": "Lemma", "target_term": "引理"}, {"source_term": "sets", "target_term": "集合"}, {"source_term": "intersection", "target_term": "交集"}, {"source_term": "affine", "target_term": "仿射的"}, {"source_term": "Schemes", "target_term": "概形"}, {"source_term": "Lemma", "target_term": "引理"}, {"source_term": "quasi-separated", "target_term": "拟分离的"}, {"source_term": "separated", "target_term": "分离的"}, {"source_term": "valuative criterion", "target_term": "赋值判别准则"}, {"source_term": "Schemes", "target_term": "概形"}, {"source_term": "Lemma", "target_term": "引理"}, {"source_term": "ring", "target_term": "环"}, {"source_term": "fraction field", "target_term": "分式域"}, {"source_term": "morphisms", "target_term": "态射"}, {"source_term": "compositions", "target_term": "复合"}, {"source_term": "local", "target_term": "局部的"}, {"source_term": "affine", "target_term": "仿射的"}, {"source_term": "sheaf", "target_term": "层"}, {"source_term": "sections", "target_term": "截面"}, {"source_term": "coherent module", "target_term": "相干模"}, {"source_term": "module", "target_term": "模"}, {"source_term": "module", "target_term": "模"}, {"source_term": "affine schemes", "target_term": "仿射概形"}, {"source_term": "coherent modules", "target_term": "相干模"}, {"source_term": "Schemes", "target_term": "概形"}, {"source_term": "Lemma", "target_term": "引理"}, {"source_term": "modules", "target_term": "模"}, {"source_term": "locally free", "target_term": "局部自由的"}, {"source_term": "rank", "target_term": "秩"}, {"source_term": "Lemma", "target_term": "引理"}, {"source_term": "local", "target_term": "局部的"}, {"source_term": "free", "target_term": "自由的"}, {"source_term": "Algebra", "target_term": "代数"}, {"source_term": "L