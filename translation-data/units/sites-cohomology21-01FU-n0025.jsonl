{"chapter": "sites-cohomology", "node_kind": "paragraph", "parent_tag": "01FU", "placeholders": {"ACCENT_0001": "\\'e", "STRUCT_0001": "\\noindent"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R2", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:8836d60eddf73837028352066c4c8434ecc9d7dd40f243844e12efc0834f1f26", "source_text": "\n\n<STRUCT_0001>\nThe following lemma will be used to see what happens if we change a\npartial universe, or to compare cohomology of the small and big <ACCENT_0001>tale\nsites.\n\n", "source_text_hash": "sha256:8de562caeee480f2a00ad08b92839b20ca44a981b80eb05edc8ff404a2e505f7", "unit_id": "tag:01FU:prose-0002"}
