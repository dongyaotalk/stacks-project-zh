{"chapter": "topologies", "node_kind": "paragraph", "parent_tag": "0224", "placeholders": {"STRUCT_0001": "\\noindent"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R2", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:5f66aaba62f27af3d693f62e01cfa6b5803f9ba6e4af5451d7ac6a760574e643", "source_text": "\n\n<STRUCT_0001>\nThus we define the corresponding standard coverings of affines as follows.\n\n", "source_text_hash": "sha256:c6fc6acd5442ae08d942785456938b46f7474665c094eb74d77f623a49f76092", "unit_id": "tag:0224:prose-0003"}
