          "projection_end": 91,
          "concept": "isomorphism",
          "rule": "catalog"
        }
      ]
    },
    {
      "unit_id": "tag:06NC:proof",
      "source_text": "As <MATH_0001> is a flat, quasi-compact, surjective morphism\nwe see <MATH_0002> is an fpqc covering of <MATH_0003>.\nThe diagonal <MATH_0004> is an isomorphism\n(Schemes, Lemma <REF_0001>).\nThis implies that the base change of <MATH_0005> by <MATH_0006> is an\nisomorphism. Hence we see <MATH_0007> is an isomorphism by\nLemma <REF_0002>.\n",
      "node_kind": "proof",
      "protected_nodes": {
        "MATH_0001": "$f$",
        "MATH_0002": "$\\{X \\to Y\\}$",
        "MATH_0003": "$Y$",
        "MATH_0004": "$\\Delta : X \\to X \\times_Y X$",
        "REF_0001": "\\ref{schemes-lemma-monomorphism}",
        "MATH_0005": "$f$",
        "MATH_0006": "$f$",
        "MATH_0007": "$f$",
        "REF_0002": "\\ref{lemma-descending-property-isomorphism}"
      },
      "required_source_terms": [
        {
