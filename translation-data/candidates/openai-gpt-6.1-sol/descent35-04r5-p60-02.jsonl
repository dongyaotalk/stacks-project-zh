d86d2bb52a1fb1599c98eec53a4ff", "source_label": "descent-lemma-dimension-local-ring-fibre", "usage": "root-phrase", "usage_source": {"after": "d", "before": "}\n", "environments": []}}, "command": "text", "policy_entry": "descent-fibre-dimension", "slot_byte_span": {"end": 116, "start": 88}, "slot_id": "math/0001/text/0002", "source": " of the fibre has dimension "}], "source": "$$\n\\mathcal{P}_d((X, x) \\to (S, s)) =\n\\text{the local ring }\n\\mathcal{O}_{X_s, x}\n\\text{ of the fibre has dimension }d\n$$", "source_byte_span": {"end": 252, "start": 131}, "source_hash": "sha256:d94b6e8b4d850ce6842fb484498cfcb50b1be40866f7f921b656c0352232c7ec"}], "node_kind": "lemma", "parent_tag": "04R5", "placeholders": {"ACCENT_0001": "\\'e", "LOCKED_0001": "\\label{lemma-dimension-local-ring-fibre}", "MATHSEG_0001": "$$\n\\mathcal{P}_d((X, x) \\to (S, s)) =\n\\text{", "MATHSEG_0002": "}\n\\mathcal{O}_{X_s, x}\n\\text{", "MATHSEG_0003": "}d\n$$", "MATH_0001": "$d \\in \\{0, 1, 2, \\ldots, \\infty\\}$", "STRUCT_0001": "\\begin{lemma}", "STRUCT_0002": "\\end{lemma}"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R3", "schema_version": 2, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:31f2dbda3c0202e2ab45e730feb33d1f9f0ec8374731d48ef627dbd910420cd2", "source_math_skeleton_hash": "sha256:540987c0386108daf263729765926a8c193d9b72c09d848e2ba453f76ad9bd60", "source_status": "CURRENT", "source_structure_hash": "sha256:ff5018c61bf040e35965eb0a679be537fe1642b93464ddaf59cae30352cc6895", "source_text": "<STRUCT_0001>\n<LOCKED_0001>\nLet <MATH_0001>.\nThe property of morphisms of germs\n<MATHSEG_0001>the local ring <MATHSEG_0002> of the fibre has dimension <MATHSEG_0003>\nis <ACCENT_0001>tale local on the source-and-target.\n<STRUCT_0002>", "source_text_hash": "sha256:c6738a205796730a599ebe6a9b2dea3a3fbb7e753e483808d13297b830c53c74", "unit_id": "inventory:descent:04NJ:lemma/0001"}}}, {"context_id": "neighbor:inventory:descent:04NK:lemma/0001", "hash": "sha256:129e862415c4e9ce9d1f3deab9596b765e120ba6442dbb1c0c7b0e7f68275a2b", "value": {"kind": "locked-English-neighbor", "location": {"byte_end": 304313, "byte_start": 304031, "file": "descent.tex", "fragment_hash": "sha256:982d996f1e4f50fda02d11d8b21aaebbe3b8f443a304f1a2bd0041371acb1a2c", "line_end": 8033, "line_start": 8023}, "owner_tag": "04NK", "parent_tag": "04R5", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "descent", "node_kind": "lemma", "parent_tag": "04R5", "placeholders": {"ACCENT_0001": "\\'e", "LOCKED_0001": "\\label{lemma-transcendence-degree-at-point}", "MATH_0001": "$r \\in \\{0, 1, 2, \\ldots, \\infty\\}$", "MATH_0002": "$$\n\\mathcal{P}_r((X, x) \\to (S, s))\n\\Leftrightarrow\n\\text{trdeg}_{\\kappa(s)} \\kappa(x) = r\n$$", "STRUCT_0001": "\\begin{lemma}", "STRUCT_0002": "\\end{lemma}"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:19b6f08eda26e9988921d719ba1429238a32d8ae548453b16437bc29581c94c0", "source_status": "CURRENT", "source_structure_hash": "sha256:8eb62ac904af46e4b57d26a13d8d7d3ac3428e23b7af2e211ed900d898c8ed35", "source_text": "<STRUCT_0001>\n<LOCKED_0001>\nLet <MATH_0001>.\nThe property of morphisms of germs\n<MATH_0002>\nis <ACCENT_0001>tale local on the source-and-target.\n<STRUCT_0002>", "source_text_hash": "sha256:738a4b1a30f2ddca7823a01af3e5c619dfe05f33977b5889e58d7f1bf55b92b7", "unit_id": "inventory:descent:04NK:lemma/0001"}}}, {"context_id": "neighbor:inventory:descent:04NK:proof/0001", "hash": "sha256:4e06a0ec3730a62ee7416ae24d2cb782b61f01c1fcbeac92ce98e91302576398", "value": {"kind": "locked-English-neighbor", "location": {"byte_end": 304986, "byte_start": 304315, "file": "descent.tex", "fragment_hash": "sha256:6fa453f10d192e33adf01e8bd70634c1a627199d4ff5c9e1ae5f56a6f4010347", "line_end": 8053, "line_start": 8035}, "owner_tag": "04NK", "parent_tag": "04R5", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "descent", "node_kind": "proof", "parent_tag": "04R5", "placeholders": {"ACCENT_0001": "\\'e", "MATH_0001": "$$\n\\xymatrix{\n\\mathcal{O}_{U', u'} & \\mathcal{O}_{V', v'} \\ar[l] \\\\\n\\mathcal{O}_{U, u} \\ar[u] & \\mathcal{O}_{V, v} \\ar[l] \\ar[u]\n}\n$$", "MATH_0002": "$\\kappa(u')/\\kappa(u)$", "MATH_0003": "$\\kappa(v')/\\kappa(v)$", "MATH_0004": "$\\text{trdeg}_{\\kappa(v)} \\kappa(u) = \\text{trdeg}_{\\kappa(v')} \\kappa(u)$", "REF_0001": "\\ref{definition-local-source-target-at-point}", "REF_0002": "\\ref{algebra-section-etale}", "STRUCT_0001": "\\begin{proof}", "STRUCT_0002": "\\end{proof}"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:f4b3b8f6a14f4c8df7be5a4d44ba06af6127375b8c1dd1a4aad391e5e6656b2e", "source_status": "CURRENT", "source_structure_hash": "sha256:1857f6fb763fe274f62db267ce16c9e277e9ac36848cdc2f8d6d14d8ae464ce6", "source_text": "<STRUCT_0001>\nGiven a diagram as in\nDefinition <REF_0001>\nwe obtain the following diagram of local homomorphisms of local rings\n<MATH_0001>\nNote that the vertical arrows are localizations of <ACCENT_0001>tale ring maps,\nin particular they are unramified (see\nAlgebra, Section <REF_0002>).\nHence <MATH_0002> and <MATH_0003>\nare finite separable field extensions.\nThus we have\n<MATH_0004>\nwhich proves the lemma.\n<STRUCT_0002>", "source_text_hash": "sha256:9b4680aeda635d465e93827cd4dcb0a38d9eea9c1d71d2f07366d1d9d1f09d41", "unit_id": "inventory:descent:04NK:proof/0001"}}}, {"context_id": "neighbor:inventory:descent:04R5:paragraph/0004", "hash": "sha256:c92e22d99a141ff48d893f8bc151adb54837f3e6fb2868f3312248c22a8bdfcd", "value": {"kind": "locked-English-neighbor", "location": {"byte_end": 305292, "byte_start": 304988, "file": "descent.tex", "fragment_hash": "sha256:0aa40a9cdb734b836d635711d1ff28a984b6616243120db762e27997fc20c285", "line_end": 8060, "line_start": 8055}, "owner_tag": "04R5", "parent_tag": "04R5", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "descent", "node_kind": "paragraph", "parent_tag": "04R5", "placeholders": {"MATH_0001": "$(X, x)$", "MATH_0002": "$X$", "MATH_0003": "$x$", "MATH_0004": "$x$", "MATH_0005": "$X$", "MATH_0006": "$\\dim_x(X)$", "STRUCT_0001": "\\noindent"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R1", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:89395f1fa21f44f151cdbe2d37b39fc886e12238b3726fe309d78824b2ea17bb", "source_status": "CURRENT", "source_structure_hash": "sha256:7cf7c2a06440e7dce75cbbad139ec69aec8cdbc520d16792207f874b8f988a71", "source_text": "<STRUCT_0001>\nLet <MATH_0001> be a germ of a scheme.\nThe dimension of <MATH_0002> at <MATH_0003> is the minimum of the dimensions of\nopen neighbourhoods of <MATH_0004> in <MATH_0005>, and any small enough open neighbourhood\nhas this dimension. Hence this is an invariant of the isomorphism class\nof the germ. We denote this simply <MATH_0006>.", "source_text_hash": "sha256:e8240a55c50a690f327272c52af7ec5b1c7bde946c3d0234b95e54d95bf66dac", "unit_id": "inventory:descent:04R5:paragraph/0004"}}}, {"context_id": "reference:algebra-section-etale", "hash": "sha256:bce9638f45ed7b965f71360aaa94ab4b9ca84992d3f31feb93e09482f2c46437", "value": {"kind": "locked-English-reference", "location": {"byte_end": 1436681, "byte_start": 1436632, "file": "algebra.tex", "fragment_hash": "sha256:309098703c5618414c664b4794f0f9c0201625e711c3108e97b188b3baaa268e", "line_end": 39237, "line_start": 39236}, "owner_tag": "00U0", "parent_tag": "00U0", "requested_label": "algebra-section-etale", "requested_tag": "00U0", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "algebra", "node_kind": "section_title", "parent_tag": "00U0", "placeholders": {"