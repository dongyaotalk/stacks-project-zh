m left to right is the construction\n<MATH_0005> discussed in\nExample <REF_0001>.\nThe functor from right to left assigns to <MATH_0006>\nthe presheaf of objects <MATH_0007>.\n<STRUCT_0002>", "source_text_hash": "sha256:a178ac86fb5b00c3deda07c3aac33a5e51a15b8d56d82d7d8c8da434dcd7cc8d", "unit_id": "inventory:categories:02Y2:lemma/0001"}, "state": "BLOCKED"}, "reference:categories-lemma-setoid-fibres": {"context_hash": "sha256:083184ad2b66082a7da1b20720c58bb4fc8268cf45afb242e81bef4d8c4202d5", "kind": "locked-English-reference", "location": {"byte_end": 294870, "byte_start": 294059, "file": "categories.tex", "fragment_hash": "sha256:cf4972692fbca1aa812a88b47eaa4c53b97aa27e60b56892ec4c4f3f64988aed", "line_end": 8247, "line_start": 8228}, "owner_tag": "0045", "parent_tag": "04S9", "requested_label": "categories-lemma-setoid-fibres", "requested_tag": "0045", "semantic_path": "lemma/0001", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "categories", "node_kind": "lemma", "parent_tag": "04S9", "placeholders": {"LOCKED_0001": "\\label{lemma-setoid-fibres}", "MATH_0001": "$\\mathcal{C}$", "MATH_0002": "$\\mathcal{S}$", "MATH_0003": "$\\mathcal{C}$", "MATH_0004": "$\\mathcal{S} \\to \\mathcal{S}'$", "MATH_0005": "$\\mathcal{C}$", "MATH_0006": "$\\mathcal{S}'$", "MATH_0007": "$\\mathcal{C}$", "MATH_0008": "$\\mathcal{S}$", "MATH_0009": "$\\mathcal{C}$", "MATH_0010": "$U \\in \\Ob(\\mathcal{C})$", "MATH_0011": "$\\Ob(\\mathcal{S}_U) \\to \\Ob(\\mathcal{S}'_U)$", "MATH_0012": "$p : \\mathcal{S} \\to \\mathcal{C}$", "MATH_0013": "$p' : \\mathcal{S}' \\to \\mathcal{C}$", "MATH_0014": "$\\text{can} : \\mathcal{S} \\to \\mathcal{S}'$", "MATH_0015": "$\\mathcal{C}$", "STRUCT_0001": "\\begin{lemma}", "STRUCT_0002": "\\begin{enumerate}", "STRUCT_0003": "\\item", "STRUCT_0004": "\\begin{enumerate}", "STRUCT_0005": "\\item", "STRUCT_0006": "\\item", "STRUCT_0007": "\\end{enumerate}", "STRUCT_0008": "\\item", "STRUCT_0009": "\\end{enumerate}", "STR