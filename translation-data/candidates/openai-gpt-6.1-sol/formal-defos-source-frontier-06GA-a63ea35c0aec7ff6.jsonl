ransformation <MATH_0027> is given on the object <MATH_0028> by\n<MATH_0029>.\n<STRUCT_0010>", "source_text_hash": "sha256:7891914cbc58fa48287dc991a25a8060895716462ef47fafa79e6db5c37c44af", "unit_id": "inventory:categories:0040:lemma/0001"}}}, {"context_id": "locked-English-reference:categories:inventory:categories:003V:lemma/0001:categories-lemma-fibred-groupoids", "hash": "sha256:c7ce354f2556fab9ef5faf3c37d96bd4fa6d127f51d571ecdf717214c60164d2", "value": {"kind": "locked-English-reference", "location": {"byte_end": 247528, "byte_start": 246812, "file": "categories.tex", "fragment_hash": "sha256:2b530e74c2a3c55fcc8d82d290320dd77777a345b986bceffd27024e8f54ac2f", "line_end": 7052, "line_start": 7035}, "owner_tag": "003V", "parent_tag": "003S", "requested_label": "categories-lemma-fibred-groupoids", "requested_tag": "003V", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "categories", "node_kind": "lemma", "parent_tag": "003S", "placeholders": {"LOCKED_0001": "\\label{lemma-fibred-groupoids}", "MATH_0001": "$p : \\mathcal{S} \\to \\mathcal{C}$", "MATH_0002": "$p : \\mathcal{S} \\to \\mathcal{C}$", "MATH_0003": "$\\mathcal{S}$", "MATH_0004": "$\\mathcal{C}$", "MATH_0005": "$\\mathcal{S}$", "MATH_0006": "$f^\\ast x \\to x$", "MATH_0007": "$f$", "MATH_0008": "$f: V \\to U = p(x)$", "MATH_0009": "$(U \\mapsto \\mathcal{S}_U, f \\mapsto f^*, \\alpha_{f, g}, \\alpha_U)$", "MATH_0010": "$\\mathcal{C}^{opp}$", "MATH_0011": "$(2, 1)$", "REF_0001": "\\ref{lemma-fibred}", "STRUCT_0001": "\\begin{lemma}", "STRUCT_0002": "\\begin{enumerate}", "STRUCT_0003": "\\item", "STRUCT_0004": "\\item", "STRUCT_0005": "\\end{enumerate}", "STRUCT_0006": "\\end{lemma}"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:5cd131a3b8734d966b83878b2b9423cf305a70d80e119c5406f1fb234dd89158", "source_status": "CURRENT", "source_structure_hash":