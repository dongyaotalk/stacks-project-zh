    {
      "context_id": "locked-English-reference:sites:inventory:sites:00XR:lemma/0001:sites-lemma-when-shriek",
      "value": {
        "kind": "locked-English-reference",
        "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14",
        "source_unit": {
          "schema_version": 1,
          "unit_id": "inventory:sites:00XR:lemma/0001",
          "parent_tag": "00XN",
          "chapter": "sites",
          "node_kind": "lemma",
          "risk_level": "R3",
          "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14",
          "source_text": "<STRUCT_0001>\n<LOCKED_0001>\n<LOCKED_0002>\nLet <MATH_0001> and <MATH_0002> be sites.\nLet <MATH_0003> be a functor.\nAssume that\n<STRUCT_0002>\n<ITEMOPEN_0001>(a)<ITEMCLOSE_0001> <MATH_0004> is cocontinuous, and\n<ITEMOPEN_0002>(b)<ITEMCLOSE_0002> <MATH_0005> is continuous.\n<STRUCT_0003>\nLet <MATH_0006>\nbe the associated morphism of topoi. Then\n<STRUCT_0004>\n<STRUCT_0005> sheafification in the formula <MATH_0007> is\nunnecessary, in other words <MATH_0008>,\n<STRUCT_0006> <MATH_0009> has a left adjoint <MATH_0010>, and\n<STRUCT_0007> <MATH_0011> commutes with arbitrary limits and colimits.\n<STRUCT_0008>\n<STRUCT_0009>",
          "source_status": "CURRENT",
          "placeholders": {
            "STRUCT_0001": "\\begin{lemma}",
            "LOCKED_0001": "\\label{lemma-when-shriek}",
            "LOCKED_0002": "\\begin{slogan}\nSheafification is redundant in topoi morphisms associated to simultaneously\ncontinuous and cocontinuous site functors.\n\\end{slogan}",
            "MATH_0001": "$\\mathcal{C}$",
            "MATH_0002": "$\\mathcal{D}$",
            "MATH_0003": "$u : \\mathcal{C} \\to \\mathcal{D}$",
            "STRUCT_0002": "\\begin{enumerate}",
            "ITEMOPEN_0001": "\\item[",
            "ITEMCLOSE_0001": "]",
            "MATH_0004": "$u$",
            "ITEMOPEN_0002": "\\item[",
            "ITEMCLOSE_0002": "]",
            "MATH_0005": "$u$",
            "STRUCT_0003": "\\end{enumerate}",
            "MATH_0006": "$g : \\Sh(\\mathcal{C}) \\to \\Sh(\\mathcal{D})$",
            "STRUCT_0004": "\\begin{enumerate}",
            "STRUCT_0005": "\\item",
            "MATH_0007": "$g^{-1} = (u^p\\ )^\\#$",
            "MATH_0008": "$g^{-1}(\\mathcal{G})(U) = \\mathcal{G}(u(U))$",
            "STRUCT_0006": "\\item",
            "MATH_0009": "$g^{-1}$",
            "MATH_0010": "$g_{!} = (u_p\\ )^\\#$",
            "STRUCT_0007": "\\item",
            "MATH_0011": "$g^{-1}$",
            "STRUCT_0008": "\\end{enumerate}",
            "STRUCT_0009": "\\end{lemma}"
          },
          "render": {
            "prefix": "",
            "suffix": ""
          },
          "source_text_hash": "sha256:bc69b1a61c2b342ca92f9840fdc0135981469687a426ab632997785282f4c24a",
