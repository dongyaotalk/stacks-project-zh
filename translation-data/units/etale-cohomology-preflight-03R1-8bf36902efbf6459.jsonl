{"chapter": "etale-cohomology", "node_kind": "paragraph", "parent_tag": "03R1", "placeholders": {"REF_0001": "\\ref{brauer-section-introduction}", "REF_0002": "\\cite{SerreCorpsLocaux}", "REF_0003": "\\cite{SerreGaloisCohomology}", "REF_0004": "\\cite{Weil}", "STRUCT_0001": "\\noindent"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R2", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:ff4773f49fb9e42b483b34ba2765c812dd051f4a954757f796e090ef23b68330", "source_text": "\n\n<STRUCT_0001>\nBrauer groups of fields are defined using finite central simple algebras.\nIn this section we review the relevant facts about Brauer groups, most of\nwhich are discussed in the chapter\nBrauer Groups, Section <REF_0001>.\nFor other references, see <REF_0002>,\n<REF_0003> or <REF_0004>.\n\n", "source_text_hash": "sha256:4d900dbd3362f49fb7973bc2acdcd1f05475f40957c1cbecfd85c782a50699b3", "unit_id": "tag:03R1:prose-0001"}
