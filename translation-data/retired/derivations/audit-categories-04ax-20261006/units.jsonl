{"chapter": "categories", "node_kind": "paragraph", "parent_tag": "04AX", "placeholders": {}, "render": {"prefix": "\\noindent\n", "suffix": "\n\n"}, "risk_level": "R1", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:89aa38e6974a7d3316228f309de964ed1afb5cedc529d18c714d37214d84c2c3", "source_text": "It turns out we sometimes need a more finegrained control over the\npossible conditions one can impose on index categories. Thus we add\nsome lemmas on the possible things one can require.", "source_text_hash": "sha256:2f4d617b73b900cdacdda1510b4e923d15418229b461bcd42db6c7df1c08ff37", "unit_id": "tag:04AX:p005"}
