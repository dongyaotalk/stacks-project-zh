{"allowed_english": [], "context": {"approved_glossary_entries": [], "generation_contexts": [{"context_id": "locked-English-neighbor:algebraic:inventory:algebraic:026K:title_title/0001", "hash": "sha256:254497b2551006372d13c7e0ca5e74d8addacc9f41dce96ea981acde88bffd37", "value": {"kind": "locked-English-neighbor", "location": {"byte_end": 80, "byte_start": 56, "file": "algebraic.tex", "fragment_hash": "sha256:421910e585fa09aeb3023c59e99df96786bd0031c70c5f31b17af271615d115d", "line_end": 7, "line_start": 7}, "owner_tag": "026K", "parent_tag": "026K", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "algebraic", "node_kind": "title_title", "parent_tag": "026K", "placeholders": {"TEXTCLOSE_0001": "}", "TEXTOPEN_0001": "\\title{"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R1", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:b408cd74dc604d8c14064b48cbf9afebf4607573a78ca0b107c87c319089b61a", "source_text": "<TEXTOPEN_0001>Algebraic Stacks<TEXTCLOSE_0001>", "source_text_hash": "sha256:875b2d39448d24b7154326ab5796ae9022db8e002274fb021a605b81d104fe36", "unit_id": "inventory:algebraic:026K:title_title/0001"}}}, {"context_id": "locked-English-neighbor:algebraic:inventory:algebraic:026L:paragraph/0001", "hash": "sha256:76865440f26ddef3337fe42273ada70d10033dd3a5d409de3968cfd848bd337b", "value": {"kind": "locked-English-neighbor", "location": {"byte_end": 578, "byte_start": 207, "file": "algebraic.tex", "fragment_hash": "sha256:6fa70d6d6fe71b8ceba652c554ab70d81d0b248fd14182a8d8065616e4d84dba", "line_end": 26, "line_start": 20}, "owner_tag": "026L", "parent_tag": "026L", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "algebraic", "node_kind": "paragraph", "parent_tag": "026L", "placeholders": {"REF_0001": "\\cite{LM-B}", "STRUCT_0001": "\\noindent"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R1", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:af44b7feac527af6577893f200e75ed7d76c576a86a0d1159fe68b1c9641e84e", "source_text": "<STRUCT_0001>\nThis is where we define algebraic stacks and make some very elementary\nobservations. The general philosophy will be to have no separation\nconditions whatsoever and add those conditions necessary to make lemmas,\npropositions, theorems true/provable. Thus the notions discussed here\ndiffer slightly from those in other places in the literature, e.g.,\n<REF_0001>.", "source_text_hash": "sha256:bc893ec88c9b1b8653b18d5ece73e7fdbba6c19f5f259d09d4e85eca6d3279da", "unit_id": "inventory:algebraic:026L:paragraph/0001"}}}, {"context_id": "locked-English-neighbor:algebraic:inventory:algebraic:026L:section_title/0001", "hash": "sha256:b945cb941c1d9af969aee7967469132dc8809763c817dcc22c1cee20ab13e32a", "value": {"kind": "locked-English-neighbor", "location": {"byte_end": 205, "byte_start": 154, "file": "algebraic.tex", "fragment_hash": "sha256:818b11324e818fe49df54475c6acdad873cdb21ec9d6e3fdc16fee24d3904974", "line_end": 18, "line_start": 17}, "owner_tag": "026L", "parent_tag": "026L", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "algebraic", "node_kind": "section_title", "parent_tag": "026L", "placeholders": {"LOCKED_0001": "\\label{section-introduction}", "TEXTCLOSE_0001": "}", "TEXTOPEN_0001": "\\section{"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R1", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha