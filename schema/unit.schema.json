{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stacks-project-zh.invalid/schema/unit.schema.json",
  "title": "Stacks Project Chinese translation unit",
  "oneOf": [
    {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://stacks-project-zh.invalid/schema/unit.schema.json",
      "title": "Stacks Project Chinese translation unit",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "unit_id",
        "parent_tag",
        "chapter",
        "node_kind",
        "risk_level",
        "source_commit",
        "source_text",
        "source_text_hash",
        "source_structure_hash",
        "source_math_hash",
        "source_status",
        "placeholders",
        "render"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "unit_id": {
          "type": "string",
          "minLength": 1
        },
        "parent_tag": {
          "type": "string",
          "minLength": 4
        },
        "chapter": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "node_kind": {
          "type": "string",
          "minLength": 1
        },
        "risk_level": {
          "enum": [
            "R0",
            "R1",
            "R2",
            "R3"
          ]
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "source_text": {
          "type": "string",
          "minLength": 1
        },
        "source_text_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "source_structure_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "source_math_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "source_status": {
          "enum": [
            "CURRENT",
            "STALE_TEXT",
            "STALE_MATH",
            "PARTIAL_STALE",
            "RETIRED"
          ]
        },
        "placeholders": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Z][A-Z0-9]*_[0-9]{4}$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "render": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "prefix",
            "suffix"
          ],
          "properties": {
            "prefix": {
              "type": "string"
            },
            "suffix": {
              "type": "string"
            }
          }
        }
      }
    },
    {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://stacks-project-zh.invalid/schema/unit.schema.json",
      "title": "Stacks Project Chinese translation unit",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "unit_id",
        "parent_tag",
        "chapter",
        "node_kind",
        "risk_level",
        "source_commit",
        "source_text",
        "source_text_hash",
        "source_structure_hash",
        "source_math_hash",
        "source_status",
        "placeholders",
        "render",
        "math_text_regions",
        "source_math_skeleton_hash"
      ],
      "properties": {
        "schema_version": {
          "const": 2
        },
        "unit_id": {
          "type": "string",
          "minLength": 1
        },
        "parent_tag": {
          "type": "string",
          "minLength": 4
        },
        "chapter": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "node_kind": {
          "type": "string",
          "minLength": 1
        },
        "risk_level": {
          "const": "R3"
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "source_text": {
          "type": "string",
          "minLength": 1
        },
        "source_text_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "source_structure_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "source_math_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "source_status": {
          "enum": [
            "CURRENT",
            "STALE_TEXT",
            "STALE_MATH",
            "PARTIAL_STALE",
            "RETIRED"
          ]
        },
        "placeholders": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Z][A-Z0-9]*_[0-9]{4}$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "render": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "prefix",
            "suffix"
          ],
          "properties": {
            "prefix": {
              "type": "string"
            },
            "suffix": {
              "type": "string"
            }
          }
        },
        "math_text_regions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "region_id",
              "delimiter_kind",
              "source",
              "source_hash",
              "source_byte_span",
              "pieces",
              "slots"
            ],
            "properties": {
              "region_id": {
                "type": "string",
                "pattern": "^math/[0-9]{4}$"
              },
              "delimiter_kind": {
                "enum": [
                  "inline-dollar",
                  "display-dollar",
                  "inline-paren",
                  "display-bracket",
                  "environment"
                ]
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "source_hash": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "source_byte_span": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "start",
                  "end"
                ],
                "properties": {
                  "start": {
                    "type": "integer"
                  },
                  "end": {
                    "type": "integer"
                  }
                }
              },
              "pieces": {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "kind",
                        "placeholder"
                      ],
                      "properties": {
                        "kind": {
                          "const": "locked"
                        },
                        "placeholder": {
                          "type": "string",
                          "pattern": "^MATHSEG_[0-9]{4}$"
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "kind",
                        "slot_id"
                      ],
                      "properties": {
                        "kind": {
                          "const": "text"
                        },
                        "slot_id": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  ]
                }
              },
              "slots": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "slot_id",
                    "source",
                    "command",
                    "policy_entry",
                    "slot_byte_span",
                    "boundary_placeholders",
                    "classification_witness"
                  ],
                  "properties": {
                    "slot_id": {
                      "type": "string",
                      "pattern": "^math/[0-9]{4}/text/[0-9]{4}$"
                    },
                    "source": {
                      "type": "string",
                      "minLength": 1
                    },
                    "command": {
                      "const": "text"
                    },
                    "policy_entry": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]*$"
                    },
                    "slot_byte_span": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "start",
                        "end"
                      ],
                      "properties": {
                        "start": {
                          "type": "integer"
                        },
                        "end": {
                          "type": "integer"
                        }
                      }
                    },
                    "boundary_placeholders": {
                      "type": "array",
                      "maxItems": 2,
                      "items": {
                        "type": "string",
                        "pattern": "^MATHSEG_[0-9]{4}$"
                      }
                    },
                    "classification_witness": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "usage",
                        "usage_source",
                        "source_label",
                        "policy_hash",
                        "anchor"
                      ],
                      "properties": {
                        "usage": {
                          "enum": [
                            "quad-connector",
                            "matrix-condition",
                            "set-description"
                          ]
                        },
                        "usage_source": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "before",
                            "after",
                            "environments"
                          ],
                          "properties": {
                            "before": {
                              "type": "string"
                            },
                            "after": {
                              "type": "string"
                            },
                            "environments": {
                              "type": "array",
                              "items": {
                                "type": "string",
                                "minLength": 1
                              }
                            }
                          }
                        },
                        "source_label": {
                          "type": "string",
                          "minLength": 1
                        },
                        "policy_hash": {
                          "type": "string",
                          "pattern": "^sha256:[0-9a-f]{64}$"
                        },
                        "anchor": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "source_commit",
                            "file",
                            "owner_tag",
                            "owner_label",
                            "kind",
                            "ordinal",
                            "matches"
                          ],
                          "properties": {
                            "source_commit": {
                              "type": "string",
                              "pattern": "^[0-9a-f]{40}$"
                            },
                            "file": {
                              "type": "string",
                              "minLength": 1
                            },
                            "owner_tag": {
                              "type": "string",
                              "minLength": 1
                            },
                            "owner_label": {
                              "type": "string",
                              "minLength": 1
                            },
                            "kind": {
                              "enum": [
                                "section",
                                "lemma",
                                "proof"
                              ]
                            },
                            "ordinal": {
                              "type": "integer"
                            },
                            "matches": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "additionalProperties": false,
                                "required": [
                                  "container_byte_span",
                                  "container_hash",
                                  "command_byte_span",
                                  "command_hash"
                                ],
                                "properties": {
                                  "container_byte_span": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "required": [
                                      "start",
                                      "end"
                                    ],
                                    "properties": {
                                      "start": {
                                        "type": "integer"
                                      },
                                      "end": {
                                        "type": "integer"
                                      }
                                    }
                                  },
                                  "container_hash": {
                                    "type": "string",
                                    "pattern": "^sha256:[0-9a-f]{64}$"
                                  },
                                  "command_byte_span": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "required": [
                                      "start",
                                      "end"
                                    ],
                                    "properties": {
                                      "start": {
                                        "type": "integer"
                                      },
                                      "end": {
                                        "type": "integer"
                                      }
                                    }
                                  },
                                  "command_hash": {
                                    "type": "string",
                                    "pattern": "^sha256:[0-9a-f]{64}$"
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "source_math_skeleton_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  ]
}
