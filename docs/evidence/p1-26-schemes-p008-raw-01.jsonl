{"unit_id": "tag:01J9:statement", "translation": "设<MATH_0001>为概形（scheme）。<MATH_0002>的点（Points）与从域（fields）的谱（spectra）到<MATH_0003>的态射（morphisms）的等价类（equivalence classes）一一对应（bijectively）。此外，每个等价类（equivalence class）都包含一个最小元素（element）<MATH_0004>，它在唯一同构（isomorphism）的意义下是唯一的。\n", "allowed_english": [], "term_occurrences": [{"source_term": "scheme", "target_term": "概形"}, {"source_term": "Points", "target_term": "点"}, {"source_term": "fields", "target_term": "域"}, {"source_term": "spectra", "target_term": "谱"}, {"source_term": "morphisms", "target_term": "态射"}, {"source_term": "equivalence classes", "target_term": "等价类"}, {"source_term": "bijectively", "target_term": "一一对应"}, {"source_term": "equivalence class", "target_term": "等价类"}, {"source_term": "element", "target_term": "元素"}, {"source_term": "isomorphism", "target_term": "同构"}], "unknown_terms": [{"source_term": "scheme", "target_term": "概形", "context": "引理中给定的几何对象"}, {"source_term": "Points", "target_term": "点", "context": "参与一一对应的概形的点"}, {"source_term": "fields", "target_term": "域", "context": "取其谱作为态射的源"}, {"source_term": "spectra", "target_term": "谱", "context": "参与等价关系的态射的源"}, {"source_term": "morphisms", "target_term": "态射", "context": "划分为等价类的对象"}, {"source_term": "equivalence classes", "target_term": "等价类", "context": "与概形的点一一对应的类"}, {"source_term": "bijectively", "target_term": "一一对应", "context": "描述概形的点与这些类之间的对应"}, {"source_term": "equivalence class", "target_term": "等价类", "context": "含有最小元素的每个类"}, {"source_term": "element", "target_term": "元素", "context": "该等价类中的最小成员"}, {"source_term": "isomorphism", "target_term": "同构", "context": "限定最小元素的唯一性"}], "notes": []}
