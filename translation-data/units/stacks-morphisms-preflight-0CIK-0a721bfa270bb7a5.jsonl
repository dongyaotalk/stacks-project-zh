{"chapter": "stacks-morphisms", "node_kind": "lemma", "parent_tag": "0CIK", "placeholders": {"ACCENT_0001": "\\'e", "ACCENT_0002": "\\'e"}, "render": {"prefix": "\\begin{lemma}\n\\label{lemma-base-change-etale}\n", "suffix": "\\end{lemma}"}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:244c052a273345803ac693dd54bbfc939327f7b473995165af998aa7b2b8e8ce", "source_text": "A base change of an <ACCENT_0001>tale morphism is <ACCENT_0002>tale.\n", "source_text_hash": "sha256:cf39fdc64582711c195f92365d59acdebd0a07cb3392d96819d9af97b2ccad75", "unit_id": "tag:0CIN:statement"}
