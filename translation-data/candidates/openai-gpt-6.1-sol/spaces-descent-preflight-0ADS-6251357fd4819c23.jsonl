": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:cfa8fbe66f95e78083778d23c0df9f87a4cde06a49b49d0834f1fc693f890643", "source_text": "<STRUCT_0001>\nThis section is the analogue of Descent, Section\n<REF_0001>.\nIt is slightly different as algebraic spaces are already sheaves.", "source_text_hash": "sha256:2ba4f894c5a3494f4367c8c927c3ad4399538f13ee8eaea7aaf9d480a19efe75", "unit_id": "inventory:spaces-descent:0ADS:paragraph/0001"}}}, {"context_id": "locked-English-neighbor:spaces-descent:inventory:spaces-descent:0ADT:proof/0001", "hash": "sha256:4d5580d6665acfcfe5a71ec1e27b3ea3bad06fe5c77e2eafdec2070b2008a82e", "value": {"kind": "locked-English-neighbor", "location": {"byte_end": 134723, "byte_start": 133263, "file": "spaces-descent.tex", "fragment_hash": "sha256:ddcb467940a84361291e8c6115811320bacdcf57dcc98c2208db73fe59b06cac", "line_end": 3664, "line_start": 3620}, "owner_tag": "0ADT", "parent_tag": "0ADS", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "spaces-descent", "node_kind": "proof", "parent_tag": "0ADS", "placeholders": {"MATH_0001": "$F \\to X$", "MATH_0002": "$(\\Sch/S)_{fppf}$", "MATH_0003": "$V_i = X_i \\times_X F$", "MATH_0004": "$V_i \\to X_i$", "MATH_0005": "$V_i \\times_X X_j$", "MATH_0006": "$X_i \\times_X V_j$", "MATH_0007": "$X_i \\times_X F \\times_X X_j$", "MATH_0008": "$$\n\\varphi_{ii'} : V_i \\times_X X_j \\to X_i \\times_X V_j\n$$", "MATH_0009": "$\\varphi_{ij}$", "MATH_0010": "$X_i \\times_X X_j$", "MATH_0011": "$F \\mapsto (V_i, \\varphi_{ij})$", "MATH_0012": "$\\varphi_{ij}$", "MATH_0013": "$$\n\\varphi_{ij} : V_i \\times_X X_j \\longrightarrow X_i \\times_X V_j\n$$", "MATH_0014": "$X_i \\times X_j$", "MATH_0015": "$F$", "MATH_0016": "$$\n\\xymatrix{\n\\coprod_{i, i'} V_i \\times_X X_j\n\\ar@<1ex>[rr]^-{\\text{pr}_0}\n\\ar@<-1ex>[rr]_-{\\text{pr}_1 \\circ \\varphi_{ij}}\n& &\n\\coprod_i V_i \\ar[r]\n&\nF\n}\n$$", "MATH_0017": "$F$", "MATH_0018": "$F \\to X$", "MATH_0019": "$X_i \\times_X F$", "MATH_0020": "$V_i$", "MATH_0021": "$(V_i, \\varphi_{ij}) \\mapsto F$", "STRUCT_0001": "\\begin{proof}", "STRUCT_0002": "\\medskip", "STRUCT_0003": "\\noindent", "STRUCT_0004": "\\medskip", "STRUCT_0005": "\\noindent", "STRUCT_0006": "\\end{proof}"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:39b791ea19f0a268c3379b5d50987e2e0f220af1af7c117350e08fe123999c10", "source_status": "CURRENT", "source_structure_hash": "sha256:146a7e995b6d8b74a94f01ab8567c37fc27db09969c02dcd25b9725c8d85cb3a", "source_text": "<STRUCT_0001>\nLet us construct the functor from right to left.\nLet <MATH_0001> be a map of sheaves on <MATH_0002> such that each\n<MATH_0003> is an algebraic space. We have the\nprojection <MATH_0004>.\nThen both <MATH_0005> and <MATH_0006>\nrepresent the sheaf <MATH_0007>\nand hence we obtain an isomorphism\n<MATH_0008>\nIt is straightforward to see that the maps <MATH_0009>\nare morphisms over <MATH_0010> and satisfy the\ncocycle condition. The functor from right to left is given\nby this construction <MATH_0011>.\n\n<STRUCT_0002><STRUCT_0003>\nLet us construct a functor from left to right.\nThe isomorphisms <MATH_0012> give isomorphisms\n<MATH_0013>\nover <MATH_0014>. Set <MATH_0015> equal to the coequalizer in the\nfollowing diagram\n<MATH_0016>\nThe cocycle condition guarantees that <MATH_0017> comes with a map\n<MATH_0018> and that <MATH_0019> is isomorphic to <MATH_0020>.\nThe functor from left to right is given\nby this construction <MATH_0021>.\n\n<STRUCT_0004><STRUCT_0005>\nWe omit the verification that these constructions\nare mutually quasi-inverse functors. The final statements\n(1) and (2) follow from the constructions.\n<STRUCT_0006>", "source_text_hash": "sha256:c06c59044791005cd1c79c70d1b7eca0ccd65c2cccb1074f3096fb337bf2cf00", "unit_id": "inventory:spaces-descent:0ADT:proof/0001"}}}, {"context_id": "locked-English-reference:bootstrap:inventory:bootstrap:0ADV:lemma/0001:bootstrap-lemma-descend-algebraic-space", "hash": "sha256:f375b483c768f99084baca8e6f1920bb61e177099f18033c2bbd3995b9c76d45", "value": {"kind": "locked-English-reference", "location": {"byte_end": 67287, "byte_start": 66366, "file": "bootstrap.tex", "fragment_hash": "sha256:e399498ee99af53e31b82ba9b383d970915ee2e0d677663a6d3f26cecc16e7c6", "line_end": 1797, "line_start": 1777}, "owner_tag": "0ADV", "parent_tag": "04SJ", "requested_label": "bootstrap-lemma-descend-algebraic-space", "requested_tag": "0ADV", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "bootstrap", "node_kind": "lemma", "parent_tag": "04SJ", "placeholders": {"FOOTNOTECLOSE_0001": "}", "FOOTNOTEOPEN_0001": "\\footnote{", "LOCKED_0001": "\\label{lemma-descend-algebraic-space}", "LOCKED_0002": "\\begin{slogan}\nFppf descent data for algebraic spaces are effective.\n\\end{slogan}", "MATH_0001": "$S$", "MATH_0002": "$\\{X_i \\to X\\}_{i \\in I}$", "MATH_0003": "$S$", "MATH_0004": "$I$", "MATH_0005": "$\\{X_i \\to X\\}$", "MATH_0006": "$(Y_i, \\varphi_{ij})$", "MATH_0007": "$\\{X_i \\to X\\}_{i \\in I}$", "MATH_0008": "$Y_i \\to X_i$", "REF_0001": "\\ref{lemma-locally-algebraic-space-finite-type}", "REF_0002": "\\ref{spaces-descent-definition-descent-datum-for-family-of-morphisms}", "STRUCT_0001": "\\begin{lemma}", "STRUCT_0002": "\\begin{enumerate}", "STRUCT_0003": "\\item", "STRUCT_0004": "\\item", "STRUCT_0005": "\\end{enumerate}", "STRUCT_0006": "\\end{lemma}"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:154b5bc79a8d6a8e5fd2e660a64fd19443c0b00c843e8317ee576d1d1516ff35", "source_status": "CURRENT", "source_structure_hash": "sha256:37c4d3a65f0f918b30369ef0827f9addeadba1e5b801df96ddfcd7556697a6fd", "source_text": "<STRUCT_0001>\n<LOCKED_0001>\n<LOCKED_0002>\nLet <MATH_0001> be a scheme. Let <MATH_0002> be an fppf\ncovering of algebraic spaces over <MATH_0003>.\n<STRUCT_0002>\n<STRUCT_0003> If <MATH_0004> is countable<FOOTNOTEOPEN_0001>The restriction on countablility can be\nignored by those who do not care about set theoretical issues. We can allow\nlarger index sets here if we can bound the size of the algebraic spaces\nwhich we are descending. See for example\nLemma <REF_0001>.<FOOTNOTECLOSE_0001>, then any\ndescent datum for algebraic spaces relative to <MATH_0005> is effective.\n<STRUCT_0004> Any descent datum <MATH_0006> relative to\n<MATH_0007> (Descent on Spaces, Definition\n<REF_0002>)\nwith <MATH_0008> of finite type\nis effective.\n<STRUCT_0005>\n<STRUCT_0006>", "source_text_hash": "sha256:ceeadda63b0d7b406c7cd12faa8d64e86a244a2b1562651f99ac2cbbf7062c66", "unit_id": "inventory:bootstrap:0ADV:lemma/0001"}}}, {"context_id": "locked-English-reference:spaces-topologies:inventory:spaces-topologies:03Y8:definition/0001:spaces-topologies-definition-fppf-covering", "hash": "sha256:6508787752dc513c008c4eadd9f8d2262e94a2071e5f846ed507a6a9cbb9a91a", "value": {"kind": "locked-English-reference", "location": {"byte_end": 25880, "byte_start": 25456, "file": "spaces-topologies.tex", "fragment_hash": "sha256:cab7289736d8e03e3cf9902e785e3572da4faa2b5abcacdcb5ff32c13083a676", "line_end": 772, "line_start": 761}, "owner_tag": "03Y8", "parent_tag": "03Y7", "requested_label": "spaces-topologies-definition-fppf-covering", "requested_tag": "03Y8", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "spaces-topologies", "node_kind": "definition", "parent_tag": "03Y7", "placeholders": {"LOCKED_0001": "\\label{definition-fppf-covering}", "MATH_0001": "$S$", "MATH_0002": "$X$", "MATH_0003": "$S$", "MATH_0004": "$X$", "MATH_0005": "$\\{f_i : X_i \\to X\\}_{i \\in I}$", "MATH_0006": "$S$", "MATH_0007": "$f_i$", "MATH_0008": "$$\n|X| = \\bigcup\\nolimits_{i \\in I} |f_i|(|X_i|),\n$$", "STRUCT_0001": "\\begin{definition}", "STRUCT_0002": "\\end{definition}", "TEXTITCLOSE_0001": "}", "TEXTITOPEN_0001": "{\\it "}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:e76fae56c3226e3151fabee0092a70b466b5acf08f6f31c1ff32db92d85286f7", "source_status": "CURRENT", "source_structure_hash": "sha256:4e564d9abf74c2f19e58dc284e32e60e3599e14745e47ca2c171b41dc84c5c5b", "source_text": "<STRUCT_0001>\n<LOCKED_0001>\nLet <MATH_0001> be a scheme, and let <MATH_0002> be an algebraic space over <MATH_0003>.\nAn <TEXTITOPEN_0001>fppf covering of <MATH_0004><TEXTITCLOSE_0001> is a family of morphisms\n<MATH_0005> of algebraic spaces over <MATH_0006>\nsuch that each <MATH_0007> is flat and locally of finite presentation\nand such that\n<MATH_0008>\ni.e., the morphisms are jointly surjective.\n<STRUCT_0002>", "source_text_hash": "sha256:8bc6d8395fa0ce4806a9c3bfdd5a9449985ef99257bd1f9a32ea4c910a82157e", "unit_id": "inventory:spaces-topologies:03Y8:definition/0001"}}}], "input_freeze": {"hash": "sha256:77ceccc4b11dd452d25f6cfc6dfeb9018768495a5962f3ecc6402aa8106c06b7", "path": "translation-data/source-adoption-inputs/spaces-descent74-gpt61sol-p014-20261113-policy968.json"}, "model_output": {"hash": "sha256:b7e201f8c5e6aa9fa8b581d06e7db6f2381d98e25a95e78a3e792c1d14f71d4d", "path": "docs/evidence/spaces-descent74-gpt61sol-p014-20261113-policy968-raw-01.jsonl", "record_hash": "sha256:3aa8d7e0857bd94cc3bc3ffe20f51371436393ce95b12bb5f3bdf7b75681e3a6"}, "neighbor_unit_ids": [], "policy_revision": "git:8cd9dc4c752b346f3a9e549def3a59528230be5c", "prior_generations": [], "prompt_version": "translator-v2", "source_adoption_id": "spaces-descent74-gpt61sol-p014-20261113-policy968", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "style_guide_path": "config/style-guide.md", "turn_id": "01a1d3c1-9df9-7d62-bade-4ed2b1eac1bf", "unit_id": "tag:0ADT:statement"}, "context_hash": "sha256:1550e8ccc7f06baf15c5e77ca6deaf81a53477a29d56790018d7453543d16ba3", "created_at": "2026-11-13T08:39:42.991719+00:00", "glossary_revision": "git:8cd9dc4c752b346f3a9e549def3a59528230be5c", "harness_id": "codex", "harness_version": "0.167.2", "model_id": "gpt-6.1-sol", "model_identity_confidence": "declared", "model_lane": "openai-gpt-6.1-sol", "model_record_id": "openai:gpt-6.1-sol:declared", "model_snapshot": null, "notes": [], "prompt_version": "translator-v2", "publication_status": "CANDIDATE", "qa_status": "PASS", "reasoning_effort": "high", "run_id": "run-spaces-descent74-gpt61sol-p014-20261113-policy968", "schema_version": 2, "source_adoption_id": "spaces-descent74-gpt61sol-p014-20261113-policy968", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_status": "CURRENT", "source_text_hash": "sha256:c434e4e512172d1b917239cecd66be6c7bfdf26d259bf3ad243fc1ff04ad144f", "stage": "STRUCTURE_OK", "term_occurrences": [{"source_term": "scheme", "target_term": "概形"}, {"source_term": "algebraic spaces", "target_term": "代数空间"}, {"source_term": "fppf covering", "target_term": "fppf 覆盖"}, {"source_term": "Topologies", "target_term": "拓扑"}, {"source_term": "equivalence of categories", "target_term": "范畴等价"}, {"source_term": "descent", "target_term": "下降"}, {"source_term": "sheaves", "target_term": "层"}, {"source_term": "map", "target_term": "映射"}, {"source_term": "algebraic space", "target_term": "代数空间"}, {"source_term": "algebraic space", "target_term": "代数空间"}, {"source_term": "sheaf", "target_term": "层"}, {"source_term": "algebraic space", "target_term": "代数空间"}, {"source_term": "large", "target_term": "大"}, {"source_term": "descent", "target_term": "下降"}, {"source_term": "effective", "target_term": "有效"}], "term_status": "DECISION_REQUIRED", "translation": "设<MATH_0001>是一个概形（scheme）。设<MATH_0002>是<MATH_0003>上的代数空间（algebraic spaces）的 fppf 覆盖（fppf covering）（《空间上的拓扑（Topologies）》，定义<REF_0001>）。\n有一个范畴等价（equivalence of categories）\n<MATHSEG_0001>下降（descent）数据<MATHSEG_0002>相对于<MATHSEG_0003>层（sheaves）<MATHSEG_0004>位于<MATHSEG_0005>上，并配备<MATHSEG_0006>一个映射（map）<MATHSEG_0007>，使得每个<MATHSEG_0008>是一个代数空间（algebraic space）<MATHSEG_0009>\n此外，\n<STRUCT_0001>\n<STRUCT_0002>右边的代数空间（algebraic space）<MATH_0004>对应于左边的<MATH_0005>，并且\n<STRUCT_0003>层（sheaf）<MATH_0006>是一个代数空间（algebraic space）<FOOTNOTEOPEN_0001>我们稍后将看到，若<MATH_0007>不太大（large），则总是如此，见 Bootstrap，引理<REF_0002>。<FOOTNOTECLOSE_0001>当且仅当相应的下降（descent）数据<MATH_0008>是有效（effective）的。\n<STRUCT_0004>\n", "translation_hash": "sha256:a0ca57c73643bffcd93d12acefddbe642c94cc8d28d42590bed6475cc1dea84b", "unit_id": "tag:0ADT:statement", "unknown_terms": [{"context": "基概形。", "source_term": "scheme", "target_term": "概形"}, {"context": "fppf覆盖的空间。", "source_term": "algebraic spaces", "target_term": "代数空间"}, {"context": "进行下降的覆盖。", "source_term": "fppf covering", "target_term": "fppf 覆盖"}, {"context": "引用空间上的拓扑章。", "source_term": "Topologies", "target_term": "拓扑"}, {"context": "下降数据与层的等价。", "source_term": "equivalence of categories", "target_term": "范畴等价"}, {"context": "下降数据。", "source_term": "descent", "target_term": "下降"}, {"context": "配备到目标的映射的层。", "source_term": "sheaves", "target_term": "层"}, {"context": "层到目标的映射。", "source_term": "map", "target_term": "映射"}, {"context": "层的表示性质。", "source_term": "algebraic space", "target_term": "代数空间"}, {"context": "下降数据对应的层。", "source_term": "sheaf", "target_term": "层"}, {"context": "索引集合的大小。", "source_term": "large", "target_term": "大"}, {"context": "下降数据的有效性。", "source_term": "effective", "target_term": "有效"}]}
