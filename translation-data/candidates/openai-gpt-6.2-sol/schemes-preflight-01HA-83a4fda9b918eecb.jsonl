_0001": "\\noindent"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R1", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:63f8e46357a3c1a5b0abb11f3dfd52d6782e141da3906735245384a0f9cfbdc7", "source_text": "<STRUCT_0001>\nIn this document we define schemes.\nA basic reference is <REF_0001>.", "source_text_hash": "sha256:056e1e04b7ded9bc557147dd609283dfc419bfc79a2094c8bbee7b376f74b444", "unit_id": "inventory:schemes:01H9:paragraph/0001"}}}, {"context_id": "sha256:4f80d2b21515ced6a0b134b8441cbe5c65d24c92fac80a165948e06d10df3bbc", "hash": "sha256:4f80d2b21515ced6a0b134b8441cbe5c65d24c92fac80a165948e06d10df3bbc", "value": {"kind": "locked-English-neighbor", "location": {"byte_end": 196, "byte_start": 145, "file": "schemes.tex", "fragment_hash": "sha256:818b11324e818fe49df54475c6acdad873cdb21ec9d6e3fdc16fee24d3904974", "line_end": 18, "line_start": 17}, "owner_tag": "01H9", "parent_tag": "01H9", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "schemes", "node_kind": "section_title", "parent_tag": "01H9", "placeholders": {"LOCKED_0001": "\\label{section-introduction}", "TEXTCLOSE_0001": "}", "TEXTOPEN_0001": "\\section{"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R1", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:a4a83d910265c2510bdf235f37f65c43032eb26ea64831314842567af87f9af6", "source_text": "<TEXTOPEN_0001>Introduction<TEXTCLOSE_0001>\n<LOCKED_0001>", "source_text_hash": "sha256:358b48665c395d8bf84033167442fa9f0a726bdcbe11c206a6666a1f33ed1718", "unit_id": "inventory:schemes:01H9:section_title/0001"}}}, {"context_id": "sha256:f6e4da13a