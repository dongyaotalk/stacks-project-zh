hash": "sha256:8041478908b37ecdcc8c1acf80b37d1345e89e805fe57c2b0b91848bf891ec05", "source_label": "etale-section-unramified-definition", "usage": "root-phrase", "usage_source": {"after": "g", "before": ")", "environments": []}}, "command": "text", "policy_entry": "etale-local-unramified-at", "slot_byte_span": {"end": 98, "start": 80}, "slot_id": "math/0001/text/0002", "source": " is unramified at "}], "source": "$$\nG \\to \\Spec(k)\\text{ is unramified at }e\n\\Leftrightarrow\nG \\to \\Spec(k)\\text{ is unramified at }g\n$$", "source_byte_span": {"end": 684, "start": 581}, "source_hash": "sha256:f404e2e963c60f168a0a0589171e0961bce68c3df5c91cac360cf9effbf92922"}], "node_kind": "proof", "parent_tag": "06P5", "placeholders": {"MATHSEG_0001": "$$\nG \\to \\Spec(k)\\text{", "MATHSEG_0002": "}e\n\\Leftrightarrow\nG \\to \\Spec(k)\\text{", "MATHSEG_0003": "}g\n$$", "MATH_0001": "$U \\subset G$", "MATH_0002": "$U \\to B$", "MATH_0003": "$U$", "MATH_0004": "$B = \\Spec(k)$", "MATH_0005": "$g \\in G(K)$", "MATH_0006": "$K/k$", "MATH_0007": "$g$", "MATH_0008": "$U$", "MATH_0009": "$K$", "MATH_0010": "$k$", "MATH_0011": "$g$", "MATH_0012": "$g$", "MATH_0013": "$e$", "MATH_0014": "$g$", "MATH_0015": "$G$", "MATH_0016": "$k$", "REF_0001": "\\ref{spaces-morphisms-lemma-where-unramified}", "REF_0002": "\\ref{spaces-morphisms-lemma-base-change-quasi-finite-locus}", "SPACE_0001": "\\ ", "SPACE_0002": "\\ ", "SPACE_0003": "\\ "}, "render": {"prefix": "\\begin{proof}\n", "suffix": "\\end{proof}"}, "risk_level": "R3", "schema_version": 2, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:d2bad85b2295b5704181025a4247b3e25eea6573935885c433a4d9ba9cc2cd94", "source_math_skeleton_hash": "sha256:6d6c4597f22d0e51904dd308dc81e37fda2204c0a376fd8db05112785b280333", "source_status": "CURRENT", "source_structure_hash": "sha256:f6fcc26206f7d28844207d515d12b137781c131eed4982e1b3815e0ee603d030", "source_text": "By Morphisms of Spaces, Lemma <REF_0001>\n(resp.<SPACE_0001>Morphisms of Spaces, Lemma\n<REF_0002>)\nthere is a maximal open subspace <MATH_0001> such that <MATH_0002> is\nunramified (resp.<SPACE_0002>locally quasi-finite) and formation of <MATH_0003>\ncommutes with base change. Thus we reduce to the case where\n<MATH_0004> is the spectrum of a field.\nLet <MATH_0005> be a point with values in an extension <MATH_0006>.\nThen to check whether or not <MATH_0007> is in <MATH_0008>, we may base\nchange to <MATH_0009>. Hence it suffices to show\n<MATHSEG_0001> is unramified at <MATHSEG_0002> is unramified at <MATHSEG_0003>\nfor a <MATH_0010>-rational point <MATH_0011> (resp.<SPACE_0003>similarly for\nquasi-finite at <MATH_0012> and <MATH_0013>). Since translation by <MATH_0014>\nis an automorphism of <MATH_0015> over <MATH_0016> this is clear.\n", "source_text_hash": "sha256:26c81004a0697f43b034832d8ec74bec56a3633b08c8aec12e66e1c3fcf59fc4", "unit_id": "tag:0DSI:proof"}
{"chapter": "spaces-groupoids", "node_kind": "lemma", "parent_tag": "06P5", "placeholders": {"MATH_0001": "$S$", "MATH_0002": "$B$", "MATH_0003": "$S$", "MATH_0004": "$G$", "MATH_0005": "$B$", "MATH_0006": "$G \\to B$", "MATH_0007": "$U \\subset B$", "MATH_0008": "$G_U \\to U$", "MATH_0009": "$U$", "MATH_0010": "$U \\subset B$", "MATH_0011": "$G_U \\to U$", "MATH_0012": "$U$", "STRUCT_0001": "\\begin{enumerate}", "STRUCT_0002": "\\item", "STRUCT_0003": "\\item", "STRUCT_0004": "\\end{enumerate}"}, "render": {"prefix": "\\begin{lemma}\n\\label{lemma-open-over-which-unramified-or-lqf}\n", "suffix": "\\end{lemma}"}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:4cf94568da104dab123e68fc91406572dfbc0cbe8020b0f7c8c39bee465c6a9a", "source_status": "CURRENT", "source_structure_hash": "sha256:81953b86886ab15e36630dbe26da0140780aa40d63ed67338724d3aa359aa5f2", "source_text": "Let <MATH_0001> be a scheme. Let <MATH_0002> be an algebraic space over <MATH_0003>.\nLet <MATH_0004> be a group algebraic space over <MATH_0005>. Assume <MATH_0006>\nis locally of finite type.\n<STRUCT_0001>\n<STRUCT_0002> There exists a maximal open subspace <MATH_0007>\nsuch that <MATH_0008> is unramified and formation of <MATH_0009>\ncommutes with base change.\n<STRUCT_0003> There exists a maximal open subspace <MATH_0010>\nsuch that <MATH_0011> is locally quasi-finite and formation of <MATH_0012>\ncommutes with base change.\n<STRUCT_0004>\n", "source_text_hash": "sha256:6d2614576852bed502c5602ac8a7a67462d0c016c21323f1521b83e39dc01b49", "unit_id": "tag:0DSJ:statement"}
