, "suffix": ""}, "risk_level": "R1", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:27ce5d6fd07b29bb3e80fe9ac4b07ca2bd187fe1550cca2940e36d4e845e3697", "source_status": "CURRENT", "source_structure_hash": "sha256:ed65c8a20e9e3e88bd4df802f83d35e040e1cf23d859e8447ad2c31cf6449d36", "source_text": "<STRUCT_0001>\nGiven a morphism of germs of schemes <MATH_0001>\nwe can define the <TEXTITOPEN_0001>fibre<TEXTITCLOSE_0001> as the isomorphism class of germs\n<MATH_0002> where <MATH_0003> is any representative. We will often abuse notation\nand just write <MATH_0004>.", "source_text_hash": "sha256:181fd8079f7d45fadbc7b09520338b7758b63a3df46daa1653247ad3e7f965e2", "unit_id": "inventory:descent:04R5:paragraph/0003"}}}, {"context_id": "neighbor:inventory:descent:04NJ:lemma/0001", "hash": "sha256:5e94ef533c97466d210f0c86efec684d2b48d5de13d3fb7cc737b10bcacd043c", "value": {"kind": "locked-English-neighbor", "location": {"byte_end": 303730, "byte_start": 303423, "file": "descent.tex", "fragment_hash": "sha256:e7da6ae74d22ecc9f316d64a856441e1139693a1f8e1982783102ec718e610de", "line_end": 8011, "line_start": 8000}, "owner_tag": "04NJ", "parent_tag": "04R5", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "descent", "math_text_regions": [{"delimiter_kind": "display-dollar", "pieces": [{"kind": "locked", "placeholder": "MATHSEG_0001"}, {"kind": "text", "slot_id": "math/0001/text/0001"}, {"kind": "locked", "placeholder": "MATHSEG_0002"}, {"kind": "text", "slot_id": "math/0001/text/0002"}, {"kind": "locked", "placeholder": "MATHSEG_0003"}], "region_id": "math/0001", "slots": [{"boundary_placeholders": ["MATHSEG_0001", "MATHSEG_0002"], "classification_witness": {"anchor": {"file": "descent.tex", "kind": "lemma", "matches": [{"command_byte_span": {"end": 303614, "start": 303592}, "command_hash": "sha256:deaa9a76f221d3ddadc9461dfdaf8d739f7cfb7a0a55b58c295b25c838ec851b", "container_byte_spa