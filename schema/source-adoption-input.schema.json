{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stacks-project-zh.invalid/schema/source-adoption-input.schema.json",
  "title": "Complete first-source generation input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool_version",
    "adoption_id",
    "origin_commit",
    "source_commit",
    "task_id",
    "created_at",
    "runtime",
    "policies",
    "contexts",
    "batches",
    "outside_preferred_reason",
    "unit_ids",
    "chapter",
    "parent_tags",
    "run_id",
    "task"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "tool_version": {
      "enum": [
        "source-adoption-input-v1",
        "source-adoption-input-v2",
        "source-adoption-input-v3"
      ]
    },
    "adoption_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "origin_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_lane",
        "model",
        "harness",
        "reasoning_effort",
        "turn_id",
        "replayable"
      ],
      "properties": {
        "model_lane": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "record_id",
            "provider",
            "requested_id",
            "resolved_id",
            "snapshot",
            "identity_confidence"
          ],
          "properties": {
            "record_id": {
              "type": "string",
              "minLength": 1
            },
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "requested_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "resolved_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "snapshot": {
              "type": [
                "string",
                "null"
              ]
            },
            "identity_confidence": {
              "enum": [
                "runtime-resolved",
                "owner-confirmed",
                "declared",
                "unknown"
              ]
            }
          }
        },
        "harness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version",
            "adapter_version"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "adapter_version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "reasoning_effort": {
          "type": "string",
          "minLength": 1
        },
        "turn_id": {
          "type": "string",
          "minLength": 1
        },
        "replayable": {
          "type": "boolean"
        }
      }
    },
    "policies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "hash"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "contexts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "context_id",
          "value",
          "hash"
        ],
        "properties": {
          "context_id": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "object"
          },
          "hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "batches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "units_path",
          "candidates_path",
          "units",
          "containers",
          "prior_attempts"
        ],
        "properties": {
          "units_path": {
            "type": "string",
            "minLength": 1
          },
          "candidates_path": {
            "type": "string",
            "minLength": 1
          },
          "units": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "containers": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "selector",
                "selected",
                "unit_ids"
              ],
              "properties": {
                "selector": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "file",
                    "owner_tag",
                    "owner_label",
                    "parent_tag",
                    "kind",
                    "ordinal"
                  ],
                  "properties": {
                    "file": {
                      "type": "string",
                      "minLength": 1
                    },
                    "owner_tag": {
                      "type": "string",
                      "minLength": 1
                    },
                    "owner_label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "parent_tag": {
                      "type": "string",
                      "minLength": 1
                    },
                    "kind": {
                      "type": "string",
                      "minLength": 1
                    },
                    "ordinal": {
                      "type": "integer"
                    }
                  }
                },
                "selected": {
                  "type": "object"
                },
                "unit_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "prior_attempts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "units",
                "candidates",
                "runs",
                "generation_inputs",
                "raw_outputs"
              ],
              "properties": {
                "units": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "hash"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "hash": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    }
                  }
                },
                "candidates": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "hash"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "hash": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    }
                  }
                },
                "runs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "path",
                      "hash"
                    ],
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "hash": {
                        "type": "string",
                        "pattern": "^sha256:[0-9a-f]{64}$"
                      }
                    }
                  }
                },
                "generation_inputs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "path",
                      "hash"
                    ],
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "hash": {
                        "type": "string",
                        "pattern": "^sha256:[0-9a-f]{64}$"
                      }
                    }
                  }
                },
                "raw_outputs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "path",
                      "hash"
                    ],
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "hash": {
                        "type": "string",
                        "pattern": "^sha256:[0-9a-f]{64}$"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "outside_preferred_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "unit_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "chapter": {
      "type": "string",
      "minLength": 1
    },
    "parent_tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue",
        "owner",
        "branch",
        "scope_manifest",
        "scope_manifest_sha256",
        "scope_bytes"
      ],
      "properties": {
        "issue": {
          "type": "integer"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "scope_manifest": {
          "type": "string",
          "pattern": "^task-scopes/[A-Za-z0-9][A-Za-z0-9._-]*\\.json$"
        },
        "scope_manifest_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "scope_bytes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "prior_adoptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record",
          "outputs"
        ],
        "properties": {
          "record": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "hash"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "hash": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "units",
                "candidates"
              ],
              "properties": {
                "units": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "hash"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "hash": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    }
                  }
                },
                "candidates": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "hash"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "hash": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "shared_run_histories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record",
          "outputs"
        ],
        "properties": {
          "record": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "hash"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "hash": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "units",
                "candidates"
              ],
              "properties": {
                "units": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "hash"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "hash": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    }
                  }
                },
                "candidates": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "hash"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "hash": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "tool_version": {
          "const": "source-adoption-input-v1"
        },
        "prior_adoptions": {
          "type": "null"
        },
        "shared_run_histories": {
          "type": "null"
        }
      }
    },
    {
      "properties": {
        "tool_version": {
          "const": "source-adoption-input-v2"
        },
        "shared_run_histories": {
          "type": "null"
        }
      },
      "required": [
        "prior_adoptions"
      ]
    },
    {
      "properties": {
        "tool_version": {
          "const": "source-adoption-input-v3"
        },
        "prior_adoptions": {
          "type": "null"
        }
      },
      "required": [
        "shared_run_histories"
      ]
    }
  ]
}
