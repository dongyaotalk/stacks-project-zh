\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{styles/reference-template-compat}[2026/08/24 Full imported template compatibility]

% Packages present in the authoritative reference entry point. They remain
% separate from the Stacks adapter so translated chapters inherit the full
% mathematical and layout surface of the original template.
\RequirePackage{siunitx}
\RequirePackage{physics}
\RequirePackage{romannum}
\RequirePackage{nicematrix}

% The reference called its bold-symbol helper \matrix, which overwrites the
% standard matrix environment. Keep the feature under the safe name \mat.
\providecommand{\mat}[1]{\boldsymbol{#1}}
\providecommand{\diag}[1]{\mathrm{diag}\qty{#1}}
\providecommand{\closure}[2][3]{{}\mkern#1mu\overline{\mkern-#1mu#2}}
\providecommand{\seg}[2]{\qty[#1,#2]}
\providecommand{\segl}[2]{\left(#1,#2\right]}
\providecommand{\segr}[2]{\left[#1,#2\right)}
\providecommand{\seglr}[2]{\qty(#1,#2)}

\endinput
