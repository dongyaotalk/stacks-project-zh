bset", "target_term": "闭子集", "context": "其补集满足所述充分条件"}, {"source_term": "retrocompact", "target_term": "逆紧", "context": "闭子集的补集所须满足的性质"}, {"source_term": "complement", "target_term": "补集", "context": "所述充分条件限制的集合"}], "notes": []}
