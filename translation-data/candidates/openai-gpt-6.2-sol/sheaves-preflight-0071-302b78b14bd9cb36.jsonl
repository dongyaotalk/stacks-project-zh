[], "policy_revision": "git:0cd5a696ed1fb6b267587570250073149a81bf7f", "prior_generations": [], "prompt_version": "translator-v2", "source_adoption_id": "p1-06-sheaves-d001", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "style_guide_path": "config/style-guide.md", "turn_id": "01a219d6-af88-74b1-92dd-aa615d442bfa", "unit_id": "tag:0071:prose-0001"}, "context_hash": "sha256:e9b37d81e5663275b4cf25691bbacbddd98837d0d995c849e159074f9d67a1b1", "created_at": "2026-11-26T21:50:31.705Z", "glossary_revision": "git:0cd5a696ed1fb6b267587570250073149a81bf7f", "harness_id": "codex", "harness_version": "0.172.0", "model_id": "gpt-6.2-sol", "model_identity_confidence": "declared", "model_lane": "openai-gpt-6.2-sol", "model_record_id": "openai:gpt-6.2-sol:declared", "model_snapshot": null, "notes": [], "prompt_version": "translator-v2", "publication_status": "CANDIDATE", "qa_status": "PASS", "reasoning_effort": "high", "run_id": "run-p1-06-sheaves-d001", "schema_version": 2, "source_adoption_id": "p1-06-sheaves-d001", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_status": "CURRENT", "source_text_hash": "sha256:c508794019104477a42d3090a541b1d14c9509d557ca442077c9fa3eb03b1551", "stage": "STRUCTURE_OK", "term_occurrences": [{"source_term": "sheaves", "target_term": "层"}, {"source_term": "sheaf condition", "target_term": "层条件"}, {"source_term": "presheaf", "target_term": "预层"}, {"source_term": "sets", "target_term": "集合"}, {"source_term": "topological space", "target_term": "拓扑空间"}, {"source_term": "sheaf condition", "target_term": "层条件"}, {"source_term": "covering", "target_term": "覆盖"}, {"source_term": "diagram", "target_term": "图式"}, {"source_term": "map", "target_term": "映射"}, {"source_term": "maps", "target_term": "映射"}, {"source_term": "maps", "target_term": "映射"}, {"source_term": "sheaf condition", "target_term": "层条件"}, {"source_term": "equalizer", "target_term": "等化子"}, {"source_term": "presheaves", "target_term": "预层"}, {"source_term": "category", "target_term": "范畴"}, {"source_term": "category", "target_term": "范畴"}, {"source_term": "products", "target_term": "积"}], "term_status": "DECISION_REQUIRED", "translation": "\n\n<STRUCT_0001>\n我们来阐明某些类型的结构所成的层（sheaves）的定义。\n首先，我们换一种方式表述层条件（sheaf condition）。具体地说，设<MATH_0001>是一个预层（presheaf），取值为集合（sets），定义在拓扑空间（topological space）<MATH_0002>上。\n层条件（sheaf condition）可重述如下。设<MATH_0003>是一个开覆盖（covering）。考虑如下图式（diagram）\n<MATH_0004>\n这里，左侧的映射（map）由规则<MATH_0005>定义。右侧的两个映射（maps）分别是映射（maps）<MATHSEG_0001>和<MATHSEG_0002>\n层条件（sheaf condition）恰好是说，左侧的箭头是右侧两个箭头的等化子（equalizer）。这一表述可直接推广到预层（presheaves）取值于某个范畴（category）的情形，只要该范畴（category）具有积（products）。\n\n", "translation_hash": "sha256:591f5062740cdbd8f9e0d08554b508314174c4a15801acf18a2dbcbeff3a5906", "unit_id": "tag:0071:prose-0001", "unknown_terms": [{"context": "用于指某些类型的结构所成的层。", "source_term": "sheaves", "target_term": "层"}, {"context": "用于引出该条件的改述并表明它与图式中的等化子条件等价。", "source_term": "sheaf condition", "target_term": "层条件"}, {"context": "用于称呼拓扑空间上的集合值预层。", "source_term": "presheaf", "target_term": "预层"}, {"context": "用于说明预层的取值是集合。", "source_term": "sets", "target_term": "集合"}, {"context": "用于指定预层所定义的空间。", "source_term": "topological space", "target_term": "拓扑空间"}, {"context": "用于开覆盖，其中「开」对应原文的 open。", "source_term": "covering", "target_term": "覆盖"}, {"context": "用于指示以若干映射构成的范畴论图式。", "source_term": "diagram", "target_term": "图式"}, {"context": "用于称呼由给定规则定义的左侧映射。", "source_term": "map", "target_term": "映射"}, {"context": "用于称呼右侧的两个映射及对这两个映射的列举。", "source_term": "maps", "target_term": "映射"}, {"context": "用于描述左侧箭头与右侧一对箭头的范畴论关系。", "source_term": "equalizer", "target_term": "等化子"}, {"context": "用于将所述表述推广到范畴值预层。", "source_term": "presheaves", "target_term": "预层"}, {"context": "用于指定预层的取值范畴，并对该范畴提出条件。", "source_term": "category", "target_term": "范畴"}, {"context": "用于给出取值范畴须具备的范畴论构造。", "source_term": "products", "target_term": "积"}]}
