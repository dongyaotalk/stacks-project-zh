{"chapter": "categories", "node_kind": "example", "parent_tag": "003A", "placeholders": {}, "render": {"prefix": "\\begin{example}\n\\label{example-mono-epi-sets}\n", "suffix": "\\end{example}"}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:f568706029a51c57f93240d50696a9a02c3358a9994960b9f346d0186a119f96", "source_text": "In the category of sets the monomorphisms correspond to injective\nmaps and the epimorphisms correspond to surjective maps.\n", "source_text_hash": "sha256:166a08176a53e733de66204ba60e533ceb4a07c02758ada029a21625a1252c7a", "unit_id": "tag:003C:statement"}
