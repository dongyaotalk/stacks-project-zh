suffix": ""}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:4a8ca80e107b709347a4fdb26823e951c539327ac9d6517cdda64284190f2f60", "source_status": "CURRENT", "source_structure_hash": "sha256:9171e4d46bb2b394aa117dc2d431dbf2fd1a50fab63977b6b57b4d5bb593536d", "source_text": "<STRUCT_0001>\n<LOCKED_0001>\nLet <MATH_0001> be a locally Noetherian scheme. Let\n<MATH_0002> be a category fibred in groupoids.\n<STRUCT_0002>\n<STRUCT_0003> A <TEXTITOPEN_0001>formal object<TEXTITCLOSE_0001> <MATH_0003> of <MATH_0004> consists\nof a Noetherian complete local <MATH_0005>-algebra <MATH_0006>, objects <MATH_0007> of\n<MATH_0008> lying over <MATH_0009>, and morphisms\n<MATH_0010> of <MATH_0011> lying over\n<MATH_0012>\nsuch that <MATH_0013> is a field of finite type over <MATH_0014>.\n<STRUCT_0004> A <TEXTITOPEN_0002>morphism of formal objects<TEXTITCLOSE_0002>\n<MATH_0015>\nis given by morphisms <MATH_0016> such that for every <MATH_0017>\nthe diagram\n<MATH_0018>\nis commutative. Applying the functor <MATH_0019> we obtain a compatible collection\nof morphisms <MATH_0020> and\nhence a morphism <MATH_0021> over <MATH_0022>. We say that\n<MATH_0023> <TEXTITOPEN_0003>lies over<TEXTITCLOSE_0003> <MATH_0024>.\n<STRUCT_0005>\n<STRUCT_0006>", "source_text_hash": "sha256:52610f8b2256aea66813ff28b819bc619c062725bc62cdd03acb38fbf98690eb", "unit_id": "inventory:artin:07X4:definition/0001"}}}], "input_freeze": {"hash": "sha256:d2af9f6c51b2e05ea25ffd73e0d160a946d5b7c8a566e60ed7d2edf6154e2851", "path": "translation-data/source-adoption-inputs/p0-98-artin-p031.json"}, "model_output": {"hash": "sha256:14f42411ca62d302ca2e6577d911055a751af88a8c5dd328698208775c4b24cb", "path": "docs/evidence/p0-98-artin-p031-raw-01.jsonl", "record_hash": "sha256:deba10fc8504cf2903c35b72cd2810d1a74c2ce570106f5bfeceecec461b1079"}, "neighbor_unit_ids": [], "policy_revision": "git:c4895b2b9bf3fca2cca824ee70162f0c2033d93d", "prior_generatio