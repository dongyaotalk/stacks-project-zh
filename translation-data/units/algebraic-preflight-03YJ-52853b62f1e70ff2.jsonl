{"chapter": "algebraic", "node_kind": "section_title", "parent_tag": "03YJ", "placeholders": {}, "render": {"prefix": "\\section{", "suffix": "}\n\\label{section-representable-properties}"}, "risk_level": "R1", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:46410ab28d882cce74dd0d818e74501d228cb81508e0cf2086b8f03a21d79f24", "source_text": "Properties of morphisms representable by algebraic spaces", "source_text_hash": "sha256:324e340ee083edfcab458af08117ffc98655b826046069338156a5f829353b53", "unit_id": "tag:03YJ:title"}
{"chapter": "algebraic", "node_kind": "paragraph", "parent_tag": "03YJ", "placeholders": {"STRUCT_0001": "\\noindent"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R2", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:8393a5c969da4f63cd188a9c4c071afcaa300f907bfd31d4393b9bf741bfca0f", "source_text": "\n\n<STRUCT_0001>\nHere is the definition that makes this work.\n\n", "source_text_hash": "sha256:87507983410d80f25ab0324e81f484c17317965f3cc2e5f59c5f28502af1bc7e", "unit_id": "tag:03YJ:prose-0001"}
{"chapter": "algebraic", "node_kind": "definition", "parent_tag": "03YJ", "placeholders": {"MATH_0001": "$S$", "MATH_0002": "$\\Sch_{fppf}$", "MATH_0003": "$f : \\mathcal{X} \\to \\mathcal{Y}$", "MATH_0004": "$1$", "MATH_0005": "$(\\Sch/S)_{fppf}$", "MATH_0006": "$f$", "MATH_0007": "$\\mathcal{P}$", "MATH_0008": "$f$", "MATH_0009": "$\\mathcal{P}$", "MATH_0010": "$U \\in \\Ob((\\Sch/S)_{fppf})$", "MATH_0011": "$y \\in \\mathcal{Y}_U$", "MATH_0012": "$f_y : F_y \\to U$", "MATH_0013": "$\\mathcal{P}$", "REF_0001": "\\ref{spaces-descent-definition-property-morphisms-local}", "REF_0002": "\\ref{equation-representable-by-algebraic-spaces}", "STRUCT_0001": "\\begin{enumerate}", "STRUCT_0002": "\\item", "STRUCT_0003": "\\item", "STRUCT_0004": "\\end{enumerate}", "TEXTITCLOSE_0001": "}", "TEXTITOPEN_0001": "{\\it "}, "render": {"prefix": "\\begin{definition}\n\\label{definition-relative-representable-property}\n", "suffix": "\\end{definition}"}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:4f29cc53c5ac65423894e245b649afeb6474702b40cd5114954de98f941c0b5c", "source_status": "CURRENT", "source_structure_hash": "sha256:5865118d2422ef423b6a93befa08e2717360ef515066a0d7d8c3843cc19435e6", "source_text": "Let <MATH_0001> be a scheme contained in <MATH_0002>.\nLet <MATH_0003> be a <MATH_0004>-morphism\nof categories fibred in groupoids over <MATH_0005>.\nAssume <MATH_0006> is representable by algebraic spaces.\nLet <MATH_0007> be a property of morphisms of algebraic spaces which\n<STRUCT_0001>\n<STRUCT_0002> is preserved under any base change, and\n<STRUCT_0003> is fppf local on the base, see\nDescent on Spaces,\nDefinition <REF_0001>.\n<STRUCT_0004>\nIn this case we say that <MATH_0008> has <TEXTITOPEN_0001>property <MATH_0009><TEXTITCLOSE_0001> if for every\n<MATH_0010> and\nany <MATH_0011> the resulting morphism of algebraic spaces\n<MATH_0012>, see\ndiagram (<REF_0002>),\nhas property <MATH_0013>.\n", "source_text_hash": "sha256:e157091ebe2d514dc0f9135a0820eada9ef80c8b7888408b8a49cc98849d5115", "unit_id": "tag:03YK:statement"}
{"chapter": "algebraic", "node_kind": "paragraph", "parent_tag": "03YJ", "placeholders": {"STRUCT_0001": "\\noindent"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R2", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:8393a5c969da4f63cd188a9c4c071afcaa300f907bfd31d4393b9bf741bfca0f", "source_text": "\n\n<STRUCT_0001>\nIt is important to note that we will only use this definition for\nproperties of morphisms that are stable under base change, and\nlocal in the fppf topology on the target. This is\nnot because the definition doesn't make sense otherwise; rather it\nis because we may want to give a different definition which is\nbetter suited to the property we have in mind.\n\n", "source_text_hash": "sha256:ee5c6271b8ac91f73ac5200be3d1ac326f5eb689281f42f2155754349a053f7d", "unit_id": "tag:03YJ:prose-0002"}
