{"unit_id": "tag:01JT:statement", "translation": "设<MATH_0001>和<MATH_0002>是目标（target）相同的概形（schemes）的态射（morphisms）。点（Points）<MATH_0003>取自<MATH_0004>，它们与四元组（quadruples）\n<MATH_0005>\n成双射（bijective）对应，其中<MATH_0006>、<MATH_0007>、<MATH_0008>是满足<MATH_0009>、<MATH_0010>的点（points），而<MATH_0011>是环（ring）<MATH_0012>的一个素理想（ideal）。\n<MATH_0013>的剩余域（residue field）与素理想（prime）<MATH_0014>的剩余域（residue field）相对应。\n", "allowed_english": [], "term_occurrences": [{"source_term": "target", "target_term": "目标"}, {"source_term": "schemes", "target_term": "概形"}, {"source_term": "morphisms", "target_term": "态射"}, {"source_term": "Points", "target_term": "点"}, {"source_term": "quadruples", "target_term": "四元组"}, {"source_term": "bijective", "target_term": "双射"}, {"source_term": "points", "target_term": "点"}, {"source_term": "ring", "target_term": "环"}, {"source_term": "ideal", "target_term": "素理想"}, {"source_term": "residue field", "target_term": "剩余域"}, {"source_term": "prime", "target_term": "素理想"}, {"source_term": "residue field", "target_term": "剩余域"}], "unknown_terms": [{"source_term": "target", "target_term": "目标", "context": "态射指向的概形"}, {"source_term": "schemes", "target_term": "概形", "context": "代数几何中的概形，原文为复数"}, {"source_term": "morphisms", "target_term": "态射", "context": "范畴中的态射，原文为复数"}, {"source_term": "Points", "target_term": "点", "context": "纤维积上的点，原文句首为复数"}, {"source_term": "quadruples", "target_term": "四元组", "context": "描述纤维积上的点的数据，原文为复数"}, {"source_term": "bijective", "target_term": "双射", "context": "描述点与四元组之间的对应"}, {"source_term": "points", "target_term": "点", "context": "概形上的点，原文为复数"}, {"source_term": "ring", "target_term": "环", "context": "其中取素理想的环"}, {"source_term": "ideal", "target_term": "素理想", "context": "原文为 prime ideal，冻结术语库存列出 ideal"}, {"source_term": "residue field", "target_term": "剩余域", "context": "概形的点或素理想处的剩余域"}, {"source_term": "prime", "target_term": "素理想", "context": "此处省称上文的素理想"}, {"source_term": "residue field", "target_term": "剩余域", "context": "概形的点或素理想处的剩余域"}]