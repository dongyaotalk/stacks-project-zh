{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stacks-project-zh.invalid/schema/translator-output.schema.json",
  "title": "Translator-owned candidate fields",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "unit_id",
    "translation",
    "allowed_english",
    "term_occurrences",
    "unknown_terms",
    "notes"
  ],
  "properties": {
    "unit_id": {"type": "string", "minLength": 1},
    "translation": {"type": "string", "minLength": 1},
    "allowed_english": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "term_occurrences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_term", "target_term"],
        "properties": {
          "source_term": {"type": "string", "minLength": 1},
          "target_term": {"type": "string", "minLength": 1}
        }
      }
    },
    "unknown_terms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_term", "target_term", "context"],
        "properties": {
          "source_term": {"type": "string", "minLength": 1},
          "target_term": {"type": "string", "minLength": 1},
          "context": {"type": "string", "minLength": 1}
        }
      }
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
