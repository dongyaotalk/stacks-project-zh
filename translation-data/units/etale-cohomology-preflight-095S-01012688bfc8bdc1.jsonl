{"chapter": "etale-cohomology", "node_kind": "paragraph", "parent_tag": "095S", "placeholders": {"REF_0001": "\\cite[XII, Theorem 5.1]{SGA4}", "STRUCT_0001": "\\noindent"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R2", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:cbb0a383ac52e20de326e84621d271946597567dcdae492f89e7d3bfc99a843c", "source_text": "\n\n<STRUCT_0001>\nThe proper base change theorem is stated and proved in this section.\nOur approach follows roughly the proof in <REF_0001>\nusing Gabber's ideas (from the affine case) to slightly simplify\nthe arguments.\n\n", "source_text_hash": "sha256:eb976c9361d1430edead46bad3c967e43ba7dd4c91ec572f8ce14be52e282206", "unit_id": "tag:095S:prose-0001"}
