{"chapter": "stacks-morphisms", "node_kind": "lemma", "parent_tag": "0DQM", "placeholders": {"MATH_0001": "$\\mathcal{X}$", "MATH_0002": "$|\\mathcal{X}|$"}, "render": {"prefix": "\\begin{lemma}\n\\label{lemma-spectral-qcqs}\n", "suffix": "\\end{lemma}"}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:a7839d23bf48e0dc6349546818aa2f7457c6239c3af9c433cafeb2e386faaef7", "source_status": "CURRENT", "source_structure_hash": "sha256:269ea3f18ed08b5f78d03f68111d027481543d4bc2a1e71dbe3588376e548e3d", "source_text": "Let <MATH_0001> be a quasi-compact and quasi-separated algebraic stack.\nThen <MATH_0002> is a spectral topological space.\n", "source_text_hash": "sha256:9ca321841bd10f0e6d7698e926b574eb648de970a74b41ead8dd616443a5c7d3", "unit_id": "tag:0DQP:statement"}
