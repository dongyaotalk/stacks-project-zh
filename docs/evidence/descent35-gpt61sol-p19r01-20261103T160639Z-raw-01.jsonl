": "范畴", "context": "模和环的范畴及范畴论证明，待决。"}, {"source_term": "universally", "target_term": "普遍", "context": "单射性的普遍限定，待决。"}, {"source_term": "injective", "target_term": "单射", "context": "普遍单射性质，待决。"}, {"source_term": "module", "target_term": "模", "context": "任意基环模，待决。"}, {"source_term": "injective", "target_term": "单射的", "context": "张量积诱导映射的单射性，待决。"}, {"source_term": "sufficient condition", "target_term": "充分条件", "context": "有效下降的充分条件，待决。"}, {"source_term": "pure", "target_term": "纯", "context": "Olivier 使用的名称，待决。"}, {"source_term": "datum", "target_term": "数据", "context": "所比较的下降数据定义，待决。"}, {"source_term": "monads", "target_term": "单子", "context": "范畴论证明的表述，待决。"}, {"source_term": "algebras", "target_term": "代数", "context": "可下降性质的代数对象，待决。"}, {"source_term": "homomorphisms", "target_term": "同态", "context": "普遍单射环同态，待决。"}, {"source_term": "descended", "target_term": "下降", "context": "沿同态下降性质，待决。"}, {"source_term": "finite", "target_term": "有限", "context": "模的有限性，待决。"}, {"source_term": "flat modules", "target_term": "平坦模", "context": "已处理的另一类模，待决。"}], "notes": []}
