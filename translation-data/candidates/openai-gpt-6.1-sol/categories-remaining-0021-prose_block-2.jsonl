": "01a15218-e3ec-7cd1-841b-0150e0cb043c", "unit_id": "tag:0021:prose-0002"}, "context_hash": "sha256:268c88ca9f6e7304b7f9e14306a8f9999fd1871589b69a64da4a7adadc3b2d24", "created_at": "2026-10-19T03:07:46.306482Z", "glossary_revision": "git:b33b9b37f1623d49d4030a11f1661dfc29fa2ce4", "harness_id": "codex", "harness_version": "0.163.0-alpha.10.2", "model_id": "gpt-6.1-sol", "model_identity_confidence": "declared", "model_lane": "openai-gpt-6.1-sol", "model_record_id": "openai:gpt-6.1-sol:declared", "model_snapshot": null, "notes": [], "prompt_version": "translator-v2", "publication_status": "CANDIDATE", "qa_status": "PASS", "reasoning_effort": "high", "run_id": "run-20261019-categories-remaining-p003-gpt61sol", "schema_version": 2, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_status": "CURRENT", "source_text_hash": "sha256:6edcc3044d2ad7ba37603b557d6afc53a2de52c088c6b88b4d066fbea13bc1e9", "stage": "STRUCTURE_OK", "term_occurrences": [{"source_term": "morphism", "target_term": "态射"}, {"source_term": "object", "target_term": "对象"}, {"source_term": "element", "target_term": "元素"}, {"source_term": "Yoneda Lemma", "target_term": "米田引理"}, {"source_term": "transformation", "target_term": "变换"}, {"source_term": "fibre product", "target_term": "纤维积"}, {"source_term": "representable", "target_term": "可表"}, {"source_term": "representing", "target_term": "表示"}, {"source_term": "fibre product", "target_term": "纤维积"}, {"source_term": "functor", "target_term": "函子"}, {"source_term": "representable", "target_term": "可表"}, {"source_term": "transformations", "target_term": "变换"}], "term_status": "DECISION_REQUIRED", "translation": "\n\n<STRUCT_0001>\n作为一个特例，设我们有态射（morphism）<MATH_0001>、对象（object）<MATH_0002>及元素（element）<MATH_0003>。根据米田引理（Yoneda Lemma）<REF_0001>，这给出变换（transformation）<MATH_0004>。此时的纤维积（fibre product）由规则\n<MATH_0005>\n描述。若<MATH_0006>、<MATH_0007>也可表（representable），那么这就是表示（representing）纤维积（fibre product）（若它存在）的函子（functor），见第<REF_0002>节。与定义<REF_0003>的类比促使我们定义可表（representable）变换（transformations）的概念。\n\n", "translation_hash": "sha256:ad0044a5ace92e897ff898c6af252032a1914a33d5dfd4352c6341b0035c8f34", "unit_id": "tag:0021:prose-0002", "unknown_terms": [{"context": "所给函子之间的态射；词表无批准项。", "source_term": "morphism", "target_term": "态射"}, {"context": "定义域范畴中的对象；词表无批准项。", "source_term": "object", "target_term": "对象"}, {"context": "函子取值中的元素；词表无批准项。", "source_term": "element", "target_term": "元素"}, {"context": "所引用的引理；暂定译法。", "source_term": "Yoneda Lemma", "target_term": "米田引理"}, {"context": "由元素给出的自然变换；暂定译法。", "source_term": "transformation", "target_term": "变换"}, {"context": "函子的纤维积及其所表示的纤维积；词表无批准项。", "source_term": "fibre product", "target_term": "纤维积"}, {"context": "函子及变换的可表性；暂定译法。", "source_term": "representable", "target_term": "可表"}, {"context": "表示纤维积的函子；词表无批准项。", "source_term": "functor", "target_term": "函子"}, {"context": "函子表示纤维积；暂定译法。", "source_term": "representing", "target_term": "表示"}, {"context": "将要定义的可表变换；暂定译法。", "source_term": "transformations", "target_term": "变换"}]}
