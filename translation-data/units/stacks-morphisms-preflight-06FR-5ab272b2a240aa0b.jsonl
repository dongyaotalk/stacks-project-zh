{"chapter": "stacks-morphisms", "node_kind": "lemma", "parent_tag": "06FR", "placeholders": {}, "render": {"prefix": "\\begin{lemma}\n\\label{lemma-composition-finite-type}\n", "suffix": "\\end{lemma}"}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:3fa6e12b2077038355afc600812065704bcc02f8913df1eff945573457abeb2a", "source_text": "The composition of finite type morphisms is of finite type.\nThe same holds for locally of finite type.\n", "source_text_hash": "sha256:29114cbfbfd7bef270f56fe8296d511b38800454e0768aee916b29c579651f51", "unit_id": "tag:06FT:statement"}
