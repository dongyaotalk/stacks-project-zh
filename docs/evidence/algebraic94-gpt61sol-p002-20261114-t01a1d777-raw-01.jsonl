{"unit_id":"tag:0456:statement","translation":"设<MATH_0001>为<MATH_0002>的对象（object）。考虑<MATH_0003>-交换图表（commutative diagram）\n<MATH_0004>\n其中各箭头是<MATH_0005>-态射（morphisms），位于<MATH_0006>上以群胚（groupoids）为纤维的范畴（categories）之间。假设水平（horizontal）箭头（arrows）为等价（equivalences）。则<MATH_0007>是可表的（representable），当且仅当<MATH_0008>是可表的（representable）。\n","allowed_english":[],"term_occurrences":[{"source_term":"object","target_term":"对象"},{"source_term":"commutative diagram","target_term":"交换图表"},{"source_term":"morphisms","target_term":"态射"},{"source_term":"groupoids","target_term":"群胚"},{"source_term":"categories","target_term":"范畴"},{"source_term":"horizontal","target_term":"水平"},{"source_term":"arrows","target_term":"箭头"},{"source_term":"equivalences","target_term":"等价"},{"source_term":"representable","target_term":"可表的"},{"source_term":"representable","target_term":"可表的"}],"unknown_terms":[{"source_term":"object","target_term":"对象","context":"底范畴的对象。"},{"source_term":"commutative diagram","target_term":"交换图表","context":"2-交换图表。"},{"source_term":"morphisms","target_term":"态射","context":"图表中的1-态射。"},{"source_term":"groupoids","target_term":"群胚","context":"纤维的类型。"},{"source_term":"categories","target_term":"范畴","context":"图表中的纤维范畴。"},{"source_term":"horizontal","target_term":"水平","context":"图表中箭头的方向。"},{"source_term":"arrows","target_term":"箭头","context":"图表中的水平箭头。"},{"source_term":"equivalences","target_term":"等价","context":"水平箭头表示范畴等价。"},{"source_term":"representable","target_term":"可表的","context":"竖直态射的可表性；译名待决。"}],"notes":[]}
