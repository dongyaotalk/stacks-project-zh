          "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14",
          "source_text": "<STRUCT_0001>\n<LOCKED_0001>\nLocally ringed spaces.\n<STRUCT_0002>\n<STRUCT_0003> A <TEXTITOPEN_0001>locally ringed space <MATH_0001><TEXTITCLOSE_0001>\nis a pair consisting of a\ntopological space <MATH_0002> and a sheaf of rings <MATH_0003> all of whose stalks\nare local rings.\n<STRUCT_0004> Given a locally ringed space <MATH_0004> we say that\n<MATH_0005> is the <TEXTITOPEN_0002>local ring of <MATH_0006> at <MATH_0007><TEXTITCLOSE_0002>.\nWe denote <MATH_0008> or simply <MATH_0009>\nthe maximal ideal of <MATH_0010>. Moreover, the\n<TEXTITOPEN_0003>residue field of <MATH_0011> at <MATH_0012><TEXTITCLOSE_0003> is the residue field\n<MATH_0013>.\n<STRUCT_0005> A <TEXTITOPEN_0004>morphism of locally ringed spaces<TEXTITCLOSE_0004>\n<MATH_0014>\nis a morphism of ringed spaces such that for all <MATH_0015>\nthe induced ring map <MATH_0016> is a\nlocal ring map.\n<STRUCT_0006>\n<STRUCT_0007>",
          "source_status": "CURRENT",
          "placeholders": {
            "STRUCT_0001": "\\begin{definition}",
            "LOCKED_0001": "\\label{definition-locally-ringed-space}",
            "STRUCT_0002": "\\begin{enumerate}",
            "STRUCT_0003": "\\item",
            "TEXTITOPEN_0001": "{\\it ",
            "MATH_0001": "$(X, \\mathcal{O}_X)$",
            "TEXTITCLOSE_0001": "}",
            "MATH_0002": "$X$",
            "MATH_0003": "$\\mathcal{O}_X$",
            "STRUCT_0004": "\\item",
            "MATH_0004": "$(X, \\mathcal{O}_X)$",
            "MATH_0005": "$\\mathcal{O}_{X, x}$",
            "TEXTITOPEN_0002": "{\\it ",
            "MATH_0006": "$X$",
            "MATH_0007": "$x$",
            "TEXTITCLOSE_0002": "}",
            "MATH_0008": "$\\mathfrak{m}_{X, x}$",
            "MATH_0009": "$\\mathfrak{m}_x$",
            "MATH_0010": "$\\mathcal{O}_{X, x}$",
            "TEXTITOPEN_0003": "{\\it ",
            "MATH_0011": "$X$",
            "MATH_0012": "$x$",
            "TEXTITCLOSE_0003": "}",
            "MATH_0013": "$\\kappa(x) = \\mathcal{O}_{X, x}/\\mathfrak{m}_x$",
            "STRUCT_0005": "\\item",
