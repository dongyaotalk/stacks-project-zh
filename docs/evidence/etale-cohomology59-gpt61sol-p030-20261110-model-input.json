    {
      "context_id": "locked-English-neighbor:etale-cohomology:inventory:etale-cohomology:03QT:theorem/0001",
      "value": {
        "kind": "locked-English-neighbor",
        "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14",
        "source_unit": {
          "schema_version": 1,
          "unit_id": "inventory:etale-cohomology:03QT:theorem/0001",
          "parent_tag": "03QW",
          "chapter": "etale-cohomology",
          "node_kind": "theorem",
          "risk_level": "R3",
          "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14",
          "source_text": "<STRUCT_0001>\n<LOCKED_0001>\nLet <MATH_0001> with <MATH_0002> a field.\nLet <MATH_0003> be a geometric point of <MATH_0004>.\nLet <MATH_0005> denote the absolute Galois group.\nTaking stalks induces an equivalence of categories\n<MATH_0006>\n<STRUCT_0002>",
          "source_status": "CURRENT",
          "placeholders": {
            "STRUCT_0001": "\\begin{theorem}",
            "LOCKED_0001": "\\label{theorem-equivalence-sheaves-point}",
            "MATH_0001": "$S = \\Spec(K)$",
            "MATH_0002": "$K$",
            "MATH_0003": "$\\overline{s}$",
            "MATH_0004": "$S$",
            "MATH_0005": "$G = \\text{Gal}_{\\kappa(s)}$",
            "MATH_0006": "$$\n\\Sh(S_\\etale) \\longrightarrow G\\textit{-Sets},\n\\quad\n\\mathcal{F} \\longmapsto \\mathcal{F}_{\\overline{s}}.\n$$",
            "STRUCT_0002": "\\end{theorem}"
          },
          "render": {
            "prefix": "",
            "suffix": ""
