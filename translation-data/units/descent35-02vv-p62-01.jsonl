7a90f8b52931f80421e96858df128753cdc6dfd8243ac00f78c9", "container_byte_span": {"end": 330244, "start": 328619}, "container_hash": "sha256:14342781cd8b850a61684f8e9d3ae17f7f7982ac180fefd87d8274f377c6e30b"}, {"command_byte_span": {"end": 329949, "start": 329936}, "command_hash": "sha256:59bb442866127a90f8b52931f80421e96858df128753cdc6dfd8243ac00f78c9", "container_byte_span": {"end": 330244, "start": 328619}, "container_hash": "sha256:14342781cd8b850a61684f8e9d3ae17f7f7982ac180fefd87d8274f377c6e30b"}], "ordinal": 1, "owner_label": "descent-lemma-fpqc-refinement-coverings-fully-faithful", "owner_tag": "02VZ", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14"}, "policy_hash": "sha256:2762bd3987f6da68e373928da96eb653423d86d2bb52a1fb1599c98eec53a4ff", "source_label": "descent-lemma-fpqc-refinement-coverings-fully-faithful", "usage": "descent-lemma-reference", "usage_source": {"after": "\\ref{lemma-family-is-one}", "before": "{", "environments": []}}, "command": "text", "policy_entry": "descent-lemma-reference", "slot_byte_span": {"end": 151, "start": 145}, "slot_id": "math/0001/text/0002", "source": "Lemma "}], "source": "$$\n\\xymatrix{\nDD(Y/S) \\ar[r] & DD(X/S) \\\\\nDD(\\mathcal{V}) \\ar[u]^{\\text{Lemma }\\ref{lemma-family-is-one}} \\ar[r] &\nDD(\\mathcal{U}) \\ar[u]_{\\text{Lemma }\\ref{lemma-family-is-one}}\n}\n$$", "source_byte_span": {"end": 1361, "start": 1178}, "source_hash": "sha256:813bb5537c80c36b23b1cc25da2b0edc15f32953e8ef7105a116b0493aee2dd5"}], "node_kind": "proof", "parent_tag": "02VV", "placeholders": {"MATHSEG_0001": "$$\n\\xymatrix{\nDD(Y/S) \\ar[r] & DD(X/S) \\\\\nDD(\\mathcal{V}) \\ar[u]^{\\text{", "MATHSEG_0002": "}\\ref{lemma-family-is-one}} \\ar[r] &\nDD(\\mathcal{U}) \\ar[u]_{\\text{", "MATHSEG_0003": "}\\ref{lemma-family-is-one}}\n}\n$$", "MATH_0001": "$$\ng :\nX = \\coprod\\nolimits_{i \\in I} U_i\n\\longrightarrow\nY = \\coprod\\nolimits_{j \\in J} V_j\n$$", "MATH_0002": "$S$", "MATH_0003": "$i$", "MATH_0004": "$\\alpha(i)$", "MATH_0005": "$g_{\\alpha(i)}$", "MATH_0006": "$\\{g : X \\to Y\\}$", "MATH_0007": "$j$", "MATH_0008": "$\\{\\coprod_{\\alpha(i) = j} U_i \\to V_j\\}$", "MATH_0009": "$V \\subset V_j$", "MATH_0010": "$Y$", "MATH_0011": "$W_1, \\ldots, W_n \\subset \\coprod_{\\alpha(i) = j} U_i$", "MATH_0012": "$X$", "MATH_0013": "$V = \\bigcup_{i = 1, \\ldots, n} g(W_i)$", "MATH_0014": "$Y$", "MATH_0015": "$X$", "MATH_0016": "$DD(X/S)$", "MATH_0017": "$DD(\\mathcal{U})$", "MATH_0018": "$X/S$", "MATH_0019": "$\\mathcal{U}$", "MATH_0020": "$Y/S$", "MATH_0021": "$\\mathcal{V}$", "REF_0001": "\\ref{topologies-lemma-disjoint-union-is-fpqc-covering}", "REF_0002": "\\ref{topologies-lemma-recognize-fpqc-covering}", "REF_0003": "\\ref{lemma-pullback-family}", "REF_0004": "\\ref{lemma-fully-faithful}", "SPACE_0001": "\\ ", "SPACE_0002": "\\ "}, "render": {"prefix": "\\begin{proof}\n", "suffix": "\\end{proof}"}, "risk_level": "R3", "schema_version": 2, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:3f34556e0063a6dfe3caca95b8957b5de9e9d517ba5d72d7556c6168fea3b7a2", "source_math_skeleton_hash": "sha256:edb5c7504b2a5d0e9616989ca90c465504ab063dd7de3e633ae15bdb68c077ea", "source_status": "CURRENT", "source_structure_hash": "sha256:8189dc16053715f0389d32999f5c395cdcc739ad7ca7f7bbbbf040d58f76a322", "source_text": "Consider the morphism of schemes\n<MATH_0001>\nover <MATH_0002> which on the <MATH_0003>th component maps into the <MATH_0004>th component\nvia the morphism <MATH_0005>. We claim that <MATH_0006>\nis an fpqc covering of schemes. Namely, by\nTopologies, Lemma <REF_0001>\nfor each <MATH_0007> the morphism <MATH_0008> is an\nfpqc covering. Thus for every affine open <MATH_0009>\n(which we may think of as an affine open of <MATH_0010>)\nwe can find finitely many affine opens\n<MATH_0011>\n(which we may think of as affine opens of <MATH_0012>)\nsuch that <MATH_0013>.\nThis provides enough affine opens of <MATH_0014> which can be covered by finitely\nmany affine opens of <MATH_0015> so that\nTopologies, Lemma <REF_0002> part (3)\napplies, and the claim follows. Let us write <MATH_0016>,\nresp.<SPACE_0001><MATH_0017> for the category of descent data with respect\nto <MATH_0018>, resp.<SPACE_0002><MATH_0019>, and similarly for <MATH_0020> and <MATH_0021>.\nConsider the diagram\n<MATHSEG_0001>Lemma <MATHSEG_0002>Lemma <MATHSEG_0003>\nThis diagram is commutative, see the proof of\nLemma <REF_0003>.\nThe vertical arrows are equivalences. Hence the lemma follows from\nLemma <REF_0004> which shows the top horizontal arrow\nof the diagram is fully faithful.\n", "source_text_hash": "sha256:ca968269d6e7df21f7848dde7dcdebf790395fd427a9032f15983dc8f8d30dbe", "unit_id": "tag:02VZ:proof"}
{"chapter": "descent", "node_kind": "paragraph", "parent_tag": "02VV", "placeholders": {"MATH_0001": "$S$", "STRUCT_0001": "\\noindent"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R2", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:86ec2eecd570d0c8a4f479624baf284069e51967c1f2fc353abd21054aea9915", "source_status": "CURRENT", "source_structure_hash": "sha256:b8ae24e0612d6623d2281bd31c413af1d71a4db531dc1668eba895af1c21cad4", "source_text": "\n\n<STRUCT_0001>\nThe next lemma shows that, in order to check effectiveness,\nwe may always Zariski refine the given family of morphisms\nwith target <MATH_0001>.\n\n", "source_text_hash": "sha256:0096bf5e428109b6c8ce18023aeb05904d7e8ee0b5e4405c98568b6abab9cb36", "unit_id": "tag:02VV:prose-0004"}
