{"unit_id":"tag:0D3C:statement","translation":"设<MATH_0001>是一个概形（scheme）。设<MATH_0002>是一个态射（morphism），其源和目标为<MATH_0003>上的代数空间（algebraic spaces）。设<MATH_0004>是一个可逆的（invertible）<MATH_0005>-模（module）。设<MATH_0006>是一个fpqc覆盖（fpqc covering）。设<MATH_0007>是<MATH_0008>的基底变换（base change），并设<MATH_0009>是<MATH_0010>到<MATH_0011>的拉回（pullback）。下列条件等价（equivalent）<STRUCT_0001>\n<STRUCT_0002> <MATH_0012>在<MATH_0013>上是丰沛的（ample），以及\n<STRUCT_0003> <MATH_0014>在<MATH_0015>上是丰沛的（ample），对每个<MATH_0016>成立。\n<STRUCT_0004>\n","allowed_english":[],"term_occurrences":[{"source_term":"scheme","target_term":"概形"},{"source_term":"morphism","target_term":"态射"},{"source_term":"algebraic spaces","target_term":"代数空间"},{"source_term":"invertible","target_term":"可逆的"},{"source_term":"module","target_term":"模"},{"source_term":"fpqc covering","target_term":"fpqc覆盖"},{"source_term":"base change","target_term":"基底变换"},{"source_term":"pullback","target_term":"拉回"},{"source_term":"equivalent","target_term":"等价"},{"source_term":"ample","target_term":"丰沛的"},{"source_term":"ample","target_term":"丰沛的"}],"unknown_terms":[{"source_term":"scheme","target_term":"概形","context":"对象，待决。"},{"source_term":"morphism","target_term":"态射","context":"映射，待决。"},{"source_term":"algebraic spaces","target_term":"代数空间","context":"对象，待决。"},{"source_term":"invertible","target_term":"可逆的","context":"模性质，待决。"},{"source_term":"module","target_term":"模","context":"对象，待决。"},{"source_term":"fpqc covering","target_term":"fpqc覆盖","context":"覆盖，待决。"},{"source_term":"base change","target_term":"基底变换","context":"运算，待决。"},{"source_term":"pullback","target_term":"拉回","context":"运算，待决。"},{"source_term":"equivalent","target_term":"等价","context":"条件等价，待决。"},{"source_term":"ample","target_term":"丰沛的","context":"可逆模性质，待决。"}],"notes":[]}
