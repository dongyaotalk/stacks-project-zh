{"unit_id":"tag:02ZT:statement","translation":"设<MATH_0001>为包含在<MATH_0002>中的概形（scheme）。设<MATH_0003>为<MATH_0004>上以群胚（groupoids）为纤维的范畴（categories）。设<MATH_0005>为可表的（representable）<MATH_0006>-态射（morphism）。设<MATH_0007>为任意<MATH_0008>-态射（morphism）。考虑纤维积（fibre product）图表（diagram）\n<MATH_0009>\n则基变换（base change）<MATH_0010>是可表的（representable）<MATH_0011>-态射（morphism）。\n","allowed_english":[],"term_occurrences":[{"source_term":"scheme","target_term":"概形"},{"source_term":"groupoids","target_term":"群胚"},{"source_term":"categories","target_term":"范畴"},{"source_term":"representable","target_term":"可表的"},{"source_term":"morphism","target_term":"态射"},{"source_term":"morphism","target_term":"态射"},{"source_term":"fibre product","target_term":"纤维积"},{"source_term":"diagram","target_term":"图表"},{"source_term":"base change","target_term":"基变换"},{"source_term":"representable","target_term":"可表的"},{"source_term":"morphism","target_term":"态射"}],"unknown_terms":[{"source_term":"scheme","target_term":"概形","context":"底概形。"},{"source_term":"groupoids","target_term":"群胚","context":"纤维的类型。"},{"source_term":"categories","target_term":"范畴","context":"以群胚为纤维的范畴。"},{"source_term":"representable","target_term":"可表的","context":"1-态射的可表性。"},{"source_term":"morphism","target_term":"态射","context":"给定及基变换后的1-态射。"},{"source_term":"fibre product","target_term":"纤维积","context":"基变换的纤维积。"},{"source_term":"diagram","target_term":"图表","context":"纤维积图表。"},{"source_term":"base change","target_term":"基变换","context":"可表态射的基变换；译名待决。"}],"notes":[]}
