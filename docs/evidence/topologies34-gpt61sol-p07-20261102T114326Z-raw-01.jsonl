{"unit_id":"tag:021W:statement","translation":"设<MATH_0001>是一个大 fppf 景（site）。设<MATH_0002>是<MATH_0003>中的态射（morphism）。函子（functor）<MATH_0004>余连续（cocontinuous），并有连续（continuous）的右伴随（right adjoint）<MATH_0005>。它们诱导同一个拓扑斯态射（morphism of topoi）<MATH_0006>。有<MATH_0007>。有<MATH_0008>。此外，<MATH_0009>具有左伴随（left adjoint）<MATH_0010>，它与纤维积（fibre products）和等化子（equalizers）交换（commutes）。\n","allowed_english":["fppf"],"term_occurrences":[{"source_term":"site","target_term":"景"},{"source_term":"morphism","target_term":"态射"},{"source_term":"functor","target_term":"函子"},{"source_term":"cocontinuous","target_term":"余连续"},{"source_term":"continuous","target_term":"连续"},{"source_term":"right adjoint","target_term":"右伴随"},{"source_term":"morphism of topoi","target_term":"拓扑斯态射"},{"source_term":"left adjoint","target_term":"左伴随"},{"source_term":"fibre products","target_term":"纤维积"},{"source_term":"equalizers","target_term":"等化子"},{"source_term":"commutes","target_term":"交换"}],"unknown_terms":[{"source_term":"site","target_term":"景","context":"待决"},{"source_term":"morphism","target_term":"态射","context":"待决"},{"source_term":"functor","target_term":"函子","context":"待决"},{"source_term":"cocontinuous","target_term":"余连续","context":"待决"},{"source_term":"continuous","target_term":"连续","context":"待决"},{"source_term":"right adjoint","target_term":"右伴随","context":"待决"},{"source_term":"morphism of topoi","target_term":"拓扑斯态射","context":"待决"},{"source_term":"left adjoint","target_term":"左伴随","context":"待决"},{"source_term":"fibre products","target_term":"纤维积","context":"待决"},{"source_term":"equalizers","target_term":"等化子","context":"待决"},{"source_term":"commutes","target_term":"交换","context":"待决"}],"notes":[]}
