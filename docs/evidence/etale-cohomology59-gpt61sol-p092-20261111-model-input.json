    {
      "context_id": "locked-English-neighbor:etale-cohomology:inventory:etale-cohomology:03NQ:paragraph/0003",
      "value": {
        "kind": "locked-English-neighbor",
        "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14",
        "source_unit": {
          "schema_version": 1,
          "unit_id": "inventory:etale-cohomology:03NQ:paragraph/0003",
          "parent_tag": "03NQ",
          "chapter": "etale-cohomology",
          "node_kind": "paragraph",
          "risk_level": "R1",
          "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14",
          "source_text": "We omit the proof of the first fact.\nTo see part (2), consider another triple <MATH_0001> with\n<MATH_0002>. Then we have the commutative diagram\n<MATH_0003>\nGiven a section <MATH_0004>, its image in\n<MATH_0005> under the map given by\n<MATH_0006>\nis <MATH_0007>, and\nits image under the map given by <MATH_0008>\nis <MATH_0009>. These\ntwo are equal since by assumption <MATH_0010>\nand hence both are equal to the pullback of the common value\n<MATH_0011>\npulled back by the map <MATH_0012> in the diagram.",
          "source_status": "CURRENT",
          "placeholders": {
            "MATH_0001": "$(\\psi, \\beta, \\psi_j)$",
            "MATH_0002": "$\\chi = \\psi$",
            "MATH_0003": "$$\n\\xymatrix{\nV_j \\ar[rrr]_{(\\chi_j, \\psi_j)} \\ar[dd] & & &\nU_{\\alpha(j)} \\times_U U_{\\beta(j)} \\ar[dl] \\ar[dr] \\\\\n& & U_{\\alpha(j)} \\ar[dr] & &\nU_{\\beta(j)} \\ar[dl] \\\\\nV \\ar[rrr]^{\\chi = \\psi} & & & U.\n}\n$$",
            "MATH_0004": "$s \\in \\mathcal{F}(\\mathcal{U})$",
            "MATH_0005": "$\\mathcal{F}(V_j)$",
            "MATH_0006": "$(\\chi, \\alpha, \\{\\chi_j\\}_{j \\in J})$",
            "MATH_0007": "$\\chi_j^*s_{\\alpha(j)}$",
            "MATH_0008": "$(\\psi, \\beta, \\{\\psi_j\\}_{j \\in J})$",
            "MATH_0009": "$\\psi_j^*s_{\\beta(j)}$",
            "MATH_0010": "$s \\in \\check H^0(\\mathcal{U}, \\mathcal{F})$",
            "MATH_0011": "$$\ns_{\\alpha(j)}|_{U_{\\alpha(j)} \\times_U U_{\\beta(j)}} =\ns_{\\beta(j)}|_{U_{\\alpha(j)} \\times_U U_{\\beta(j)}}\n$$",
            "MATH_0012": "$(\\chi_j, \\psi_j)$"
          },
          "render": {
            "prefix": "",
            "suffix": ""
          },
          "source_text_hash": "sha256:f1f8d616d9080695c69b4f6401415765486f50fb2a00334fa6c8f97dc4ab3707",
