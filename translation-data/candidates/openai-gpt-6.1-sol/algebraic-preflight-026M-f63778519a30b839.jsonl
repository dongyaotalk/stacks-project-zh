ne_end": 2083, "line_start": 2068}, "owner_tag": "021S", "parent_tag": "021L", "requested_label": "topologies-definition-big-small-fppf", "requested_tag": "021S", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "topologies", "node_kind": "definition", "parent_tag": "021L", "placeholders": {"LOCKED_0001": "\\label{definition-big-small-fppf}", "MATH_0001": "$S$", "MATH_0002": "$\\Sch_{fppf}$", "MATH_0003": "$S$", "MATH_0004": "$S$", "MATH_0005": "$(\\Sch/S)_{fppf}$", "MATH_0006": "$\\Sch_{fppf}/S$", "MATH_0007": "$S$", "MATH_0008": "$(\\textit{Aff}/S)_{fppf}$", "MATH_0009": "$(\\Sch/S)_{fppf}$", "MATH_0010": "$U/S$", "MATH_0011": "$(\\textit{Aff}/S)_{fppf}$", "MATH_0012": "$\\{U_i \\to U\\}$", "MATH_0013": "$(\\Sch/S)_{fppf}$", "REF_0001": "\\ref{sites-section-localize}", "STRUCT_0001": "\\begin{definition}", "STRUCT_0002": "\\begin{enumerate}", "STRUCT_0003": "\\item", "STRUCT_0004": "\\item", "STRUCT_0005": "\\end{enumerate}", "STRUCT_0006": "\\end{definition}", "TEXTITCLOSE_0001": "}", "TEXTITCLOSE_0002": "}", "TEXTITOPEN_0001": "{\\it ", "TEXTITOPEN_0002": "{\\it "}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:303ed10af359e4e22041ab6a07f9a09b0b58678dbe8ad93db077796cc9a5bbba", "source_status": "CURRENT", "source_structure_hash": "sha256:c750b8b0dae51f13b8452a2157a65bd0c535c37417fc3649701f620e131ae060", "source_text": "<STRUCT_0001>\n<LOCKED_0001>\nLet <MATH_0001> be a scheme. Let <MATH_0002> be a big fppf\nsite containing <MATH_0003>.\n<STRUCT_0002>\n<STRUCT_0003> The <TEXTITOPEN_0001>big fppf site of <MATH_0004><TEXTITCLOSE_0001>, denoted\n<MATH_0005>, is the site <MATH_0006>\nintroduced in Sites, Section <REF_0001>.\n<STRUCT_0004> The <TEXTITOPEN_0002>big affine fppf site of <MATH_0007><TEXTITCLOSE_0002>, denoted\n<MATH_0008>, is the full subcategory of\n<MATH_0009> whose objects are affine <MATH_0010>.\nA covering of <MATH_0011> is any covering\n<MATH_0012> of <MATH_0013> which is a\nstandard fppf covering.\n<STRUCT_0005>\n<STRUCT_0006>", "source_text_hash": "sha256:d5093960c76877136290937a733f5f4739df9bf4da8a7c0814d5fcadb17a3cf8", "unit_id": "inventory:topologies:021S:definition/0001"}}}], "input_freeze": {"hash": "sha256:9cb8914df64ced4f653eb169c7d0ec413d09ec3d2b08a4193302c005f287d4be", "path": "translation-data/source-adoption-inputs/algebraic94-gpt61sol-p014-20261115-t01a1dadf.json"}, "model_output": {"hash": "sha256:d50cff5d7d6c97d4c1f9362b8cc3ac002f83517d7eb6783f05962c321e56a155", "path": "docs/evidence/algebraic94-gpt61sol-p014-20261115-t01a1dadf-raw-02.jsonl", "record_hash": "sha256:d8957a7da2167d7c1453fe5a3a07b8fda50581df90ac4758a4a5fa89e2a397de"}, "neighbor_unit_ids": ["tag:026M:title"], "policy_revision": "git:8eab2c8fa9f57d5366d1f482eef57207fd749c2e", "prior_generations": [], "prompt_version": "translator-v2", "source_adoption_id": "algebraic94-gpt61sol-p014-20261115-t01a1dadf", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "style_guide_path": "config/style-guide.md", "turn_id": "01a1dadf-027a-7111-a553-9fcf7c010ad4", "unit_id": "tag:026M:prose-0001"}, "context_hash": "sha256:85c6ab000e1674f64ec668c3868d018613669eafcd3261b4f35057ed72bb126a", "created_at": "2026-11-14T16:28:21.272611+00:00", "glossary_revision": "git:8eab2c8fa9f57d5366d1f482eef57207fd749c2e", "harness_id": "codex", "harness_version": "0.169.0", "model_id": "gpt-6.1-sol", "model_identity_confidence": "declared", "model_lane": "openai-gpt-6.1-sol", "model_record_id": "openai:gpt-6.1-sol:declared", "model_snapshot": null, "notes": [], "prompt_version": "translator-v2", "publication_status": "CANDIDATE", "qa_status": "PASS", "reasoning_effort": "high", "run_id": "run-algebraic94-gpt61sol-p014-20261115-t01a1dadf", "schema_version": 2, "source_adoption_id": "algebraic94-gpt61sol-p014-20261115-t01a1dadf", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_status": "CURRENT", "source_text_hash": "sha256:32deaa3f1f10fa801eb8cd82e2f12e2774c948fb0cb2968bebe4c88d6c6ef318", "stage": "STRUCTURE_OK", "term_occurrences": [{"source_term": "algebraic spaces", "target_term": "代数空间"}, {"source_term": "big", "target_term": "大"}, {"source_term": "site", "target_term": "景"}, {"source_term": "Topologies", "target_term": "拓扑"}, {"source_term": "schemes", "target_term": "概形"}, {"source_term": "objects", "target_term": "对象"}, {"source_term": "big", "target_term": "大"}, {"source_term": "site", "target_term": "景"}, {"source_term": "base", "target_term": "基底"}, {"source_term": "big", "target_term": "大"}, {"source_term": "site", "target_term": "景"}, {"source_term": "Topologies", "target_term": "拓扑"}, {"source_term": "schemes", "target_term": "概形"}, {"source_term": "points", "target_term": "点"}, {"source_term": "set", "target_term": "集合"}, {"source_term": "fpqc covering", "target_term": "fpqc 覆盖"}, {"source_term": "universal", "target_term": "普遍"}, {"source_term": "effective", "target_term": "有效"}, {"source_term": "epimorphism", "target_term": "满态射"}, {"source_term": "Descent", "target_term": "下降"}, {"source_term": "topology", "target_term": "拓扑"}, {"source_term": "canonical", "target_term": "典范"}, {"source_term": "topology", "target_term": "拓扑"}, {"source_term": "representable", "target_term": "可表"}, {"source_term": "presheaves", "target_term": "预层"}, {"source_term": "sheaves", "target_term": "层"}], "term_status": "DECISION_REQUIRED", "translation": "\n\n<STRUCT_0001>\n本章采用的约定与代数空间（algebraic spaces）一章中的约定相同。为方便起见，在此重复这些约定。\n\n<STRUCT_0002><STRUCT_0003>\n我们在适当的大（big）fppf 景（site）<MATH_0001>上工作，如《拓扑（Topologies）》定义<REF_0001>所述。因此，若未明确另作说明，所有概形（schemes）都是<MATH_0002>的对象（objects）。改变大（big）fppf 景（site）时会发生哪些变化，我们在第<REF_0002>节讨论。\n\n<STRUCT_0004><STRUCT_0005>\n我们总是相对于基底（base）<MATH_0003>工作，它包含于<MATH_0004>。于是使用大（big）fppf 景（site）<MATH_0005>，见《拓扑（Topologies）》定义<REF_0003>。取<MATH_0006>便可得到绝对情形。\n\n<STRUCT_0006><STRUCT_0007>\n若<MATH_0007>是<MATH_0008>上的概形（schemes），则用<MATH_0009>表示<MATH_0010>-值点（points）<TEXTITOPEN_0001>在<TEXTITCLOSE_0001><MATH_0011>上的集合（set）。用公式表示为<MATH_0012>。\n\n<STRUCT_0008><STRUCT_0009>\n注意，任何 fpqc 覆盖（fpqc covering）都是普遍（universal）有效（effective）满态射（epimorphism），见《下降（Descent）》引理<REF_0004>。因此，<MATH_0013>上的拓扑（topology）弱于典范（canonical）拓扑（topology），而所有可表（representable）的预层（presheaves）都是层（sheaves）。\n\n\n\n\n\n\n\n\n", "translation_hash": "sha256:5c660ff044165e1b4aa7e230fd666df16f1c506852a8c28aaf095bd0475d9e6b", "unit_id": "tag:026M:prose-0001", "unknown_terms": [{"context": "本单元锁定英文中的数学术语；词表尚无批准条目，使用暂定双语译法。", "source_term": "algebraic spaces", "target_term": "代数空间"}, {"context": "本单元锁定英文中的数学术语；词表尚无批准条目，使用暂定双语译法。", "source_term": "big", "target_term": "大"}, {"context": "本单元锁定英文中的数学术语；词表尚无批准条目，使用暂定双语译法。", "source_term": "site", "target_term": "景"}, {"context": "本单元锁定英文中的数学术语；词表尚无批准条目，使用暂定双语译法。", "source_term": "Topologies", "target_term": "拓扑"}, {"context": "本单元锁定英文中的数学术语；词表尚无批准条目，使用暂定双语译法。", "source_term": "schemes", "target_term": "概形"}, {"context": "本单元锁定英文中的数学术语；词表尚无批准条目，使用暂定双语译法。", "source_term": "objects", "target_term": "对象"}, {"context": "本单元锁定英文中的数学术语；词表尚无批准条目，使用暂定双语译法。", "source_term": "base", "target_term": "基底"}, {"context": "本单元锁定英文中的数学术语；词表尚无批准条目，使用暂定双语译法。", "source_term": "points", "target_term": "点"}, {"context": "本单元锁定英文中的数学术语；词表尚无批准条目，使用暂定双语译法。", "source_term": "set", "target_term": "集合"}, {"context": "本单元锁定英文中的数学术语；词表尚无批准条目，使用暂定双语译法。", "source_term": "fpqc covering", "target_term": "fpqc 覆盖"}, {"context": "本单元锁定英文中的数学术语；词表尚无批准条目，使用暂定双语译法。", "source_term": "universal", "target_term": "普遍"}, {"context": "本单元锁定英文中的数学术语；词表尚无批准条目，使用暂定双语译法。", "source_term": "effective", "target_term": "有效"}, {"context": "本单元锁定英文中的数学术语；词表尚无批准条目，使用暂定双语译法。", "source_term": "epimorphism", "target_term": "满态射"}, {"context": "本单元锁定英文中的数学术语；词表尚无批准条目，使用暂定双语译法。", "source_term": "Descent", "target_term": "下降"}, {"context": "本单元锁定英文中的数学术语；词表尚无批准条目，使用暂定双语译法。", "source_term": "topology", "target_term": "拓扑"}, {"context": "本单元锁定英文中