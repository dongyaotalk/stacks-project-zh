, "model_output": {"hash": "sha256:f6de5897af0d60c17bd047bac666649771e90372004127b84e18dd6d85ba7238", "path": "docs/evidence/p1-06-sheaves-d000-raw-01.jsonl", "record_hash": "sha256:64bd9b60cd36b4b9212a5f91fa7240a43f1deae7829dd9778f338b3eb1f06f6a"}, "neighbor_unit_ids": ["tag:006V:statement"], "policy_revision": "git:0cd5a696ed1fb6b267587570250073149a81bf7f", "prior_generations": [], "prompt_version": "translator-v2", "source_adoption_id": "p1-06-sheaves-d000", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "style_guide_path": "config/style-guide.md", "turn_id": "01a219d6-af88-7712-a6ce-6ecbaa71b161", "unit_id": "tag:006S:prose-0002"}, "context_hash": "sha256:6ed82c4f855016b2f00780549c433bed16523322539a9f5bf101cf47d5276940", "created_at": "2026-11-26T21:50:31.707Z", "glossary_revision": "git:0cd5a696ed1fb6b267587570250073149a81bf7f", "harness_id": "codex", "harness_version": "0.172.0", "model_id": "gpt-6.2-sol", "model_identity_confidence": "declared", "model_lane": "openai-gpt-6.2-sol", "model_record_id": "openai:gpt-6.2-sol:declared", "model_snapshot": null, "notes": [], "prompt_version": "translator-v2", "publication_status": "CANDIDATE", "qa_status": "PASS", "reasoning_effort": "high", "run_id": "run-p1-06-sheaves-d000", "schema_version": 2, "source_adoption_id": "p1-06-sheaves-d000", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_status": "CURRENT", "source_text_hash": "sha256:17b0d5b7b3e6d7326b161570dbaca0199bebbd8ac32b18f8fdb9129c9f5ef9af", "stage": "STRUCTURE_OK", "term_occurrences": [{"source_term": "constant", "target_term": "常值"}, {"source_term": "sheaves", "target_term": "层"}, {"source_term": "set", "target_term": "集合"}, {"source_term": "discrete", "target_term": "离散"}, {"source_term": "topology", "target_term": "拓扑"}, {"source_term": "open subset", "target_term": "开子集"}, {"source_term": "continuous", "target_term": "连续"}, {"source_term": "locally constant", "target_term": "局部常值"}, {"source_term": "open", "target_term"