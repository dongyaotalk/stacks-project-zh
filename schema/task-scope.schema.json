{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stacks-project-zh.invalid/schema/task-scope.schema.json",
  "title": "Issue hash-pinned exact bulk task scopes",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "owner",
    "branch",
    "source_commit",
    "allowed_write_files",
    "data_scopes"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\s\\x00-\\x1f\\x7f]+$"
    },
    "owner": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}$"
    },
    "branch": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\s\\x00-\\x1f\\x7f]+$"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "allowed_write_files": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "data_scopes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scope_id",
          "chapter",
          "parent_tags",
          "historical_parent_tags",
          "unit_ids",
          "input_unit_ids",
          "output_unit_ids",
          "allowed_write_files",
          "run_scope",
          "model_scope"
        ],
        "properties": {
          "scope_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "chapter": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "parent_tags": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[0-9A-Z]{4}$"
            }
          },
          "historical_parent_tags": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[0-9A-Z]{4}$"
            }
          },
          "unit_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\s\\x00-\\x1f\\x7f]+$"
            }
          },
          "input_unit_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\s\\x00-\\x1f\\x7f]+$"
            }
          },
          "output_unit_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\s\\x00-\\x1f\\x7f]+$"
            }
          },
          "allowed_write_files": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "run_scope": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "model_scope": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
