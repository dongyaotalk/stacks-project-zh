ies", "owner_tag": "072V", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14"}, "policy_hash": "sha256:878540b6cdbdc48efab8e6db8351e1c8fba4c3c4af0e4effe84233a954bb5508", "source_label": "stacks-introduction-section-properties", "usage": "root-phrase", "usage_source": {"after": "H", "before": "p", "environments": []}}, "command": "text", "policy_entry": "stacks-introduction-factors", "slot_byte_span": {"end": 93, "start": 84}, "slot_id": "math/0004/text/0001", "source": " factors "}], "source": "$$\nE_2^{p, q} = H_\\etale^q(W \\times H \\times \\ldots \\times H, \\Lambda)\n\\quad(p\\text{ factors }H)\n$$", "source_byte_span": {"end": 2798, "start": 2699}, "source_hash": "sha256:bd4631c3ef078402329f30c72008403db983f97dc0bec7b9229137634cfdff4e"}], "node_kind": "paragraph", "parent_tag": "072V", "placeholders": {"ACCENT_0001": "\\'E", "ACCENT_0002": "\\v C", "ACCENT_0003": "\\'e", "FOOTNOTECLOSE_0001": "}", "FOOTNOTEOPEN_0001": "\\footnote{", "GROUPCLOSE_0001": "}", "GROUPOPEN_0001": "{", "MATHSEG_0001": "$$\n\\mathcal{M}_{1, 1} \\to \\Spec(\\mathbf{Z})\\text{", "MATHSEG_0002": "}\n\\Leftrightarrow\nW \\to \\Spec(\\mathbf{Z})\\text{", "MATHSEG_0003": "}\n$$", "MATHSEG_0004": "$$\n\\begin{matrix}\n\\mathcal{M}_{1, 1}\\text{", "MATHSEG_0005": "} \\Leftarrow W\\text{", "MATHSEG_0006": "}\n\\\\\n\\mathcal{M}_{1, 1}\\text{", "MATHSEG_0007": "} \\Leftarrow W\\text{", "MATHSEG_0008": "}\n\\end{matrix}\n$$", "MATHSEG_0009": "$$\n\\QCoh(\\mathcal{O}_{\\mathcal{M}_{1, 1}}) =\nH\\text{", "MATHSEG_0010": "}W\n$$", "MATHSEG_0011": "$$\nE_2^{p, q} = H_\\etale^q(W \\times H \\times \\ldots \\times H, \\Lambda)\n\\quad(p\\text{", "MATHSEG_0012": "}H)\n$$", "MATH_0001": "$\\mathcal{M}_{1, 1}$", "MATH_0002": "$\\mathcal{M}_{1, 1}$", "MATH_0003": "$S \\to \\mathcal{M}_{1, 1}$", "MATH_0004": "$\\mathcal{M}_{1, 1}$", "MATH_0005": "$\\mathcal{F}_{S, e}$", "MATH_0006": "$S$", "MATH_0007": "$e : S \\to \\mathcal{M}_{1, 1}$", "MATH_0008": "$(E_W, f_W, 0_W) :  W \\to \\mathcal{M}_{1, 1}