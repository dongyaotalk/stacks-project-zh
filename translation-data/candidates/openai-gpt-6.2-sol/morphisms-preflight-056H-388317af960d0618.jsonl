: "拟凝聚理想层"}, {"context": "描述证明所归结到的事实所属的数学领域。", "source_term": "algebra", "target_term": "代数"}, {"context": "最后一项代数事实的假设对象。", "source_term": "ring", "target_term": "环"}, {"context": "该代数事实对模所加的有限生成条件。", "source_term": "finite", "target_term": "有限生成"}, {"context": "代数事实中满足有限生成条件的模。", "source_term": "module", "target_term": "模"}]}
