operty of\nthe sheaves <MATH_0008>.\n<STRUCT_0002>", "source_text_hash": "sha256:063f3abc894a31a35165688d2d045b9cdc47c8d4dc28eed16990a4a959c58269", "unit_id": "inventory:schemes:01I7:proof/0001"}}}, {"context_id": "sha256:95131b38c9ca820f1e7df518a800d442ba6c52b2a3742c1920535cfa003220e0", "hash": "sha256:95131b38c9ca820f1e7df518a800d442ba6c52b2a3742c1920535cfa003220e0", "value": {"kind": "locked-English-neighbor", "location": {"byte_end": 39728, "byte_start": 38938, "file": "schemes.tex", "fragment_hash": "sha256:2ad09ea89432ff3323abce820c9c70fcf2614a431b98e232811073e754c6541f", "line_end": 1167, "line_start": 1153}, "owner_tag": "01I8", "parent_tag": "01I6", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "schemes", "node_kind": "proof", "parent_tag": "01I6", "placeholders": {"ENVARGEND_0001": "]", "ENVARGOPEN_0001": "[", "MATH_0001": "$M \\mapsto \\widetilde M$", "MATH_0002": "$\\pi^*$", "MATH_0003": "$\\pi$", "MATH_0004": "$\\pi : (X, \\mathcal{O}_X) \\to (\\{*\\}, R)$", "MATH_0005": "$\\mathcal{O}_X$", "MATH_0006": "$R$", "MATH_0007": "$R$", "MATH_0008": "$\\pi$", "REF_0001": "\\ref{lemma-compare-constructions}", "REF_0002": "\\ref{modules-lemma-construct-quasi-coherent-sheaves}", "REF_0003": "\\ref{modules-lemma-tensor-product-pullback}", "REF_0004": "\\ref{modules-lemma-pullback-tensor-algebra}", "REF_0005": "\\ref{lemma-spec-sheaves}", "REF_0006": "\\ref{modules-lemma-pullback-internal-hom}", "STRUCT_0001": "\\begin{proof}", "STRUCT_0002": "\\end{proof}"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:ff44e70d2c6321c2c76878f4b2675bd7457f7132253a059f6b3f141ba8990fb2", "source_status": "CURRENT", "source_structure_hash": "sha256:6fc7994afe3dadc7a716d69ee216496cfa852000d7544542458aa39a10fcfd9b", "source_text": "<STRUCT_0001><ENVARGOPEN_0001>First proof<ENVARGEND_0001>\nUsing Lemma <REF_0001> and\nModul