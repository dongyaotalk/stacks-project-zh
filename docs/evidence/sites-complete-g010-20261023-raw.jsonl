{"unit_id":"tag:00XC:statement","translation":"给定位点（sites）的态射（morphism）<MATH_0001>，对应于函子（functor）<MATH_0002>，则一对函子（functors）<MATH_0003> 是拓扑斯态射（morphism of topoi）<MATH_0004>。\n","allowed_english":[],"term_occurrences":[{"source_term":"sites","target_term":"位点"},{"source_term":"morphism","target_term":"态射"},{"source_term":"functor","target_term":"函子"},{"source_term":"functors","target_term":"函子"},{"source_term":"morphism of topoi","target_term":"拓扑斯态射"}],"unknown_terms":[{"source_term":"sites","target_term":"位点","context":"给定态射的源和目标"},{"source_term":"morphism","target_term":"态射","context":"给定的位点态射"},{"source_term":"functor","target_term":"函子","context":"对应的连续函子"},{"source_term":"functors","target_term":"函子","context":"诱导的一对层函子"},{"source_term":"morphism of topoi","target_term":"拓扑斯态射","context":"由位点态射给出的拓扑斯态射"}],"notes":[]}
