    {
      "context_id": "locked-English-reference:defos:inventory:defos:08UK:lemma/0001:defos-lemma-choices-ringed-topoi",
      "value": {
        "kind": "locked-English-reference",
        "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14",
        "source_unit": {
          "schema_version": 1,
          "unit_id": "inventory:defos:08UK:lemma/0001",
          "parent_tag": "08UE",
          "chapter": "defos",
          "node_kind": "lemma",
          "risk_level": "R3",
          "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14",
          "source_text": "<STRUCT_0001>\n<LOCKED_0001>\nIf there exists a solution to (<REF_0001>),\nthen the set of isomorphism classes of solutions is principal homogeneous\nunder <MATH_0001>.\n<STRUCT_0002>",
          "source_status": "CURRENT",
          "placeholders": {
            "STRUCT_0001": "\\begin{lemma}",
            "LOCKED_0001": "\\label{lemma-choices-ringed-topoi}",
            "REF_0001": "\\ref{equation-to-solve-ringed-topoi}",
            "MATH_0001": "$\\Ext^1_\\mathcal{O}(\n\\NL_{\\mathcal{O}/\\mathcal{O}_\\mathcal{B}}, \\mathcal{G})$",
            "STRUCT_0002": "\\end{lemma}"
          },
          "render": {
            "prefix": "",
            "suffix": ""
          },
          "source_text_hash": "sha256:0cedf1db101ad79413c8303fa7d0f448eee115118ba0b3d234d5cc542cd40775",
