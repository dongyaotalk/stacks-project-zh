          "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14",
          "source_text": "<STRUCT_0001>\n<LOCKED_0001>\n<LOCKED_0002>\nLet <MATH_0001>, <MATH_0002> be locally ringed spaces.\nIf <MATH_0003> is an isomorphism of\nringed spaces, then <MATH_0004> is an isomorphism\nof locally ringed spaces.\n<STRUCT_0002>",
          "source_status": "CURRENT",
          "placeholders": {
            "STRUCT_0001": "\\begin{lemma}",
            "LOCKED_0001": "\\label{lemma-isomorphism-locally-ringed}",
            "LOCKED_0002": "\\begin{slogan}\nAn isomorphism of ringed spaces between locally ringed spaces is an\nisomorphism of locally ringed spaces.\n\\end{slogan}",
            "MATH_0001": "$X$",
            "MATH_0002": "$Y$",
            "MATH_0003": "$f : X \\to Y$",
            "MATH_0004": "$f$",
            "STRUCT_0002": "\\end{lemma}"
