{"unit_id":"tag:0FPV:statement","translation":"设 <MATH_0001> 为赋环位点（ringed site）。设 <MATH_0002> 为 <MATH_0003> 的对象（object）。若 <MATH_0004> 在幺半范畴（monoidal category）<MATH_0005> 中具有左对偶（left dual）（《范畴（Categories）》定义 <REF_0001>），则 <MATH_0006> 完美（perfect），且左对偶（left dual）如例 <REF_0002> 中所构造。\n","allowed_english":[],"term_occurrences":[{"source_term":"ringed site","target_term":"赋环位点"},{"source_term":"object","target_term":"对象"},{"source_term":"monoidal category","target_term":"幺半范畴"},{"source_term":"left dual","target_term":"左对偶"},{"source_term":"Categories","target_term":"范畴"},{"source_term":"perfect","target_term":"完美"},{"source_term":"left dual","target_term":"左对偶"}],"unknown_terms":[{"source_term":"ringed site","target_term":"赋环位点","context":"系数位点"},{"source_term":"object","target_term":"对象","context":"导出对象"},{"source_term":"monoidal category","target_term":"幺半范畴","context":"导出对偶环境"},{"source_term":"left dual","target_term":"左对偶","context":"对偶存在与唯一性"},{"source_term":"Categories","target_term":"范畴","context":"引用章节"},{"source_term":"perfect","target_term":"完美","context":"对偶存在的必要条件"}],"notes":[]}
