e_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_status": "CURRENT", "source_text_hash": "sha256:21f9d611574416223c56ba25ea1536155c3c90b40b8feaba7d11e2e2d9e4f63e", "stage": "STRUCTURE_OK", "term_occurrences": [{"source_term": "Algebra", "target_term": "代数"}, {"source_term": "ring map", "target_term": "环映射"}, {"source_term": "unramified", "target_term": "非分歧"}, {"source_term": "finite type", "target_term": "有限型"}, {"source_term": "unramified", "target_term": "非分歧"}, {"source_term": "prime", "target_term": "素理想"}, {"source_term": "unramified", "target_term": "非分歧"}, {"source_term": "ring map", "target_term": "环映射"}, {"source_term": "Algebra", "target_term": "代数"}, {"source_term": "ring map", "target_term": "环映射"}, {"source_term": "finite type", "target_term": "有限型"}, {"source_term": "prime", "target_term": "素理想"}, {"source_term": "lying over", "target_term": "位于"}, {"source_term": "unramified", "target_term": "非分歧"}, {"source_term": "finite", "target_term": "有限"}, {"source_term": "separable", "target_term": "可分"}, {"source_term": "local homomorphism", "target_term": "局部同态"}, {"source_term": "local rings", "target_term": "局部环"}, {"source_term": "unramified", "target_term": "非分歧"}], "term_status": "DECISION_REQUIRED", "translation": "\n\n<STRUCT_0001>\n这是《代数（Algebra）》一节 <REF_0001> 中定义的局部形式。该节中，环映射（ring map） <MATH_0001> 称为非分歧（unramified），当且仅当它是有限型（finite type）的，且 <MATH_0002>。我们称 <MATH_0003> 非分歧（unramified）于素理想（prime） <MATH_0004>，是指存在 <MATH_0005>，满足 <MATH_0006>，使得 <MATH_0007> 是非分歧（unramified）的环映射（ring map）。《代数（Algebra）》引理 <REF_0002> 和 <REF_0003> 证明，给定环映射（ring map） <MATH_0008>，它是有限型（finite type）的，再给定素理想（prime） <MATH_0009>，它属于 <MATH_0010> 且位于（lying over） <MATH_0011> 上方，则有\n<MATHSEG_0001> 非分歧（unramified）于 <MATHSEG_0002> 且 <MATHSEG_0003> 为有限（finite）可分（separable）的 <MATHSEG_0004>\n因此，对局部同态（local homomorphism），即局部环（local rings）之间的这类同态，上述定义所列的性质与是否非分歧（unramified）密切相关。事实上，我们已证明下列引理。\n\n", "translation_hash": "sha256:9b4869e4a8e7e9d7e50cf3a96c73f0ff53a8c03ff3a526b11f42ba8861cd235c", "unit_id": "tag:024L:prose-0002", "unknown_terms": [{"context": "暂定译名，保留所引章节的英文标题。", "source_term": "Algebra", "target_term": "代数"}, {"context": "暂定译名，指此处两个环之间的映射。", "source_term": "ring map", "target_term": "环映射"}, {"context": "暂定译名，指环映射在整体或给定素理想处的性质。", "source_term": "unramified", "target_term": "非分歧"}, {"context": "暂定译名，指该环映射的有限型条件。", "source_term": "finite type", "target_term": "有限型"}, {"context": "暂定译名，指给定环中的素理想。", "source_term": "prime", "target_term": "素理想"}, {"context": "暂定译名，指目标环素理想收缩到给定的源环素理想。", "source_term": "lying over", "target_term": "位于"}, {"context": "暂定译名，指公式中剩余域扩张的有限性。", "source_term": "finite", "target_term": "有限"}, {"context": "暂定译名，指同一剩余域扩张的可分性。", "source_term": "separable", "target_term": "可分"}, {"context": "暂定译名，指局部环间的局部同态。", "source_term": "local homomorphism", "target_term": "局部同态"}, {"context": "暂定译名，指所述局部同态的对象。", "source_term": "local rings", "target_term": "局部环"}]}
