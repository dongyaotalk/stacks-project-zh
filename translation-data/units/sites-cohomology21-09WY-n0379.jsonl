ash": "sha256:a79fffe0d17c4b4646eef30229c1a994542afed0ce19ab849497af652b04e4e3", "unit_id": "tag:0D92:statement"}
{"chapter": "sites-cohomology", "node_kind": "proof", "parent_tag": "09WY", "placeholders": {"MATH_0001": "$f_{qc}$", "MATH_0002": "$Z/Y \\mapsto Z \\times_Y X/X$", "MATH_0003": "$\\epsilon_{Y, *}$", "MATH_0004": "$\\epsilon_{Y, *} \\circ a_Y^{-1} = \\pi_Y^{-1}$", "MATH_0005": "$X$", "MATH_0006": "$a_Y^{-1}f_*\\mathcal{F} \\to f_{qc, *}a_X^{-1}\\mathcal{F}$", "MATH_0007": "$$\n\\pi_Y^{-1}f_*\\mathcal{F} =\n\\epsilon_{Y, *}a_Y^{-1}f_*\\mathcal{F} \\to\n\\epsilon_{Y, *}f_{qc, *}a_X^{-1}\\mathcal{F} =\nf_{Zar, *}\\epsilon_{X, *}a_X^{-1}\\mathcal{F} =\nf_{Zar, *}\\pi_X^{-1}\\mathcal{F}\n$$", "REF_0001": "\\ref{sites-lemma-relocalize}", "REF_0002": "\\ref{sites-lemma-relocalize-given-fibre-products}", "REF_0003": "\\ref{sites-lemma-composition-morphisms-sites}", "REF_0004": "\\ref{lemma-collect-true-things-Zar}", "REF_0005": "\\ref{lemma-collect-true-things-Zar}", "REF_0006": "\\ref{lemma-describe-pullback-pi}", "REF_0007": "\\ref{lemma-collect-true-things-Zar}", "STRUCT_0001": "\\medskip", "STRUCT_0002": "\\noindent"}, "render": {"prefix": "\\begin{proof}\n", "suffix": "\\end{proof}"}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:58ccad8e6c05d60a22c51fb12889c3fc0071507405670677bd38b4782d3d06ed", "source_status": "CURRENT", "source_structure_hash": "sha256:e26bdcb48a5ff85afecef9c4b339ac996fe064010be4848104ab16f23f9e9815", "source_text": "The morphism of topoi <MATH_0001> is the one from\nSites, Lemma <REF_0001>\nwhich in our case comes from the continuous functor\n<MATH_0002>, see\nSites, Lemma <REF_0002>.\nThe diagram on the left commutes because the corresponding\ncontinuous functors compose correctly\n(see Sites, Lemma <REF_0003>).\nThe diagram on the right commutes because the one on the left does\nand because of part (5) of Lemma <REF_0004>.\n\n<STRUCT_0001><STRUCT_0002>\nProof of the final assertion. The reader may repeat the proof of part (7a) of\nLemma <REF_0005>; we will instead deduce this from it.\nAs <MATH_0003> is the identity functor on underlying presheaves,\nit reflects isomorphisms. The description\nin Lemma <REF_0006>\nshows that <MATH_0004>\nand similarly for <MATH_0005>. To show that the canonical map\n<MATH_0006>\nis an isomorphism, it suffices to show that\n<MATH_0007>\nis an isomorphism. This is part\n(7a) of Lemma <REF_0007>.\n", "source_text_hash": "sha256:24f8d32902738e34eccf81dc71032de4574af33d343dd8ccf6aa9a7550c144ad", "unit_id": "tag:0D92:proof"}
