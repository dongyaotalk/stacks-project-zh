            "TEXTITCLOSE_0001": "}",
            "STRUCT_0007": "\\item",
            "MATH_0010": "$$\n\\xymatrix{\nS \\ar[rrr]_a \\ar[rrrd]_{(E, f, 0)} & & &\nS' \\ar[d]_{(E', F', 0')} \\ar[rrr]_{a'} & & &\nS'' \\ar[llld]^{(E'', F'', 0'')}\n\\\\\n& & & \\mathcal{M}_{1, 1}\n}\n$$",
