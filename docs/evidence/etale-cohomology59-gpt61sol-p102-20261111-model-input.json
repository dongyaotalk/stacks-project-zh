            "MATH_0021": "$M$",
            "TEXTITCLOSE_0004": "}",
            "MATH_0022": "$H^i(K, M)$",
            "MATH_0023": "$H^i(G, M)$",
            "STRUCT_0007": "\\end{enumerate}",
            "STRUCT_0008": "\\end{definition}"
          },
