escent", "node_kind": "lemma", "parent_tag": "023P", "placeholders": {"LOCKED_0001": "\\label{lemma-fpqc-universal-effective-epimorphisms}", "MATH_0001": "$\\{T_i \\to T\\}$", "MATH_0002": "$\\{T_i \\to T\\}$", "REF_0001": "\\ref{topologies-definition-fpqc-covering}", "REF_0002": "\\ref{sites-definition-universal-effective-epimorphisms}", "REF_0003": "\\ref{topologies-definition-sheaf-property-fpqc}", "STRUCT_0001": "\\begin{lemma}", "STRUCT_0002": "\\end{lemma}"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:4bc0689659e741440c660741a2c907bc6d6f53d181a32315de55b4d3446b0516", "source_status": "CURRENT", "source_structure_hash": "sha256:0d21cbb80b4781d82adc424c78313eddb3ab61c0711d00b9f413a1079b122440", "source_text": "<STRUCT_0001>\n<LOCKED_0001>\nLet <MATH_0001> be an fpqc covering, see\nTopologies, Definition <REF_0001>.\nThen <MATH_0002> is a universal effective epimorphism\nin the category of schemes, see\nSites, Definition <REF_0002>.\nIn other words, every representable functor on the category of schemes\nsatisfies the sheaf condition for the fpqc topology, see\nTopologies, Definition <REF_0003>.\n<STRUCT_0002>", "source_text_hash": "sha256:a9b60668ecc3ffb12ac665112eb31d5f39c11ef6d9309aedebf66883e5f339c0", "unit_id": "inventory:descent:023Q:lemma/0001"}}}, {"context_id": "locked-English-reference:stacks-introduction:inventory:stacks-introduction:072I:section_title/0001:stacks-introduction-section-introduction", "hash": "sha256:6fff6e8d27255bfb90c2e738c2896e3f6986fd7d2812beb25c13c7067a4688ac", "value": {"kind": "locked-English-reference", "location": {"byte_end": 221, "byte_start": 168, "file": "stacks-introduction.tex", "fragment_hash": "sha256:f8453f82d0da137e5f552b84a3a4b1dd8f52855f4404c66293439f1480ec698b", "line_end": 20, "line_start": 19}, "owner_tag": "072I", "parent_tag": "072I", "requested_label": "stacks-introduction-section-intro