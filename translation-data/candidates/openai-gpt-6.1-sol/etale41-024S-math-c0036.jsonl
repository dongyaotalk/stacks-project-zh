ntry": "etale-sections-such-that", "slot_byte_span": {"end": 121, "start": 111}, "slot_id": "math/0001/text/0004", "source": " such that"}, {"boundary_placeholders": ["MATHSEG_0005", "MATHSEG_0006"], "classification_witness": {"anchor": {"file": "etale.tex", "kind": "section", "matches": [{"command_byte_span": {"end": 19644, "start": 19621}, "command_hash": "sha256:94bdf7585eca22562d890355964397b78a902e117a8bbebfb3f35fa27b16b955", "container_byte_span": {"end": 19797, "start": 19254}, "container_hash": "sha256:fae43187c5e94f9a777d79c229de2ad0a1af215ea3acf6fdd343772cabfa5ca6"}], "ordinal": 1, "owner_label": "etale-section-topological-unramified", "owner_tag": "024S", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14"}, "policy_hash": "sha256:acf06b6ce535cbc1b73e5c23191282cb4d4ae2bada1e2793d6b76b4deff666d0", "source_label": "etale-section-topological-unramified", "usage": "etale-sections-correspondence", "usage_source": {"after": "X", "before": "\\\\\n", "environments": ["matrix"]}}, "command": "text", "policy_entry": "etale-induced-map", "slot_byte_span": {"end": 147, "start": 131}, "slot_id": "math/0001/text/0005", "source": "the induced map "}, {"boundary_placeholders": ["MATHSEG_0006", "MATHSEG_0007"], "classification_witness": {"anchor": {"file": "etale.tex", "kind": "section", "matches": [{"command_byte_span": {"end": 19677, "start": 19652}, "command_hash": "sha256:b7b04a917db61850fbad3bcd438ffa813f7f97c45a8539d3d5a28140f0a41c6c", "container_byte_span": {"end": 19797, "start": 19254}, "container_hash": "sha256:fae43187c5e94f9a777d79c229de2ad0a1af215ea3acf6fdd343772cabfa5ca6"}], "ordinal": 1, "owner_label": "etale-section-topological-unramified", "owner_tag": "024S", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14"}, "policy_hash": "sha256:acf06b6ce535cbc1b73e5c23191282cb4d4ae2bada1e2793d6b76b4deff666d0", "source_label": "etale-section-topological-unramified", "usage": "etale-sections-correspondence", "usage_source": {"after": "\n\\end{matrix}", "before": "Y", "environments": ["matrix"]}}, "command": "text", "policy_entry": "etale-sections-isomorphism", "slot_byte_span": {"end": 180, "start": 162}, "slot_id": "math/0001/text/0006", "source": " is an isomorphism"}], "source": "$$\n\\text{sections of }f\n\\leftrightarrow\n\\left\\{\n\\begin{matrix}\n\\text{connected components }X'\\text{ of }X\\text{ such that}\\\\\n\\text{the induced map }X' \\to Y\\text{ is an isomorphism}\n\\end{matrix}\n\\right\\}\n$$", "source_byte_span": {"end": 448, "start": 242}, "source_hash": "sha256:be0f20d2e5f1a8b1deaeb54f1dcf67875693b5e9565ff63d489d250a8c80f3ee"}], "node_kind": "theorem", "parent_tag": "024S", "placeholders": {"LOCKED_0001": "\\label{theorem-sections-unramified-maps}", "MATHSEG_0001": "$$\n\\text{", "MATHSEG_0002": "}f\n\\leftrightarrow\n\\left\\{\n\\begin{matrix}\n\\text{", "MATHSEG_0003": "}X'\\text{", "MATHSEG_0004": "}X\\text{", "MATHSEG_0005": "}\\\\\n\\text{", "MATHSEG_0006": "}X' \\to Y\\text{", "MATHSEG_0007": "}\n\\end{matrix}\n\\right\\}\n$$", "MATH_0001": "$Y$", "MATH_0002": "$f : X \\to Y$", "MATH_0003": "$f$", "MATH_0004": "$x \\in X$", "MATH_0005": "$x$", "STRUCT_0001": "\\begin{theorem}", "STRUCT_0002": "\\end{theorem}"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R3", "schema_version": 2, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:a43b68f571fa6e23e630f2187ba72fd37863f461c7ce5276b845da18919959a0", "source_math_skeleton_hash": "sha256:afe0a97dc39113a395183da4115972269fa0be1aee09c4438b2e083902a3b366", "source_status": "CURRENT", "source_structure_hash": "sha256:3b877608f699f679dadf3272664fd6cd6a173dc8661493d40e5509838eda77fa", "source_text": "<STRUCT_0001>\n<LOCKED_0001>\nLet <MATH_0001> be a connected scheme.\nLet <MATH_0002> be unramified and separated.\nEvery section of <MATH_0003> is an isomorphism onto a connected component.\nThere exists a bijective correspondence\n<MATHSEG_0001>sections of <MATHSEG_0002>connected components <MATHSEG_0003> of <MATHSEG_0004> such that<MATHSEG_0005>the induced map <MATHSEG_0006> is an isomorphism<MATHSEG_0007>\nIn particular, given <MATH_0004> there is at most one\nsection passing through <MATH_0005>.\n<STRUCT_0002>", "source_text_hash": "sha256:748fede4c11c3b2ffc26b37f0c9b86c272fe23284cb52682ffcf533c53f6171e", "unit_id": "inventory:etale:024U:theorem/0001"}}}, {"context_id": "locked-English-neighbor:etale:inventory:etale:024S:paragraph/0003", "hash": "sha256:c880ea458e51872b1ea840a3c83d3096baebbc426b7f382c34d62ed73280bf71", "value": {"kind": "locked-English-neighbor", "location": {"byte_end": 20281, "byte_start": 19898, "file": "etale.tex", "fragment_hash": "sha256:97baed3975309712c58fa7e8b0d4500c7db08a01534a9342ac9551687f2db36a", "line_end": 526, "line_start": 520}, "owner_tag": "024S", "parent_tag": "024S", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "etale", "node_kind": "paragraph", "parent_tag": "024S", "placeholders": {"REF_0001": "\\cite[Expos\\'e V]{SGA1}", "REF_0002": "\\ref{morphisms-lemma-value-at-one-point}", "STRUCT_0001": "\\noindent"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R1", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:eef9b455ccb0a2dd429c4d175c4da8d9d6521689331f146ac86894b7bb5ab236", "source_text": "<STRUCT_0001>\nThe preceding theorem gives us some idea of the ``rigidity'' of unramified\nmorphisms. Further indication is provided by the following proposition\nwhich, besides being intrinsically interesting, is also useful in the\ntheory of the algebraic fundamental group (see <REF_0001>).\nSee also the more general\nMorphisms, Lemma <REF_0002>.", "source_text_hash": "sha256:4793412070f019fba08bf4d09283963cef0ebf2f13921240518ebdabcda7ddb2", "unit_id": "inventory:etale:024S:paragraph/0003"}}}, {"context_id": "locked-English-reference:etale:inventory:etale:024T:proposition/0001:etale-proposition-properties-sections", "hash": "sha256:ab1d4c60b991959d9de83f69a0c9d94fd2c35e27170af957d04bb3363a6ab5fb", "value": {"kind": "locked-English-reference", "location": {"byte_end": 18448, "byte_start": 18098, "file": "etale.tex", "fragment_hash": "sha256:7996e8e12889b348c4edb9c84417d6f08d709ea238ed494a7104dae7d58930e0", "line_end": 474, "line_start": 466}, "owner_tag": "024T", "parent_tag": "024S", "requested_label": "etale-proposition-properties-sections", "requested_tag": "024T", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "etale", "node_kind": "proposition", "parent_tag": "024S", "placeholders": {"LOCKED_0001": "\\label{proposition-properties-sections}", "STRUCT_0001": "\\begin{proposition}", "STRUCT_0002": "\\begin{enumerate}", "STRUCT_0003": "\\item", "STRUCT_0004": "\\item", "STRUCT_0005": "\\item", "STRUCT_0006": "\\end{enumerate}", "STRUCT_0007": "\\end{proposition}"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:8e8bf4bec461c67c5f62c97d3b49886b8e4753b09f0f9143b79102bda4c0614c", "source_text": "<STRUCT_0001>\n<LOCKED_0001>\nSections of unramified morphisms.\n<STRUCT_0002>\n<STRUCT_0003> Any section of an unramified morphism is an open immersion.\n<STRUCT_0004> Any section of a separated morphism is a closed immersion.\n<STRUCT_0005> Any section of an unramified separated morphism is open and closed.\n<STRUCT_0006>\n<STRUCT_0007>", "source_text_hash": "sha256:1e8e2eacc6d879dd6563a328bdd650cd3644a993ea6cf87f5ad851f4c0335611", "unit_id": "inventory:etale:024T:proposition/0001"}}}], "input_freeze": {"hash": "sha256:596a6227d8cf8aeb958eed1bd0c464cb9972df6e10f5038e6fbb270dac54574a