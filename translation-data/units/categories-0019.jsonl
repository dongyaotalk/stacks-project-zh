{"chapter": "categories", "node_kind": "example", "parent_tag": "0013", "placeholders": {"MATH_0001": "$G$", "MATH_0002": "$x$", "MATH_0003": "$\\Mor(x, x) = G$", "MATH_0004": "$G$"}, "render": {"prefix": "\\begin{example}\n\\label{example-group-groupoid}\n", "suffix": "\\end{example}"}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:383823b46a4447bf4e5335d11566309cb0b9ddcc760a75daa49f005fc3a29836", "source_status": "CURRENT", "source_structure_hash": "sha256:d3baf93a37aa92dde83e0611d019e3768b60616c0a431c69c63f8f4bfdd1bd3b", "source_text": "A group <MATH_0001> gives rise to a groupoid with a single object <MATH_0002>\nand morphisms <MATH_0003>, with the composition rule\ngiven by the group law in <MATH_0004>. Every groupoid with a single\nobject is of this form.\n", "source_text_hash": "sha256:82151b0aae4e901c049da0cf0863b6537e503a7c57727938d512f014845d14f8", "unit_id": "tag:0019:statement"}
