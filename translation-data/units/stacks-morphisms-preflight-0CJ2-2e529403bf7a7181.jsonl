{"chapter": "stacks-morphisms", "node_kind": "lemma", "parent_tag": "0CJ2", "placeholders": {}, "render": {"prefix": "\\begin{lemma}\n\\label{lemma-flat-base-change-lci}\n", "suffix": "\\end{lemma}"}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:214d4439b0d01fa4e049e335c35100d722c207df7e3487ddc35500a171968c67", "source_text": "A flat base change of a local complete intersection morphism is\na local complete intersection morphism.\n", "source_text_hash": "sha256:f7c0c73d1f47d28ef06db2fcaaf8ae077b18879931a44b2f6c44d5458229db72", "unit_id": "tag:0CJ5:statement"}
