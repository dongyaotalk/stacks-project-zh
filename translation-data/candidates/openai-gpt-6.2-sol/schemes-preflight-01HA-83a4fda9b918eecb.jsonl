ther words, an element of <MATH_0017>\nis the same thing as what is sometimes called\na <TEXTITOPEN_0001>germ of a <MATH_0018>-function at <MATH_0019><TEXTITCLOSE_0001>.\n<STRUCT_0004>", "source_text_hash": "sha256:c2ef4b44d39b66af523a2ebc33e811f63ed45f3060123271f45794f454c53780", "unit_id": "inventory:sheaves:007C:example/0001"}}}, {"context_id": "sha256:d98b36111dcae21c040050163483161499dc670cc14971b8336e4c8472109bfe", "hash": "sha256:d98b36111dcae21c040050163483161499dc670cc14971b8336e4c8472109bfe", "value": {"kind": "locked-English-reference", "location": {"byte_end": 76122, "byte_start": 75498, "file": "sheaves.tex", "fragment_hash": "sha256:dbd88b7f33d5ebf6b1685a4dfc74352ac5b5886b30bd61268abfc568fbbf968b", "line_end": 2262, "line_start": 2248}, "owner_tag": "008K", "parent_tag": "008C", "requested_label": "sheaves-lemma-f-map", "requested_tag": "008K", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "sheaves", "node_kind": "lemma", "parent_tag": "008C", "placeholders": {"LOCKED_0001": "\\label{lemma-f-map}", "MATH_0001": "$f : X \\to Y$", "MATH_0002": "$\\mathcal{G} \\to f_*\\mathcal{F}$", "MATH_0003": "$f^{-1}\\mathcal{G} \\to \\mathcal{F}$", "MATH_0004": "$f$", "MATH_0005": "$\\xi : \\mathcal{G} \\to \\mathcal{F}$", "MATH_0006": "$\\xi_{U, V} : \\mathcal{G}(V) \\to \\mathcal{F}(U)$", "MATH_0007": "$U \\subset X$", "MATH_0008": "$V \\subset Y$", "MATH_0009": "$f(U) \\subset V$", "MATH_0010": "$\\mathcal{F} \\in \\Sh(X)$", "MATH_0011": "$\\mathcal{G} \\in \\Sh(Y)$", "STRUCT_0001": "\\begin{lemma}", "STRUCT_0002": "\\begin{enumerate}", "STRUCT_0003": "\\item", "STRUCT_0004": "\\item", "STRUCT_0005": "\\item", "STRUCT_0006": "\\item", "STRUCT_0007": "\\end{enumerate}", "STRUCT_0008": "\\end{lemma}"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:4b6ce937485bada22797c2a8303975d9c75907c6e81c1fef883d6185