{"chapter": "moduli", "node_kind": "lemma", "parent_tag": "0DM5", "placeholders": {"MATH_0001": "$B$", "MATH_0002": "$\\pi : X \\to Y$", "MATH_0003": "$B$", "MATH_0004": "$\\pi$", "MATH_0005": "$\\Hilbfunctor_{X/B} \\to \\Hilbfunctor_{Y/B}$"}, "render": {"prefix": "\\begin{lemma}\n\\label{lemma-hilb-open}\n", "suffix": "\\end{lemma}"}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:57d829221d9505c917a5de2335a67fa38445aaf58ddd1d804da9e3b02f5ee5c0", "source_status": "CURRENT", "source_structure_hash": "sha256:4f484af93d8354e42af68f572e8c0fcc75a8f17ea64e5d48c8fd820c2b07059a", "source_text": "Let <MATH_0001> be an algebraic space. Let <MATH_0002> be an open immersion\nof algebraic spaces which are separated and of finite presentation over <MATH_0003>.\nThen <MATH_0004> induces an open immersion\n<MATH_0005>.\n", "source_text_hash": "sha256:02696b1236dfb891ece2d4ad8029de361ecdf48cd1de75a747e3c96ad92e4503", "unit_id": "tag:0DPE:statement"}
