{"chapter": "cotangent", "node_kind": "paragraph", "parent_tag": "08SH", "placeholders": {"MATH_0001": "$A \\to B$", "MATH_0002": "$L_{B/A}$", "STRUCT_0001": "\\noindent"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R2", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:566b39b20916aeaec3953564285919833de5e0bb634af4f7af20123fe55503fa", "source_status": "CURRENT", "source_structure_hash": "sha256:90e2874d08a5762aab68bc1d398eb0d13a77f48d35f9fb154bc654e754db6cae", "source_text": "\n\n<STRUCT_0001>\nIf <MATH_0001> is a local complete intersection map, then\n<MATH_0002> is a perfect complex. The key to proving this is\nthe following lemma.\n\n", "source_text_hash": "sha256:6e831a449129167c13848811f778696e087aabfca20cd9a294f70a4ed103211b", "unit_id": "tag:08SH:prose-0001"}
