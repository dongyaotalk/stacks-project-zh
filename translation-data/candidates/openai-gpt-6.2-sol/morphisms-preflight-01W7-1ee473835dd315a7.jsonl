": "$R$", "STRUCT_0001": "\\begin{lemma}", "STRUCT_0002": "\\end{lemma}"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:191bf435e456e786618992ef990eca09baf4b4fd3617540b38a1fe27c35fc2c0", "source_status": "CURRENT", "source_structure_hash": "sha256:d52ebfebd37a83aa7216ca06871a57374e92c04b45c3cf1286f1e7f4e4f251bc", "source_text": "<STRUCT_0001>\n<LOCKED_0001>\nLet <MATH_0001> be an affine scheme.\nThe quasi-coherent sheaf of <MATH_0002>-modules\n<MATH_0003> is a finite type <MATH_0004>-module\nif and only if <MATH_0005> is a finite <MATH_0006>-module.\n<STRUCT_0002>", "source_text_hash": "sha256:f8579b1550130e6b36059d48021248c8655432b9527aa5485713b5fd01eeee0b", "unit_id": "inventory:properties:01PB:lemma/0001"}}}], "input_freeze": {"hash": "sha256:b786d30068a168687bdd71067824f610b1ac66f3decbeb0d1ba123101667014a", "path": "translation-data/source-adoption-inputs/p1-29-morphisms-d025.json"}, "model_output": {"hash": "sha256:11af420679b30ea97f3de3da253d7d705f5e6f50b775959e56727c2c058e09a7", "path": "docs/evidence/p1-29-morphisms-d025-raw-01.jsonl", "record_hash": "sha256:49aa71f444537988a986298139ab8748d228ea5456012b461f7f62e3411e70f6"}, "neighbor_unit_ids": [], "policy_revision": "git:b753f6444727f8fc4aa34d05b8523e6abff18b21", "prior_generations": [], "prompt_version": "translator-v2", "source_adoption_id": "p1-29-morphisms-d025", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "style_guide_path": "config/style-guide.md", "turn_id": "01a21ddc-5e36-7453-8f69-72a786795236", "unit_id": "tag:01WB:proof"}, "context_hash": "sha256:2ad03cc5ea9e39bead6d531e5d521be95420c50fa49881941bd915c9b0b9a0f1", "created_at": "2026-11-27T16:35:12.149Z", "glossary_revision": "git:b753f6444727f8fc4aa34d05b8523e6abff18b21", "harness_id": "codex", "harness_version": "0.172.0", "model_id": "gpt-6.2-sol", "model_identity_confidence": "declared", "model_lane": "openai-gpt-6.2-sol", "model_record_id": "openai:gpt-6.2-sol:declared", "model_snapshot": null, "notes": [], "prompt_version": "translator-v2", "publication_status": "CANDIDATE", "qa_status": "PASS", "reasoning_effort": "high", "run_id": "run-p1-29-morphisms-d025", "schema_version": 2, "source_adoption_id": "p1-29-morphisms-d025", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_status": "CURRENT", "source_text_hash": "sha256:e51bb4146f7386f59865d44cbab3b4888046042f625d8bfd839b6b5eb2f495d7", "stage": "STRUCTURE_OK", "term_occurrences": [{"source_term": "point", "target_term": "点"}, {"source_term": "affine open", "target_term": "仿射开"}, {"source_term": "neighbourhood", "target_term": "邻域"}, {"source_term": "isomorphic", "target_term": "同构"}, {"source_term": "closed subscheme", "target_term": "闭子概形"}, {"source_term": "finite type", "target_term": "有限型"}, {"source_term": "quasi-coherent sheaf", "target_term": "拟凝聚层"}, {"source_term": "modules", "target_term": "模"}, {"source_term": "finite type", "target_term": "有限型"}, {"source_term": "module", "target_term": "模"}, {"source_term": "generators", "target_term": "生成元"}, {"source_term": "module", "target_term": "模"}, {"source_term": "surjective", "target_term": "满射"}, {"source_term": "graded", "target_term": "分次"}, {"source_term": "algebra map", "target_term": "代数映射"}, {"source_term": "morphism", "target_term": "态射"}, {"source_term": "closed immersion", "target_term": "闭浸入"}, {"source_term": "isomorphic", "target_term": "同构"}, {"source_term": "closed subscheme", "target_term": "闭子概形"}, {"source_term": "scheme", "target_term": "概形"}], "term_status": "DECISION_REQUIRED", "translation": "由引理<REF_0001>可知，（2）蕴含（1）。假设（1）成立。\n对每个点（point）<MATH_0001>，都能找到<MATH_0002>，它是<MATH_0003>的一个仿射开（affine open）邻域（neighbourhood），使得<MATH_0004>同构（isomorphic）于<MATH_0005>的一个闭子概形（closed subscheme），其中用到某个有限型（finite type）的拟凝聚层（quasi-coherent sheaf），它是<MATH_0006>-模（modules）层<MATH_0007>。\n将该层写成<MATH_0008>，其中取某个有限型（finite type）的<MATH_0009>-模（module）<MATH_0010>（见 Properties 章的引理<REF_0002>）。\n选取生成元（generators）<MATH_0011>，用以生成<MATH_0012>这个<MATH_0013>-模（module）。\n考虑满射（surjective）的分次（graded）<MATH_0014>-代数映射（algebra map）\n<MATH_0015>\n根据 Constructions 章的引理<REF_0003>，相应的态射（morphism）\n<MATH_0016>\n是闭浸入（closed immersion）。因此，<MATH_0017>同构（isomorphic）于<MATH_0018>的一个闭子概形（closed subscheme）（作为<MATH_0019>上的概形（scheme））。\n换言之，（2）成立。\n", "translation_hash": "sha256:ff78b679afba1590667a954ea30189c771da81167b88923d2c4a65b202a5270f", "unit_id": "tag:01WB:proof", "unknown_terms": [{"context": "逐点选取开邻域时的量化对象。", "source_term": "point", "target_term": "点"}, {"context": "限定所选邻域为仿射且开。", "source_term": "affine open", "target_term": "仿射开"}, {"context": "所选仿射开集是给定点的邻域。", "source_term": "neighbourhood", "target_term": "邻域"}, {"context": "局部对象同构于所给空间的闭子概形。", "source_term": "isomorphic", "target_term": "同构"}, {"context": "局部同构所指的子对象。", "source_term": "closed subscheme", "target_term": "闭子概形"}, {"context": "限定所选的拟凝聚模层。", "source_term": "finite type", "target_term": "有限型"}, {"context": "指定用于局部描述的层。", "source_term": "quasi-coherent sheaf", "target_term": "拟凝聚层"}, {"context": "说明该层是指定结构环上的模层，保留英文复数词形。", "source_term": "modules", "target_term": "模"}, {"context": "限定用来表示该层的模。", "source_term": "finite type", "target_term": "有限型"}, {"context": "用来表示该层的有限型代数对象。", "source_term": "module", "target_term": "模"}, {"context": "为该模选取的一组生成元。", "source_term": "generators", "target_term": "生成元"}, {"context": "指明选取生成元所依据的模结构。", "source_term": "module", "target_term": "模"}, {"context": "限定所考察代数映射的满射性质。", "source_term": "surjective", "target_term": "满射"}, {"context": "说明所考察映射的分次代数结构。", "source_term": "graded", "target_term": "分次"}, {"context": "指诱导相应态射的映射。", "source_term": "algebra map", "target_term": "代数映射"}, {"context": "指与分次代数映射相应的几何映射。", "source_term": "morphism", "target_term": "态射"}, {"context": "引用引理判定相应态射的性质。", "source_term": "closed immersion", "target_term": "闭浸入"}, {"context": "结论中在指定底上成立的同构关系。", "source_term": "isomorphic", "target_term": "同构"}, {"context": "结论中相对于指定底的闭子对象。", "source_term": "closed subscheme", "target_term": "闭子概形"}, {"context": "说明结论中的同构是指定底上的概形同构。", "source_term": "scheme", "target_term": "概形"}]}
