{"unit_id":"tag:0GZR:statement","translation":"设 <MATH_0001> 为范畴（category），将其视为赋有混沌（chaotic）拓扑（topology）的位点（site）。设 <MATH_0002> 为 <MATH_0003> 上的环层（sheaf of rings）。假设对所有 <MATH_0004>，位于 <MATH_0005> 中，限制（restriction）映射（map）<MATH_0006> 为平坦（flat）环映射（ring map）。则 <MATH_0007> 与子范畴（subcategory）<MATH_0008> 一致，后者由上同调层（cohomology sheaves）拟凝聚（quasi-coherent）的复形（complexes）组成。\n","allowed_english":[],"term_occurrences":[{"source_term":"category","target_term":"范畴"},{"source_term":"chaotic","target_term":"混沌"},{"source_term":"topology","target_term":"拓扑"},{"source_term":"site","target_term":"位点"},{"source_term":"sheaf of rings","target_term":"环层"},{"source_term":"restriction","target_term":"限制"},{"source_term":"map","target_term":"映射"},{"source_term":"flat","target_term":"平坦"},{"source_term":"ring map","target_term":"环映射"},{"source_term":"subcategory","target_term":"子范畴"},{"source_term":"cohomology sheaves","target_term":"上同调层"},{"source_term":"quasi-coherent","target_term":"拟凝聚"},{"source_term":"complexes","target_term":"复形"}],"unknown_terms":[{"source_term":"category","target_term":"范畴","context":"系数的基"},{"source_term":"site","target_term":"位点","context":"赋予范畴的结构"},{"source_term":"chaotic","target_term":"混沌","context":"平凡覆盖的拓扑"},{"source_term":"topology","target_term":"拓扑","context":"基位点的结构"},{"source_term":"sheaf of rings","target_term":"环层","context":"系数"},{"source_term":"restriction","target_term":"限制","context":"系数的限制箭头"},{"source_term":"map","target_term":"映射","context":"系数比较"},{"source_term":"flat","target_term":"平坦","context":"系数限制的性质"},{"source_term":"ring map","target_term":"环映射","context":"每个基箭头的系数作用"},{"source_term":"subcategory","target_term":"子范畴","context":"上同调拟凝聚的复形"},{"source_term":"complexes","target_term":"复形","context":"比较的导出对象"},{"source_term":"cohomology sheaves","target_term":"上同调层","context":"拟凝聚条件"},{"source_term":"quasi-coherent","target_term":"拟凝聚","context":"上同调系数的性质"}],"notes":[]}
