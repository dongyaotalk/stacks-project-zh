{"chapter": "desirables", "node_kind": "paragraph", "parent_tag": "02BN", "placeholders": {"ACCENT_0001": "\\'e", "MATH_0001": "$1$", "REF_0001": "\\ref{stacks-cohomology-section-lisse-etale}", "REF_0002": "\\ref{examples-section-lisse-etale-not-functorial}", "STRUCT_0001": "\\noindent"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R2", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:aac061bd983bb0f94e2a4090413873d992eb27445b9946699dcdee9b85ff3a03", "source_status": "CURRENT", "source_structure_hash": "sha256:91910a6d56eabea5707582b3e8729e625542aefd083af3371979a08059eec7da", "source_text": "<STRUCT_0001>\nThis has been introduced in\nCohomology of Stacks, Section <REF_0001>.\nAn example to show that it is not functorial with respect to <MATH_0001>-morphisms\nof algebraic stacks is discussed in\nExamples, Section <REF_0002>.\nOf course a lot more could be said about this, but it turns out\nto be very useful to prove things using the ``big'' <ACCENT_0001>tale site\nas much as possible.", "source_text_hash": "sha256:3ba86e28f3752f7c0145fba96783f1d9587554ccdb62144e4a3038fb3d691230", "unit_id": "tag:02BN:paragraph-0001"}
