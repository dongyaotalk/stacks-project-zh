        "MATH_0008": "$\\mathcal{A}$",
        "MATH_0009": "$\\mathcal{A}$",
        "MATH_0010": "$$\nC(\\mathcal{A}) = \\underline{\\Spec}_S(\\mathcal{A}).\n$$",
        "REF_0001": "\\cite[II, (8.3.1)]{EGA}",
        "TEXTITCLOSE_0001": "}",
