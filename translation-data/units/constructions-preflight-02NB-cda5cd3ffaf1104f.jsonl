{"schema_version": 1, "unit_id": "tag:02NB:prose-0001", "parent_tag": "02NB", "chapter": "constructions", "node_kind": "paragraph", "risk_level": "R2", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_text": "\n\n<STRUCT_0001>\nLet <MATH_0001> be a scheme.\nLet <MATH_0002> be a\nquasi-coherent graded <MATH_0003>-algebra.\nLet <MATH_0004> be an invertible sheaf on <MATH_0005>.\nIn this situation we obtain another quasi-coherent graded\n<MATH_0006>-algebra, namely\n<MATH_0007>\nIt turns out that <MATH_0008> and <MATH_0009> have\nisomorphic relative homogeneous spectra.\n\n", "source_status": "CURRENT", "placeholders": {"STRUCT_0001": "\\noindent", "MATH_0001": "$S$", "MATH_0002": "$\\mathcal{A} = \\bigoplus_{d \\geq 0} \\mathcal{A}_d$", "MATH_0003": "$\\mathcal{O}_S$", "MATH_0004": "$\\mathcal{L}$", "MATH_0005": "$S$", "MATH_0006": "$\\mathcal{O}_S$", "MATH_0007": "$$\n\\mathcal{B}\n=\n\\bigoplus\\nolimits_{d \\geq 0}\n\\mathcal{A}_d \\otimes_{\\mathcal{O}_S} \\mathcal{L}^{\\otimes d}\n$$", "MATH_0008": "$\\mathcal{A}$", "MATH_0009": "$\\mathcal{B}$"}, "render": {"prefix": "", "suffix": ""}, "source_text_hash": "sha256:51d23ebf1aba23472448aef0e79f30998b5589013ac1f99e74264e324b898119", "source_structure_hash": "sha256:9c653af11de0d770231aef2edc6d774e96b742fddab5a7bee00a4ca3dd2b49f8", "source_math_hash": "sha256:1a60388ee902d3f060557674d622e8d578764ced3fc8e85daae46dd6259a8ad2"}
