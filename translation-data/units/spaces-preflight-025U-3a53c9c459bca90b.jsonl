{"chapter": "spaces", "node_kind": "proof", "parent_tag": "025U", "placeholders": {}, "render": {"prefix": "\\begin{proof}\n", "suffix": "\\end{proof}"}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:899b57105ce096a0a6d456cfba8e63440f72e913a415dbe02c2e5be542ae5ac0", "source_text": "This is entirely formal and works in any category.\n", "source_text_hash": "sha256:ded7fd3e85f4ed5567f1e9f28ba9572642bb6eaff86f24136ab7f2ceead4080e", "unit_id": "tag:02WA:proof"}
