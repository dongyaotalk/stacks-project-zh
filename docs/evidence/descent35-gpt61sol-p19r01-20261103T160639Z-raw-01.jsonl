{"source_term": "modules", "target_term": "模"}, {"source_term": "category", "target_term": "范畴"}, {"source_term": "module", "target_term": "模"}, {"source_term": "map", "target_term": "映射"}, {"source_term": "injective", "target_term": "单射的"}, {"source_term": "sufficient condition", "target_term": "充分条件"}, {"source_term": "modules", "target_term": "模"}, {"source_term": "category", "target_term": "范畴"}, {"source_term": "split", "target_term": "分裂"}, {"source_term": "rings", "target_term": "环"}, {"source_term": "category", "target_term": "范畴"}, {"source_term": "modules", "target_term": "模"}, {"source_term": "effective", "target_term": "有效的"}, {"source_term": "descent", "target_term": "下降"}, {"source_term": "morphism", "target_term": "态射"}, {"source_term": "universally", "target_term": "普遍"}, {"source_term": "injective", "target_term": "单射"}, {"source_term": "morphisms", "target_term": "态射"}, {"source_term": "pure", "target_term": "纯"}, {"source_term": "algebraic geometry", "target_term": "代数几何"}, {"source_term": "descent", "target_term": "下降"}, {"source_term": "datum", "target_term": "数据"}, {"source_term": "category", "target_term": "范畴"}, {"source_term": "monads", "target_term": "单子"}, {"source_term": "modules", "target_term": "模"}, {"source_term": "algebras", "target_term": "代数"}, {"source_term": "morphisms", "target_term": "态射"}, {"source_term": "properties", "target_term": "性质"}, {"source_term": "universally", "target_term": "普遍"}, {"source_term": "injective", "target_term": "单射"}, {"source_term": "ring", "target_term": "环"}, {"source_term": "homomorphisms", "target_term": "同态"}, {"source_term": "descended", "target_term": "下降"}, {"source_term": "finite", "target_term": "有限"}, {"source_term": "modules", "target_term": "模"}, {"source_term": "flat modules", "target_term": "平坦模"}], "unknown_terms": [{"source_term": "algebraic geometry", "target_term": "代数几何", "context": "本节技术的领域，待决。"}, {"source_term": "descent", "target_term": "下降", "context": "构造及性质下降，待决。"}, {"source_