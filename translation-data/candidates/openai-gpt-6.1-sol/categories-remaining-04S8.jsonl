54047Z", "glossary_revision": "git:e7a1627e7bce13592b8c07d43974a815ba27c0d5", "harness_id": "codex", "harness_version": "0.163.0-alpha.10.2", "model_id": "gpt-6.1-sol", "model_identity_confidence": "declared", "model_lane": "openai-gpt-6.1-sol", "model_record_id": "openai:gpt-6.1-sol:declared", "model_snapshot": null, "notes": [], "prompt_version": "translator-v2", "publication_status": "CANDIDATE", "qa_status": "PASS", "reasoning_effort": "high", "run_id": "run-20261019-categories-remaining-p016-gpt61sol", "schema_version": 2, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_status": "CURRENT", "source_text_hash": "sha256:210c8846ffc596e58c5e5e15f12025d5bf0810ad6ad75fb5be15eb1f064272cf", "stage": "STRUCTURE_OK", "term_occurrences": [{"source_term": "category", "target_term": "范畴"}, {"source_term": "category of categories fibred in sets", "target_term": "集合纤维化范畴之范畴"}, {"source_term": "category", "target_term": "范畴"}, {"source_term": "fibred", "target_term": "纤维化"}, {"source_term": "groupoids", "target_term": "群胚"}, {"source_term": "categories", "target_term": "范畴"}, {"source_term": "category", "target_term": "范畴"}, {"source_term": "objects", "target_term": "对象"}, {"source_term": "categories", "target_term": "范畴"}, {"source_term": "fibred", "target_term": "纤维化"}, {"source_term": "sets", "target_term": "集合"}, {"source_term": "morphisms", "target_term": "态射"}, {"source_term": "functors", "target_term": "函子"}, {"source_term": "morphism", "target_term": "态射"}, {"source_term": "strongly cartesian", "target_term": "强笛卡尔"}, {"source_term": "morphisms", "target_term": "态射"}, {"source_term": "functors", "target_term": "函子"}, {"source_term": "morphisms", "target_term": "态射"}], "term_status": "DECISION_REQUIRED", "translation": "设<MATH_0001>为范畴（category）。<TEXTITOPEN_0001><MATH_0002>-集合纤维化范畴之范畴（category of categories fibred in sets），基底为<MATH_0003><TEXTITCLOSE_0001>，是子<MATH_0004>-范畴（category），属于由<MATH_0005>上纤维化（fibred）于群胚（groupoids）的范畴（categories）构成的范畴（category）（见定义<REF_0001>），其定义如下：\n<STRUCT_0001>\n<STRUCT_0002> 其对象（objects）为范畴（categories）<MATH_0006>，它们纤维化（fibred）于集合（sets）。\n<STRUCT_0003> 其<MATH_0007>-态射（morphisms）<MATH_0008>是函子（functors）<MATH_0009>，满足<MATH_0010>（由于每个态射（morphism）都是强笛卡尔（strongly cartesian）的，<MATH_0011>自动保持它们）。\n<STRUCT_0004> 其<MATH_0012>-态射（morphisms）<MATH_0013>，对于<MATH_0014>，是函子（functors）的态射（morphisms），满足<MATH_0015>，对所有<MATH_0016>均如此。\n<STRUCT_0005>\n", "translation_hash": "sha256:1a45000a5558b2e5a0243404dd24ba081d724913119810fc8fa2d1d1db2ef1d3", "unit_id": "tag:04S8:statement", "unknown_terms": [{"context": "基底及高阶范畴；待决。", "source_term": "category", "target_term": "范畴"}, {"context": "本定义的高阶范畴名称，阶数及基底受保护；待决。", "source_term": "category of categories fibred in sets", "target_term": "集合纤维化范畴之范畴"}, {"context": "高阶范畴的对象；待决。", "source_term": "categories", "target_term": "范畴"}, {"context": "给定范畴的纤维化条件；待决。", "source_term": "fibred", "target_term": "纤维化"}, {"context": "环境范畴的群胚纤维化条件；待决。", "source_term": "groupoids", "target_term": "群胚"}, {"context": "对象的集合纤维化条件；待决。", "source_term": "sets", "target_term": "集合"}, {"context": "高阶范畴中的对象；待决。", "source_term": "objects", "target_term": "对象"}, {"context": "带阶数限定的态射及函子之间的态射；待决。", "source_term": "morphisms", "target_term": "态射"}, {"context": "第一阶态射及第二阶态射的端点；待决。", "source_term": "functors", "target_term": "函子"}, {"context": "自动具有强笛卡尔性的态射；待决。", "source_term": "morphism", "target_term": "态射"}, {"context": "所有态射自动具有的性质；待决。", "source_term": "strongly cartesian", "target_term": "强笛卡尔"}]}
