{"chapter": "morphisms", "node_kind": "lemma", "parent_tag": "056H", "placeholders": {"MATH_0001": "$X$", "MATH_0002": "$\\mathcal{F}$", "MATH_0003": "$X$", "MATH_0004": "$\\mathcal{F}$"}, "render": {"prefix": "\\begin{lemma}\n\\label{lemma-support-closed-specialization}\n", "suffix": "\\end{lemma}"}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:df7f51b8f6af480f656f1eca1a8a109966b799fd8f64f327143a9f84d518ca9c", "source_status": "CURRENT", "source_structure_hash": "sha256:996653c746d1ec1ff2c338f976b26a0fd865100b09fc82680008451127718ca1", "source_text": "Let <MATH_0001> be a scheme.\nLet <MATH_0002> be a quasi-coherent sheaf on <MATH_0003>.\nThe support of <MATH_0004> is closed under specialization.\n", "source_text_hash": "sha256:ded9f8ddc8c144513cbef2877f57b60179b42968c82b15684490b53564c7a18d", "unit_id": "tag:05AC:statement"}
