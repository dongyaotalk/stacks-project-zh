{"chapter": "guide", "node_kind": "subsection_title", "parent_tag": "04V4", "placeholders": {}, "render": {"prefix": "\\subsection{", "suffix": "}\n\\label{guide-subsection-hilbert-quot-hom}\n\n\\noindent\n"}, "risk_level": "R1", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:3bfb8eace49cd3ce9722568f2a81907066b9bbed5c4b93a56c5ee72d4caeb152", "source_text": "Hilbert, Quot, Hom and branchvariety stacks", "source_text_hash": "sha256:e17b395a5a48f17d3a9bb2c2163f6518105f957abdc4fa7b84611785e0948fc9", "unit_id": "tag:04V4:title"}
