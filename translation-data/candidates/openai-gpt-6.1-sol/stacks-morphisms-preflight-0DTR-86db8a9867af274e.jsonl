256:efb827df70d6f0ba02337402f171fcadf7e83ba8ef94aa2fe14c60372542a1d5", "unit_id": "inventory:stacks-morphisms:0DTT:lemma/0001"}}}, {"context_id": "sha256:5ef363b522d31ece2d90db2b2ee9399254196b40899504a502302e24cf96d9ab", "hash": "sha256:5ef363b522d31ece2d90db2b2ee9399254196b40899504a502302e24cf96d9ab", "value": {"kind": "locked-English-neighbor", "location": {"byte_end": 138879, "byte_start": 138149, "file": "stacks-morphisms.tex", "fragment_hash": "sha256:241c9a75861d15777155d2d23f8d0274ef17eeee95fdc52a30767c0d2599dd5c", "line_end": 3798, "line_start": 3785}, "owner_tag": "0DTU", "parent_tag": "0DTR", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "stacks-morphisms", "node_kind": "remark", "parent_tag": "0DTR", "placeholders": {"LOCKED_0001": "\\label{remark-property-automorphism-groups}", "MATH_0001": "$P$", "MATH_0002": "$\\mathcal{X}$", "MATH_0003": "$x \\in |\\mathcal{X}|$", "MATH_0004": "$\\mathcal{X}$", "MATH_0005": "$x$", "MATH_0006": "$P$", "MATH_0007": "$\\mathcal{X}$", "MATH_0008": "$x$", "MATH_0009": "$G_x \\to \\Spec(k)$", "MATH_0010": "$x : \\Spec(k) \\to \\mathcal{X}$", "MATH_0011": "$x$", "REF_0001": "\\ref{lemma-property-automorphism-groups}", "STRUCT_0001": "\\begin{remark}", "STRUCT_0002": "\\end{remark}", "TEXTITCLOSE_0001": "}", "TEXTITOPEN_0001": "{\\it "}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:c2e048adfc4efead185ef91be1397985c7120a261a34f07213e8340ca9877af1", "source_status": "CURRENT", "source_structure_hash": "sha256:be2cd1c5c299fd4e5f40d3fd94e2c8921a786bf3f9dd496ad6070e7aa54deb71", "source_text": "<STRUCT_0001>\n<LOCKED_0001>\nLet <MATH_0001> be a property of algebraic spaces over fields which is invariant\nunder ground field extensions. Given an algebraic stack <MATH_0002>\nand <MATH_0003>, we say the automorphism group of <MATH_0004>\nat <MATH_0005> has <MATH_0006> if the equivalent conditions of\nLemma <REF_0001> are satisfied.\nFor example, we say <TEXTITOPEN_0001>the automorphism group of <MATH_0007>\nat <MATH_0008> is finite<TEXTITCLOSE_0001>, if <MATH_0009> is finite whenever\n<MATH_0010> is a representative of <MATH_0011>.\nSimilarly for smooth, proper, etc.\n(There is clearly an abuse of language going on here, but we\nbelieve it will not cause confusion or imprecision.)\n<STRUCT_0002>", "source_text_hash": "sha256:c213789ca7f1daebd390e213959f17f14056b587e354f6d491909610f427fac1", "unit_id": "inventory:stacks-morphisms:0DTU:remark/0001"}}}], "input_freeze": {"hash": "sha256:b7a785960481a06a97be8a94b7ae4b8f10f8e0b6a58e83f6ea4c040b3ff2f9e7", "path": "translation-data/source-adoption-inputs/p0-101-stacks-morphisms-p043.json"}, "model_output": {"hash": "sha256:f0f3d52348bfdbcd2193b4a181afb368fcc30d23aa59b2418a3f58d66c67f9a0", "path": "docs/evidence/p0-101-stacks-morphisms-p043-raw-01.jsonl", "record_hash": "sha256:82c4f31c606938a018bfdb573153a18420b9bbfd105391381f461204434e44a6"}, "neighbor_unit_ids": ["tag:0DTT:proof"], "policy_revision": "git:7c4e1984fe4e6b4ae37e01477744ca9f9a46294c", "prior_generations": [], "prompt_version": "translator-v2", "source_adoption_id": "p0-101-stacks-morphisms-p043", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "style_guide_path": "config/style-guide.md", "turn_id": "01a20c35-8459-7061-aee0-2e985a7072f3", "unit_id": "tag:0DTT:statement"}, "context_hash": "sha256:3dac1ac5b2335a48c561d7c932d6ca714471170491f162814765dd85edde5f4c", "created_at": "2026-11-24T06:19:27.670774+00:00", "glossary_revision": "git:7c4e1984fe4e6b4ae37e01477744ca9f9a46294c", "harness_id": "codex", "harness_version": "0.172.0", "model_id": "gpt-6.1-sol", "model_identity_confidence": "declared", "model_lane": "openai-gpt-6.1-sol", "model_record_id": "openai:gpt-6.1-sol:declared", "model_snapshot": null, "notes": [], "prompt_version": "translator-v2", "publication_status": "CANDIDATE", "qa_status": "PASS", "reaso