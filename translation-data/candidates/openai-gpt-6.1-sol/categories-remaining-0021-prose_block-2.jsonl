85, "line_start": 976}, "owner_tag": "0023", "parent_tag": "0021", "semantic_path": "definition/0001", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "categories", "node_kind": "definition", "parent_tag": "0021", "placeholders": {"LOCKED_0001": "\\label{definition-representable-map-presheaves}", "MATH_0001": "$\\mathcal{C}$", "MATH_0002": "$F, G : \\mathcal{C}^{opp} \\to \\textit{Sets}$", "MATH_0003": "$a : F \\to G$", "MATH_0004": "$F$", "MATH_0005": "$G$", "MATH_0006": "$U \\in \\Ob(\\mathcal{C})$", "MATH_0007": "$\\xi \\in G(U)$", "MATH_0008": "$h_U \\times_{\\xi, G, a} F$", "STRUCT_0001": "\\begin{definition}", "STRUCT_0002": "\\end{definition}", "TEXTITCLOSE_0001": "}", "TEXTITCLOSE_0002": "}", "TEXTITOPEN_0001": "{\\it ", "TEXTITOPEN_0002": "{\\it "}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:de215175745878360f8ac43c4a6b1df1691af031fb64145e1085bc2bf3a87376", "source_status": "CURRENT", "source_structure_hash": "sha256:6b9c3d9bc07208a39370ef72c29e335ded663bdf2d1c4dffadc5111e71e04f7d", "source_text": "<STRUCT_0001>\n<LOCKED_0001>\nLet <MATH_0001> be a category.\nLet <MATH_0002>\nbe functors. We say a morphism <MATH_0003> is\n<TEXTITOPEN_0001>representable<TEXTITCLOSE_0001>, or that <TEXTITOPEN_0002><MATH_0004> is relatively representable\nover <MATH_0005><TEXTITCLOSE_0002>, if for every <MATH_0006>\nand any <MATH_0007> the functor\n<MATH_0008> is representable.\n<STRUCT_0002>", "source_text_hash": "sha256:a7d7bb5f174eddbd3b9cd9cfec2f8ef06a1175ecb8c38d66b67b178a19efc900", "unit_id": "inventory:categories:0023:definition/0001"}, "state": "READY"}, "reference:categories-definition-representable-morphism": {"context_hash": "sha256:5e485fbe0cacd40f9863c6eb2191aab7185a059e8dff752c67a9649491f97ebe", "kind": "locked-English-reference", "location": {"byte_end": 27037, "byte_start": 26783, "file": "categories.tex", "fragment_hash": "sha256:02d2fc2d9d205510c84182a620663ca167ed042610b660e2b0da972ddd2c9c75", "line_end": 788, "line_start": 783}, "owner_tag": "001X", "parent_tag": "001U", "requested_label": "categories-definition-representable-morphism", "requested_tag": "001X", "semantic_path": "definition/0001", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "categories", "node_kind": "definition", "parent_tag": "001U", "placeholders": {"LOCKED_0001": "\\label{definition-representable-morphism}", "MATH_0001": "$f : x \\to y$", "MATH_0002": "$\\mathcal{C}$", "MATH_0003": "$z \\to y$", "MATH_0004": "$\\mathcal{C}$", "MATH_0005": "$x \\times_y z$", "STRUCT_0001": "\\begin{definition}", "STRUCT_0002": "\\end{definition}", "TEXTITCLOSE_0001": "}", "TEXTITOPEN_0001": "{\\it "}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:15b6b20253f4eeccb0f1d296054f2e9cb5f1860a67a87ec84ef56a7eab05a6f5", "source_status": "CURRENT", "source_structure_hash": "sha256:e9c105ec5f1ef105a2fa58775bcf7959dc8cd520fef52063b22ae24a5cc983f1", "source_text": "<STRUCT_0001>\n<LOCKED_0001>\nA morphism <MATH_0001> of a category <MATH_0002> is said to be\n<TEXTITOPEN_0001>representable<TEXTITCLOSE_0001> if for every morphism <MATH_0003>\nin <MATH_0004> the fibre product <MATH_0005> exists.\n<STRUCT_0002>", "source_text_hash": "sha256:79db78e82fc5ec41fd86bfd5a0f4f65803d2a9df5c74c2930f800bc106de27dd", "unit_id": "inventory:categories:001X:definition/0001"}, "state": "READY"}, "reference:categories-lemma-yoneda": {"context_hash": "sha256:02615723e30cd2eded9ec770d4bc197cd246e0a8ad20b8ed2982bcf675da0d42", "kind": "locked-English-reference", "location": {"byte_end": 20318, "byte_start": 19691, "file": "categories.tex", "fragment_hash": "sha256:2a5052d951cf1e928456104a391eaabfaf366e9dae4c7b7ae9205d410ed9909a", "line_end": 558, "line_start": 540}, "owner_