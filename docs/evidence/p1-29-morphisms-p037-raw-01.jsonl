{"unit_id": "tag:0B3F:statement", "translation": "设<MATH_0001>是态射（morphism），其源和靶均为概形（schemes）。\n设<MATH_0002>是可逆（invertible）的<MATH_0003>模（module）。\n设<MATH_0004>是态射（morphism），其源和靶均为概形（schemes）。\n令<MATH_0005>为<MATH_0006>的基变换（base change），并记<MATH_0007>为<MATH_0008>到<MATH_0009>的拉回（pullback）。\n若<MATH_0010>相对于<MATH_0011>很丰沛（very ample），则<MATH_0012>相对于<MATH_0013>很丰沛（very ample）。\n", "allowed_english": [], "term_occurrences": [{"source_term": "morphism", "target_term": "态射"}, {"source_term": "schemes", "target_term": "概形"}, {"source_term": "invertible", "target_term": "可逆"}, {"source_term": "module", "target_term": "模"}, {"source_term": "morphism", "target_term": "态射"}, {"source_term": "schemes", "target_term": "概形"}, {"source_term": "base change", "target_term": "基变换"}, {"source_term": "pullback", "target_term": "拉回"}, {"source_term": "very ample", "target_term": "很丰沛"}, {"source_term": "very ample", "target_term": "很丰沛"}], "unknown_terms": [{"source_term": "morphism", "target_term": "态射", "context": "首个概形之间的箭头。"}, {"source_term": "schemes", "target_term": "概形", "context": "首个态射的源和靶。"}, {"source_term": "invertible", "target_term": "可逆", "context": "假设中模的性质。"}, {"source_term": "module", "target_term": "模", "context": "假设中可逆的模。"}, {"source_term": "morphism", "target_term": "态射", "context": "用于基变换的另一个概形之间的箭头。"}, {"source_term": "schemes", "target_term": "概形", "context": "第二个态射的源和靶。"}, {"source_term": "base change", "target_term": "基变换", "context": "沿第二个态射进行的变换。"}, {"source_term": "pullback", "target_term": "拉回", "context": "将原模拉回到基变换后的源。"}, {"source_term": "very ample", "target_term": "很丰沛", "context": "原模相对于原态射的假设。"}, {"source_term": "very ample", "target_term": "很丰沛", "context": "拉回的模相对于基变换后态射的结论。"}], "notes": []}
