{"chapter": "criteria", "node_kind": "proposition", "parent_tag": "05Y0", "placeholders": {"MATH_0001": "$S$", "MATH_0002": "$Z \\to B$", "MATH_0003": "$X \\to B$", "MATH_0004": "$S$", "MATH_0005": "$Z \\to B$", "MATH_0006": "$\\mathit{Mor}_B(Z, X)$"}, "render": {"prefix": "\\begin{proposition}\n\\label{proposition-hom-functor-algebraic-space}\n", "suffix": "\\end{proposition}"}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:8aa00f5e3e318af70c2e4356cad172a4ae1079d173cb6c83772b9be6d1824af8", "source_status": "CURRENT", "source_structure_hash": "sha256:33bbf3e9b715397762f2218328152ab6d72ae3747826ae6ab61113c38d21b14c", "source_text": "Let <MATH_0001> be a scheme. Let <MATH_0002> and <MATH_0003> be morphisms of\nalgebraic spaces over <MATH_0004>. If <MATH_0005> is finite locally free\nthen <MATH_0006> is an algebraic space.\n", "source_text_hash": "sha256:3a95aac4d3c30d06a079a1ed45821dba33a7dcaddcea01c2e7b885daf8d24abe", "unit_id": "tag:05Y7:statement"}
