{"unit_id":"tag:03YC:prose-0004","translation":"\n\n<STRUCT_0001>\n定义了这个概念后，可以进行局部化（localize），得到代数空间（algebraic space）的平展（<ACCENT_0001>tale）位点（site）。\n\n","allowed_english":[],"term_occurrences":[{"source_term":"localize","target_term":"局部化"},{"source_term":"algebraic space","target_term":"代数空间"},{"source_term":"<ACCENT_0001>tale","target_term":"平展"},{"source_term":"site","target_term":"位点"}],"unknown_terms":[{"source_term":"localize","target_term":"局部化","context":"构造相应位点的操作；待批准。"},{"source_term":"algebraic space","target_term":"代数空间","context":"位点对应的空间；待批准。"},{"source_term":"<ACCENT_0001>tale","target_term":"平展","context":"所构造的位点；待批准。"},{"source_term":"site","target_term":"位点","context":"局部化所得位点；待批准。"}],"notes":[]}
