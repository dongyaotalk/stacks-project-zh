apter": "sheaves", "node_kind": "lemma", "parent_tag": "008C", "placeholders": {"LOCKED_0001": "\\label{lemma-pushforward-sheaf}", "MATH_0001": "$f : X \\to Y$", "MATH_0002": "$\\mathcal{F}$", "MATH_0003": "$X$", "MATH_0004": "$f_*\\mathcal{F}$", "MATH_0005": "$Y$", "STRUCT_0001": "\\begin{lemma}", "STRUCT_0002": "\\end{lemma}"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:50c31e793b272209cf08face1953be37f83b09e13f46cdae82c2d10ed01ca9fb", "source_status": "CURRENT", "source_structure_hash": "sha256:cf7f371c645d3e32cc24383ea9b455528431548b474969695762246ef95fc499", "source_text": "<STRUCT_0001>\n<LOCKED_0001>\nLet <MATH_0001> be a continuous map.\nLet <MATH_0002> be a sheaf of sets on <MATH_0003>.\nThen <MATH_0004> is a sheaf on <MATH_0005>.\n<STRUCT_0002>", "source_text_hash": "sha256:13075268629c5ef17e831656cdaa66f0a3797831181094d2d3f1995d1a31766c", "unit_id": "inventory:sheaves:008D:lemma/0001"}}}], "input_freeze": {"hash": "sha256:414c1c58a1ca7b2ea6832f131d0adc6554fa357743f072ff26882d813ca39874", "path": "translation-data/source-adoption-inputs/p1-06-sheaves-d003.json"}, "model_output": {"hash": "sha256:9c7d81df52c950435272ca77eb66ee0988f64743704e5800b3b838be6b24c182", "path": "docs/evidence/p1-06-sheaves-d003-raw-01.jsonl", "record_hash": "sha256:a492cf67572ada96195ca42a364e6610a9c785fce718d606ec0fad61cb17e6ae"}, "neighbor_unit_ids": [], "policy_revision": "git:0cd5a696ed1fb6b267587570250073149a81bf7f", "prior_generations": [], "prompt_version": "translator-v2", "source_adoption_id": "p1-06-sheaves-d003", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "style_guide_path": "config/style-guide.md", "turn_id": "01a219d7-577e-7d73-b8e5-9c8405e10edb", "unit_id": "tag:008C:prose-0001"}, "context_hash": "sha256:f1fe1b707a798a5a6c09cc623140c38a226e74bc433275a0e9ef85073a4aa82e", "created_at": "2026-11-26T21:51:14.078Z", "glossary_revision": "git:0cd5a696ed1fb6b267587570250073149a81bf7f", "harness_id": "codex", "harness_version": "0.172.0", "model_id": "gpt-6.2-sol", "model_identity_confidence": "declared", "model_lane": "openai-gpt-6.2-sol", "model_record_id": "openai:gpt-6.2-sol:declared", "model_snapshot": null, "notes": [], "prompt_version": "translator-v2", "publication_status": "CANDIDATE", "qa_status": "PASS", "reasoning_effort": "high", "run_id": "run-p1-06-sheaves-d003", "schema_version": 2, "source_adoption_id": "p1-06-sheaves-d003", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_status": "CURRENT", "source_text_hash": "sha256:9fab4112c229877c54a4ca3df3c88e20b78268c5866a05321556442723b5902d", "stage": "STRUCTURE_OK", "term_occurrences": [{"source_term": "map", "target_term": "映射"}, {"source_term": "topological spaces", "target_term": "拓扑空间"}, {"source_term": "pushforward", "target_term": "直像"}, {"source_term": "pullback functors", "target_term": "拉回函子"}, {"source_term": "presheaves", "target_term": "预层"}, {"source_term": "sheaves", "target_term": "层"}, {"source_term": "presheaf", "target_term": "预层"}, {"source_term": "sets", "target_term": "集合"}, {"source_term": "pushforward", "target_term": "直像"}, {"source_term": "map", "target_term": "映射"}, {"source_term": "diagram", "target_term": "图表"}, {"source_term": "presheaf", "target_term": "预层"}, {"source_term": "sets", "target_term": "集合"}, {"source_term": "presheaf", "target_term": "预层"}, {"source_term": "functor", "target_term": "函子"}], "term_status": "DECISION_REQUIRED", "translation": "\n\n<STRUCT_0001>\n设<MATH_0001>为连续映射（map），其源空间和目标空间均为拓扑空间（topological spaces）。\n我们将定义直像（pushforward）函子和拉回函子（pullback functors），对预层（presheaves）和层（sheaves）都给出这两种函子。\n\n<STRUCT_0002><STRUCT_0003>\n设<MATH_0002>是<MATH_0003>上的一个预层（presheaf），取值于集合（sets）。我们定义<TEXTITOPEN_0001>直像（pushforward）<TEXTITCLOSE_0001>，对<MATH_0004>采用如下规则\n<MATH_0005>\n其中<MATH_0006>为任意开集。\n给定<MATH_0007>，其中所涉集合均为开集，限制映射（map）由下列图表（diagram）的交换性给出\n<MATHSEG_0001>限制，适用于<MATHSEG_0002>\n显然，这定义了一个预层（presheaf），取值于集合（sets）。这一构造显然关于预层（presheaf）<MATH_0008>是函子性的，因此我们得到一个函子（functor）\n<MATH_0009>\n\n", "translation_hash": "sha256:5458d42d310fcf71c7fef63007df0b17c499fc612e3d7bd23c90e67343d58fc4", "unit_id": "tag:008C:prose-0001", "unknown_terms": [{"context": "开头所设连续映射的名词。", "source_term": "map", "target_term": "映射"}, {"context": "连续映射的源空间和目标空间。", "source_term": "topological spaces", "target_term": "拓扑空间"}, {"context": "开头预告定义的沿连续映射取直像的函子。", "source_term": "pushforward", "target_term": "直像"}, {"context": "开头与直像函子并列预告定义的函子。", "source_term": "pullback functors", "target_term": "拉回函子"}, {"context": "开头列举的第一类函子对象。", "source_term": "presheaves", "target_term": "预层"}, {"context": "开头列举的第二类函子对象。", "source_term": "sheaves", "target_term": "层"}, {"context": "用于定义直像的原预层。", "source_term": "presheaf", "target_term": "预层"}, {"context": "原预层所取的值。", "source_term": "sets", "target_term": "集合"}, {"context": "按给定规则定义的原预层的直像。", "source_term": "pushforward", "target_term": "直像"}, {"context": "由交换图表给出的限制映射。", "source_term": "map", "target_term": "映射"}, {"context": "用其交换性给出限制映射的图表。", "source_term": "diagram", "target_term": "图表"}, {"context": "由给定规则和限制映射定义出的预层。", "source_term": "presheaf", "target_term": "预层"}, {"context": "所构造出的预层所取的值。", "source_term": "sets", "target_term": "集合"}, {"context": "直像构造对其具有函子性的原预层。", "source_term": "presheaf", "target_term": "预层"}, {"context": "从直像构造的函子性得到的函子。", "source_term": "functor", "target_term": "函子"}]}
