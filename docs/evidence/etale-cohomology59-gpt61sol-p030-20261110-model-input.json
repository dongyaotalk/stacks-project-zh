    {
      "context_id": "locked-English-neighbor:etale-cohomology:inventory:etale-cohomology:04JM:proof/0001",
      "value": {
        "kind": "locked-English-neighbor",
        "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14",
        "source_unit": {
          "schema_version": 1,
          "unit_id": "inventory:etale-cohomology:04JM:proof/0001",
          "parent_tag": "03QW",
          "chapter": "etale-cohomology",
          "node_kind": "proof",
          "risk_level": "R3",
          "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14",
          "source_text": "<STRUCT_0001>\nWe can prove this using formal arguments and the result of\nTheorem <REF_0001>\nas follows. Given a sheaf <MATH_0001> corresponding to\nthe <MATH_0002>-set <MATH_0003> we have\n<MATH_0004>\nHere the first identification is explained in\nSites, Sections <REF_0002> and\n<REF_0003>,\nthe second results from\nTheorem <REF_0004>\nand the third is clear. We will also give a direct proof<FOOTNOTEOPEN_0001>For\nthe doubting Thomases out there.<FOOTNOTECLOSE_0001>.\n\n<STRUCT_0002><STRUCT_0003>\nSuppose that <MATH_0005> is a global section.\nThen the triple <MATH_0006> defines an element of\n<MATH_0007> which is clearly invariant under the\naction of <MATH_0008>. Conversely, suppose that <MATH_0009>\ndefines an element of <MATH_0010> which is invariant.\nThen we may shrink <MATH_0011> and assume <MATH_0012> for some\nfinite separable field extension of <MATH_0013>, see\nProposition <REF_0005>.\nIn this case the map <MATH_0014>\nis injective, because for any morphism of <ACCENT_0001>tale neighbourhoods\n<MATH_0015> the restriction map\n<MATH_0016> is injective since <MATH_0017>\nis a covering of <MATH_0018>.\nAfter enlarging <MATH_0019> a bit we may assume <MATH_0020> is a finite\nGalois extension. At this point we use that\n<MATH_0021>\nwhere the maps <MATH_0022>\ncome from the ring maps <MATH_0023>. Hence we\nsee that the condition that <MATH_0024> is invariant\nunder all of <MATH_0025> implies that <MATH_0026>\nmaps to the same element of\n<MATH_0027>\nvia restriction by either projection (this uses the injectivity mentioned\nabove; details omitted). Hence the sheaf condition of <MATH_0028>\nfor the <ACCENT_0002>tale covering <MATH_0029> kicks\nin and we conclude that <MATH_0030> comes from a unique section of <MATH_0031>\nover <MATH_0032>.\n<STRUCT_0004>",
          "source_status": "CURRENT",
          "placeholders": {
            "STRUCT_0001": "\\begin{proof}",
            "REF_0001": "\\ref{theorem-equivalence-sheaves-point}",
            "MATH_0001": "$\\mathcal{F}$",
            "MATH_0002": "$G$",
            "MATH_0003": "$M = \\mathcal{F}_{\\overline{s}}$",
            "MATH_0004": "\\begin{eqnarray*}\n\\Gamma(S, \\mathcal{F}) & = &\n\\Mor_{\\Sh(S_\\etale)}(h_{\\Spec(K)},  \\mathcal{F})\n\\\\\n& = & \\Mor_{G\\textit{-Sets}}(\\{*\\}, M) \\\\\n& = & M^G\n\\end{eqnarray*}",
            "REF_0002": "\\ref{sites-section-presheaves}",
            "REF_0003": "\\ref{sites-section-representable-sheaves}",
            "REF_0004": "\\ref{theorem-equivalence-sheaves-point}",
            "FOOTNOTEOPEN_0001": "\\footnote{",
            "FOOTNOTECLOSE_0001": "}",
            "STRUCT_0002": "\\medskip",
            "STRUCT_0003": "\\noindent",
            "MATH_0005": "$t \\in \\Gamma(S, \\mathcal{F})$",
            "MATH_0006": "$(S, \\overline{s}, t)$",
            "MATH_0007": "$\\mathcal{F}_{\\overline{s}}$",
            "MATH_0008": "$G$",
            "MATH_0009": "$(U, \\overline{u}, t)$",
            "MATH_0010": "$\\mathcal{F}_{\\overline{s}}$",
            "MATH_0011": "$U$",
            "MATH_0012": "$U = \\Spec(L)$",
            "MATH_0013": "$K$",
            "REF_0005": "\\ref{proposition-etale-morphisms}",
            "MATH_0014": "$\\mathcal{F}(U) \\to \\mathcal{F}_{\\overline{s}}$",
            "ACCENT_0001": "\\'e",
            "MATH_0015": "$(U', \\overline{u}') \\to (U, \\overline{u})$",
            "MATH_0016": "$\\mathcal{F}(U) \\to \\mathcal{F}(U')$",
            "MATH_0017": "$U' \\to U$",
            "MATH_0018": "$S_\\etale$",
            "MATH_0019": "$L$",
            "MATH_0020": "$K \\subset L$",
            "MATH_0021": "$$\n\\Spec(L) \\times_{\\Spec(K)} \\Spec(L)\n=\n\\coprod\\nolimits_{\\sigma \\in \\text{Gal}(L/K)} \\Spec(L)\n$$",
            "MATH_0022": "$\\Spec(L) \\to \\Spec(L \\otimes_K L)$",
            "MATH_0023": "$a \\otimes b \\mapsto a\\sigma(b)$",
            "MATH_0024": "$(U, \\overline{u}, t)$",
            "MATH_0025": "$G$",
            "MATH_0026": "$t \\in \\mathcal{F}(\\Spec(L))$",
            "MATH_0027": "$\\mathcal{F}(\\Spec(L) \\times_{\\Spec(K)} \\Spec(L))$",
            "MATH_0028": "$\\mathcal{F}$",
            "ACCENT_0002": "\\'e",
            "MATH_0029": "$\\{\\Spec(L) \\to \\Spec(K)\\}$",
            "MATH_0030": "$t$",
            "MATH_0031": "$\\mathcal{F}$",
            "MATH_0032": "$\\Spec(K)$",
            "STRUCT_0004": "\\end{proof}"
          },
          "render": {
