        "source_unit": {
          "schema_version": 1,
          "unit_id": "inventory:constructions:062Q:definition/0001",
          "parent_tag": "062P",
          "chapter": "constructions",
          "node_kind": "definition",
          "risk_level": "R3",
          "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14",
          "source_text": "<STRUCT_0001>\n<LOCKED_0001>\nLet <MATH_0001> be a scheme. Let <MATH_0002> be a quasi-coherent\ngraded <MATH_0003>-algebra. Assume that <MATH_0004>\nis an isomorphism<FOOTNOTEOPEN_0001>Often one imposes the assumption that\n<MATH_0005> is generated by <MATH_0006> over <MATH_0007>. We do not\nassume this in order to be consistent with <REF_0001>.<FOOTNOTECLOSE_0001>.\nThe <TEXTITOPEN_0001>cone associated to <MATH_0008><TEXTITCLOSE_0001> or the\n<TEXTITOPEN_0002>affine cone associated to <MATH_0009><TEXTITCLOSE_0002>\nis\n<MATH_0010>\n<STRUCT_0002>",
          "source_status": "CURRENT",
          "placeholders": {
            "STRUCT_0001": "\\begin{definition}",
            "LOCKED_0001": "\\label{definition-cone}",
            "MATH_0001": "$S$",
            "MATH_0002": "$\\mathcal{A}$",
            "MATH_0003": "$\\mathcal{O}_S$",
            "MATH_0004": "$\\mathcal{O}_S \\to \\mathcal{A}_0$",
            "FOOTNOTEOPEN_0001": "\\footnote{",
            "MATH_0005": "$\\mathcal{A}$",
            "MATH_0006": "$\\mathcal{A}_1$",
            "MATH_0007": "$\\mathcal{O}_S$",
            "REF_0001": "\\cite[II, (8.3.1)]{EGA}",
            "FOOTNOTECLOSE_0001": "}",
            "TEXTITOPEN_0001": "{\\it ",
            "MATH_0008": "$\\mathcal{A}$",
            "TEXTITCLOSE_0001": "}",
            "TEXTITOPEN_0002": "{\\it ",
            "MATH_0009": "$\\mathcal{A}$",
            "TEXTITCLOSE_0002": "}",
            "MATH_0010": "$$\nC(\\mathcal{A}) = \\underline{\\Spec}_S(\\mathcal{A}).\n$$",
            "STRUCT_0002": "\\end{definition}"
          },
          "render": {
            "prefix": "",
            "suffix": ""
          },
          "source_text_hash": "sha256:9ec925b36027904ca312cf0981e44e449ce7f41737f100744bddc19ed828d9e1",
