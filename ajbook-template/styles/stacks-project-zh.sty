\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{styles/stacks-project-zh}[2026/09/10 Chinese AJbook adapter for the Stacks Project]

\RequirePackage{stacks-project-macros}
\RequirePackage{makeidx}
\RequirePackage{etoolbox}
\RequirePackage{hyperref}

\hypersetup{
  pageanchor=true,
  breaklinks=true,
  unicode=true,
  bookmarksnumbered=true,
  bookmarksopen=true,
  linktoc=all,
  plainpages=false,
  pdfstartview=Fit,
  pdfpagelayout=OneColumn,
  pdfborder={0 0 0}
}
\urlstyle{same}

\setlength{\parindent}{2em}
\setlength{\parskip}{0pt plus 1pt}
\emergencystretch=3em

\renewcommand{\indexname}{索引}
\providecommand{\idxquad}{\quad}

% AJbook defines its standard theorem environments at begin-document time.
% Register the extra Stacks source environments afterwards and share the same
% (subsection-backed) counter.
\AtBeginDocument{%
  \theoremstyle{plain}%
  \theoremsymbol{}%
  \theorembodyfont{\songti}%
  \theoremheaderfont{\sffamily\bfseries\thmheiti}%
  \theoremseparator{\ }%
  \newtheorem{situation}[subsection]{情形}%
  \newtheorem{remarks}[subsection]{注记}%
}

\newcommand{\StacksTag}[1]{%
  \href{https://stacks.math.columbia.edu/tag/#1}{\texttt{Tag #1}}}

\endinput
