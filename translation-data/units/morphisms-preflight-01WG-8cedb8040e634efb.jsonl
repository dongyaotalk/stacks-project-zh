{"chapter": "morphisms", "node_kind": "lemma", "parent_tag": "01WG", "placeholders": {}, "render": {"prefix": "\\begin{lemma}\n\\label{lemma-composition-finite}\n", "suffix": "\\end{lemma}"}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:7524aea0628a813d776247ceb6f857c1e3f263da21b8e4fcc8afeb6a29bf4c80", "source_text": "A composition of finite morphisms is finite.\nSame is true for integral morphisms.\n", "source_text_hash": "sha256:d25355ec1f5ff182f41b7e0bd6f5d458ac029c9dabcbd5e9303c28424d0532e0", "unit_id": "tag:01WK:statement"}
