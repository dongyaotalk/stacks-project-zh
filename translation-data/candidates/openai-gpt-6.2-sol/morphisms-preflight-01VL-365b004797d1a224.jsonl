788c3aefee52ad9f5b2474ecf67aabe861982ca9c6f7c0d557e759c7a0c", "source_text": "<STRUCT_0001>\n<LOCKED_0001>\nAn immersion of schemes is a monomorphism.\nIn particular, any immersion is separated.\n<STRUCT_0002>", "source_text_hash": "sha256:b73666010eb639d207908bba87f14665e0baa1563ee7c05fe44993f7dd4801a3", "unit_id": "inventory:schemes:01L7:lemma/0001"}}}, {"context_id": "sha256:9211470ba2b86767384e124c065aebbc365669262b59427125a1fff7ddce9ef7", "hash": "sha256:9211470ba2b86767384e124c065aebbc365669262b59427125a1fff7ddce9ef7", "value": {"kind": "locked-English-reference", "location": {"byte_end": 141851, "byte_start": 141790, "file": "schemes.tex", "fragment_hash": "sha256:54f4ab054ba0ae3e8ed671a8382999102fd7728b936a75a91fe2a5acfc1267d1", "line_end": 4005, "line_start": 4004}, "owner_tag": "01KH", "parent_tag": "01KH", "requested_label": "schemes-section-separation-axioms", "requested_tag": "01KH", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "schemes", "node_kind": "section_title", "parent_tag": "01KH", "placeholders": {"LOCKED_0001": "\\label{section-separation-axioms}", "TEXTCLOSE_0001": "}", "TEXTOPEN_0001": "\\section{"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R1", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:054d92661d5404a94aecedf61d6bf7f6d863d39cc259698f5adb2e2eb466dc4b", "source_text": "<TEXTOPEN_0001>Separation axioms<TEXTCLOSE_0001>\n<LOCKED_0001>", "source_text_hash": "sha256:8b13dc890d0a15f9f7ce37c41202b644b19e60c3c58a951b28d3d0c5b9545e62", "unit_id": "inventory:schemes:01KH:section_title/0001"}}}], "input_freeze": {"hash": "sha256:5911b2835eccbd19a137896f4a9c41dab1c6a9322ef04842edd4b2a7ddd2e1ce", "path": "translation-data/source-adoption-inputs/p1-29-morphisms-p036.json"}, "model_output": {"hash": "sha256:ae0109cd7efcbec4c1d7ffa30fdd1606c8d8234b736e02d3d528649313ea2f5b", "path": "docs/evidence/p1-29-morphisms-p036-raw-01.jsonl", "record_hash": "sha256:c4b44478d25929f4621c69c23be47bd10605c7b8cb598053b61d9491bb37807d"}, "neighbor_unit_ids": ["tag:01VQ:statement"], "policy_revision": "git:c0c436b9d7ac86a6d277fd74ff439fd2389bdb84", "prior_generations": [], "prompt_version": "translator-v2", "source_adoption_id": "p1-29-morphisms-p036", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "style_guide_path": "config/style-guide.md", "turn_id": "01a21bc3-dc96-7fd0-b40b-22957793028b", "unit_id": "tag:01VQ:proof"}, "context_hash": "sha256:588e0a461e17e98c308c81e5cdc854382349250ffc4febe2d1d671ff15e7edb8", "created_at": "2026-11-27T06:49:11.957Z", "glossary_revision": "git:c0c436b9d7ac86a6d277fd74ff439fd2389bdb84", "harness_id": "codex", "harness_version": "0.172.0", "model_id": "gpt-6.2-sol", "model_identity_confidence": "declared", "model_lane": "openai-gpt-6.2-sol", "model_record_id": "openai:gpt-6.2-sol:declared", "model_snapshot": null, "notes": [], "prompt_version": "translator-v2", "publication_status": "CANDIDATE", "qa_status": "PASS", "reasoning_effort": "high", "run_id": "run-p1-29-morphisms-p036", "schema_version": 2, "source_adoption_id": "p1-29-morphisms-p036", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_status": "CURRENT", "source_text_hash": "sha256:aebb8cea0572f671789bfb896026283a5bc34f64d6726bbf634ba2b2a51fd228", "stage": "STRUCTURE_OK", "term_occurrences": [{"source_term": "separated", "target_term": "分离"}, {"source_term": "local on the base", "target_term": "在基底上是局部的"}, {"source_term": "Schemes", "target_term": "概形"}, {"source_term": "immersion", "target_term": "浸入"}, {"source_term": "separated", "target_term": "分离"}, {"source_term": "Schemes", "target_term": "概形"}, {"source_term": "locally", "target_term": "局部地"}, {"source_term": "immersion", "target_term": "浸入"}, {"source_term": "graded ring", "target_term": "分次环"}, {"source_term": "homogeneous spectrum", "target_term": "齐次谱"}, {"source_term": "separated", "target_term": "分离"}, {"source_term": "Constructions", "target_term": "构造"}], "term_status": "DECISION_REQUIRED", "translation": "分离（separated）这一性质在基底上是局部的（local on the base）（见《概形（Schemes）》第<REF_0001>节）。\n浸入（immersion）是分离（separated）的（见《概形（Schemes）》引理<REF_0002>）。\n故该引理成立，因为局部地（locally），<MATH_0001>有一个浸入（immersion），其目标是一个分次环（graded ring）的齐次谱（homogeneous spectrum），而后者是分离（separated）的，见《构造（Constructions）》引理<REF_0003>。\n", "translation_hash": "sha256:44d9d9b727114c62b7ea4b143762e02de7d3e25294b988b7cd2485929041cdf7", "unit_id": "tag:01VQ:proof", "unknown_terms": [{"context": "此处讨论分离性可在基底上局部检验。", "source_term": "separated", "target_term": "分离"}, {"context": "说明分离性的局部性是相对于基底而言。", "source_term": "local on the base", "target_term": "在基底上是局部的"}, {"context": "指分离性局部性的出处所在章节。", "source_term": "Schemes", "target_term": "概形"}, {"context": "指第二句断言具备分离性的一类态射。", "source_term": "immersion", "target_term": "浸入"}, {"context": "指第二句断言浸入具备的性质。", "source_term": "separated", "target_term": "分离"}, {"context": "指浸入具有分离性这一引理的出处所在章节。", "source_term": "Schemes", "target_term": "概形"}, {"context": "修饰通向齐次谱的浸入的存在断言。", "source_term": "locally", "target_term": "局部地"}, {"context": "指局部存在的、以齐次谱为目标的态射。", "source_term": "immersion", "target_term": "浸入"}, {"context": "指构成该齐次谱所用的环。", "source_term": "graded ring", "target_term": "分次环"}, {"context": "指用作局部浸入目标的谱。", "source_term": "homogeneous spectrum", "target_term": "齐次谱"}, {"context": "指所用齐次谱具备的性质。", "source_term": "separated", "target_term": "分离"}, {"context": "指齐次谱具有分离性这一引理的出处所在章节。", "source_term": "Constructions", "target_term": "构造"}]}
