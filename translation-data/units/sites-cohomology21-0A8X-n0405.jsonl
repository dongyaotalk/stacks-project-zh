{"chapter": "sites-cohomology", "node_kind": "paragraph", "parent_tag": "0A8X", "placeholders": {"MATH_0001": "$(\\mathcal{C}, \\mathcal{O})$", "MATH_0002": "$\\mathcal{L}^\\bullet$", "MATH_0003": "$\\mathcal{M}^\\bullet$", "MATH_0004": "$\\mathcal{O}$", "MATH_0005": "$\\mathcal{O}$", "MATH_0006": "$\\SheafHom^\\bullet(\\mathcal{L}^\\bullet, \\mathcal{M}^\\bullet)$", "MATH_0007": "$n$", "MATH_0008": "$$\n\\SheafHom^n(\\mathcal{L}^\\bullet, \\mathcal{M}^\\bullet) =\n\\prod\\nolimits_{n = p + q}\n\\SheafHom_\\mathcal{O}(\\mathcal{L}^{-q}, \\mathcal{M}^p)\n$$", "MATH_0009": "$\\SheafHom^n$", "MATH_0010": "$\\mathcal{O}$", "MATH_0011": "$\\mathcal{O}$", "MATH_0012": "$\\mathcal{L}^\\bullet$", "MATH_0013": "$\\mathcal{M}^\\bullet$", "MATH_0014": "$\\mathcal{O}$", "MATH_0015": "$n$", "MATH_0016": "$$\n\\text{d}(f) =\n\\text{d}_\\mathcal{M} \\circ f - (-1)^n f \\circ \\text{d}_\\mathcal{L}\n$$", "MATH_0017": "$f \\in \\SheafHom^n_\\mathcal{O}(\\mathcal{L}^\\bullet, \\mathcal{M}^\\bullet)$", "MATH_0018": "$\\text{d}^2 = 0$", "MATH_0019": "\\begin{equation}\n\\label{equation-cohomology-hom-complex}\nH^n(\\Gamma(U, \\SheafHom^\\bullet(\\mathcal{L}^\\bullet, \\mathcal{M}^\\bullet))) =\n\\Hom_{K(\\mathcal{O}_U)}(\\mathcal{L}^\\bullet|_U, \\mathcal{M}^\\bullet[n]|_U)\n\\end{equation}", "MATH_0020": "$n \\in \\mathbf{Z}$", "MATH_0021": "$U \\in \\Ob(\\mathcal{C})$", "MATH_0022": "\\begin{equation}\n\\label{equation-global-cohomology-hom-complex}\nH^n(\\Gamma(\\mathcal{C},\n\\SheafHom^\\bullet(\\mathcal{L}^\\bullet, \\mathcal{M}^\\bullet))) =\n\\Hom_{K(\\mathcal{O})}(\\mathcal{L}^\\bullet, \\mathcal{M}^\\bullet[n])\n\\end{equation}", "REF_0001": "\\ref{dga-example-category-complexes}", "STRUCT_0001": "\\noindent"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R2", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:f29f58564cfd07f81717f4bf014efa9e1f9f9fa3e8e6353ae1e001d98bc89f66", "source_status": "CURRENT", "sour