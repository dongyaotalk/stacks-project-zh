{"unit_id":"tag:06YR:statement","translation":"设 <MATH_0001> 为赋环位点（ringed site）。设 <MATH_0002> 为 K-平坦（K-flat）复形（complexes）的系（system）。则 <MATH_0003> 是 K-平坦（K-flat）的。\n","allowed_english":[],"term_occurrences":[{"source_term":"ringed site","target_term":"赋环位点"},{"source_term":"K-flat","target_term":"K-平坦"},{"source_term":"complexes","target_term":"复形"},{"source_term":"system","target_term":"系"},{"source_term":"K-flat","target_term":"K-平坦"}],"unknown_terms":[{"source_term":"ringed site","target_term":"赋环位点","context":"底层位点"},{"source_term":"K-flat","target_term":"K-平坦","context":"余极限保持的性质"},{"source_term":"complexes","target_term":"复形","context":"系中的复形"},{"source_term":"system","target_term":"系","context":"复形系"}],"notes":[]}
