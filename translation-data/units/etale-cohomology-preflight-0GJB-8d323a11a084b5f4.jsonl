{"chapter": "etale-cohomology", "node_kind": "paragraph", "parent_tag": "0GJB", "placeholders": {"REF_0001": "\\ref{section-vanishing-torsion}", "STRUCT_0001": "\\noindent"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R2", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:85ab2f9bf3288f5f2e77b9d65eb81948fa2aabf1c0a3950fd9901dae9de1b599", "source_text": "\n\n<STRUCT_0001>\nIn this section we repeat the arguments of\nSection <REF_0001>\nfor constructible sheaves of modules over a Noetherian ring\nwhich are torsion. We start with the most interesting step.\n\n", "source_text_hash": "sha256:c623ad25a4652f90b83da2a510c517881f2e41920fe6d3b81ee40998d6973ad1", "unit_id": "tag:0GJB:prose-0001"}
