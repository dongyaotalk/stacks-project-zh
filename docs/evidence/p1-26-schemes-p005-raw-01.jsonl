{"unit_id": "tag:01I6:prose-0003", "translation": "\n\n<STRUCT_0001>\n从此以后，我们不再区分仿射概形（affine schemes）上的拟凝聚层（quasi-coherent sheaves）和形如<MATH_0001>的层（sheaves）。\n\n", "allowed_english": [], "term_occurrences": [{"source_term": "affine schemes", "target_term": "仿射概形"}, {"source_term": "quasi-coherent sheaves", "target_term": "拟凝聚层"}, {"source_term": "sheaves", "target_term": "层"}], "unknown_terms": [{"source_term": "affine schemes", "target_term": "仿射概形", "context": "第一类层所在的空间"}, {"source_term": "quasi-coherent sheaves", "target_term": "拟凝聚层", "context": "从此不再与给定形式的层区分的对象"}, {"source_term": "sheaves", "target_term": "层", "context": "具有给定形式的对象"}], "notes": []}
{"unit_id": "tag:01IC:statement", "translation": "设<MATH_0001>为仿射概形（affine scheme）。拟凝聚（quasi-coherent）的<MATH_0002>-模（modules）之间的映射（maps），其核（Kernels）和余核（cokernels）都是拟凝聚（quasi-coherent）的。\n", "allowed_english": [], "term_occurrences": [{"source_term": "affine scheme", "target_term": "仿射概形"}, {"source_term": "quasi-coherent", "target_term": "拟凝聚"}, {"source_term": "modules", "target_term": "模"}, {"source_term": "maps", "target_term": "映射"}, {"source_term": "Kernels", "target_term": "核"}, {"source_term": "cokernels", "target_term": "余核"}, {"source_term": "quasi-coherent", "target_term": "拟凝聚"}], "unknown_terms": [{"source_term": "affine scheme", "target_term": "仿射概形", "context": "给定的概形类型"}, {"source_term": "quasi-coherent", "target_term": "拟凝聚", "context": "对映射两端的模的假设"}, {"source_term": "modules", "target_term": "模", "context": "映射两端的对象类型"}, {"source_term": "maps", "target_term": "映射", "context": "对其取核和余核"}, {"source_term": "Kernels", "target_term": "核", "context": "断言拟凝聚的第一类对象"}, {"source_term": "cokernels", "target_term": "余核", "context": "断言拟凝聚的第二类对象"}, {"source_term": "quasi-coherent", "target_term": "拟凝聚", "context": "核与余核具有的性质"}], "notes": []}
