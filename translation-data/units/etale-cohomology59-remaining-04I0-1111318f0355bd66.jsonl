7e735c96ecec467d442e75d8b62fb4916e", "container_byte_span": {"end": 165283, "start": 165050}, "container_hash": "sha256:caac7a4771a5bd57eb100a5860e9c26593418d563cc3e07fd5706445c3dab831"}, {"command_byte_span": {"end": 165119, "start": 165100}, "command_hash": "sha256:d3ad291598a6cc0f9eeb0642cb94217e735c96ecec467d442e75d8b62fb4916e", "container_byte_span": {"end": 165283, "start": 165050}, "container_hash": "sha256:caac7a4771a5bd57eb100a5860e9c26593418d563cc3e07fd5706445c3dab831"}], "ordinal": 1, "owner_label": "etale-cohomology-section-functoriality", "owner_tag": "04I0", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14"}, "policy_hash": "sha256:29d7a759bdc4d4411eb3aeccfe7fcce5603644085ae4365b37f9ec839e6a1ee7", "source_label": "etale-cohomology-section-functoriality", "usage": "etale-scheme-diagrams", "usage_source": {"after": "$", "before": "= ", "environments": []}}, "command": "text", "policy_entry": "etale-cohomology-8c1965f6f0da", "slot_byte_span": {"end": 44, "start": 32}, "slot_id": "math/0001/text/0002", "source": "final object"}], "source": "$u(\\text{final object}) = \\text{final object}$", "source_byte_span": {"end": 698, "start": 652}, "source_hash": "sha256:6148e1d79fc369adb3afbae260765699eb0221d6ae71c922a9848fec2b46df6b"}], "node_kind": "paragraph", "parent_tag": "04I0", "placeholders": {"ACCENT_0001": "\\'e", "ACCENT_0002": "\\'e", "ACCENT_0003": "\\'e", "ACCENT_0004": "\\'e", "ACCENT_0005": "\\'e", "MATHSEG_0001": "$u(\\text{", "MATHSEG_0002": "}) = \\text{", "MATHSEG_0003": "}$", "MATH_0001": "$f : X \\to Y$", "MATH_0002": "\\begin{equation}\n\\label{equation-functorial}\nu : Y_\\etale \\longrightarrow X_\\etale, \\quad\nV/Y \\longmapsto X \\times_Y V/X.\n\\end{equation}", "MATH_0003": "$u$", "MATH_0004": "$\\{V_j \\to V\\}$", "MATH_0005": "$Y_\\etale$", "MATH_0006": "$\\{u(V_j) \\to u(V)\\}$", "MATH_0007": "$X_\\etale$", "MATH_0008": "$$\nf_{small} : X_\\etale \\longrightarrow Y_\\etale,\n$$", "MATH_0009": "$f_{small, *}$", "MATH_0010": "$f_{small}^{-1}$", "REF_0001": "\\ref{topologies-section-etale}", "REF_0002": "\\ref{sites-definition-morphism-sites}", "REF_0003": "\\ref{sites-proposition-get-morphism}", "STRUCT_0001": "\\noindent", "STRUCT_0002": "\\medskip", "STRUCT_0003": "\\noindent", "STRUCT_0004": "\\begin{enumerate}", "STRUCT_0005": "\\item", "STRUCT_0006": "\\item", "STRUCT_0007": "\\item", "STRUCT_0008": "\\end{enumerate}", "TEXTITCLOSE_0001": "}", "TEXTITOPEN_0001": "{\\it "}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R3", "schema_version": 2, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:d296be1b6d7c0823cf46df63a9eabfeab7ff7f53093462b615ca5da54ff060ee", "source_math_skeleton_hash": "sha256:c9e13882c030143138e5c99d492d6257c198a66002a396c6aee461fa105f3b93", "source_status": "CURRENT", "source_structure_hash": "sha256:fa6af3ec278ac2cb1bf7c77e32b80d8f41d33f5352186143019dcf2b0897dce3", "source_text": "\n\n<STRUCT_0001>\nSo far we haven't yet discussed the functoriality of the <ACCENT_0001>tale site, in\nother words what happens when given a morphism of schemes. A precise formal\ndiscussion can be found in\nTopologies, Section <REF_0001>.\nIn this and the next sections we discuss this material briefly specifically\nin the setting of small <ACCENT_0002>tale sites.\n\n<STRUCT_0002><STRUCT_0003>\nLet <MATH_0001> be a morphism of schemes. We obtain a functor\n<MATH_0002>\nThis functor has the following important properties\n<STRUCT_0004>\n<STRUCT_0005> <MATHSEG_0001>final object<MATHSEG_0002>final object<MATHSEG_0003>,\n<STRUCT_0006> <MATH_0003> preserves fibre products,\n<STRUCT_0007> if <MATH_0004> is a covering in <MATH_0005>, then\n<MATH_0006> is a covering in <MATH_0007>.\n<STRUCT_0008>\nEach of these is easy to check (omitted). As a consequence we obtain what\nis called a <TEXTITOPEN_0001>morphism of sites<TEXTITCLOSE_0001>\n<MATH_0008>\nsee\nSites, Definition <REF_0002>\nand\nSites, Proposition <REF_0003>.\nIt is not necessary to know about the abstract notion in detail\nin order to work with <ACCENT_0003>tale sheaves and <ACCENT_0004>tale cohomology.\nIt usually suffices to know that there are functors\n<MATH_0009> (pushforward) and <MATH_0010> (pullback)\non <ACCENT_0005>tale sheaves, and to know some of their simple properties.\nWe will discuss these properties in the next sections, but we will\nsometimes refer to the more abstract material for proofs since\nthat is often the natural setting to prove them.\n\n\n", "source_text_hash": "sha256:2ba129a78db89531d64b958a8f57451719b605e6d227cd61f28e1653cab7969d", "unit_id": "tag:04I0:prose-0001"}
