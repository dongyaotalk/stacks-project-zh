{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stacks-project-zh.invalid/schema/source-reextraction.schema.json",
  "title": "Immutable locked-English proof re-extraction evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_reextraction_id", "derivation_id", "source_commit", "created_at", "old_unit", "new_unit", "old_source_tex_hash", "new_source_tex_hash", "selector", "fragment", "fragment_hash"],
  "properties": {
    "schema_version": {"const": 1},
    "source_reextraction_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "derivation_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "old_unit": {"type": "object"},
    "new_unit": {"type": "object"},
    "old_source_tex_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "new_source_tex_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "selector": {
      "type": "object", "additionalProperties": false,
      "required": ["file", "statement_tag", "statement_label", "kind", "proof_index"],
      "properties": {
        "file": {"type": "string", "pattern": "^[A-Za-z0-9_-]+\\.tex$"},
        "statement_tag": {"type": "string", "pattern": "^[0-9A-Z]+$"},
        "statement_label": {"type": "string", "pattern": "^[A-Za-z0-9._:+-]+$"},
        "kind": {"const": "proof"},
        "proof_index": {"type": "integer"}
      }
    },
    "fragment": {"type": "string", "minLength": 1},
    "fragment_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
