{"chapter": "sites", "node_kind": "paragraph", "parent_tag": "00YW", "placeholders": {"STRUCT_0001": "\\noindent"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R2", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:223cd6fb2213f56ad803f2a85a5e3131ab69888c18e9f9cc11ad78150514e4d5", "source_text": "\n\n<STRUCT_0001>\nAt this point we can define\nwithout any motivation what a sheaf is.\n\n", "source_text_hash": "sha256:4df4f1fad2a0f678aa9605f22ae96d9eb5ff072155eb96b1c15dba59a623587b", "unit_id": "tag:00YW:prose-0006"}
