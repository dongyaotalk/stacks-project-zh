          "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14",
          "source_text": "<STRUCT_0001>\n<LOCKED_0001>\nLet <MATH_0001>\nbe an affine scheme. Let <MATH_0002> be an <MATH_0003>-module. There exists a canonical\nisomorphism between the sheaf <MATH_0004> associated to the <MATH_0005>-module\n<MATH_0006> (Definition <REF_0001>) and the sheaf\n<MATH_0007> associated to the <MATH_0008>-module <MATH_0009>\n(Modules, Definition <REF_0002>).\nThis isomorphism is functorial in <MATH_0010>. In particular,\nthe sheaves <MATH_0011> are quasi-coherent. Moreover, they\nare characterized by the following mapping property\n<MATH_0012>\nfor any sheaf of <MATH_0013>-modules <MATH_0014>.\nHere a map <MATH_0015> corresponds\nto its effect on global sections.\n<STRUCT_0002>",
          "source_status": "CURRENT",
          "placeholders": {
            "STRUCT_0001": "\\begin{lemma}",
            "LOCKED_0001": "\\label{lemma-compare-constructions}",
            "MATH_0001": "$(X, \\mathcal{O}_X) = (\\Spec(R), \\mathcal{O}_{\\Spec(R)})$",
            "MATH_0002": "$M$",
            "MATH_0003": "$R$",
            "MATH_0004": "$\\widetilde M$",
            "MATH_0005": "$R$",
            "MATH_0006": "$M$",
            "REF_0001": "\\ref{definition-structure-sheaf}",
            "MATH_0007": "$\\mathcal{F}_M$",
            "MATH_0008": "$R$",
            "MATH_0009": "$M$",
            "REF_0002": "\\ref{modules-definition-sheaf-associated}",
            "MATH_0010": "$M$",
            "MATH_0011": "$\\widetilde M$",
            "MATH_0012": "$$\n\\Hom_{\\mathcal{O}_X}(\\widetilde M, \\mathcal{F})\n=\n\\Hom_R(M, \\Gamma(X, \\mathcal{F}))\n$$",
            "MATH_0013": "$\\mathcal{O}_X$",
            "MATH_0014": "$\\mathcal{F}$",
            "MATH_0015": "$\\alpha : \\widetilde M \\to \\mathcal{F}$",
            "STRUCT_0002": "\\end{lemma}"
