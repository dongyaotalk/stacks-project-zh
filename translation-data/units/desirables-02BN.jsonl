{"chapter": "desirables", "node_kind": "paragraph", "parent_tag": "02BN", "placeholders": {"LATIN_0001": "\\'etale", "MATH_0001": "$1$", "QUOTECLOSE_0001": "''", "QUOTEOPEN_0001": "``", "REF_0001": "\\ref{stacks-cohomology-section-lisse-etale}", "REF_0002": "\\ref{examples-section-lisse-etale-not-functorial}"}, "render": {"prefix": "\\noindent\n", "suffix": "\n\n"}, "risk_level": "R2", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:aac061bd983bb0f94e2a4090413873d992eb27445b9946699dcdee9b85ff3a03", "source_status": "CURRENT", "source_structure_hash": "sha256:37e3e8cc71bfc315635057f8ce66ddbcdc952ed8161e42531c978d766c5a0282", "source_text": "This has been introduced in Cohomology of Stacks, Section <REF_0001>. An example to show that it is not functorial with respect to <MATH_0001>-morphisms of algebraic stacks is discussed in Examples, Section <REF_0002>. Of course a lot more could be said about this, but it turns out to be very useful to prove things using the <QUOTEOPEN_0001>big<QUOTECLOSE_0001> <LATIN_0001> site as much as possible.", "source_text_hash": "sha256:f5239ace71dd28da7436902c52ec63aed032292c4a806bb75c08823601d6f2bc", "unit_id": "tag:02BN:p001"}
