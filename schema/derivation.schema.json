{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stacks-project-zh.invalid/schema/derivation.schema.json",
  "title": "Immutable historical tool derivation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "derivation_id",
    "source_commit",
    "created_at",
    "tool",
    "files",
    "unit_id_map",
    "operations",
    "origin_commit"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "derivation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "const": "stacks-zh-derive"
        },
        "version": {
          "enum": ["1", "2"]
        }
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_units",
        "input_candidates",
        "output_units",
        "output_candidates"
      ],
      "properties": {
        "input_units": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "hash"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "input_candidates": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "hash"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "output_units": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "hash"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "output_candidates": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "hash"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "unit_id_map": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "unit_id",
          "kinds",
          "reason",
          "unit_updates",
          "candidate_updates"
        ],
        "properties": {
          "unit_id": {
            "type": "string",
            "minLength": 1
          },
          "kinds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "coordinates",
                "protected-extraction",
                "term-display",
                "footnote-display",
                "model-revision"
              ]
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "unit_updates": {
            "type": "object"
          },
          "candidate_updates": {
            "type": "object"
          },
          "model_correction_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          }
        }
      }
    },
    "origin_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    }
  }
}
