, "TEXTCLOSE_0001": "}", "TEXTOPEN_0001": "\\section{"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R1", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:3173e86e0552da45a9f266bdbf3de61d192679c2a9734622d72a2d5660e2e76e", "source_text": "<TEXTOPEN_0001>Picard groups of curves<TEXTCLOSE_0001>\n<LOCKED_0001>", "source_text_hash": "sha256:c272a90ff0a07e62f4e27ec02e48dde1402521a465b9397baa2c42bdf3154e4b", "unit_id": "inventory:etale-cohomology:03RN:section_title/0001"}}}, {"context_id": "locked-English-neighbor:etale-cohomology:inventory:etale-cohomology:03RQ:lemma/0001", "hash": "sha256:4b4f7f9cf0a6a4f5ff9dd7ec81e9a3d77587638ee94088c8cc60134965252b29", "value": {"kind": "locked-English-neighbor", "location": {"byte_end": 412854, "byte_start": 412023, "file": "etale-cohomology.tex", "fragment_hash": "sha256:64a8f8992609254eaef51fb6ebe2cb4a0d3889bd5314c0b04af221b32d5a4d1c", "line_end": 11163, "line_start": 11134}, "owner_tag": "03RQ", "parent_tag": "03RN", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "etale-cohomology", "node_kind": "lemma", "parent_tag": "03RN", "placeholders": {"LOCKED_0001": "\\label{lemma-cohomology-smooth-projective-curve}", "MATH_0001": "$X$", "MATH_0002": "$g$", "MATH_0003": "$k$", "MATH_0004": "$n \\geq 1$", "MATH_0005": "$k$", "MATH_0006": "$$\nH_\\etale^q(X, \\mu_n) =\n\\left\\{\n\\begin{matrix}\n\\mu_n(k) & \\text{ if }q = 0, \\\\\n\\Pic^0(X)[n] & \\text{ if }q = 1, \\\\\n\\mathbf{Z}/n\\mathbf{Z} & \\text{ if }q = 2, \\\\\n0 & \\text{ if }q \\geq 3.\n\\end{matrix}\n\\right.\n$$", "MATH_0007": "$\\mu_n \\cong \\underline{\\mathbf{Z}/n\\mathbf{Z}}$", "MATH_0008": "$$\nH_\\etale^q(X, \\underline{\\mathbf{Z}/n\\mathbf{Z}}) \\cong\n\\left\\{\n\\begin{matrix}\n\\mathbf{Z}/n\\mathbf{Z} & \\text{ if }q = 0, \\\\\