{"unit_id": "tag:0G44:statement", "translation": "设<MATH_0001>为环同态（ring map）。记<MATH_0002>为相应的仿射概形（affine schemes）之间的态射（morphism）。设<MATH_0003>和<MATH_0004>为<MATH_0005>-模（modules）。若<MATH_0006>是拟凝聚的（quasi-coherent），则将微分算子（differential operator）送到它在整体截面（global sections）上的作用的映射（map）\n<MATH_0007>\n是双射（bijective）。\n", "allowed_english": [], "term_occurrences": [{"source_term": "ring map", "target_term": "环同态"}, {"source_term": "affine schemes", "target_term": "仿射概形"}, {"source_term": "morphism", "target_term": "态射"}, {"source_term": "modules", "target_term": "模"}, {"source_term": "quasi-coherent", "target_term": "拟凝聚的"}, {"source_term": "differential operator", "target_term": "微分算子"}, {"source_term": "global sections", "target_term": "整体截面"}, {"source_term": "map", "target_term": "映射"}, {"source_term": "bijective", "target_term": "双射"}], "unknown_terms": [{"source_term": "ring map", "target_term": "环同态", "context": "引理设定的环之间的同态。"}, {"source_term": "affine schemes", "target_term": "仿射概形", "context": "相应态射的两个对象。"}, {"source_term": "morphism", "target_term": "态射", "context": "由给定环同态对应得到的概形态射。"}, {"source_term": "modules", "target_term": "模", "context": "引理所设的两个模。"}, {"source_term": "quasi-coherent", "target_term": "拟凝聚的", "context": "映射为双射所需的条件。"}, {"source_term": "differential operator", "target_term": "微分算子", "context": "所述映射的输入。"}, {"source_term": "global sections", "target_term": "整体截面", "context": "取微分算子的作用所用的截面。"}, {"source_term": "map", "target_term": "映射", "context": "把微分算子送到其在整体截面上的作用。"}, {"source_term": "bijective", "target_term": "双射", "context": "引理在给定条件下断言的映射性质。"}], "notes": []}
