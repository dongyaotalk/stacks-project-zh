    {
      "context_id": "locked-English-reference:descent:inventory:descent:023Q:lemma/0001:descent-lemma-fpqc-universal-effective-epimorphisms",
      "value": {
        "kind": "locked-English-reference",
        "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14",
        "source_unit": {
          "schema_version": 1,
          "unit_id": "inventory:descent:023Q:lemma/0001",
          "parent_tag": "023P",
          "chapter": "descent",
          "node_kind": "lemma",
          "risk_level": "R3",
          "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14",
          "source_text": "<STRUCT_0001>\n<LOCKED_0001>\nLet <MATH_0001> be an fpqc covering, see\nTopologies, Definition <REF_0001>.\nThen <MATH_0002> is a universal effective epimorphism\nin the category of schemes, see\nSites, Definition <REF_0002>.\nIn other words, every representable functor on the category of schemes\nsatisfies the sheaf condition for the fpqc topology, see\nTopologies, Definition <REF_0003>.\n<STRUCT_0002>",
          "source_status": "CURRENT",
          "placeholders": {
            "STRUCT_0001": "\\begin{lemma}",
            "LOCKED_0001": "\\label{lemma-fpqc-universal-effective-epimorphisms}",
            "MATH_0001": "$\\{T_i \\to T\\}$",
            "REF_0001": "\\ref{topologies-definition-fpqc-covering}",
            "MATH_0002": "$\\{T_i \\to T\\}$",
            "REF_0002": "\\ref{sites-definition-universal-effective-epimorphisms}",
            "REF_0003": "\\ref{topologies-definition-sheaf-property-fpqc}",
            "STRUCT_0002": "\\end{lemma}"
          },
          "render": {
            "prefix": "",
            "suffix": ""
          },
