    {
      "unit_id": "tag:06NC:statement",
      "source_text": "Let <MATH_0001> be a flat, quasi-compact, surjective monomorphism.\nThen f is an isomorphism.\n",
      "node_kind": "lemma",
      "protected_nodes": {
        "MATH_0001": "$f : X \\to Y$"
      },
      "required_source_terms": [
        {
          "source_term": "flat",
          "projection_start": 21,
          "projection_end": 25,
          "concept": "flat",
          "rule": "catalog"
        },
        {
          "source_term": "quasi-compact",
          "projection_start": 27,
          "projection_end": 40,
          "concept": "quasi-compact",
          "rule": "catalog"
        },
        {
          "source_term": "surjective",
          "projection_start": 42,
          "projection_end": 52,
          "concept": "surjective",
          "rule": "catalog"
        },
        {
          "source_term": "monomorphism",
          "projection_start": 53,
          "projection_end": 65,
          "concept": "monomorphism",
