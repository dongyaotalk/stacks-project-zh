. Then there exists\nan equivalence <MATH_0012> of categories over\n<MATH_0013> such that <MATH_0014> is <MATH_0015>-isomorphic to <MATH_0016> as <MATH_0017>-morphisms\nof categories over <MATH_0018>. If the diagram above actually commutes, then\nwe can arrange it so that <MATH_0019> is <MATH_0020>-isomorphic to <MATH_0021> as\n<MATH_0022>-morphisms of categories over <MATH_0023>.\n<STRUCT_0002>", "source_text_hash": "sha256:ecf46b27cb373aa83e184b93040cfc437ac2deff274956abb77c58e49a8b72f8", "unit_id": "inventory:categories:06N8:lemma/0001"}, "state": "READY"}, "reference:categories-lemma-ameliorate-morphism-categories-fibred-groupoids": {"context_hash": "sha256:e0f718254afff752efaaf6dc0686ec1280a206ec154aedf864e8a22e2d92060c", "kind": "locked-English-reference", "location": {"byte_end": 266998, "byte_start": 266461, "file": "categories.tex", "fragment_hash": "sha256:f04316fb417919053e57699c3e8b9205af5d15c2410944d6194862ba8f3afbbd", "line_end": 7498, "line_start": 7489}, "owner_tag": "06N7", "parent_tag": "003S", "requested_label": "categories-lemma-ameliorate-morphism-categories-fibred-groupoids", "requested_tag": "06N7", "semantic_path": "lemma/0001", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "categories", "node_kind": "lemma", "parent_tag": "003S", "placeholders": {"LOCKED_0001": "\\label{lemma-ameliorate-morphism-categories-fibred-groupoids}", "MATH_0001": "$\\mathcal{C}$", "MATH_0002": "$F : \\mathcal{X} \\to \\mathcal{Y}$", "MATH_0003": "$1$", "MATH_0004": "$\\mathcal{C}$", "MATH_0005": "$\\mathcal{X} \\to \\mathcal{X}' \\to \\mathcal{Y}$", "MATH_0006": "$1$", "MATH_0007": "$\\mathcal{C}$", "MATH_0008": "$\\mathcal{X} \\to \\mathcal{X}'$", "MATH_0009": "$\\mathcal{C}$", "MATH_0010": "$\\mathcal{X}'$", "MATH_0011": "$\\mathcal{Y}$", "STRUCT_0001": "\\begin{lemma}", "STRUCT_0002": "\\end{lemma}"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871a