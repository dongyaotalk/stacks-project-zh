          "node_kind": "definition",
          "risk_level": "R3",
          "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14",
          "source_text": "<STRUCT_0001>\n<LOCKED_0001>\nLet <MATH_0001> be a scheme. A <TEXTITOPEN_0001>cone <MATH_0002> over <MATH_0003><TEXTITCLOSE_0001> is an\naffine morphism of schemes such that <MATH_0004> is endowed with\nthe structure of a graded <MATH_0005>-algebra\n<MATH_0006>\nsuch that <MATH_0007>. A <TEXTITOPEN_0002>morphism of cones<TEXTITCLOSE_0002>\nfrom <MATH_0008> to <MATH_0009>\nis a morphism <MATH_0010> such that the induced map\n<MATH_0011>\nis compatible with the given gradings.\n<STRUCT_0002>",
          "source_status": "CURRENT",
          "placeholders": {
            "STRUCT_0001": "\\begin{definition}",
            "LOCKED_0001": "\\label{definition-abstract-cone}",
            "MATH_0001": "$S$",
            "TEXTITOPEN_0001": "{\\it ",
            "MATH_0002": "$\\pi : C \\to S$",
            "MATH_0003": "$S$",
            "TEXTITCLOSE_0001": "}",
            "MATH_0004": "$\\pi_*\\mathcal{O}_C$",
            "MATH_0005": "$\\mathcal{O}_S$",
            "MATH_0006": "$\\pi_*\\mathcal{O}_C = \\bigoplus\\nolimits_{n \\geq 0} \\mathcal{A}_n$",
            "MATH_0007": "$\\mathcal{A}_0 = \\mathcal{O}_S$",
            "TEXTITOPEN_0002": "{\\it ",
            "TEXTITCLOSE_0002": "}",
            "MATH_0008": "$\\pi : C \\to S$",
            "MATH_0009": "$\\pi' : C' \\to S$",
            "MATH_0010": "$f : C \\to C'$",
            "MATH_0011": "$$\nf^* : \\pi'_*\\mathcal{O}_{C'} \\longrightarrow \\pi_*\\mathcal{O}_C\n$$",
            "STRUCT_0002": "\\end{definition}"
          },
          "render": {
            "prefix": "",
            "suffix": ""
          },
          "source_text_hash": "sha256:e1394bbc1938d8e59cf2bdfd9970505931936951c7207efe4a4d045b6723e92f",
          "source_structure_hash": "sha256:25b6d2486b4e0bd6d70f83bd3f8337cf360483ac1ee84a3d1a090f800d2a80e9",
          "source_math_hash": "sha256:434166c7fe419baee1062354776b972f703c110d87235d0521019104bdecc663"
        },
