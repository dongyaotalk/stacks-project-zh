3873dc89b6adc6ec2bc4a7ddd0bf7", "container_byte_span": {"end": 120611, "start": 119763}, "container_hash": "sha256:535b83fa2b11982de34852e1e9c114fc511335350fcf6a14070f53e861aa6aee"}, {"command_byte_span": {"end": 120515, "start": 120494}, "command_hash": "sha256:69422d8fcbadd1b21d8d828105f555f88713873dc89b6adc6ec2bc4a7ddd0bf7", "container_byte_span": {"end": 120611, "start": 119763}, "container_hash": "sha256:535b83fa2b11982de34852e1e9c114fc511335350fcf6a14070f53e861aa6aee"}], "ordinal": 1, "owner_label": "cotangent-lemma-compute-L-morphism-sheaves-rings", "owner_tag": "08SW", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14"}, "policy_hash": "sha256:4108cf525225a3a755d96ea80bf1b4fb421350b56ee9543c0b8ab97e2eaa3f9f", "source_label": "cotangent-lemma-compute-L-morphism-sheaves-rings", "usage": "cotangent-source-frames", "usage_source": {"after": "U", "before": "{", "environments": []}}, "command": "text", "policy_entry": "cotangent-sections-over", "slot_byte_span": {"end": 138, "start": 124}, "slot_id": "math/0001/text/0002", "source": "sections over "}], "source": "$$\n\\xymatrix{\n\\mathcal{A}\\textit{-Alg} \\ar[d]_{\\text{sections over }U} \\ar[r] &\n\\Sh(\\mathcal{C}) \\ar@<1ex>[l] \\ar[d]^{\\text{sections over }U} \\\\\n\\mathcal{A}(U)\\textit{-Alg} \\ar[r] & \\textit{Sets} \\ar@<1ex>[l]\n}\n$$", "source_byte_span": {"end": 826, "start": 613}, "source_hash": "sha256:393c3675852e26bce88e24864d829164a050e8e7d8e38597939311312765652c"}], "node_kind": "proof", "parent_tag": "08UQ", "placeholders": {"MATHSEG_0001": "$$\n\\xymatrix{\n\\mathcal{A}\\textit{-Alg} \\ar[d]_{\\text{", "MATHSEG_0002": "}U} \\ar[r] &\n\\Sh(\\mathcal{C}) \\ar@<1ex>[l] \\ar[d]^{\\text{", "MATHSEG_0003": "}U} \\\\\n\\mathcal{A}(U)\\textit{-Alg} \\ar[r] & \\textit{Sets} \\ar@<1ex>[l]\n}\n$$", "MATH_0001": "$\\mathcal{C}'$", "MATH_0002": "$\\mathcal{C}$", "MATH_0003": "$f : \\Sh(\\mathcal{C}) \\to \\Sh(\\mathcal{C}')$", "MATH_0004": "$f_*$", "MATH_0005": "$f^{-1}$", "MATH_0006": "$\\mathcal{C}'$", "MATH_0007": "$\\mathcal{C}$", "MATH_0008": "$\\mathcal{C}$", "MATH_0009": "$L_{\\mathcal{B}/\\mathcal{A}}(U)$", "MATH_0010": "$L_{\\mathcal{B}(U)/\\mathcal{A}(U)}$", "REF_0001": "\\ref{lemma-pullback-cotangent-morphism-topoi}", "STRUCT_0001": "\\medskip", "STRUCT_0002": "\\noindent"}, "render": {"prefix": "\\begin{proof}\n", "suffix": "\\end{proof}"}, "risk_level": "R3", "schema_version": 2, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:675c5c57ae3ca2b738d98bf591915d385543ce63629c132983e35a969a8b37be", "source_math_skeleton_hash": "sha256:92ae8f903140d268a6622f9adf4b0ff876f2b713d682c4c600f2cedf66fa8e7a", "source_status": "CURRENT", "source_structure_hash": "sha256:7288d5d94de9ee3d56eb1ae6044efef7c7ed64050d86fee28951f7a71ec5c31c", "source_text": "Let <MATH_0001> be the site we get by endowing <MATH_0002> with the\nchaotic topology (presheaves are sheaves). There is a morphism of topoi\n<MATH_0003> where <MATH_0004> is the inclusion\nof sheaves into presheaves and <MATH_0005> is sheafification.\nBy Lemma <REF_0001>\nit suffices to prove the result for <MATH_0006>, i.e.,\nin case <MATH_0007> has the chaotic topology.\n\n<STRUCT_0001><STRUCT_0002>\nIf <MATH_0008> carries the chaotic topology, then\n<MATH_0009> is equal to\n<MATH_0010> because\n<MATHSEG_0001>sections over <MATHSEG_0002>sections over <MATHSEG_0003>\ncommutes.\n", "source_text_hash": "sha256:e6f584392f7b1520430e4840d0074b5ea05a88dbf68dc32abe740114ff3a3b97", "unit_id": "tag:08SW:proof"}
