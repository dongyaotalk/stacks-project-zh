{"chapter": "stacks-properties", "node_kind": "paragraph", "parent_tag": "04XE", "placeholders": {"STRUCT_0001": "\\noindent"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R2", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:bc22d0480f4840d675df0b8d0a2f728ceaa570c27b0630c8894b2683ae15631b", "source_text": "\n\n<STRUCT_0001>\nHere is a lemma explaining how to compute the set of points in terms\nof a presentation.\n\n", "source_text_hash": "sha256:ed749074e1f5a7038edad36f6552435e7aaadffc65e3ac491b357c7221ec27ba", "unit_id": "tag:04XE:prose-0003"}
