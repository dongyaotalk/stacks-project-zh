{"chapter": "topologies", "node_kind": "definition", "parent_tag": "021Y", "placeholders": {"MATH_0001": "$\\Sch_{smooth}$", "MATH_0002": "$S_0$", "MATH_0003": "$\\text{Cov}_0$", "MATH_0004": "$\\Sch_\\alpha$", "MATH_0005": "$S_0$", "MATH_0006": "$\\Sch_\\alpha$", "MATH_0007": "$\\text{Cov}_0$", "REF_0001": "\\ref{sites-definition-site}", "REF_0002": "\\ref{sets-lemma-construct-category}", "REF_0003": "\\ref{sets-lemma-coverings-site}", "STRUCT_0001": "\\begin{enumerate}", "STRUCT_0002": "\\item", "STRUCT_0003": "\\item", "STRUCT_0004": "\\item", "STRUCT_0005": "\\end{enumerate}", "TEXTITCLOSE_0001": "}", "TEXTITOPEN_0001": "{\\it "}, "render": {"prefix": "\\begin{definition}\n\\label{definition-big-smooth-site}\n", "suffix": "\\end{definition}"}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:cf1bb5df55977223084b7d2264c86cc811eb923ffa329f36d5c7ee297029c419", "source_status": "CURRENT", "source_structure_hash": "sha256:4b49f0df20a7b7021f61a1c31f1820fa44962ea770698e80d533fe80eb920be5", "source_text": "A <TEXTITOPEN_0001>big smooth site<TEXTITCLOSE_0001> is any site <MATH_0001> as in\nSites, Definition <REF_0001> constructed as follows:\n<STRUCT_0001>\n<STRUCT_0002> Choose any set of schemes <MATH_0002>, and any set of smooth coverings\n<MATH_0003> among these schemes.\n<STRUCT_0003> As underlying category take any category <MATH_0004>\nconstructed as in Sets, Lemma <REF_0002>\nstarting with the set <MATH_0005>.\n<STRUCT_0004> Choose any set of coverings as in\nSets, Lemma <REF_0003> starting with the\ncategory <MATH_0006> and the class of smooth coverings,\nand the set <MATH_0007> chosen above.\n<STRUCT_0005>\n", "source_text_hash": "sha256:db20d5febb7162e3cd10430ebf6a9d7f47315031700fbec15ef411104021a57e", "unit_id": "tag:03WY:statement"}
