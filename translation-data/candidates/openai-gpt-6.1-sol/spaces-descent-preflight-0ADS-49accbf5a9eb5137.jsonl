{"allowed_english": [], "context": {"approved_glossary_entries": [], "generation_contexts": [{"context_id": "locked-English-neighbor:spaces-descent:inventory:spaces-descent:0ADT:lemma/0001", "hash": "sha256:b58dd23e8293d7d05b3a842c92715d17426312a271c75fb8a08c7c6742f934f3", "value": {"kind": "locked-English-neighbor", "location": {"byte_end": 133261, "byte_start": 132203, "file": "spaces-descent.tex", "fragment_hash": "sha256:12782b213b106e200d0d408da4de49cef431e9981f58e7b13a89a59b6075a5e0", "line_end": 3618, "line_start": 3586}, "owner_tag": "0ADT", "parent_tag": "0ADS", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "spaces-descent", "node_kind": "lemma", "parent_tag": "0ADS", "placeholders": {"FOOTNOTECLOSE_0001": "}", "FOOTNOTEOPEN_0001": "\\footnote{", "LOCKED_0001": "\\label{lemma-descent-data-sheaves}", "MATH_0001": "$S$", "MATH_0002": "$\\{X_i \\to X\\}_{i \\in I}$", "MATH_0003": "$S$", "MATH_0004": "$$\n\\left\\{\n\\begin{matrix}\n\\text{descent data }(V_i, \\varphi_{ij})\\\\\n\\text{relative to }\\{X_i \\to X\\}\n\\end{matrix}\n\\right\\}\n\\leftrightarrow\n\\left\\{\n\\begin{matrix}\n\\text{sheaves }F\\text{ on }(\\Sch/S)_{fppf}\\text{ endowed}\\\\\n\\text{with a map }F \\to X\\text{ such that each}\\\\\nX_i \\times_X F\\text{ is an algebraic space}\n\\end{matrix}\n\\right\\}.\n$$", "MATH_0005": "$X_i \\times_X F$", "MATH_0006": "$V_i$", "MATH_0007": "$F$", "MATH_0008": "$I$", "MATH_0009": "$(X_i, \\varphi_{ij})$", "REF_0001": "\\ref{spaces-topologies-definition-fppf-covering}", "REF_0002": "\\ref{bootstrap-lemma-descend-algebraic-space}", "STRUCT_0001": "\\begin{lemma}", "STRUCT_0002": "\\begin{enumerate}", "STRUCT_0003": "\\item", "STRUCT_0004": "\\item", "STRUCT_0005": "\\end{enumerate}", "STRUCT_0006": "\\end{lemma}"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:d8dbec93dfecc508840e559834731342482262dc10a71d341f67af43fe1d9292", "source_status": "CURRENT", "source_structure_hash": "sha256:a3b28d9dd26eaca7b030fbb9ffd38b8bf3b07a6e447d3cc290f515778758ccfc", "source_text": "<STRUCT_0001>\n<LOCKED_0001>\nLet <MATH_0001> be a scheme. Let <MATH_0002> be an fppf\ncovering of algebraic spaces over <MATH_0003> (Topologies on Spaces,\nDefinition <REF_0001>).\nThere is an equivalence of categories\n<MATH_0004>\nMoreover,\n<STRUCT_0002>\n<STRUCT_0003> the algebraic space <MATH_0005> on the right hand side\ncorresponds to <MATH_0006> on the left hand side, and\n<STRUCT_0004> the sheaf <MATH_0007> is an algebraic space<FOOTNOTEOPEN_0001>We will see\nlater that this is always the case if <MATH_0008> is not too large, see\nBootstrap, Lemma <REF_0002>.<FOOTNOTECLOSE_0001>\nif and only if the\ncorresponding descent datum <MATH_0009> is effective.\n<STRUCT_0005>\n<STRUCT_0006>", "source_text_hash": "sha256:a37ae3542454b6cf83353e8a0a7d2bf51f4f4cb351c15f8b97f20f046c6872c9", "unit_id": "inventory:spaces-descent:0ADT:lemma/0001"}}}], "input_freeze": {"hash": "sha256:2e5a242483d77c129b910de26649cff6a7551cf5cf661c9f71f6fbc9cfbca1f8", "path": "translation-data/source-adoption-inputs/spaces-descent74-gpt61sol-p012-20261112-h1672-r01.json"}, "model_output": {"hash": "sha256:407dda55bfb874526a344e0fc3caf3630eaf039a400da679bdfe4ce920438ef5", "path": "docs/evidence/spaces-descent74-gpt61sol-p012-20261112-h1672-r01-raw-01.jsonl", "record_hash": "sha256:d80f826fd0c66f9cc3521f2fad509a5b1564053a21ee45b918b17ca8e6290fcf"}, "neighbor_unit_ids": [], "policy_revision": "git:b085882bcc8bf31744c1e7e236f72c9e5ca2bf9b", "prior_generations": [], "prompt_version": "translator-v2", "source_adoption_id": "spaces-descent74-gpt61sol-p012-20261112-h1672-r01", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "style_guide_path": "config/style-guide.md", "turn_id": "01a1d283-4744-76b3-9f91-ed8f8a99604e", "unit_id": "tag:0ADT:proof"}, "context_hash": "sha256:afd2f34e906ebdaa488bc3e370ef0f65e3