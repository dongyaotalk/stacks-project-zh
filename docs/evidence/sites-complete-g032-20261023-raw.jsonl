{"unit_id":"tag:00YR:prose-0004","translation":"\n\n<STRUCT_0001>\n我们将在《位点上的模（Modules on Sites）》第 <REF_0001> 节中讨论环的层（sheaf of rings）上的模（modules）的层（sheaves）的范畴（category）。\n\n","allowed_english":[],"term_occurrences":[{"source_term":"Modules on Sites","target_term":"位点上的模"},{"source_term":"sheaf of rings","target_term":"环的层"},{"source_term":"modules","target_term":"模"},{"source_term":"sheaves","target_term":"层"},{"source_term":"category","target_term":"范畴"}],"unknown_terms":[{"source_term":"Modules on Sites","target_term":"位点上的模","context":"章名；待决。"},{"source_term":"sheaf of rings","target_term":"环的层","context":"待决。"},{"source_term":"modules","target_term":"模","context":"待决。"},{"source_term":"sheaves","target_term":"层","context":"待决。"},{"source_term":"category","target_term":"范畴","context":"待决。"}],"notes":[]}
{"unit_id":"tag:00YU:statement","translation":"设 <MATH_0001>、<MATH_0002> 是位点（sites）。设 <MATH_0003> 是连续（continuous）函子（functor），给出位点（sites）的态射（morphism）<MATH_0004>。注意，即使在阿贝尔群（abelian groups）的情形，我们也还没有定义阿贝尔群（abelian groups）的预层（presheaves）的逆像（pullback）函子（functor）。由于所有余极限（colimits）在阿贝尔群（abelian groups）的范畴（category）中都可表（representable），当然可以在阿贝尔（abelian）预层（presheaves）上定义函子（functor）<MATH_0005>，使用与我们在集合的预层（presheaves of sets）上定义 <MATH_0006> 时相同的余极限（colimits）。在阿贝尔（abelian）预层（presheaves）的范畴（categories）上，<MATH_0007> 也将伴随（adjoint）于 <MATH_0008>。然而，<MATH_0009> 并不总是与 <MATH_0010> 在底层预层（underlying presheaves）（取值为集合（sets））上一致。\n","allowed_english":[],"term_occurrences":[{"source_term":"sites","target_term":"位点"},{"source_term":"continuous","target_term":"连续"},{"source_term":"functor","target_term":"函子"},{"source_term":"sites","target_term":"位点"},{"source_term":"morphism","target_term":"态射"},{"source_term":"abelian groups","target_term":"阿贝尔群"},{"source_term":"abelian groups","target_term":"阿贝尔群"},{"source_term":"presheaves","target_term":"预层"},{"source_term":"pullback","target_term":"逆像"},{"source_term":"functor","target_term":"函子"},{"source_term":"colimits","target_term":"余极限"},{"source_term":"abelian groups","target_term":"阿贝尔群"},{"source_term":"category","target_term":"范畴"},{"source_term":"representable","target_term":"可表"},{"source_term":"abelian","target_term":"阿贝尔"},{"source_term":"presheaves","target_term":"预层"},{"source_term":"functor","target_term":"函子"},{"source_term":"presheaves of sets","target_term":"集合的预层"},{"source_term":"colimits","target_term":"余极限"},{"source_term":"abelian","target_term":"阿贝尔"},{"source_term":"presheaves","target_term":"预层"},{"source_term":"categories","target_term":"范畴"},{"source_term":"adjoint","target_term":"伴随"},{"source_term":"underlying presheaves","target_term":"底层预层"},{"source_term":"sets","target_term":"集合"}],"unknown_terms":[{"source_term":"sites","target_term":"位点","context":"待决。"},{"source_term":"continuous","target_term":"连续","context":"待决。"},{"source_term":"functor","target_term":"函子","context":"待决。"},{"source_term":"morphism","target_term":"态射","context":"待决。"},{"source_term":"abelian groups","target_term":"阿贝尔群","context":"待决。"},{"source_term":"presheaves","target_term":"预层","context":"待决。"},{"source_term":"pullback","target_term":"逆像","context":"待决。"},{"source_term":"colimits","target_term":"余极限","context":"待决。"},{"source_term":"category","target_term":"范畴","context":"待决。"},{"source_term":"representable","target_term":"可表","context":"来源对余极限使用 representable；待决。"},{"source_term":"abelian","target_term":"阿贝尔","context":"待决。"},{"source_term":"presheaves of sets","target_term":"集合的预层","context":"待决。"},{"source_term":"categories","target_term":"范畴","context":"待决。"},{"source_term":"adjoint","target_term":"伴随","context":"待决。"},{"source_term":"underlying presheaves","target_term":"底层预层","context":"待决。"},{"source_term":"sets","target_term":"集合","context":"待决。"}],"notes":[]}
