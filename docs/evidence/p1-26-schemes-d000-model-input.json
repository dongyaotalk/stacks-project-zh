        "MATH_0016": "$$\nf^\\sharp_x : \\mathcal{O}_{Y, f(x)} \\longrightarrow \\mathcal{O}_{X, x}\n$$",
        "MATH_0017": "$\\mathfrak m_{Y, f(x)}$",
        "MATH_0018": "$\\mathfrak m_{X, x}$",
        "STRUCT_0002": "\\medskip",
        "STRUCT_0003": "\\noindent",
        "MATH_0019": "$f : X \\to Y$",
        "MATH_0020": "$g : Y \\to Z$",
        "MATH_0021": "$f$",
        "MATH_0022": "$g$",
        "REF_0001": "\\ref{sheaves-definition-composition-maps-ringed-spaces}",
        "MATH_0023": "$x \\in X$",
        "REF_0002": "\\ref{sheaves-lemma-compose-f-maps-stalks}",
        "MATH_0024": "$$\n\\mathcal{O}_{Z, g(f(x))}\n\\xrightarrow{g^\\sharp}\n\\mathcal{O}_{Y, f(x)}\n\\xrightarrow{f^\\sharp}\n\\mathcal{O}_{X, x}\n$$",
        "MATH_0025": "$g \\circ f$",
