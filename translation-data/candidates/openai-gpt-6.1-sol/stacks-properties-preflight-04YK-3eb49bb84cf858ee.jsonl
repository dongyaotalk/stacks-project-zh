, "suffix": ""}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:aad5e0750f7851e09bdac3a96227ac7aa7a391ff987fc03de5e53d05b083fa5f", "source_status": "CURRENT", "source_structure_hash": "sha256:1f40beee38e91d237e58b621e25aaf99f7c93eb01a23da64a7d1665f954083cb", "source_text": "<STRUCT_0001>\n<LOCKED_0001>\nLet <MATH_0001> be an algebraic stack. The rule\n<MATH_0002> defines an inclusion preserving\nbijection between open substacks of <MATH_0003> and open subsets\nof <MATH_0004>.\n<STRUCT_0002>", "source_text_hash": "sha256:2ef5c4c3d2fa16e69a60410895b2c26f4e8c169364d447ce428b98dfb59cc4ec", "unit_id": "inventory:stacks-properties:06FJ:lemma/0001"}}}, {"context_id": "sha256:1c680987dd4f0567c35e1a45517eb220b7e00e69fac6ef535618ed5562216b4a", "hash": "sha256:1c680987dd4f0567c35e1a45517eb220b7e00e69fac6ef535618ed5562216b4a", "value": {"kind": "locked-English-reference", "location": {"byte_end": 61038, "byte_start": 60490, "file": "stacks-properties.tex", "fragment_hash": "sha256:b9fc37cdd8e09a9effc30c35e61e89608de94d4b477dacc22ff0deb1f8ccf8e5", "line_end": 1693, "line_start": 1678}, "owner_tag": "0505", "parent_tag": "04YK", "requested_label": "stacks-properties-lemma-immersion-into-presentation", "requested_tag": "0505", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "stacks-properties", "node_kind": "lemma", "parent_tag": "04YK", "placeholders": {"LOCKED_0001": "\\label{lemma-immersion-into-presentation}", "MATH_0001": "$(U, R, s, t, c)$", "MATH_0002": "$i : \\mathcal{Z} \\to [U/R]$", "MATH_0003": "$R$", "MATH_0004": "$Z \\subset U$", "MATH_0005": "$[Z/R_Z] \\to \\mathcal{Z}$", "MATH_0006": "$R_Z$", "MATH_0007": "$R$", "MATH_0008": "$Z$", "MATH_0009": "$$\n\\xymatrix{\n[Z/R_Z] \\ar[dr] \\ar[rr] & & \\mathcal{Z} \\ar[ld]^i \\\\\n& [U/R]\n}\n$$", "MATH_0010": "$2$", "MATH_0011": "$i$", "MATH_0012": "$Z$", "MATH_0013": "$U$", "SPACE_0001": "\\ ", "SPACE_0002": "\\ ", "STRUCT_0001": "\\begin{lemma}", "STRUCT_0002": "\\end{lemma}"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:60cc01fca06d37262d478e376d8fe70a704dce0dd99cbf1d7934969a810a9e03", "source_status": "CURRENT", "source_structure_hash": "sha256:2a1b6591ae963cd4eb43fe22d74d0738efb5eaa30a02fa30d471d93b3fb74024", "source_text": "<STRUCT_0001>\n<LOCKED_0001>\nLet <MATH_0001> be a smooth groupoid in algebraic spaces.\nLet <MATH_0002> be an immersion.\nThen there exists an <MATH_0003>-invariant locally closed subspace\n<MATH_0004> and a presentation <MATH_0005>\nwhere <MATH_0006> is the restriction of <MATH_0007> to <MATH_0008> such that\n<MATH_0009>\nis <MATH_0010>-commutative. If <MATH_0011> is a closed (resp.<SPACE_0001>open) immersion\nthen <MATH_0012> is a closed (resp.<SPACE_0002>open) subspace of <MATH_0013>.\n<STRUCT_0002>", "source_text_hash": "sha256:07c9779fd01434b35fde3644a6a61b50c9b9223e72f5dbfdaf2718cf61d54f8b", "unit_id": "inventory:stacks-properties:0505:lemma/0001"}}}, {"context_id": "sha256:8d0cd342639279cc63d26f5aeaf79d666b5af69b8e586c37b35ff4a086db0130", "hash": "sha256:8d0cd342639279cc63d26f5aeaf79d666b5af69b8e586c37b35ff4a086db0130", "value": {"kind": "locked-English-reference", "location": {"byte_end": 62415, "byte_start": 61831, "file": "stacks-properties.tex", "fragment_hash": "sha256:e263d4c6330212d940724a5f9b3be9f01267afe902ab1ddefa4df1b4ed56ec3a", "line_end": 1731, "line_start": 1718}, "owner_tag": "04YN", "parent_tag": "04YK", "requested_label": "stacks-properties-lemma-immersion-presentation", "requested_tag": "04YN", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "stacks-properties", "node_kind": "lemma", "parent_tag": "04YK", "placeholders": {"LOCKED_0001": "\\label{lemma-immersion-presentation}", "MATH_0001": "$(U, R, s, t, c)$", "MATH_0002": "$\\mathcal{X} = [U/R]$", "M