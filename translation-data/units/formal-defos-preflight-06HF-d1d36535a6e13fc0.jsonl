{"chapter": "formal-defos", "node_kind": "paragraph", "parent_tag": "06HF", "placeholders": {"STRUCT_0001": "\\noindent"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R2", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:40fa10600b685d20713d8469cb4c60bb6cd3b877078a3915acf12d47317e594c", "source_text": "\n\n<STRUCT_0001>\nSmooth morphisms satisfy the following functorial properties.\n\n", "source_text_hash": "sha256:99a2f55ef67fb74201e903fcd9471dc807d43a79f1c0e1004a8b6ac5cd88c3e9", "unit_id": "tag:06HF:prose-0003"}
