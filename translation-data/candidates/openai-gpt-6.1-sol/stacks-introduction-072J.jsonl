d527738fbc29150d63dab74", "value": {"kind": "locked-English-neighbor", "location": {"byte_end": 883, "byte_start": 752, "file": "stacks-introduction.tex", "fragment_hash": "sha256:9e68a928eadcccebecec26ce822f0f3c16cc2177fe3e507a08454c0f5730e0e6", "line_end": 34, "line_start": 32}, "owner_tag": "072I", "parent_tag": "072I", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "stacks-introduction", "node_kind": "paragraph", "parent_tag": "072I", "placeholders": {"REF_0001": "\\cite{KatzMazur}", "REF_0002": "\\cite{mumford_picard}", "STRUCT_0001": "\\medskip", "STRUCT_0002": "\\noindent"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R1", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:9048e9ef7270ded42ecdcf16727923b4dce7b6dfdbba0e45b141e50b7f073848", "source_text": "<STRUCT_0001><STRUCT_0002>\nThe point of view we take here is close to the point of view taken in\n<REF_0001> and <REF_0002>.", "source_text_hash": "sha256:7520f5d0d967cf8b95a6547c3899b1035115cf1ff01f64af16fbbfd7ebd1c78e", "unit_id": "inventory:stacks-introduction:072I:paragraph/0002"}}}, {"context_id": "neighbor:inventory:stacks-introduction:072J:paragraph/0001", "hash": "sha256:48b7b75cfe9f3bb87b4c3c6956e86a6e85091171fc4bb2fca3d5a4d619d58184", "value": {"kind": "locked-English-neighbor", "location": {"byte_end": 1122, "byte_start": 941, "file": "stacks-introduction.tex", "fragment_hash": "sha256:8c763f784daeb350d243aeb71111d18d98c57756065c99a897ccb22df15d5ab2", "line_end": 47, "line_start": 44}, "owner_tag": "072J", "parent_tag": "072J", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "stacks-introduction", "node_kind": "paragraph", "parent_tag": "072J", "placeholders": {"MATH_0001": "$S$", "MATH_0002": "$S$", "MATH_0003": "$(E, f, 0)$", "MATH_0004": "$E$", "MATH_0005": "$f : E \\to S$", "MATH_0006": "$0 : S \\to E$", "STRUCT_0001": "\\noindent", "TEXTITCLOSE_0001": "}", "TEXTITOPEN_0001": "{\\it "}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R1", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:95314c934be84f8f26da46fbc258d292d5a7e1ab4a69bfdb0b9ad264866240f9", "source_status": "CURRENT", "source_structure_hash": "sha256:3f7b0f6fa3d40ff755ac363c01206309b0c84403a8df7a74af386cfd6735f8a3", "source_text": "<STRUCT_0001>\nLet <MATH_0001> be a scheme. An <TEXTITOPEN_0001>elliptic curve<TEXTITCLOSE_0001> over <MATH_0002> is a triple\n<MATH_0003> where <MATH_0004> is a scheme and <MATH_0005> and <MATH_0006>\nare morphisms of schemes such that\n", "source_text_hash": "sha256:2c1aa761a24ae5a8fc5777bb4ee0320e2982748623b7706e41140e6ec36ebada", "unit_id": "inventory:stacks-introduction:072J:paragraph/0001"}}}, {"context_id": "neighbor:inventory:stacks-introduction:072K:section_title/0001", "hash": "sha256:750d359ac7b7c69685d3b815e50e59283271b716a1ac4ec588043625a7ea83c1", "value": {"kind": "locked-English-neighbor", "location": {"byte_end": 2634, "byte_start": 2550, "file": "stacks-introduction.tex", "fragment_hash": "sha256:42947db732a93ba875e9ef348d4111aa6e06cb817ce117651a54958f0a697879", "line_end": 82, "line_start": 81}, "owner_tag": "072K", "parent_tag": "072K", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "stacks-introduction", "node_kind": "section_title", "parent_tag": "072K", "placeholders": {"LOCKED_0001": "\\label{section-moduli-elliptic-curves}", "TEXTCLOSE_0001": "}", "TEXTOPEN_0001": "\\section{"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R1", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:b3c4cd8d3cd8882c162ecc7128d22fab69fa9cf1d5a6286af4c9c380d483e6be", "source_text": "<TEXTOPEN_0001>The moduli stack of elliptic curves<TEXTCLOSE_0001>\n<LOCKED_0001>", "source_text_hash": "sha256:d80ae491527348a2d602b9e815b087f5c83781b94796bbffafc9da8d0a44e055", "unit_id": "inventory:stacks-introduction:072K:section_title/0001"}}}], "input_freeze": {"hash": "sha256:d80d3cc830ea34f2c657b8e78e7cd2f43cb18a69d3c2b278936d7aeca0b0be45", "path": "translation-data/source-adoption-inputs/stacks-introduction-072i-072j-g001-20261021.json"}, "model_output": {"hash": "sha256:c60aa37571c84e9cb488c5529aec94bdac63940f1c55019ced53f1620046d0a7", "path": "docs/evidence/stacks-introduction-072i-072j-g001-20261021-raw.jsonl", "record_hash": "sha256:56d9495cba45f85ad728e67c069d634fbe35fd0e49a0fa2a0c0ec7831c1d29ce"}, "neighbor_unit_ids": ["tag:072J:title"], "policy_revision": "git:a53e3edd47784658af30152aaf7ff3e5c6a3f3ac", "prior_generations": [], "prompt_version": "translator-v2", "source_adoption_id": "stacks-introduction-072i-072j-g001-20261021", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "style_guide_path": "config/style-guide.md", "turn_id": "01a15ed6-a655-7b11-af97-6475f24885fb", "unit_id": "tag:072J:prose-0001"}, "context_hash": "sha256:34ccac10128702825f0528e83b0d6913da42146be90febd735f47ced7770a8c2", "created_at": "2026-10-21T14:29:03.020829Z", "glossary_revision": "git:a53e3edd47784658af30152aaf7ff3e5c6a3f3ac", "harness_id": "codex", "harness_version": "0.163.0-alpha.11", "model_id": "gpt-6.1-sol", "model_identity_confidence": "declared", "model_lane": "openai-gpt-6.1-sol", "model_record_id": "openai:gpt-6.1-sol:declared", "model_snapshot": null, "notes": [], "prompt_version": "translator-v2", "publication_status": "CANDIDATE", "qa_status": "PASS", "reasoning_effort": "high", "run_id": "run-stacks-introduction-072i-072j-g001-20261021", "schema_version": 2, "source_adoption_id": "stacks-introduction-072i-072j-g001-20261021", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_status": "CURRENT", "source_text_hash": "sha256:d4d277bcfad17a686b4fbf16eb518789a30408869e505172e17cc66aa2da2faa", "stage": "STRUCTURE_OK", "term_occurrences": [{"source_term": "scheme", "target_term": "概形"}, {"source_term": "elliptic curve", "target_term": "椭圆曲线"}, {"source_term": "triple", "target_term": "三元组"}, {"source_term": "scheme", "target_term": "概形"}, {"source_term": "schemes", "target_term": "概形"}, {"source_term": "morphisms", "target_term": "态射"}, {"source_term": "proper", "target_term": "真"}, {"source_term": "smooth", "target_term": "光滑"}, {"source_term": "relative dimension", "target_term": "相对维数"}, {"source_term": "fibre", "target_term": "纤维"}, {"source_term": "connected", "target_term": "连通"}, {"source_term": "curve", "target_term": "曲线"}, {"source_term": "genus", "target_term": "亏格"}, {"source_term": "vector spaces", "target_term": "向量空间"}, {"source_term": "section", "target_term": "截面"}, {"source_term": "elliptic curves", "target_term": "椭圆曲线"}, {"source_term": "elliptic curves", "target_term": "椭圆曲线"}, {"source_term": "morphism", "target_term": "态射"}, {"source_term": "morphism", "target_term": "态射"}, {"source_term": "diagram", "target_term": "图表"}, {"source_term": "commutative", "target_term": "交换"}, {"source_term": "inner square", "target_term": "内方块"}, {"source_term": "cartesian", "target_term": "笛卡尔"}, {"source_term": "morphism", "target_term": "态射"}, {"source_term": "isomorphism", "target_term": "同构"}, {"source_term": "elliptic curves", "target_term": "椭圆曲线"}, {"source_term": "stack", "target_term": "栈"}, {"source_term": "Stacks", "target_term": "栈"}, {"source_term": "category", "target_term": "范畴"}, {"source_term": "functor", "target_term": "函子"}, {"source_term": "schemes", "target_term": "概形"}, {"source_term": "categories", "target_term": "范畴"}, {"source_term": "fibred categories", "target_term": "纤维范畴"}, {"source_term": "topologies", "target_term": "拓扑"}, {"source_term": "groupoids", "target_term": "群胚"}, {"source_term": "fibred", "target_term": "纤维化"}, {"source_term": "stacks", "target_term": "栈"}, {"source_term": "coverings", "target_term": "覆盖"}], "term_status": "DECISION_REQUIRED", "translation": "\n\n<STRUCT_0001>\n令<MATH_0001>为一个概形（scheme）。一条<TEXTITOPEN_0001>椭圆曲线（elliptic curve）<TEXTITCLOSE_0001>在<MATH_0002>上由一个三元组（triple）<MATH_0003>给出，其中<MATH_0004>是一个概形（scheme），而<MATH_0005>和<MATH_0006>是概形（schemes）之间的态射（morphisms），并满足\n<STRUCT_0002>\n<STRUCT_0003> <MATH_0007>是真（proper）且光滑（smooth）的，相对维数（relative dimension）为<MATH_0008>；\n<STRUCT_0004> 对每个<MATH_0009>，纤维（fibre）<MATH_0010>是一条连通（connected）曲线（curve），亏格（genus）为<MATH_0011>，即<MATH_0012>和<MATH_0013>都是<MATH_0014>维的<MATH_0015>-向量空间（vector spaces）；并且\n<STRUCT_0005> <MATH_0016>是<MATH_0017>的截面（section）。\n<STRUCT_0006>\n给定椭圆曲线（elliptic curves）<MATH_0018>和<MATH_0019>，一个<TEXTITOPEN_0002>在<MATH_0020>之上的椭圆曲线（elliptic curves）的态射（morphism）<TEXTITCLOSE_0002>是一个态射（morphism）<MATH_0021>，使得图表（diagram）<MATH_0022>是交换（commutative）的，而其中的内方块（inner square）是笛卡尔（cartesian）的；换言之，态射（morphism）<MATH_0023>诱导一个同构（isomorphism）<MATH_0024>。\n我们将定义椭圆曲线（elliptic curves）的栈（stack）<MATH_0025>。\n在栈（Stacks）项目的其余部分，我们展开Deligne和Mumford的论文<REF_0001>中引入的方法，其做法是把<MATH_0026>呈现为一个范畴（category），并赋予它一个函子（functor）<MATH_0027>。\n这意味着你要处理概形（schemes）的范畴（categories）之上的纤维范畴（fibred categories）、拓扑（topologies）、群胚（groupoids）纤维化（fibred）的栈（stacks）、覆盖（coverings），等等。\n本章把这一切都抛开，以稍有不同的方式来思考——这大概更接近理论的开创者们最初自己的思考方式。\n\n\n", "translation_hash": "sha256:f8ef9a54a99f40163b9ad879ffacf08854a1a7e47b329436da87af8e7953cebd", "unit_id": "tag:072J:prose-0001", "unknown_terms": [{"context": "本处是椭圆曲线定义中的基底及总空间，暂用概形。", "source_term": "scheme", "target_term": "概形"}, {"context": "本处以三元组及随后的三个条件定义椭圆曲线，暂用此译法。", "source_term": "elliptic curve", "target_term": "椭圆曲线"}, {"context": "本处指有序的三个定义数据，暂用三元组。", "source_term": "triple", "target_term": "三元组"}, {"context": "本处为scheme的复数形式，用于概形间的态射及概形范畴。", "source_term": "schemes", "target_term": "概形"}, {"context": "本处指概形之间的两个态射，保留原文复数形式。", "source_term": "morphisms", "target_term": "态射"}, {"context": "本处修饰椭圆曲线的结构态射，暂用真。", "source_term": "proper", "target_term": "真"}, {"context": "本处修饰结构态射，暂用光滑。", "source_term": "smooth", "target_term": "光滑"}, {"context": "本处为光滑结构态射的相对维数，暂用此译法。", "source_term": "relative dimension", "target_term": "相对维数"}, {"context": "本处指基底点上的纤维，暂用纤维。", "source_term": "fibre", "target_term": "纤维"}, {"context": "本处修饰几何定义中出现的曲线，暂用连通。", "source_term": "connected", "target_term": "连通"}, {"context": "本处指亏格为一的连通曲线，暂用曲线。", "source_term": "curve", "target_term": "曲线"}, {"context": "本处以随后给出的上同调条件说明亏格为一，暂用亏格。", "source_term": "genus", "target_term": "亏格"}, {"context": "本处指两个上同调空间，保留复数词形。", "source_term": "vector spaces", "target_term": "向量空间"}, {"context": "本处指结构态射的零截面，暂用截面。", "source_term": "section", "target_term": "截面"}, {"context": "本处为elliptic curve的复数形式，用于给定对象、态射及其栈。", "source_term": "elliptic curves", "target_term": "椭圆曲线"}, {"context": "本处用于椭圆曲线的态射及其底层概形态射，暂用态射。", "source_term": "morphism", "target_term": "态射"}, {"context": "本处为原文给出的交换图表，暂用图表。", "source_term": "diagram", "target_term": "图表"}, {"context": "本处指所给图表的交换性，暂用交换。", "source_term": "commutative", "target_term": "交换"}, {"context": "本处指所给图表中内部的方块，暂用内方块。", "source_term": "inner square", "target_term": "内方块"}, {"context": "本处修饰图表的内方块，暂用笛卡尔。", "source_term": "cartesian", "target_term": "笛卡尔"}, {"context": "本处指由给定态射诱导的概形同构，暂用同构。", "source_term": "isomorphism", "target_term": "同构"}, {"context": "本处指将要定义的椭圆曲线的栈，暂用栈。", "source_term": "stack", "target_term": "栈"}, {"context": "本处是项目专名Stacks project的组成部分，暂译为栈项目，不表示数学概念或专名译法已获批准。", "source_term": "Stacks", "target_term": "栈"}, {"context": "本处指承载所述函子的范畴，暂用范畴。", "source_term": "category", "target_term": "范畴"}, {"context": "本处指从所构造范畴出发的函子，暂用函子。", "source_term": "functor", "target_term": "函子"}, {"context": "本处为category的复数形式，指作为基底的概形范畴。", "source_term": "categories", "target_term": "范畴"}, {"context": "本处指概形范畴之上的纤维范畴，暂用此译法。", "source_term": "fibred categories", "target_term": "纤维范畴"}, {"context": "本处为后续所列一般理论的拓扑，暂用拓扑。", "source_term": "topologies", "target_term": "拓扑"}, {"context": "本处描述栈的群胚纤维化性质，暂用群胚。", "source_term": "groupoids", "target_term": "群胚"}, {"context": "本处是fibred in groupoids中的纤维化修饰语，暂用纤维化。", "source_term": "fibred", "target_term": "纤维化"}, {"context": "本处指群胚纤维化的栈，暂用栈。", "source_term": "stacks", "target_term": "栈"}, {"context": "本处列举一般理论中的覆盖，暂用覆盖。", "source_term": "coverings", "target_term": "覆盖"}]}
