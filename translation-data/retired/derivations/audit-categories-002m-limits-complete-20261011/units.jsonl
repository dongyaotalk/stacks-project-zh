{"chapter": "categories", "node_kind": "paragraph", "parent_tag": "002M", "placeholders": {}, "render": {"prefix": "", "suffix": "\n\\end{lemma}\n\n"}, "risk_level": "R2", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:78d5ac8672e51e95c9787ffcfabf23ecd08d649eb6cea5c6443004757ec17efd", "source_text": "provided all the indicated colimits exist. Similar for limits.", "source_text_hash": "sha256:bab58eac71df763f3cea67d866e4784b628a3b86a4a4c4b1a5e566bd72fa6ca3", "unit_id": "tag:002M:p001"}
