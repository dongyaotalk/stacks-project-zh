          "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14",
          "source_text": "<STRUCT_0001>\n<LOCKED_0001>\nLet <MATH_0001> be a graded ring, and <MATH_0002>.\nLet <MATH_0003> and <MATH_0004> as above.\nLet <MATH_0005> be a scheme.\nLet <MATH_0006> be an invertible sheaf on <MATH_0007>.\nLet <MATH_0008> be\na graded ring homomorphism such that <MATH_0009> is\ngenerated by the sections in the image of\n<MATH_0010>.\nThen there exist a morphism\n<MATH_0011> such that <MATH_0012> and\nan isomorphism <MATH_0013>\nsuch that <MATH_0014> agrees with <MATH_0015> via <MATH_0016>:\n<MATH_0017>\ncommutes. Moreover, the pair <MATH_0018> is unique.\n<STRUCT_0002>",
          "source_status": "CURRENT",
          "placeholders": {
            "STRUCT_0001": "\\begin{lemma}",
            "LOCKED_0001": "\\label{lemma-converse-construction}",
            "MATH_0001": "$S$",
            "MATH_0002": "$X = \\text{Proj}(S)$",
            "MATH_0003": "$d \\geq 1$",
            "MATH_0004": "$U_d \\subset X$",
            "MATH_0005": "$Y$",
            "MATH_0006": "$\\mathcal{L}$",
            "MATH_0007": "$Y$",
            "MATH_0008": "$\\psi : S^{(d)} \\to \\Gamma_*(Y, \\mathcal{L})$",
            "MATH_0009": "$\\mathcal{L}$",
            "MATH_0010": "$\\psi|_{S_d} : S_d \\to \\Gamma(Y, \\mathcal{L})$",
            "MATH_0011": "$\\varphi : Y \\to X$",
            "MATH_0012": "$\\varphi(Y) \\subset U_d$",
            "MATH_0013": "$\\alpha : \\varphi^*\\mathcal{O}_{U_d}(d) \\to \\mathcal{L}$",
            "MATH_0014": "$\\psi_\\varphi^d$",
            "MATH_0015": "$\\psi$",
            "MATH_0016": "$\\alpha$",
            "MATH_0017": "$$\n\\xymatrix{\n\\Gamma_*(Y, \\mathcal{L}) &\n\\Gamma_*(Y, \\varphi^*\\mathcal{O}_{U_d}(d)) \\ar[l]^-\\alpha &\n\\Gamma_*(U_d, \\mathcal{O}_{U_d}(d)) \\ar[l]^-{\\varphi^*} \\\\\nS^{(d)} \\ar[u]^\\psi & &\nS^{(d)} \\ar[u]^{\\psi^d} \\ar[ul]^{\\psi^d_\\varphi} \\ar[ll]_{\\text{id}}\n}\n$$",
            "MATH_0018": "$(\\varphi, \\alpha)$",
            "STRUCT_0002": "\\end{lemma}"
          },
