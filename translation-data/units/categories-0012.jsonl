{"chapter": "categories", "node_kind": "paragraph", "parent_tag": "0012", "placeholders": {"MATH_0001": "$2$", "MATH_0002": "$2$", "MATH_0003": "$2$", "REF_0001": "\\cite{GenEqui}", "REF_0002": "\\ref{section-formal-cat-cat}", "STRUCT_0001": "\\noindent"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R2", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:303363e9b6c790ba5ca90d96b706e2fbe945c9405a1ce907fd0854891f894ba9", "source_status": "CURRENT", "source_structure_hash": "sha256:6b7a46cfa292e0e2ec1b2f2c2617a8f3cbccd1ebd5f4a091a2ca0d354f101d96", "source_text": "<STRUCT_0001>\nCategories were first introduced in <REF_0001>.\nThe category of categories (which is a proper class)\nis a <MATH_0001>-category. Similarly, the category of stacks\nforms a <MATH_0002>-category. If you already know\nabout categories, but not about <MATH_0003>-categories you\nshould read\nSection <REF_0002>\nas an introduction to the formal definitions later on.", "source_text_hash": "sha256:f3c08ec47cce0c031df961f5b968a83c32dd9d0c2d16095c874ee0fd9e052afa", "unit_id": "tag:0012:paragraph-0001"}
