{"chapter": "categories", "node_kind": "lemma", "parent_tag": "0032", "placeholders": {"MATH_0001": "$\\mathcal{I}$", "MATH_0002": "$I$", "MATH_0003": "$(x_i, \\varphi_{ii'})$", "MATH_0004": "$I$", "MATH_0005": "$\\mathcal{I}$"}, "render": {"prefix": "\\begin{lemma}\n\\label{categories-lemma-directed-category-system}\n", "suffix": "\n\\begin{enumerate}\n"}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:93ff7d7bdbbd95389c649bb36def2f8bb2f1ee41494e184c35cea2815c8cf4f4", "source_status": "CURRENT", "source_structure_hash": "sha256:173df46f5cd3bc562e2546383c00152d74c082679558c9516734fb20214141f7", "source_text": "Let <MATH_0001> be a filtered index category. There exist a directed set <MATH_0002> and a system <MATH_0003> over <MATH_0004> in <MATH_0005> with the following properties:", "source_text_hash": "sha256:2c5d89ccde76d12697261d7acd0f70a5e5b7dcd047e8c10b9773edb05a4d0ba6", "unit_id": "tag:0032:statement"}
