{"unit_id":"tag:0ETA:prose-0003","translation":"\n\n<STRUCT_0001>\nV 拓扑（topology）具有与 fpqc 拓扑（fpqc topology）相同的集合（set）论问题。因此，我们不定义 V 景（sites），也不考虑关于 V 拓扑（topology）的上同调（cohomology）。另一方面，给定<MATH_0001>，询问<MATH_0002>是否对 V 拓扑（topology）满足层性质（sheaf property）是有意义的，见下文。此外，还可以考虑 V 拓扑（topology）中对象（object）的下降（descent）等问题。\n\n","allowed_english":["V"],"term_occurrences":[{"source_term":"topology","target_term":"拓扑"},{"source_term":"fpqc topology","target_term":"fpqc 拓扑"},{"source_term":"set","target_term":"集合"},{"source_term":"sites","target_term":"景"},{"source_term":"topology","target_term":"拓扑"},{"source_term":"cohomology","target_term":"上同调"},{"source_term":"topology","target_term":"拓扑"},{"source_term":"sheaf property","target_term":"层性质"},{"source_term":"topology","target_term":"拓扑"},{"source_term":"object","target_term":"对象"},{"source_term":"descent","target_term":"下降"}],"unknown_terms":[{"source_term":"topology","target_term":"拓扑","context":"待决"},{"source_term":"fpqc topology","target_term":"fpqc 拓扑","context":"待决"},{"source_term":"set","target_term":"集合","context":"待决"},{"source_term":"sites","target_term":"景","context":"待决"},{"source_term":"cohomology","target_term":"上同调","context":"待决"},{"source_term":"sheaf property","target_term":"层性质","context":"待决"},{"source_term":"object","target_term":"对象","context":"待决"},{"source_term":"descent","target_term":"下降","context":"待决"}],"notes":[]}
