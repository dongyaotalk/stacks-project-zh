{"unit_id": "tag:01ID:statement", "translation": "设<MATH_0001>为仿射概形（affine scheme）。<MATH_0002>上任意一族（collection）拟凝聚层（quasi-coherent sheaves）的直和（direct sum）都是拟凝聚（quasi-coherent）的。同样的结论也适用于余极限（colimits）。\n", "allowed_english": [], "term_occurrences": [{"source_term": "affine scheme", "target_term": "仿射概形"}, {"source_term": "collection", "target_term": "族"}, {"source_term": "quasi-coherent sheaves", "target_term": "拟凝聚层"}, {"source_term": "direct sum", "target_term": "直和"}, {"source_term": "quasi-coherent", "target_term": "拟凝聚"}, {"source_term": "colimits", "target_term": "余极限"}], "unknown_terms": [{"source_term": "affine scheme", "target_term": "仿射概形", "context": "给定的概形类型"}, {"source_term": "collection", "target_term": "族", "context": "取直和的任意一族对象"}, {"source_term": "quasi-coherent sheaves", "target_term": "拟凝聚层", "context": "取直和的对象类型"}, {"source_term": "direct sum", "target_term": "直和", "context": "断言保持拟凝聚性的构造"}, {"source_term": "quasi-coherent", "target_term": "拟凝聚", "context": "所得直和的性质"}, {"source_term": "colimits", "target_term": "余极限", "context": "同样满足该结论的构造"}], "notes": []}
