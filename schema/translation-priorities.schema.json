{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stacks-project-zh.invalid/schema/translation-priorities.schema.json",
  "title": "Stacks Project Chinese translation priority policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "method_revision",
    "selection_order",
    "levels",
    "chapters"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "method_revision": {"type": "string", "minLength": 1},
    "selection_order": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "levels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["P0", "P1", "P2", "P3", "P4"],
      "properties": {
        "P0": {"type": "object", "additionalProperties": false, "required": ["rank", "label", "description"], "properties": {"rank": {"type": "integer"}, "label": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}}},
        "P1": {"type": "object", "additionalProperties": false, "required": ["rank", "label", "description"], "properties": {"rank": {"type": "integer"}, "label": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}}},
        "P2": {"type": "object", "additionalProperties": false, "required": ["rank", "label", "description"], "properties": {"rank": {"type": "integer"}, "label": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}}},
        "P3": {"type": "object", "additionalProperties": false, "required": ["rank", "label", "description"], "properties": {"rank": {"type": "integer"}, "label": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}}},
        "P4": {"type": "object", "additionalProperties": false, "required": ["rank", "label", "description"], "properties": {"rank": {"type": "integer"}, "label": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}}}
      }
    },
    "chapters": {
      "type": "object",
      "propertyNames": {"pattern": "^[A-Za-z0-9._-]+$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["priority", "wave", "order", "tracks", "reason"],
        "properties": {
          "priority": {"enum": ["P0", "P1", "P2", "P3", "P4"]},
          "wave": {"type": "integer"},
          "order": {"type": "integer"},
          "tracks": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
