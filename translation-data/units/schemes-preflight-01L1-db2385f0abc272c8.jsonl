{"chapter": "schemes", "node_kind": "proof", "parent_tag": "01L1", "placeholders": {"REF_0001": "\\ref{lemma-immersions-monomorphisms}", "REF_0002": "\\ref{lemma-separated-permanence}"}, "render": {"prefix": "\\begin{proof}\n", "suffix": "\\end{proof}"}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:e0c1a24f60a28647b3208f095f99c1cbee3d7c567102c4a6f59d596b66c976a4", "source_text": "Follows from Lemma <REF_0001>\nand the fact that a composition of separated morphisms is separated\n(Lemma <REF_0002>).\n", "source_text_hash": "sha256:6fecbf2e3c4ffdead5a7b25f83d345625b03fb7f05aeac30819adde225c0f63c", "unit_id": "tag:01L8:proof"}
