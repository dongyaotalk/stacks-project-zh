{"chapter": "morphisms", "node_kind": "lemma", "parent_tag": "03J3", "placeholders": {}, "render": {"prefix": "\\begin{lemma}\n\\label{lemma-immersion-universally-bounded}\n", "suffix": "\\end{lemma}"}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:65a3346848a0fe11cf2ed179468ac2cca2729d9bd026b4c5cefbd88a3bb7766c", "source_text": "An immersion has universally bounded fibres.\n", "source_text_hash": "sha256:6a129549ac3044c541b120314a5894dd40ad2fe57171f42f715482f3e03c951f", "unit_id": "tag:03J9:statement"}
