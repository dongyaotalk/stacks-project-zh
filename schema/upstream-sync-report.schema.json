{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stacks-project-zh.invalid/schema/upstream-sync-report.schema.json",
  "title": "Upstream synchronization report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_kind",
    "old_commit",
    "new_commit",
    "generated_at",
    "generator",
    "index_snapshot",
    "statistics",
    "unit_changes",
    "unresolved_mappings",
    "qa_result"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "report_kind": {"enum": ["baseline", "synchronization"]},
    "old_commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "new_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "generator": {
      "type": "object",
      "required": ["parser_version", "normalization_version"],
      "properties": {
        "parser_version": {"type": "string", "minLength": 1},
        "normalization_version": {"type": "string", "minLength": 1}
      }
    },
    "index_snapshot": {"type": "object"},
    "upstream_commits": {"type": "array", "items": {"type": "object"}},
    "tag_changes": {"type": "object"},
    "statistics": {"type": "object"},
    "unit_changes": {"type": "array", "items": {"type": "object"}},
    "unresolved_mappings": {"type": "array", "items": {"type": "object"}},
    "qa_result": {"enum": ["PASS", "FAIL", "BASELINE"]},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
