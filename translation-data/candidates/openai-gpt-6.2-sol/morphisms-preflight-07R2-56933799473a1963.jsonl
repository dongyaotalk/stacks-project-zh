b17", "value": {"kind": "locked-English-neighbor", "location": {"byte_end": 120846, "byte_start": 120328, "file": "morphisms.tex", "fragment_hash": "sha256:dd3d37211f383c4cbbb835ffe6fb6232306b2414798249e3a8421d1a7f12a718", "line_end": 3323, "line_start": 3309}, "owner_tag": "07R4", "parent_tag": "07R2", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "morphisms", "node_kind": "lemma", "parent_tag": "07R2", "placeholders": {"LOCKED_0001": "\\label{lemma-J}", "MATH_0001": "$X$", "MATH_0002": "$X$", "MATH_0003": "$X$", "MATH_0004": "$\\Spec(R) = U \\subset X$", "MATH_0005": "$R$", "MATH_0006": "$S = \\bigcup U_i$", "MATH_0007": "$\\mathcal{O}(U_i)$", "MATH_0008": "$i$", "MATH_0009": "$X$", "STRUCT_0001": "\\begin{lemma}", "STRUCT_0002": "\\begin{enumerate}", "STRUCT_0003": "\\item", "STRUCT_0004": "\\item", "STRUCT_0005": "\\item", "STRUCT_0006": "\\item", "STRUCT_0007": "\\end{enumerate}", "STRUCT_0008": "\\end{lemma}"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:df77cb9d5cb0828d2d45e95c71d55c9a0d0c58434f2d04b23b1030c38e4ccec3", "source_status": "CURRENT", "source_structure_hash": "sha256:5b616f7723a19196a61843e35d9abe47afcd4eae2dd4c5f30537c343e66e5bbb", "source_text": "<STRUCT_0001>\n<LOCKED_0001>\nLet <MATH_0001> be a locally Noetherian scheme. The following are equivalent\n<STRUCT_0002>\n<STRUCT_0003> <MATH_0002> is J-2,\n<STRUCT_0004> there exists an open covering of <MATH_0003> all of whose members are\nJ-2 schemes,\n<STRUCT_0005> for every affine open <MATH_0004> the ring\n<MATH_0005> is J-2, and\n<STRUCT_0006> there exists an affine open covering <MATH_0006> such\nthat each <MATH_0007> is J-2 for all <MATH_0008>.\n<STRUCT_0007>\nMoreover, in this case any scheme locally of finite type over <MATH_0009>\nis J-2 as well.\n<STRUCT_0008>", "source_text_hash": "sha256:1b717a41395debac1e5a15e5d0cac4b1cbf