{"unit_id":"tag:00YH:statement","translation":"设 <MATH_0001> 是位点（site）。设 <MATH_0002> 是两个函子（functors），并设 <MATH_0003> 是函子（functors）的变换（transformation）。则得到茎（stalk）函子（functors）的典范（canonical）变换（transformation）<MATH_0004>，它通过引理 <REF_0001> 的等同与 <MATH_0005> 一致。\n","allowed_english":[],"term_occurrences":[{"source_term":"site","target_term":"位点"},{"source_term":"functors","target_term":"函子"},{"source_term":"functors","target_term":"函子"},{"source_term":"transformation","target_term":"变换"},{"source_term":"stalk","target_term":"茎"},{"source_term":"functors","target_term":"函子"},{"source_term":"canonical","target_term":"典范"},{"source_term":"transformation","target_term":"变换"}],"unknown_terms":[{"source_term":"site","target_term":"位点","context":"待决。"},{"source_term":"functors","target_term":"函子","context":"待决。"},{"source_term":"transformation","target_term":"变换","context":"待决。"},{"source_term":"stalk","target_term":"茎","context":"待决。"},{"source_term":"canonical","target_term":"典范","context":"待决。"}],"notes":[]}
