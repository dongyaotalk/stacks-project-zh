", "location": {"byte_end": 286477, "byte_start": 286280, "file": "categories.tex", "fragment_hash": "sha256:25937d6e3bdf1df80f345951f04340049fbff7bc8c15d2f9bc74bf5173e12bbf", "line_end": 8010, "line_start": 8007}, "owner_tag": "0042", "parent_tag": "0042", "semantic_path": "paragraph/0003", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "categories", "node_kind": "paragraph", "parent_tag": "0042", "placeholders": {"MATH_0001": "$2$", "MATH_0002": "$2$", "MATH_0003": "$(2, 1)$", "MATH_0004": "$2$", "STRUCT_0001": "\\noindent"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R1", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:b2903f24d2a74b90045a8bf5d7ca30016aaf4e6e601aacd6824d03836b9be7f6", "source_status": "CURRENT", "source_structure_hash": "sha256:57182d60e6106f9cb5767008d1b2099335b817dac4d9be04354c056ed43622b4", "source_text": "<STRUCT_0001>\nNote that every <MATH_0001>-morphism is automatically an isomorphism.\nHence this <MATH_0002>-category is actually a <MATH_0003>-category.\nHere is the obligatory lemma on the existence of <MATH_0004>-fibre products.", "source_text_hash": "sha256:da491c975a3f1cb652798986b414f0e018624885faf9363c1465e952db601f88", "unit_id": "inventory:categories:0042:paragraph/0003"}, "state": "READY"}, "reference:categories-definition-categories-fibred-in-groupoids-over-C": {"context_hash": "sha256:35823a9928de5161094924c92f3130b9d492018a87126b201975713875878b40", "kind": "locked-English-reference", "location": {"byte_end": 255297, "byte_start": 254389, "file": "categories.tex", "fragment_hash": "sha256:dbab54d9736cbbac01c473ece4291a2fd92449ca3342e1a782d4eb7dde169ee2", "line_end": 7221, "line_start": 7201}, "owner_tag": "02XS", "parent_tag": "003S", "requested_label": "categories-definition-categories-fibred-in-groupoids-over-C", "requested_tag": "02XS", "semantic_path": "definition/0001", "source_commit": "a04446e57ec1fbc252a871a