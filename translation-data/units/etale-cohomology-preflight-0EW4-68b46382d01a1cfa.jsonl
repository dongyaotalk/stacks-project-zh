{"chapter": "etale-cohomology", "node_kind": "paragraph", "parent_tag": "0EW4", "placeholders": {"REF_0001": "\\ref{flat-section-blow-up-ph}", "STRUCT_0001": "\\noindent"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R2", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:152bf2de388ff0dc01d4b2f443429f3a97f367374a79d13fdfa6f8490d6196ce", "source_text": "\n\n<STRUCT_0001>\nBlow up squares are introduced in\nMore on Flatness, Section <REF_0001>.\nUsing the proper base change theorem we can see that\nwe have a Mayer-Vietoris type result for blow up squares.\n\n", "source_text_hash": "sha256:690bff57689f187cea8756cb8e25c2df9da952d34f436cf7d39a959ffaeff70a", "unit_id": "tag:0EW4:prose-0001"}
