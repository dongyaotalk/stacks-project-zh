], "policy_revision": "git:0cd5a696ed1fb6b267587570250073149a81bf7f", "prior_generations": [], "prompt_version": "translator-v2", "source_adoption_id": "p1-26-schemes-d000", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "style_guide_path": "config/style-guide.md", "turn_id": "01a219f8-5a52-7400-8253-a5ba8af90d73", "unit_id": "tag:01HA:prose-0002"}, "context_hash": "sha256:2fe7defb8cdce7b8b1a297813047512b18174b695573fc2065ba9024c6331e42", "created_at": "2026-11-26T22:27:17.861Z", "glossary_revision": "git:0cd5a696ed1fb6b267587570250073149a81bf7f", "harness_id": "codex", "harness_version": "0.172.0", "model_id": "gpt-6.2-sol", "model_identity_confidence": "declared", "model_lane": "openai-gpt-6.2-sol", "model_record_id": "openai:gpt-6.2-sol:declared", "model_snapshot": null, "notes": [], "prompt_version": "translator-v2", "publication_status": "CANDIDATE", "qa_status": "PASS", "reasoning_effort": "high", "run_id": "run-p1-26-schemes-d000", "schema_version": 2, "source_adoption_id": "p1-26-schemes-d000", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_status": "CURRENT", "source_text_hash": "sha256:79bfb4df132b3f919b9d327c1c9af8a9528fb28398a1e230e054968d89776940", "stage": "STRUCTURE_OK", "term_occurrences": [{"source_term": "locally ringed spaces", "target_term": "局部赋环空间"}, {"source_term": "sheaf of rings", "target_term": "环层"}, {"source_term": "locally ringed space", "target_term": "局部赋环空间"}, {"source_term": "topological space", "target_term": "拓扑空间"}, {"source_term": "sheaf of rings", "target_term": "环层"}, {"source_term": "structure sheaf", "target_term": "结构层"}, {"source_term": "ideal", "target_term": "理想"}, {"source_term": "local ring", "target_term": "局部环"}, {"source_term": "locally ringed spaces", "target_term": "局部赋环空间"}, {"source_term": "morphism", "target_term": "态射"}, {"source_term": "sheaves", "target_term": "层"}, {"source_term": "map", "target_term": "映射"}, {"source_term": "topological spaces", "target_term": "拓扑空间"}, {"