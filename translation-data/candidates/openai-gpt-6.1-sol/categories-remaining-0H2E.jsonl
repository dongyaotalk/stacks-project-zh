e86a022c3c9dcac51b94b2e0f7fe5a363", "source_text": "<STRUCT_0001>\n<LOCKED_0001>\nLet <MATH_0001> and\n<MATH_0002> be categories fibred in groupoids, and\nsuppose that <MATH_0003> is a functor over\n<MATH_0004>.\n<STRUCT_0002>\n<STRUCT_0003> Then <MATH_0005> is faithful (resp.<SPACE_0001>fully faithful, resp.<SPACE_0002>an equivalence)\nif and only if for each <MATH_0006> the induced functor\n<MATH_0007> is faithful\n(resp.<SPACE_0003>fully faithful, resp.<SPACE_0004>an equivalence).\n<STRUCT_0004> If <MATH_0008> is an equivalence, then <MATH_0009> is an equivalence in the\n<MATH_0010>-category of categories fibred in groupoids over <MATH_0011>.\n<STRUCT_0005>\n<STRUCT_0006>", "source_text_hash": "sha256:b6a56ee0161fd60ed50a4aad195de0c1ea913cd40861c406b110f1460e5cf578", "unit_id": "inventory:categories:003Z:lemma/0001"}, "state": "READY"}, "inventory:categories:0041:proof/0001": {"context_hash": "sha256:4606ba8cb7b00de29a1788bb0a6511cadabe6b9c4a9024f8ce3e3cd9bb7d0558", "inventory_id": "inventory:categories:0041:proof/0001", "kind": "locked-English-neighbor", "location": {"byte_end": 256294, "byte_start": 255766, "file": "categories.tex", "fragment_hash": "sha256:4fc0bc5a8a286373742379161a323676543e153c4f960530fb334af3747bc01d", "line_end": 7246, "line_start": 7236}, "owner_tag": "0041", "parent_tag": "003S", "semantic_path": "proof/0001", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "categories", "node_kind": "proof", "parent_tag": "003S", "placeholders": {"MATH_0001": "$2$", "REF_0001": "\\ref{lemma-2-product-fibred-categories-over-C}", "REF_0002": "\\ref{lemma-2-product-categories-over-C}", "REF_0003": "\\ref{lemma-fibred-groupoids}", "REF_0004": "\\ref{lemma-fibre-2-fibre-product-categories-over-C}", "REF_0005": "\\ref{lemma-2-fibre-product-categories}", "STRUCT_0001": "\\begin{proof}", "STRUCT_0002": "\\end{proof}"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R3", "schema_version": 1, "source_commit": "a0444