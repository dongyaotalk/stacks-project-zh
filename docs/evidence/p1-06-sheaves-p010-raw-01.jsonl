{"unit_id": "tag:008R:title", "translation": "连续映射（maps）与模（modules）的层（sheaves）", "allowed_english": [], "term_occurrences": [{"source_term": "maps", "target_term": "映射"}, {"source_term": "modules", "target_term": "模"}, {"source_term": "sheaves", "target_term": "层"}], "unknown_terms": [{"source_term": "maps", "target_term": "映射", "context": "标题中的连续映射"}, {"source_term": "modules", "target_term": "模", "context": "层所取的代数对象"}, {"source_term": "sheaves", "target_term": "层", "context": "标题中的模层"}], "notes": []}
{"unit_id": "tag:008R:prose-0001", "translation": "\n\n<STRUCT_0001>\n模（modules）的层（sheaves）的情形更为复杂。这是因为，定义拉回（pullback）和推出（pushforward）函子（functors）的自然框架是下文将定义的赋环空间（ringed spaces）。我们先陈述几个显然的引理。\n\n", "allowed_english": [], "term_occurrences": [{"source_term": "modules", "target_term": "模"}, {"source_term": "sheaves", "target_term": "层"}, {"source_term": "pullback", "target_term": "拉回"}, {"source_term": "pushforward", "target_term": "推出"}, {"source_term": "functors", "target_term": "函子"}, {"source_term": "ringed spaces", "target_term": "赋环空间"}], "unknown_terms": [{"source_term": "modules", "target_term": "模", "context": "层所取的代数对象"}, {"source_term": "sheaves", "target_term": "层", "context": "讨论的层"}, {"source_term": "pullback", "target_term": "拉回", "context": "沿映射反向作用的函子"}, {"source_term": "pushforward", "target_term": "推出", "context": "沿映射正向作用的函子"}, {"source_term": "functors", "target_term": "函子", "context": "拉回与推出的范畴论构造"}, {"source_term": "ringed spaces", "target_term": "赋环空间", "context": "定义两种函子的空间框架"}], "notes": []}
{"unit_id": "tag:008S:statement", "translation": "设<MATH_0001>是拓扑空间（topological spaces）之间的连续映射（map）。设<MATH_0002>是<MATH_0003>上的环（rings）的预层（presheaf）。设<MATH_0004>是<MATH_0005>-模（modules）的预层（presheaf）。在取值为集合（sets）的底层预层（underlying presheaves）之间，有一个自然映射（map）\n<MATH_0006>\n它使<MATH_0007>成为<MATH_0008>-模（modules）的预层（presheaf）。这个构造关于<MATH_0009>是函子性的（functorial）。\n", "allowed_english": [], "term_occurrences": [{"source_term": "topological spaces", "target_term": "拓扑空间"}, {"source_term": "map", "target_term": "映射"}, {"source_term": "rings", "target_term": "环"}, {"source_term": "presheaf", "target_term": "预层"}, {"source_term": "modules", "target_term": "模"}, {"source_term": "presheaf", "target_term": "预层"}, {"source_term": "sets", "target_term": "集合"}, {"source_term": "underlying presheaves", "target_term": "底层预层"}, {"source_term": "map", "target_term": "映射"}, {"source_term": "modules", "target_term": "模"}, {"source_term": "presheaf", "target_term": "预层"}, {"source_term": "functorial", "target_term": "函子性的"}], "unknown_terms": [{"source_term": "topological spaces", "target_term": "拓扑空间", "context": "连续映射的定义域和陪域"}, {"source_term": "map", "target_term": "映射", "context": "给定的连续映射"}, {"source_term": "rings", "target_term": "环", "context": "预层所取的代数对象"}, {"source_term": "presheaf", "target_term": "预层", "context": "给定的环预层"}, {"source_term": "modules", "target_term": "模", "context": "预层所取的模"}, {"source_term": "presheaf", "target_term": "预层", "context": "给定的模预层"}, {"source_term": "sets", "target_term": "集合", "context": "底层预层所取的对象"}, {"source_term": "underlying presheaves", "target_term": "底层预层", "context": "忘掉额外代数结构后得到的预层"}, {"source_term": "map", "target_term": "映射", "context": "底层预层之间的自然映射"}, {"source_term": "modules", "target_term": "模", "context": "所得预层所取的模"}, {"source_term": "presheaf", "target_term": "预层", "context": "由自然映射赋予模结构的预层"}, {"source_term": "functorial", "target_term": "函子性的", "context": "描述构造随给定对象的变化"}], "notes": []}
{"unit_id": "tag:008S:proof", "translation": "设<MATH_0001>是开（open）的。我们将引理中的映射（map）定义为映射（map）\n<MATH_0002>\n这里中间的箭头（arrow）是<MATH_0003>上的乘法映射（multiplication map）。该映射与限制映射（restriction mappings）相容，并且所定义的<MATH_0004>-模（module）结构赋予了<MATH_0005>，这两点留给读者验证。\n", "allowed_english": [], "term_occurrences": [{"source_term": "open", "target_term": "开"}, {"source_term": "map", "target_term": "映射"}, {"source_term": "map", "target_term": "映射"}, {"source_term": "arrow", "target_term": "箭头"}, {"source_term": "multiplication map", "target_term": "乘法映射"}, {"source_term": "restriction mappings", "target_term": "限制映射"}, {"source_term": "module", "target_term": "模"}], "unknown_terms": [{"source_term": "open", "target_term": "开", "context": "所取对象的拓扑性质"}, {"source_term": "map", "target_term": "映射", "context": "引理中的映射"}, {"source_term": "map", "target_term": "映射", "context": "用来定义引理中映射的映射"}, {"source_term": "arrow", "target_term": "箭头", "context": "复合中间的一步"}, {"source_term": "multiplication map", "target_term": "乘法映射", "context": "中间箭头的代数定义"}, {"source_term": "restriction mappings", "target_term": "限制映射", "context": "预层在开集之间的结构映射"}, {"source_term": "module", "target_term": "模", "context": "由所定义映射给出的结构"}], "notes": []}
{"unit_id": "tag:008T:statement", "translation": "设<MATH_0001>是拓扑空间（topological spaces）之间的连续映射（map）。设<MATH_0002>是<MATH_0003>上的环（rings）的预层（presheaf）。设<MATH_0004>是<MATH_0005>-模（modules）的预层（presheaf）。在取值为集合（sets）的底层预层（underlying presheaves）之间，有一个自然映射（map）\n<MATH_0006>\n它使<MATH_0007>成为<MATH_0008>-模（modules）的预层（presheaf）。这个构造关于<MATH_0009>是函子性的（functorial）。\n", "allowed_english": [], "term_occurrences": [{"source_term": "topological spaces", "target_term": "拓扑空间"}, {"source_term": "map", "target_term": "映射"}, {"source_term": "rings", "target_term": "环"}, {"source_term": "presheaf", "target_term": "预层"}, {"source_term": "modules", "target_term": "模"}, {"source_term": "presheaf", "target_term": "预层"}, {"source_term": "sets", "target_term": "集合"}, {"source_term": "underlying presheaves", "target_term": "底层预层"}, {"source_term": "map", "target_term": "映射"}, {"source_term": "modules", "target_term": "模"}, {"source_term": "presheaf", "target_term": "预层"}, {"source_term": "functorial", "target_term": "函子性的"}], "unknown_terms": [{"source_term": "topological spaces", "target_term": "拓扑空间", "context": "连续映射的定义域和陪域"}, {"source_term": "map", "target_term": "映射", "context": "给定的连续映射"}, {"source_term": "rings", "target_term": "环", "context": "预层所取的代数对象"}, {"source_term": "presheaf", "target_term": "预层", "context": "给定的环预层"}, {"source_term": "modules", "target_term": "模", "context": "预层所取的模"}, {"source_term": "presheaf", "target_term": "预层", "context": "给定的模预层"}, {"source_term": "sets", "target_term": "集合", "context": "底层预层所取的对象"}, {"source_term": "underlying presheaves", "target_term": "底层预层", "context": "忘掉额外代数结构所得的预层"}, {"source_term": "map", "target_term": "映射", "context": "底层预层之间的自然映射"}, {"source_term": "modules", "target_term": "模", "context": "所得预层所取的模"}, {"source_term": "presheaf", "target_term": "预层", "context": "由自然映射赋予模结构的预层"}, {"source_term": "functorial", "target_term": "函子性的", "context": "描述构造对给定对象的依赖"}], "notes": []}
{"unit_id": "tag:008T:proof", "translation": "设<MATH_0001>是开（open）的。我们将引理中的映射（map）定义为映射（map）\n<MATH_0002>\n这里中间的箭头（arrow）是<MATH_0003>上的乘法映射（multiplication map）。第二个等式（equality）成立是因为有向（directed）余极限（colimits）与有限极限（finite limits）交换（commute），见《范畴》（Categories）一章的引理<REF_0001>。上述定义与限制映射（restriction mappings）相容，并将所定义的<MATH_0004>-模（module）结构赋予<MATH_0005>，这两点留给读者验证。\n", "allowed_english": [], "term_occurrences": [{"source_term": "open", "target_term": "开"}, {"source_term": "map", "target_term": "映射"}, {"source_term": "map", "target_term": "映射"}, {"source_term": "arrow", "target_term": "箭头"}, {"source_term": "multiplication map", "target_term": "乘法映射"}, {"source_term": "equality", "target_term": "等式"}, {"source_term": "directed", "target_term": "有向"}, {"source_term": "colimits", "target_term": "余极限"}, {"source_term": "finite limits", "target_term": "有限极限"}, {"source_term": "commute", "target_term": "交换"}, {"source_term": "Categories", "target_term": "《范畴》"}, {"source_term": "restriction mappings", "target_term": "限制映射"}, {"source_term": "module", "target_term": "模"}], "unknown_terms": [{"source_term": "open", "target_term": "开", "context": "所取对象的拓扑性质"}, {"source_term": "map", "target_term": "映射", "context": "引理中的映射"}, {"source_term": "map", "target_term": "映射", "context": "用来定义引理中映射的映射"}, {"source_term": "arrow", "target_term": "箭头", "context": "复合中间的一步"}, {"source_term": "multiplication map", "target_term": "乘法映射", "context": "中间箭头的代数定义"}, {"source_term": "equality", "target_term": "等式", "context": "定义映射时所用的第二个等式"}, {"source_term": "directed", "target_term": "有向", "context": "余极限的指标具有的性质"}, {"source_term": "colimits", "target_term": "余极限", "context": "与有限极限交换的构造"}, {"source_term": "finite limits", "target_term": "有限极限", "context": "与有向余极限交换的构造"}, {"source_term": "commute", "target_term": "交换", "context": "两种范畴论构造的相容关系"}, {"source_term": "Categories", "target_term": "《范畴》", "context": "所引引理所在的章名"}, {"source_term": "restriction mappings", "target_term": "限制映射", "context": "预层在开集