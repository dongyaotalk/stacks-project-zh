{"unit_id": "tag:02IZ:statement", "translation": "设<MATH_0001>为概形（scheme）。设<MATH_0002>为不可约闭子集（irreducible closed subset）。设<MATH_0003>为其一般点（generic point）。则\n<MATH_0004>\n其中余维（codimension）按拓扑学（Topology）中的定义<REF_0001>给出。\n", "allowed_english": [], "term_occurrences": [{"source_term": "scheme", "target_term": "概形"}, {"source_term": "irreducible closed subset", "target_term": "不可约闭子集"}, {"source_term": "generic point", "target_term": "一般点"}, {"source_term": "codimension", "target_term": "余维"}, {"source_term": "Topology", "target_term": "拓扑学"}], "unknown_terms": [{"source_term": "scheme", "target_term": "概形", "context": "引理中所设的概形。"}, {"source_term": "irreducible closed subset", "target_term": "不可约闭子集", "context": "引理中所设的闭子集，具有不可约性。"}, {"source_term": "generic point", "target_term": "一般点", "context": "所设不可约闭子集的一般点。"}, {"source_term": "codimension", "target_term": "余维", "context": "等式中按所引拓扑学定义理解的量。"}, {"source_term": "Topology", "target_term": "拓扑学", "context": "所引定义所在的章节名称。"}], "notes": []}
