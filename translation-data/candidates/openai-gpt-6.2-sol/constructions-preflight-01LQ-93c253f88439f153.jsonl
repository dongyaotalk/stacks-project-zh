cord_hash": "sha256:ea5fd327379e62153666f5080f938b44fc4a57ca9b9a8079790129484f923c7d"}, "neighbor_unit_ids": [], "policy_revision": "git:0cd5a696ed1fb6b267587570250073149a81bf7f", "prior_generations": [], "prompt_version": "translator-v2", "source_adoption_id": "p1-27-constructions-d001", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "style_guide_path": "config/style-guide.md", "turn_id": "01a21a18-95cb-7c83-a996-4ae143e6d7e8", "unit_id": "tag:01LT:proof"}, "context_hash": "sha256:dd058473b8408adea20c939dd944de4f4b24621e5e5c5f43dd75ddee0b19b3b3", "created_at": "2026-11-26T23:02:29.972Z", "glossary_revision": "git:0cd5a696ed1fb6b267587570250073149a81bf7f", "harness_id": "codex", "harness_version": "0.172.0", "model_id": "gpt-6.2-sol", "model_identity_confidence": "declared", "model_lane": "openai-gpt-6.2-sol", "model_record_id": "openai:gpt-6.2-sol:declared", "model_snapshot": null, "notes": [], "prompt_version": "translator-v2", "publication_status": "CANDIDATE", "qa_status": "PASS", "reasoning_effort": "high", "run_id": "run-p1-27-constructions-d001", "schema_version": 2, "source_adoption_id": "p1-27-constructions-d001", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_status": "CURRENT", "source_text_hash": "sha256:e73eb9c3c45a21d9c88cda1e0ae582c9177cb97af4e9f4ccdd55f3f976c5f22b", "stage": "STRUCTURE_OK", "term_occurrences": [{"source_term": "algebra", "target_term": "代数"}, {"source_term": "ring map", "target_term": "环同态"}, {"source_term": "canonical map", "target_term": "典范映射"}, {"source_term": "Schemes", "target_term": "概形"}, {"source_term": "canonical map", "target_term": "典范映射"}, {"source_term": "module map", "target_term": "模映射"}, {"source_term": "scheme", "target_term": "概形"}, {"source_term": "map", "target_term": "映射"}, {"source_term": "bijective", "target_term": "双射"}, {"source_term": "inverse", "target_term": "逆"}, {"source_term": "map", "target_term": "映射"}, {"source_term": "ring map", "target_term": "环同态"}, {"source_term": "morphism", "target_term": "态射"}, {"source_term": "schemes", "target_term": "概形"}, {"source_term": "Schemes", "target_term": "概形"}, {"source_term": "map", "target_term": "映射"}, {"source_term": "inverse", "target_term": "逆"}, {"source_term": "map", "target_term": "映射"}], "term_status": "DECISION_REQUIRED", "translation": "记<MATH_0001>和<MATH_0002>。\n于是<MATH_0003>是一个<MATH_0004>-代数（algebra），且<MATH_0005>。\n环同态（ring map）<MATH_0006>给出一个典范映射（canonical map）\n<MATH_0007>\n我们有\n<MATH_0008>\n这是由《概形（Schemes）》的引理<REF_0001>得到的。\n因此有一个典范映射（canonical map）\n<MATH_0009>\n它来自<MATH_0010>-模映射（module map）<MATH_0011>，\n<MATH_0012>。我们断言，在此情形下，二元组\n<MATH_0013>表示<MATH_0014>。\n换言之，我们断言，对任意概形（scheme）<MATH_0015>，映射（map）\n<MATHSEG_0001>二元组<MATHSEG_0002>\n是双射（bijective）。\n\n<STRUCT_0001><STRUCT_0002>\n现在构造逆（inverse）映射（map）。\n对任意二元组<MATH_0016>，我们得到诱导的环同态（ring map）\n<MATH_0017>\n这诱导出一个态射（morphism）<MATH_0018>，其源和靶均为概形（schemes）。这是由《概形（Schemes）》的引理<REF_0002>得到的。\n\n<STRUCT_0003><STRUCT_0004>\n此映射（map）逆（inverse）于上面列出的映射（map），验证从略。\n", "translation_hash": "sha256:f091980743c3fdcff54ec0dc21fa117f77b7259b503740c11073befe9b9124c9", "unit_id": "tag:01LT:proof", "unknown_terms": [{"context": "描述所记对象作为给定环上的代数。", "source_term": "algebra", "target_term": "代数"}, {"context": "给出第一个典范映射的环之间的同态。", "source_term": "ring map", "target_term": "环同态"}, {"context": "由给定环同态得到的映射。", "source_term": "canonical map", "target_term": "典范映射"}, {"context": "第一处引理所引章节的标题。", "source_term": "Schemes", "target_term": "概形"}, {"context": "由给定模映射得到的映射。", "source_term": "canonical map", "target_term": "典范映射"}, {"context": "给出第二个典范映射的模之间的映射。", "source_term": "module map", "target_term": "模映射"}, {"context": "双射断言所量化的任意测试对象。", "source_term": "scheme", "target_term": "概形"}, {"context": "断言为双射的对应。", "source_term": "map", "target_term": "映射"}, {"context": "断言上述映射同时为单射与满射。", "source_term": "bijective", "target_term": "双射"}, {"context": "修饰接下来构造的映射，指明其与上述映射的关系。", "source_term": "inverse", "target_term": "逆"}, {"context": "接下来构造的逆映射。", "source_term": "map", "target_term": "映射"}, {"context": "由任意给定二元组诱导的环之间的同态。", "source_term": "ring map", "target_term": "环同态"}, {"context": "由诱导的环同态得到的态射。", "source_term": "morphism", "target_term": "态射"}, {"context": "所诱导态射的源和靶所属的对象类别。", "source_term": "schemes", "target_term": "概形"}, {"context": "第二处引理所引章节的标题。", "source_term": "Schemes", "target_term": "概形"}, {"context": "末句中刚构造的映射。", "source_term": "map", "target_term": "映射"}, {"context": "末句所说的两个映射之间待验证的关系。", "source_term": "inverse", "target_term": "逆"}, {"context": "末句回指前面列出的映射。", "source_term": "map", "target_term": "映射"}]}
