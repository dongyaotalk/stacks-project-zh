{"unit_id":"tag:095N:statement","translation":"设<MATH_0001>为拟紧（quasi-compact）且拟分离（quasi-separated）概形（scheme）。设<MATH_0002>为Noether环（Noetherian ring）。可构造层（constructible sheaves）的范畴（category），其成员是<MATH_0003>-模（modules），恰为形如<MATH_0004>的模（modules）的范畴（category），其中<MATH_0005>和<MATH_0006>为拟紧（quasi-compact）且拟分离（quasi-separated）对象（objects），位于<MATH_0007>中。事实上，甚至可以假设<MATH_0008>和<MATH_0009>为仿射（affine）的。\n","allowed_english":[],"term_occurrences":[{"source_term":"quasi-compact","target_term":"拟紧"},{"source_term":"quasi-separated","target_term":"拟分离"},{"source_term":"scheme","target_term":"概形"},{"source_term":"Noetherian ring","target_term":"Noether环"},{"source_term":"constructible sheaves","target_term":"可构造层"},{"source_term":"category","target_term":"范畴"},{"source_term":"modules","target_term":"模"},{"source_term":"modules","target_term":"模"},{"source_term":"category","target_term":"范畴"},{"source_term":"quasi-compact","target_term":"拟紧"},{"source_term":"quasi-separated","target_term":"拟分离"},{"source_term":"objects","target_term":"对象"},{"source_term":"affine","target_term":"仿射"}],"unknown_terms":[{"source_term":"quasi-compact","target_term":"拟紧","context":"暂定译法。"},{"source_term":"quasi-separated","target_term":"拟分离","context":"暂定译法。"},{"source_term":"scheme","target_term":"概形","context":"暂定译法。"},{"source_term":"Noetherian ring","target_term":"Noether环","context":"暂定译法。"},{"source_term":"constructible sheaves","target_term":"可构造层","context":"暂定译法。"},{"source_term":"category","target_term":"范畴","context":"暂定译法。"},{"source_term":"modules","target_term":"模","context":"暂定译法。"},{"source_term":"objects","target_term":"对象","context":"暂定译法。"},{"source_term":"affine","target_term":"仿射","context":"暂定译法。"}],"notes":[]}
