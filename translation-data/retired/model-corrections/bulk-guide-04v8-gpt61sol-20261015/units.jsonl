{"chapter": "guide", "node_kind": "paragraph", "parent_tag": "03B6", "placeholders": {"EMPHCLOSE_0001": "}", "EMPHCLOSE_0002": "}", "EMPHOPEN_0001": "\\emph{", "EMPHOPEN_0002": "\\emph{", "MATH_0001": "$X$", "MATH_0002": "$D$", "MATH_0003": "$r$", "MATH_0004": "$X$", "MATH_0005": "$D$", "MATH_0006": "$\\mu_r$", "MATH_0007": "$D$", "MATH_0008": "$D$", "REF_0001": "\\cite{cadman}", "REF_0002": "\\cite{agv}", "STRUCT_0001": "\\noindent", "STRUCT_0002": "\\begin{itemize}", "STRUCT_0003": "\\item", "STRUCT_0004": "\\item", "STRUCT_0005": "\\end{itemize}"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R2", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:ff599d86bd59482b24d5bb6074cde44b9af29a9489e84233fb99a0207589936c", "source_status": "CURRENT", "source_structure_hash": "sha256:a42d2d4cf4b7f1fd27e97439e2a65dd37e198ddf2e76f7080eac2bf9327a14ee", "source_text": "\n\n<STRUCT_0001>\nThis useful construction was discovered independently by Cadman and by\nAbramovich, Graber and Vistoli. Given a scheme <MATH_0001> with an effective Cartier\ndivisor <MATH_0002>, the <MATH_0003>th root stack is an Artin stack branched over <MATH_0004> at <MATH_0005>\nwith a <MATH_0006> stabilizer over <MATH_0007> and scheme-like away from <MATH_0008>.\n<STRUCT_0002>\n<STRUCT_0003> Charles Cadman\n<EMPHOPEN_0001>Using Stacks to Impose Tangency Conditions on Curves<EMPHCLOSE_0001>\n<REF_0001>\n<STRUCT_0004> Abramovich, Graber, Vistoli: <EMPHOPEN_0002>Gromov-Witten theory for\nDeligne-Mumford stacks<EMPHCLOSE_0002> <REF_0002>\n<STRUCT_0005>\n\n", "source_text_hash": "sha256:c8ec1d1c96bab944d86f844e469345da3f1f00db46583a594280e37f0d2177e6", "unit_id": "tag:04V8:prose-0001"}
