xt": "修饰存在的相伴层。", "source_term": "canonical", "target_term": "典范的"}, {"context": "引理所断言存在的相伴对象。", "source_term": "sheaf", "target_term": "层"}, {"context": "说明相伴层是模层。", "source_term": "modules", "target_term": "模"}, {"context": "第一项中给定的对象。", "source_term": "scheme", "target_term": "概形"}, {"context": "第一项中与态射对应的数据。", "source_term": "quadruple", "target_term": "四元组"}, {"context": "由所给四元组对应的态射。", "source_term": "morphism", "target_term": "态射"}, {"context": "第一项中给出的同构。", "source_term": "canonical isomorphism", "target_term": "典范同构"}, {"context": "第一项中与拉回相容的同构。", "source_term": "isomorphisms", "target_term": "同构"}, {"context": "与第一项中的同构相容的操作。", "source_term": "pullbacks", "target_term": "拉回"}, {"context": "第三项中给出的映射。", "source_term": "canonical map", "target_term": "典范映射"}, {"context": "第四项说明构造关于给定对象的性质。", "source_term": "functorial", "target_term": "函子性的"}, {"context": "第五项说明构造的正合性。", "source_term": "exact", "target_term": "正合的"}, {"context": "修饰第六项中的映射。", "source_term": "canonical", "target_term": "典范的"}, {"context": "第六项中如所引引理所述的映射。", "source_term": "maps", "target_term": "映射"}, {"context": "修饰第七项中的映射。", "source_term": "canonical", "target_term": "典范的"}, {"context": "第七项中推广所引公式的映射。", "source_term": "maps", "target_term": "映射"}, {"context": "描述构造与基变换之间的关系。", "source_term": "commutes", "target_term": "可交换"}, {"context": "第八项中与构造可交换的操作。", "source_term": "base change", "target_term": "基变换"}]}
