{"chapter": "artin", "node_kind": "lemma", "parent_tag": "07XP", "placeholders": {"MATH_0001": "$S$", "MATH_0002": "$\\mathcal{X}$", "MATH_0003": "$(\\Sch/S)_{fppf}$", "MATH_0004": "$U$", "MATH_0005": "$S$", "MATH_0006": "$x$", "MATH_0007": "$\\mathcal{X}$", "MATH_0008": "$U$", "MATH_0009": "$x$", "MATH_0010": "$U$", "MATH_0011": "$\\mathcal{X}$", "MATH_0012": "$x : (\\Sch/U)_{fppf} \\to \\mathcal{X}$", "REF_0001": "\\ref{equation-smooth}"}, "render": {"prefix": "\\begin{lemma}\n\\label{lemma-versal-smooth}\n", "suffix": "\\end{lemma}"}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:e06dde9fe4ff334ede38c56097ded247c5cf6978c651007e72068e2398aa4904", "source_status": "CURRENT", "source_structure_hash": "sha256:2968a0e7712863827ff315e77052ccd673e5c7fc2309236e5147f0104f624416", "source_text": "Let <MATH_0001> be a locally Noetherian scheme. Let <MATH_0002> be a category\nfibred in groupoids over <MATH_0003>. Let <MATH_0004> be a scheme locally\nof finite type over <MATH_0005>. Let <MATH_0006> be an object of <MATH_0007> over <MATH_0008>.\nAssume that <MATH_0009> is versal at every finite type point of <MATH_0010> and that\n<MATH_0011> satisfies (RS). Then <MATH_0012>\nsatisfies (<REF_0001>).\n", "source_text_hash": "sha256:a8105e4a4bf48f3dbe65e62961070236da57161b111930f3d482a8e89ebc2217", "unit_id": "tag:07XT:statement"}
