": "取值为集合的预层"}, {"source_term": "Postcomposing", "target_term": "在其后复合"}, {"source_term": "map", "target_term": "映射"}, {"source_term": "inverse", "target_term": "逆"}], "unknown_terms": [{"source_term": "colimit", "target_term": "余极限", "context": "指以接下来给出的偏序集为指标的余极限。"}, {"source_term": "partially ordered set", "target_term": "偏序集", "context": "指按反向包含排序的指标集。"}, {"source_term": "open subsets", "target_term": "开子集", "context": "指构成指标集的开子集。"}, {"source_term": "inclusion", "target_term": "包含", "context": "指反向使用的子集包含关系。"}, {"source_term": "directed partially ordered set", "target_term": "有向偏序集", "context": "指满足接下来所证有向性的指标集。"}, {"source_term": "open neighbourhood", "target_term": "开邻域", "context": "指条件结论中第一个对象的任意开邻域。"}, {"source_term": "open neighbourhood", "target_term": "开邻域", "context": "指同一开邻域也是第二个对象的开邻域。"}, {"source_term": "system", "target_term": "系统", "context": "指用于定义第一个给定对象的系统。"}, {"source_term": "subsystem", "target_term": "子系统", "context": "指前一个定义系统在后一个定义系统中的关系。"}, {"source_term": "map", "target_term": "映射", "context": "指通过子系统关系得到的限制映射。"}, {"source_term": "Categories", "target_term": "范畴", "context": "指所引引理所在的章节标题。"}, {"source_term": "colimit", "target_term": "余极限", "context": "指其构造具有函子性的余极限。"}, {"source_term": "functorial", "target_term": "函子性", "context": "描述该构造关于给定对象的性质。"}, {"source_term": "restriction mappings", "target_term": "限制映射", "context": "指同样具有函子性的限制映射。"}, {"source_term": "functor", "target_term": "函子", "context": "指由上述构造给出的函子。"}, {"source_term": "small", "target_term": "简短", "context": "修饰第一条关于典范映射的注记。"}, {"source_term": "canonical map", "target_term": "典范映射", "context": "指第一条注记中首先断言存在的映射。"}, {"source_term": "open neighbourhoods", "target_term": "开邻域", "context": "指构成注记中所用系统的开邻域。"}, {"source_term": "system", "target_term": "系统", "context": "指包含指定元素的开邻域系统。"}, {"source_term": "element", "target_term": "元素", "context": "指该开邻域系统所含的指定成员。"}, {"source_term": "restriction mappings", "target_term": "限制映射", "context": "指第一条注记中映射与之相容的限制映射。"}, {"source_term": "c