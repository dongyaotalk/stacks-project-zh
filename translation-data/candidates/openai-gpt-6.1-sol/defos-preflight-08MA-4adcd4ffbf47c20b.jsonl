, "source_term": "morphism of ringed topoi", "target_term": "赋环拓扑斯的态射"}, {"context": "此回缩是加厚的左逆；中文译名待决。", "source_term": "left inverse", "target_term": "左逆"}, {"context": "选择与重建的回缩态射；中文译名待决。", "source_term": "morphism", "target_term": "态射"}, {"context": "回缩态射的选择；中文译名待决。", "source_term": "trivialization", "target_term": "平凡化"}, {"context": "代数层的分裂；中文译名待决。", "source_term": "splitting", "target_term": "分裂"}, {"context": "层的代数结构；中文译名待决。", "source_term": "algebras", "target_term": "代数"}, {"context": "底位点上的层；中文译名待决。", "source_term": "sheaves", "target_term": "层"}, {"context": "结构层的满射；中文译名待决。", "source_term": "surjection", "target_term": "满射"}, {"context": "范畴等价中的对象；中文译名待决。", "source_term": "trivialized first order thickenings", "target_term": "已平凡化一阶加厚"}, {"context": "加厚与模所成的两个范畴；中文译名待决。", "source_term": "category", "target_term": "范畴"}, {"context": "两个范畴之间的等价；中文译名待决。", "source_term": "equivalent", "target_term": "等价"}, {"context": "对应的结构层模；中文译名待决。", "source_term": "modules", "target_term": "模"}]}
