    {
      "context_id": "locked-English-neighbor:defos:inventory:defos:0D15:paragraph/0003",
      "value": {
        "kind": "locked-English-neighbor",
        "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14",
        "source_unit": {
          "schema_version": 2,
          "unit_id": "inventory:defos:0D15:paragraph/0003",
          "parent_tag": "0D15",
          "chapter": "defos",
          "node_kind": "paragraph",
          "risk_level": "R3",
          "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14",
          "source_text": "<STRUCT_0001>\nLet <MATH_0001> be a scheme. Let <MATH_0002> be a first order thickening of\nalgebraic spaces over <MATH_0003> with ideal sheaf <MATH_0004>\nwhich we view either as a quasi-coherent <MATH_0005>-module\nor as a quasi-coherent sheaf of ideals on <MATH_0006>, see\nMore on Morphisms of Spaces, Section\n<REF_0001>.\nLet <MATH_0007> be a morphism of algebraic spaces over <MATH_0008>.\nLet <MATH_0009> be a homomorphism of\n<MATH_0010>-modules (not necessarily quasi-coherent).\nLet <MATH_0011> be a map\nof <MATH_0012>-modules and denote\n<MATH_0013> the composition.\nConsider the functor\n<MATHSEG_0001> for <MATHSEG_0002> and <MATHSEG_0003> for <MATHSEG_0004> and <MATHSEG_0005>\ngiven by pushout.",
          "source_status": "CURRENT",
          "placeholders": {
            "STRUCT_0001": "\\noindent",
            "MATH_0001": "$S$",
            "MATH_0002": "$B \\subset B'$",
            "MATH_0003": "$S$",
            "MATH_0004": "$\\mathcal{J}$",
            "MATH_0005": "$\\mathcal{O}_B$",
            "MATH_0006": "$B'$",
            "REF_0001": "\\ref{spaces-more-morphisms-section-thickenings}",
            "MATH_0007": "$f : X \\to B$",
            "MATH_0008": "$S$",
            "MATH_0009": "$\\mathcal{F} \\to \\mathcal{G}$",
            "MATH_0010": "$\\mathcal{O}_X$",
            "MATH_0011": "$c : f^{-1}\\mathcal{J} \\to \\mathcal{F}$",
            "MATH_0012": "$f^{-1}\\mathcal{O}_B$",
            "MATH_0013": "$c' : f^{-1}\\mathcal{J} \\to \\mathcal{G}$",
            "MATHSEG_0001": "$$\nFT :\n\\{\\text{solutions to }(\\ref{equation-to-solve-ringed-topoi})\n\\text{",
            "MATHSEG_0002": "}\\mathcal{F}\\text{",
            "MATHSEG_0003": "}c\\}\n\\longrightarrow\n\\{\\text{solutions to }(\\ref{equation-to-solve-ringed-topoi})\n\\text{",
            "MATHSEG_0004": "}\\mathcal{G}\\text{",
            "MATHSEG_0005": "}c'\\}\n$$"
          },
          "render": {
            "prefix": "",
            "suffix": ""
          },
          "math_text_regions": [
            {
              "region_id": "math/0001",
              "delimiter_kind": "display-dollar",
              "source": "$$\nFT :\n\\{\\text{solutions to }(\\ref{equation-to-solve-ringed-topoi})\n\\text{ for }\\mathcal{F}\\text{ and }c\\}\n\\longrightarrow\n\\{\\text{solutions to }(\\ref{equation-to-solve-ringed-topoi})\n\\text{ for }\\mathcal{G}\\text{ and }c'\\}\n$$",
