{"unit_id":"tag:04LW:statement","translation":"设<MATH_0001>、<MATH_0002>为概形（schemes）。任意两个态射（morphisms）<MATH_0003>，它们是概形（schemes）的态射，若存在<MATH_0004>-同构（isomorphism）\n<MATH_0005>\n，它位于<MATH_0006>-范畴（category）中，亦即赋环拓扑斯（ringed topoi）的该范畴，则这两个态射相等。\n","allowed_english":[],"term_occurrences":[{"source_term":"schemes","target_term":"概形"},{"source_term":"morphisms","target_term":"态射"},{"source_term":"schemes","target_term":"概形"},{"source_term":"isomorphism","target_term":"同构"},{"source_term":"category","target_term":"范畴"},{"source_term":"ringed topoi","target_term":"赋环拓扑斯"}],"unknown_terms":[{"source_term":"schemes","target_term":"概形","context":"待决"},{"source_term":"morphisms","target_term":"态射","context":"待决"},{"source_term":"isomorphism","target_term":"同构","context":"待决"},{"source_term":"category","target_term":"范畴","context":"待决"},{"source_term":"ringed topoi","target_term":"赋环拓扑斯","context":"待决"}],"notes":[]}
