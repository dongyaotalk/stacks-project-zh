{"chapter": "formal-defos", "node_kind": "paragraph", "parent_tag": "06J1", "placeholders": {"MATH_0001": "$k$", "STRUCT_0001": "\\noindent"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R2", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:18ca17b0eb71e1fd9c2652c7083af14efe40c1e8a77f01232cbd02201ad96d7f", "source_status": "CURRENT", "source_structure_hash": "sha256:4939b322e8480c579a06271394e726d8a3fa54d2929f480944bfe8a6d6246947", "source_text": "\n\n<STRUCT_0001>\nThe following is one of our typical remarks on passing from a category\ncofibered in groupoids to the predeformation category at a point over <MATH_0001>: it\nsays that this process preserves (RS).\n\n", "source_text_hash": "sha256:316b0d9202825eef7f477ddae1df74514f7a91f9650d687adbfa3686d86bc877", "unit_id": "tag:06J1:prose-0004"}
