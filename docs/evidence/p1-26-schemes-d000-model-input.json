    {
      "context_id": "sha256:47559c3052460776820cf000b45694033cfb8f1b513383f06d20d168bb073688",
      "value": {
        "kind": "locked-English-reference",
        "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14",
        "source_unit": {
          "schema_version": 1,
          "unit_id": "inventory:sheaves:008M:lemma/0001",
          "parent_tag": "008C",
          "chapter": "sheaves",
          "node_kind": "lemma",
          "risk_level": "R3",
          "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14",
          "source_text": "<STRUCT_0001>\n<LOCKED_0001>\nSuppose that <MATH_0001> and <MATH_0002> are continuous\nmaps of topological spaces. Suppose that <MATH_0003> is\na sheaf on <MATH_0004>, <MATH_0005> is a sheaf on <MATH_0006>, and\n<MATH_0007> is a sheaf on <MATH_0008>.\nLet <MATH_0009> be an <MATH_0010>-map.\nLet <MATH_0011> be an <MATH_0012>-map.\nLet <MATH_0013> be a point. The map on stalks\n<MATH_0014> is the composition\n<MATH_0015>\n<STRUCT_0002>",
          "source_status": "CURRENT",
          "placeholders": {
            "STRUCT_0001": "\\begin{lemma}",
            "LOCKED_0001": "\\label{lemma-compose-f-maps-stalks}",
            "MATH_0001": "$f : X \\to Y$",
            "MATH_0002": "$g : Y \\to Z$",
            "MATH_0003": "$\\mathcal{F}$",
            "MATH_0004": "$X$",
            "MATH_0005": "$\\mathcal{G}$",
            "MATH_0006": "$Y$",
            "MATH_0007": "$\\mathcal{H}$",
            "MATH_0008": "$Z$",
            "MATH_0009": "$\\varphi : \\mathcal{G} \\to \\mathcal{F}$",
            "MATH_0010": "$f$",
            "MATH_0011": "$\\psi : \\mathcal{H} \\to \\mathcal{G}$",
            "MATH_0012": "$g$",
            "MATH_0013": "$x \\in X$",
            "MATH_0014": "$(\\varphi \\circ \\psi)_x : \\mathcal{H}_{g(f(x))}\n\\to \\mathcal{F}_x$",
            "MATH_0015": "$$\n\\mathcal{H}_{g(f(x))}\n\\xrightarrow{\\psi_{f(x)}}\n\\mathcal{G}_{f(x)}\n\\xrightarrow{\\varphi_x}\n\\mathcal{F}_x\n$$",
            "STRUCT_0002": "\\end{lemma}"
          },
