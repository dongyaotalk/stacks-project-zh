{"chapter": "morphisms", "node_kind": "lemma", "parent_tag": "01S5", "placeholders": {}, "render": {"prefix": "\\begin{lemma}\n\\label{lemma-composition-affine}\n", "suffix": "\\end{lemma}"}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:7e78faef616e1f9f0adcf1371ea2bd0a498a9004ef30a3a84213e245f5e65717", "source_text": "The composition of affine morphisms is affine.\n", "source_text_hash": "sha256:3b9345b8c80d29a730c4d673b97b2bdb26ff7d431c438e8f0234ed012b727eab", "unit_id": "tag:01SC:statement"}
