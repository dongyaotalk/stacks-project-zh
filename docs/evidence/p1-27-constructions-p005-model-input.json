          "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14",
          "source_text": "<STRUCT_0001>\nThe cone associated to a graded sheaf of <MATH_0001>-algebras\ncomes with a bit of extra structure. Namely, we obtain a grading\n<MATH_0002>\nThus we can define an abstract cone as follows.",
          "source_status": "CURRENT",
          "placeholders": {
            "STRUCT_0001": "\\noindent",
            "MATH_0001": "$\\mathcal{O}_S$",
            "MATH_0002": "$$\n\\pi_*\\mathcal{O}_{C(\\mathcal{A})} =\n\\bigoplus\\nolimits_{n \\geq 0} \\mathcal{A}_n\n$$"
          },
          "render": {
            "prefix": "",
            "suffix": ""
