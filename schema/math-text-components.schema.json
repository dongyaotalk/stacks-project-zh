{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stacks-project-zh.invalid/schema/math-text-components.schema.json",
  "title": "Verified version 3 math text regions with protected parameter components",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "region_id",
      "delimiter_kind",
      "source",
      "source_hash",
      "source_byte_span",
      "pieces",
      "slots"
    ],
    "properties": {
      "region_id": {
        "type": "string",
        "pattern": "^math/[0-9]{4}$"
      },
      "delimiter_kind": {
        "enum": [
          "inline-dollar",
          "display-dollar",
          "inline-paren",
          "display-bracket",
          "environment"
        ]
      },
      "source": {
        "type": "string",
        "minLength": 1
      },
      "source_hash": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "source_byte_span": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "start",
          "end"
        ],
        "properties": {
          "start": {
            "type": "integer"
          },
          "end": {
            "type": "integer"
          }
        }
      },
      "pieces": {
        "type": "array",
        "items": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "placeholder"
              ],
              "properties": {
                "kind": {
                  "const": "locked"
                },
                "placeholder": {
                  "type": "string",
                  "pattern": "^MATHSEG_[0-9]{4}$"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "slot_id"
              ],
              "properties": {
                "kind": {
                  "const": "text"
                },
                "slot_id": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        }
      },
      "slots": {
        "type": "array",
        "items": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "slot_id",
                "source",
                "command",
                "policy_entry",
                "slot_byte_span",
                "boundary_placeholders",
                "classification_witness"
              ],
              "properties": {
                "slot_id": {
                  "type": "string",
                  "pattern": "^math/[0-9]{4}/text/[0-9]{4}$"
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "command": {
                  "const": "text"
                },
                "policy_entry": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$"
                },
                "slot_byte_span": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "start",
                    "end"
                  ],
                  "properties": {
                    "start": {
                      "type": "integer"
                    },
                    "end": {
                      "type": "integer"
                    }
                  }
                },
                "boundary_placeholders": {
                  "type": "array",
                  "maxItems": 2,
                  "items": {
                    "type": "string",
                    "pattern": "^MATHSEG_[0-9]{4}$"
                  }
                },
                "classification_witness": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "usage",
                    "usage_source",
                    "source_label",
                    "policy_hash",
                    "anchor"
                  ],
                  "properties": {
                    "usage": {
                      "enum": [
                        "quad-connector",
                        "matrix-condition",
                        "set-description",
                        "root-phrase",
                        "matrix-prefix-condition",
                        "arrow-label-prefix",
                        "matrix-row-text",
                        "matrix-row-prefix",
                        "numeric-isomorphism-suffix",
                        "root-condition",
                        "matrix-row-condition",
                        "root-hyphen-phrase",
                        "matrix-membership",
                        "aligned-set-connector",
                        "matrix-row-description",
                        "matrix-row-statement",
                        "matrix-operator-compatibility",
                        "matrix-numeric-category-prefix",
                        "matrix-category-description"
                      ]
                    },
                    "usage_source": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "before",
                        "after",
                        "environments"
                      ],
                      "properties": {
                        "before": {
                          "type": "string"
                        },
                        "after": {
                          "type": "string"
                        },
                        "environments": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      }
                    },
                    "source_label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "policy_hash": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    },
                    "anchor": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "source_commit",
                        "file",
                        "owner_tag",
                        "owner_label",
                        "kind",
                        "ordinal",
                        "matches"
                      ],
                      "properties": {
                        "source_commit": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{40}$"
                        },
                        "file": {
                          "type": "string",
                          "minLength": 1
                        },
                        "owner_tag": {
                          "type": "string",
                          "minLength": 1
                        },
                        "owner_label": {
                          "type": "string",
                          "minLength": 1
                        },
                        "kind": {
                          "enum": [
                            "section",
                            "lemma",
                            "proof"
                          ]
                        },
                        "ordinal": {
                          "type": "integer"
                        },
                        "matches": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "container_byte_span",
                              "container_hash",
                              "command_byte_span",
                              "command_hash"
                            ],
                            "properties": {
                              "container_byte_span": {
                                "type": "object",
                                "additionalProperties": false,
                                "required": [
                                  "start",
                                  "end"
                                ],
                                "properties": {
                                  "start": {
                                    "type": "integer"
                                  },
                                  "end": {
                                    "type": "integer"
                                  }
                                }
                              },
                              "container_hash": {
                                "type": "string",
                                "pattern": "^sha256:[0-9a-f]{64}$"
                              },
                              "command_byte_span": {
                                "type": "object",
                                "additionalProperties": false,
                                "required": [
                                  "start",
                                  "end"
                                ],
                                "properties": {
                                  "start": {
                                    "type": "integer"
                                  },
                                  "end": {
                                    "type": "integer"
                                  }
                                }
                              },
                              "command_hash": {
                                "type": "string",
                                "pattern": "^sha256:[0-9a-f]{64}$"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "slot_id",
                "source",
                "command",
                "policy_entry",
                "slot_byte_span",
                "boundary_placeholders",
                "classification_witness",
                "parameter_components"
              ],
              "properties": {
                "slot_id": {
                  "type": "string",
                  "pattern": "^math/[0-9]{4}/text/[0-9]{4}$"
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "command": {
                  "const": "text"
                },
                "policy_entry": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$"
                },
                "slot_byte_span": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "start",
                    "end"
                  ],
                  "properties": {
                    "start": {
                      "type": "integer"
                    },
                    "end": {
                      "type": "integer"
                    }
                  }
                },
                "boundary_placeholders": {
                  "type": "array",
                  "maxItems": 2,
                  "items": {
                    "type": "string",
                    "pattern": "^MATHSEG_[0-9]{4}$"
                  }
                },
                "classification_witness": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "usage",
                    "usage_source",
                    "source_label",
                    "policy_hash",
                    "anchor"
                  ],
                  "properties": {
                    "usage": {
                      "enum": [
                        "indexed-component-description"
                      ]
                    },
                    "usage_source": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "before",
                        "after",
                        "environments"
                      ],
                      "properties": {
                        "before": {
                          "type": "string"
                        },
                        "after": {
                          "type": "string"
                        },
                        "environments": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      }
                    },
                    "source_label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "policy_hash": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    },
                    "anchor": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "source_commit",
                        "file",
                        "owner_tag",
                        "owner_label",
                        "kind",
                        "ordinal",
                        "matches"
                      ],
                      "properties": {
                        "source_commit": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{40}$"
                        },
                        "file": {
                          "type": "string",
                          "minLength": 1
                        },
                        "owner_tag": {
                          "type": "string",
                          "minLength": 1
                        },
                        "owner_label": {
                          "type": "string",
                          "minLength": 1
                        },
                        "kind": {
                          "enum": [
                            "section",
                            "lemma",
                            "proof"
                          ]
                        },
                        "ordinal": {
                          "type": "integer"
                        },
                        "matches": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "container_byte_span",
                              "container_hash",
                              "command_byte_span",
                              "command_hash"
                            ],
                            "properties": {
                              "container_byte_span": {
                                "type": "object",
                                "additionalProperties": false,
                                "required": [
                                  "start",
                                  "end"
                                ],
                                "properties": {
                                  "start": {
                                    "type": "integer"
                                  },
                                  "end": {
                                    "type": "integer"
                                  }
                                }
                              },
                              "container_hash": {
                                "type": "string",
                                "pattern": "^sha256:[0-9a-f]{64}$"
                              },
                              "command_byte_span": {
                                "type": "object",
                                "additionalProperties": false,
                                "required": [
                                  "start",
                                  "end"
                                ],
                                "properties": {
                                  "start": {
                                    "type": "integer"
                                  },
                                  "end": {
                                    "type": "integer"
                                  }
                                }
                              },
                              "command_hash": {
                                "type": "string",
                                "pattern": "^sha256:[0-9a-f]{64}$"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "parameter_components": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "parameter_source",
                    "parameter_byte_span",
                    "component_index",
                    "component_count",
                    "separator"
                  ],
                  "properties": {
                    "parameter_source": {
                      "type": "string",
                      "minLength": 1
                    },
                    "parameter_byte_span": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "start",
                        "end"
                      ],
                      "properties": {
                        "start": {
                          "type": "integer"
                        },
                        "end": {
                          "type": "integer"
                        }
                      }
                    },
                    "component_index": {
                      "enum": [
                        1,
                        2
                      ]
                    },
                    "component_count": {
                      "const": 2
                    },
                    "separator": {
                      "const": "\\ "
                    }
                  }
                }
              }
            }
          ]
        }
      }
    }
  }
}
