)$", "MATH_0019": "$\\zeta_{ij}$", "MATH_0020": "$1$", "MATH_0021": "$(\\zeta_{i_0i_1}) \\in \\check C(\\mathcal{V}, \\mu_n)$", "MATH_0022": "$d(\\zeta_{i_0i_1}) = 0$", "MATH_0023": "$\\check H^1(\\mathcal{V}, \\mu_n)$", "MATH_0024": "$H^1_{syntomic}(S, \\mu_{n, S})$", "MATH_0025": "$$\n\\mu_n(\\mathcal{L}, \\alpha) :\nU\n\\longmapsto\n\\mathit{Isom}_U((\\mathcal{O}_U, 1), (\\mathcal{L}, \\alpha)|_U)\n$$", "MATH_0026": "$(\\Sch/S)_{syntomic}$", "MATH_0027": "$\\SheafHom_\\mathcal{O}(\\mathcal{O}, \\mathcal{L})$", "MATH_0028": "$\\mu_{n, S}$", "MATH_0029": "$\\mathcal{V}$", "MATH_0030": "$\\mu_n(\\mathcal{L}, \\alpha)$", "MATH_0031": "$\\mu_{n, S}$", "MATH_0032": "$H^1_{syntomic}(S, \\mu_{n, S})$", "MATH_0033": "$(\\mathcal{L}, \\alpha) \\otimes (\\mathcal{L}', \\alpha')$", "MATH_0034": "$(\\mathcal{L}, \\alpha)$", "MATH_0035": "$(\\mathcal{L}', \\alpha')$", "MATH_0036": "$H^1_{syntomic}(S, \\mu_{n, S})$", "MATH_0037": "$\\xi \\in H^1_{syntomic}(S, \\mu_{n, S})$", "MATH_0038": "$\\xi$", "MATH_0039": "$\\overline{\\xi} \\in H^1_{syntomic}(S, \\mathbf{G}_{m, S})$", "MATH_0040": "$n \\overline{\\xi} = 0$", "MATH_0041": "$\\overline{\\xi}$", "MATH_0042": "$\\mathcal{L}$", "MATH_0043": "$n$", "MATH_0044": "$\\mathcal{O}_S$", "MATH_0045": "$(\\mathcal{L}, \\alpha')$", "MATH_0046": "$\\xi'$", "MATH_0047": "$\\overline{\\xi'}$", "MATH_0048": "$H^1_{syntomic}(S, \\mathbf{G}_{m, S})$", "MATH_0049": "$\\xi - \\xi'$", "MATH_0050": "$\\xi - \\xi' = \\partial(f)$", "MATH_0051": "$f \\in H^0(S, \\mathcal{O}_S^*)$", "MATH_0052": "$(\\mathcal{O}_S, f)$", "MATH_0053": "$\\partial(f)$", "MATH_0054": "$n$", "MATH_0055": "$S$", "MATH_0056": "$\\mathcal{V}$", "REF_0001": "\\ref{equation-isomorphisms-pairs}", "REF_0002": "\\ref{theorem-cech-ss}", "REF_0003": "\\ref{sites-modules-section-internal-hom}", "REF_0004": "\\ref{equation-isomorphisms-pairs}", "REF_0005": "\\ref{sites-cohomology-lemma-torsors-h1}", "REF_0006": "\\ref{sites-cohomology-lemma-trivial-torsor}", "REF_0007": "\\ref{theor