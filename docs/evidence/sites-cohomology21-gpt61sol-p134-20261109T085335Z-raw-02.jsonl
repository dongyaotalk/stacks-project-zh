{"unit_id":"tag:0FPT:statement","translation":"设 <MATH_0001> 为赋环位点（ringed site）。导出范畴（derived category）<MATH_0002> 是对称幺半范畴（symmetric monoidal category），其张量积（tensor product）由导出张量积（derived tensor product）给出，带有通常的结合性（associativity）与交换性（commutativity）约束（constraints）（符号规则（sign rules）见《代数进阶（More on Algebra）》第 <REF_0001> 节）。\n","allowed_english":[],"term_occurrences":[{"source_term":"ringed site","target_term":"赋环位点"},{"source_term":"derived category","target_term":"导出范畴"},{"source_term":"symmetric monoidal category","target_term":"对称幺半范畴"},{"source_term":"tensor product","target_term":"张量积"},{"source_term":"derived tensor product","target_term":"导出张量积"},{"source_term":"associativity","target_term":"结合性"},{"source_term":"commutativity","target_term":"交换性"},{"source_term":"constraints","target_term":"约束"},{"source_term":"sign rules","target_term":"符号规则"},{"source_term":"More on Algebra","target_term":"代数进阶"}],"unknown_terms":[{"source_term":"ringed site","target_term":"赋环位点","context":"系数位点"},{"source_term":"derived category","target_term":"导出范畴","context":"幺半环境"},{"source_term":"symmetric monoidal category","target_term":"对称幺半范畴","context":"导出张量结构"},{"source_term":"tensor product","target_term":"张量积","context":"幺半运算"},{"source_term":"derived tensor product","target_term":"导出张量积","context":"导出幺半运算"},{"source_term":"associativity","target_term":"结合性","context":"幺半约束"},{"source_term":"commutativity","target_term":"交换性","context":"对称约束"},{"source_term":"constraints","target_term":"约束","context":"幺半结构"},{"source_term":"sign rules","target_term":"符号规则","context":"分次交换符号"},{"source_term":"More on Algebra","target_term":"代数进阶","context":"引用章节"}],"notes":[]}
