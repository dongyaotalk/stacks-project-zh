{"chapter": "stacks-morphisms", "node_kind": "lemma", "parent_tag": "0CL4", "placeholders": {}, "render": {"prefix": "\\begin{lemma}\n\\label{lemma-composition-proper}\n", "suffix": "\\end{lemma}"}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:a40a09b8bd304fac5f42b1e36f7cf5abdb0bc0c3328ade512b8c2970ee1bc449", "source_text": "A composition of proper morphisms is proper.\n", "source_text_hash": "sha256:a2215eeaf72a90343a8435f29bbba8328292bda0f1848d568ab048e6c11c78d3", "unit_id": "tag:0CL7:statement"}
