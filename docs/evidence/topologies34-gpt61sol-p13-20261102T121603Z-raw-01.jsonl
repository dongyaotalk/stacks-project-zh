roperty），存在唯一的截面（section）<MATH_0070>，属于<MATH_0071>，定义在<MATH_0072>上，其到<MATH_0073>的限制（restriction）为<MATH_0074>。略去与上面类似的核验：<MATH_0075>限制（restricts）为<MATH_0076>，在<MATH_0077>上。\n","allowed_english":["Zariski","c"],"term_occurrences":[{"source_term":"scheme","target_term":"概形"},{"source_term":"covering","target_term":"覆盖"},{"source_term":"elements","target_term":"元素"},{"source_term":"map","target_term":"映到"},{"source_term":"element","target_term":"元素"},{"source_term":"element","target_term":"元素"},{"source_term":"restricting","target_term":"限制"},{"source_term":"affine","target_term":"仿射"},{"source_term":"structure morphism","target_term":"结构态射"},{"source_term":"maps","target_term":"映入"},{"source_term":"affine open","target_term":"仿射开集"},{"source_term":"covering","target_term":"覆盖"},{"source_term":"covering","target_term":"覆盖"},{"source_term":"cofiltered","target_term":"余滤过"},{"source_term":"limit","target_term":"极限"},{"source_term":"finite presentation","target_term":"有限表现"},{"source_term":"affine","target_term":"仿射"},{"source_term":"Algebra","target_term":"代数"},{"source_term":"covering","target_term":"覆盖"},{"source_term":"base change","target_term":"基变换"},{"source_term":"covering","target_term":"覆盖"},{"source_term":"base change","target_term":"基变换"},{"source_term":"covering","target_term":"覆盖"},{"source_term":"filtered colimits","target_term":"滤过余极限"},{"source_term":"exact","target_term":"正合"},{"source_term":"sheaf property","target_term":"层性质"},{"source_term":"affine open","target_term":"仿射开集"},{"source_term":"covering","target_term":"覆盖"},{"source_term":"maps","target_term":"映入"},{"source_term":"affine open","target_term":"仿射开集"},{"source_term":"covering","target_term":"覆盖"},{"source_term":"refines","target_term":"细化"},{"source_term":"index","target_term":"指标"},{"source_term":"morphism","target_term":"态射"},{"source_term":"element","target_term":"元素"},{"source_term":"restricting","target_term":"限制"},{"source_term":"restrict","target_term":"限制"},{"source_term":"element","