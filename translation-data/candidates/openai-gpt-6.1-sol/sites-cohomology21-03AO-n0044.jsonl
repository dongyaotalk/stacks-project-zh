 "STRUCT_0009": "\\item", "STRUCT_0010": "\\end{enumerate}", "STRUCT_0011": "\\end{definition}", "TEXTITCLOSE_0001": "}", "TEXTITCLOSE_0002": "}", "TEXTITCLOSE_0003": "}", "TEXTITCLOSE_0004": "}", "TEXTITOPEN_0001": "{\\it ", "TEXTITOPEN_0002": "{\\it ", "TEXTITOPEN_0003": "{\\it ", "TEXTITOPEN_0004": "{\\it "}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:66e6183fdeefd95d3623bf3c0535276090c583697c5febe7d839cc8001f2c60c", "source_status": "CURRENT", "source_structure_hash": "sha256:76b58ecf6fb26427f54305db8e3421f34f765793cc01121ec9a82b0b8f928a48", "source_text": "<STRUCT_0001>\n<LOCKED_0001>\nLet <MATH_0001> be an additive category.\n<STRUCT_0002>\n<STRUCT_0003> We set <MATH_0002>\nbe the <TEXTITOPEN_0001>category of (cochain) complexes<TEXTITCLOSE_0001>.\n<STRUCT_0004> A complex <MATH_0003> is said to be\n<TEXTITOPEN_0002>bounded below<TEXTITCLOSE_0002> if <MATH_0004> for all <MATH_0005>.\n<STRUCT_0005> A complex <MATH_0006> is said to be\n<TEXTITOPEN_0003>bounded above<TEXTITCLOSE_0003> if <MATH_0007> for all <MATH_0008>.\n<STRUCT_0006> A complex <MATH_0009> is said to be\n<TEXTITOPEN_0004>bounded<TEXTITCLOSE_0004> if <MATH_0010> for all <MATH_0011>.\n<STRUCT_0007> We let\n<MATH_0012>, <MATH_0013>,\nresp.<SPACE_0001><MATH_0014> be the full subcategory\nof <MATH_0015> whose objects are the complexes\nwhich are bounded below, bounded above, resp.<SPACE_0002>bounded.\n<STRUCT_0008> We let <MATH_0016> be the category with the same objects\nas <MATH_0017> but as morphisms homotopy classes of\nmaps of complexes (see\nHomology, Lemma <REF_0001>).\n<STRUCT_0009> We let <MATH_0018>, <MATH_0019>,\nresp.<SPACE_0003><MATH_0020> be the full subcategory of <MATH_0021>\nwhose objects are bounded below, bounded above, resp.<SPACE_0004>bounded\ncomplexes of <MATH_0022>.\n<STRUCT_0010>\n<STRUCT_0011>", "source_text_hash": "sha256:c6e15c3a4ea6cce2007b99a57342f5e57d2ecdb8a024dfecf3acc2b48016ce2b", "unit_id": "inventory:derived:013H:definition/0001"}}}, {"context_id": "locked-English-reference:homology:inventory:homology:0114:lemma/0001:homology-lemma-cat-cochain-abelian", "hash": "sha256:6b8724d576aa47fa9898ae0a9cd398df7f5d0d377614a5599585fec3496bc76d", "value": {"kind": "locked-English-reference", "location": {"byte_end": 102843, "byte_start": 102135, "file": "homology.tex", "fragment_hash": "sha256:9e5930aef54948258de6096a18f5b786b42389c8270e942de0efc801e84931b9", "line_end": 3134, "line_start": 3112}, "owner_tag": "0114", "parent_tag": "010V", "requested_label": "homology-lemma-cat-cochain-abelian", "requested_tag": "0114", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "homology", "node_kind": "lemma", "parent_tag": "010V", "placeholders": {"LOCKED_0001": "\\label{lemma-cat-cochain-abelian}", "MATH_0001": "$\\mathcal{A}$", "MATH_0002": "$\\mathcal{A}$", "MATH_0003": "$f : A^\\bullet \\to B^\\bullet$", "MATH_0004": "$f^n : A^n \\to B^n$", "MATH_0005": "$f : A^\\bullet \\to B^\\bullet$", "MATH_0006": "$f^n : A^n \\to B^n$", "MATH_0007": "$$\nA^\\bullet \\xrightarrow{f} B^\\bullet \\xrightarrow{g} C^\\bullet\n$$", "MATH_0008": "$B^\\bullet$", "MATH_0009": "$$\nA^i \\xrightarrow{f^i} B^i \\xrightarrow{g^i} C^i\n$$", "MATH_0010": "$B^i$", "STRUCT_0001": "\\begin{lemma}", "STRUCT_0002": "\\begin{enumerate}", "STRUCT_0003": "\\item", "STRUCT_0004": "\\item", "STRUCT_0005": "\\item", "STRUCT_0006": "\\item", "STRUCT_0007": "\\end{enumerate}", "STRUCT_0008": "\\end{lemma}"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:f840a95d85063e0f60be882a801fa2eac55cba1640d5f63a7a2b517adbb058d2", "source_status": "CURRENT", "source_structure_hash": "sha256:f3add6aaa965febca950ea849e2fcf84738e69ded878fa8a74069ed99fc2dff0", "source_text": "<STRUCT_0001>\n<LOCKED_0001>\nLet <MATH_0001> be an abelian category.\n<STRUCT_0002>\n<STRUCT_0003> The category of cochain complexes in <MATH_0002> is\nabelian.\n<STRUCT_0004> A morphism of cochain complexes\n<MATH_0003> is injective\nif and only if each <MATH_0004> is injective.\n<STRUCT_0005> A morphism of cochain complexes\n<MATH_0005> is surjective\nif and only if each <MATH_0006> is surjective.\n<STRUCT_0006> A sequence of cochain complexes\n<MATH_0007>\nis exact at <MATH_0008> if and only if each sequence\n<MATH_0009>\nis exact at <MATH_0010>.\n<STRUCT_0007>\n<STRUCT_0008>", "source_text_hash": "sha256:5b54b15b0a82cafde8527239f3b646bd7642951994e6e0d3b6a225b2095e203c", "unit_id": "inventory:homology:0114:lemma/0001"}}}], "input_freeze": {"hash": "sha256:1d5d93cd4489b642bbbfd0d3f292b148c91fa726031198f145743ac727f22ac1", "path": "translation-data/source-adoption-inputs/sites-cohomology21-gpt61sol-p102-20261109T053441Z.json"}, "model_output": {"hash": "sha256:98aa046b0e0d5ec2f3411122d1565a28058194e7b456bfb1956422661fc50a33", "path": "docs/evidence/sites-cohomology21-gpt61sol-p102-20261109T053441Z-raw-01.jsonl", "record_hash": "sha256:7b839415d0ffc6d923dddd969b7351f322a76b7721f3ce93a8935be0f999bc6f"}, "neighbor_unit_ids": ["tag:03AO:prose-0001"], "policy_revision": "git:ace0b76a7bf22124768d632353b60dbe75d4b0f9", "prior_generations": [], "prompt_version": "translator-v2", "source_adoption_id": "sites-cohomology21-gpt61sol-p102-20261109T053441Z", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "style_guide_path": "config/style-guide.md", "turn_id": "01a1beb5-b828-7092-a3e3-037f2e051a9c", "unit_id": "tag:03AO:title"}, "context_hash": "sha256:ff6b6b7be701ce7e2f7684c0df39c61a4a3ac83dbfa4e28913bb47db3705c3fd", "created_at": "2026-11-09T05:34:59.043366+00:00", "glossary_revision": "git:ace0b76a7bf22124768d632353b60dbe75d4b0f9", "harness_id": "codex", "harness_version": "0.167.0", "model_id": "gpt-6.1-sol", "model_identity_confidence": "declared", "model_lane": "openai-gpt-6.1-sol", "model_record