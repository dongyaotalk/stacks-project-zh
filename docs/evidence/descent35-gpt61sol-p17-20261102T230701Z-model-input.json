    {
      "unit_id": "tag:02YM:statement",
      "source_text": "The property <MATH_0001>``<MATH_0002> is an immersion''\nis fppf local on the base.\n",
      "node_kind": "lemma",
      "protected_nodes": {
        "MATH_0001": "$\\mathcal{P}(f) =$",
        "MATH_0002": "$f$"
