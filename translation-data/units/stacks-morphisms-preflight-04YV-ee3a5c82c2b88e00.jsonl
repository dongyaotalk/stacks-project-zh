{"chapter": "stacks-morphisms", "node_kind": "lemma", "parent_tag": "04YV", "placeholders": {"REF_0001": "\\ref{definition-separated}"}, "render": {"prefix": "\\begin{lemma}\n\\label{lemma-composition-separated}\n", "suffix": "\\end{lemma}"}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:417dae31166df3db8268f96b8fea45c43b8a69153c1f67dda26ab3170070de8e", "source_text": "All of the separation axioms listed in\nDefinition <REF_0001>\nare stable under composition of morphisms.\n", "source_text_hash": "sha256:8ebb1c7a1fe61812d3b0200aa2a560f521cd514919292e31cc05e7d238b81c2e", "unit_id": "tag:050K:statement"}
