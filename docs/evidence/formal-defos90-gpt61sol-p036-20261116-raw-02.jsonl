{"unit_id":"tag:06TD:prose-0001","translation":"\n\n<STRUCT_0001>\n本章的主要定理是上面的定理<REF_0001>。它完全描述了<MATH_0001>上能够由光滑的（smooth）前可表的（prorepresentable）函子群胚（groupoid in functors）给出展示（presentation）的群胚余纤维范畴（categories cofibred in groupoids）。本节简要讨论第<REF_0002>节和第<REF_0003>节中讨论的极小性（minimality）如何用于得到一个“极小的（minimal）”光滑（smooth）前可表（prorepresentable）展示（presentation）。\n\n","allowed_english":[],"term_occurrences":[{"source_term":"smooth","target_term":"光滑的"},{"source_term":"prorepresentable","target_term":"前可表的"},{"source_term":"groupoid in functors","target_term":"函子群胚"},{"source_term":"presentation","target_term":"展示"},{"source_term":"categories cofibred in groupoids","target_term":"群胚余纤维范畴"},{"source_term":"minimality","target_term":"极小性"},{"source_term":"minimal","target_term":"极小的"},{"source_term":"smooth","target_term":"光滑"},{"source_term":"prorepresentable","target_term":"前可表"},{"source_term":"presentation","target_term":"展示"}],"unknown_terms":[{"source_term":"smooth","target_term":"光滑的","context":"06TD：待决"},{"source_term":"prorepresentable","target_term":"前可表的","context":"06TD：待决"},{"source_term":"groupoid in functors","target_term":"函子群胚","context":"06TD：待决"},{"source_term":"presentation","target_term":"展示","context":"06TD：待决"},{"source_term":"categories cofibred in groupoids","target_term":"群胚余纤维范畴","context":"06TD：待决"},{"source_term":"minimality","target_term":"极小性","context":"06TD：待决"},{"source_term":"minimal","target_term":"极小的","context":"06TD：待决"},{"source_term":"smooth","target_term":"光滑","context":"06TD：待决"},{"source_term":"prorepresentable","target_term":"前可表","context":"06TD：待决"}],"notes":[]}
