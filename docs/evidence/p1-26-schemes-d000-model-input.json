          "node_kind": "definition",
          "risk_level": "R3",
          "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14",
          "source_text": "<STRUCT_0001>\n<LOCKED_0001>\nLet\n<MATH_0001> and\n<MATH_0002>\nbe morphisms of ringed spaces. Then we define\nthe <TEXTITOPEN_0001>composition of morphisms of ringed spaces<TEXTITCLOSE_0001>\nby the rule\n<MATH_0003>\nHere we use composition of <MATH_0004>-maps defined in\nDefinition <REF_0001>.\n<STRUCT_0002>",
          "source_status": "CURRENT",
          "placeholders": {
            "STRUCT_0001": "\\begin{definition}",
            "LOCKED_0001": "\\label{definition-composition-maps-ringed-spaces}",
            "MATH_0001": "$(f, f^\\sharp) : (X, \\mathcal{O}_X) \\to (Y, \\mathcal{O}_Y)$",
            "MATH_0002": "$(g, g^\\sharp) : (Y, \\mathcal{O}_Y) \\to (Z, \\mathcal{O}_Z)$",
            "TEXTITOPEN_0001": "{\\it ",
            "TEXTITCLOSE_0001": "}",
            "MATH_0003": "$$\n(g, g^\\sharp) \\circ (f, f^\\sharp) = (g \\circ f, f^\\sharp \\circ g^\\sharp).\n$$",
            "MATH_0004": "$f$",
            "REF_0001": "\\ref{definition-composition-f-maps}",
            "STRUCT_0002": "\\end{definition}"
          },
          "render": {
            "prefix": "",
            "suffix": ""
          },
          "source_text_hash": "sha256:e9d3251a4d8be67d08370359ec8bb9c11c0102d74c721ea5d296ab17d0d59fd0",
          "source_structure_hash": "sha256:1792eef380690e55557b3f6f793c9914b955acf144c1b6d62ac744b9aa07537f",
