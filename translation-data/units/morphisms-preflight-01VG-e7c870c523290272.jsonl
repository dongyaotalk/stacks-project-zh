{"chapter": "morphisms", "node_kind": "lemma", "parent_tag": "01VG", "placeholders": {"MATH_0001": "$f : X \\to S$", "MATH_0002": "$\\mathcal{L}$", "MATH_0003": "$\\mathcal{O}_X$", "MATH_0004": "$S' \\to S$", "MATH_0005": "$f' : X' \\to S'$", "MATH_0006": "$f$", "MATH_0007": "$\\mathcal{L}'$", "MATH_0008": "$\\mathcal{L}$", "MATH_0009": "$X'$", "MATH_0010": "$\\mathcal{L}$", "MATH_0011": "$f$", "MATH_0012": "$\\mathcal{L}'$", "MATH_0013": "$f'$"}, "render": {"prefix": "\\begin{lemma}\n\\label{lemma-ample-base-change}\n", "suffix": "\\end{lemma}"}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:fde80a8191cb57ddffd0429556da88b204eb45d11dccb7e63092ebcd2b24cb91", "source_status": "CURRENT", "source_structure_hash": "sha256:41ab6322db88089d41a1ef3279370c182b7eb102326feb44554b626f51fb350a", "source_text": "Let <MATH_0001> be a morphism of schemes.\nLet <MATH_0002> be an invertible <MATH_0003>-module.\nLet <MATH_0004> be a morphism of schemes.\nLet <MATH_0005> be the base change of <MATH_0006> and denote\n<MATH_0007> the pullback of <MATH_0008> to <MATH_0009>.\nIf <MATH_0010> is <MATH_0011>-ample, then <MATH_0012> is <MATH_0013>-ample.\n", "source_text_hash": "sha256:b6607b8fe3bebde5d99853061950582198ace971cc747d8e45248cee14db50e8", "unit_id": "tag:0893:statement"}
