{"chapter": "morphisms", "node_kind": "lemma", "parent_tag": "01WG", "placeholders": {}, "render": {"prefix": "\\begin{lemma}\n\\label{lemma-finite-integral}\n", "suffix": "\\end{lemma}"}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:04380c9b231986356a635171f4d7f881fba5f40ae905ee452bd3941c8a23fa3d", "source_text": "A finite morphism is integral.\nAn integral morphism which is locally of finite type is finite.\n", "source_text_hash": "sha256:78fb550ed0932ffd3ba2b9eb115d6aefb2393e7d3b97113b34f655d73553b7f0", "unit_id": "tag:01WJ:statement"}
