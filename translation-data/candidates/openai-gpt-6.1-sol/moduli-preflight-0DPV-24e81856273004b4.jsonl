: "sha256:68296af023937af788eb8f8a7f9872c5c9fa3b075d62810d7b8a4c3aa2f122d2", "source_status": "CURRENT", "source_structure_hash": "sha256:23810290b0a5f6bf299f9d03c07015016a3f6bfe0dceca2a9f3e744bfe875117", "source_text": "<STRUCT_0001>\n<LOCKED_0001>\nIn Situation <REF_0001> assume that <MATH_0001>\nis locally of finite presentation. Then\n<MATH_0002> is limit preserving\n(Artin's Axioms, Definition <REF_0002>).\n<STRUCT_0002>", "source_text_hash": "sha256:9cefbc99da770f87193b0de4083443abc1f87caa1ee15a763c474058b66b353c", "unit_id": "inventory:quot:0DLJ:lemma/0001"}}}, {"context_id": "sha256:d462a7080f6c92444acbf410847b1c74fa80a4ed1e8d6dfc8f9e7634735905a8", "hash": "sha256:d462a7080f6c92444acbf410847b1c74fa80a4ed1e8d6dfc8f9e7634735905a8", "value": {"kind": "locked-English-reference", "location": {"byte_end": 16684, "byte_start": 16235, "file": "stacks-limits.tex", "fragment_hash": "sha256:66975a481175f0a7741c5d8dbcb5cd11b2293848b6e85a57d4f21e51c8842fba", "line_end": 456, "line_start": 444}, "owner_tag": "0CMY", "parent_tag": "0CMQ", "requested_label": "stacks-limits-proposition-characterize-locally-finite-presentation", "requested_tag": "0CMY", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "stacks-limits", "node_kind": "proposition", "parent_tag": "0CMQ", "placeholders": {"LOCKED_0001": "\\label{proposition-characterize-locally-finite-presentation}", "LOCKED_0002": "\\begin{reference}\nThis is a special case of \\cite[Lemma 2.3.15]{Emerton-Gee}\n\\end{reference}", "MATH_0001": "$f : \\mathcal{X} \\to \\mathcal{Y}$", "MATH_0002": "$f$", "MATH_0003": "$f$", "MATH_0004": "$f$", "STRUCT_0001": "\\begin{proposition}", "STRUCT_0002": "\\begin{enumerate}", "STRUCT_0003": "\\item", "STRUCT_0004": "\\item", "STRUCT_0005": "\\item", "STRUCT_0006": "\\end{enumerate}", "STRUCT_0007": "\\end{proposition}"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:f4b74bd44c9002222d6561aaadc5856f82b44c89e5bc1b5a7d413afc90d85fe9", "source_status": "CURRENT", "source_structure_hash": "sha256:38a7b274c462fc8b3a8de70e4e562703f29cda893c5c00656a3c837ce1ca2bc4", "source_text": "<STRUCT_0001>\n<LOCKED_0001>\n<LOCKED_0002>\nLet <MATH_0001> be a morphism of algebraic stacks.\nThe following are equivalent\n<STRUCT_0002>\n<STRUCT_0003> <MATH_0002> is limit preserving,\n<STRUCT_0004> <MATH_0003> is limit preserving on objects, and\n<STRUCT_0005> <MATH_0004> is locally of finite presentation.\n<STRUCT_0006>\n<STRUCT_0007>", "source_text_hash": "sha256:5db710b00c1bb1ab7fc7bb4c423975c7236e797ecfb856b3d966ca683ea05d9e", "unit_id": "inventory:stacks-limits:0CMY:proposition/0001"}}}], "input_freeze": {"hash": "sha256:a013013808f70f1a69da8f03454a09fc1291c7a0d4c9403edd21b1f29f31fc8f", "path": "translation-data/source-adoption-inputs/p0-108-moduli-p008-r04.json"}, "model_output": {"hash": "sha256:2c37316c151a95352773f1534b758239fa75d3ca7bdddccbdbe9dbe8e32ddedf", "path": "docs/evidence/p0-108-moduli-p008-r04-raw-01.jsonl", "record_hash": "sha256:ef4c3d71604cf5b74ad6415daf5568c19022c988e81ed98654b1e3009732af86"}, "neighbor_unit_ids": ["tag:0DPX:statement"], "policy_revision": "git:47a3fd756322c92b986732a1a673c94462f5c165", "prior_generations": [], "prompt_version": "translator-v2", "source_adoption_id": "p0-108-moduli-p008-r04", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "style_guide_path": "config/style-guide.md", "turn_id": "01a20429-192b-7a23-bf0c-4f024d979bf3", "unit_id": "tag:0DPX:proof"}, "context_hash": "sha256:12fa3b637d96a5ef3e12c77a484b4c878e5c50a4664308d0207dff5797d35668", "created_at": "2026-11-22T16:48:54.230744+00:00", "glossary_revision": "git:47a3fd756322c92b986732a1a673c94462f5c165", "harness_id": "codex", "harness_version": "0.171.0", "model_id": "gpt-6.1-sol", "model_identity_confidence": "declared", "model_lane": "openai-gpt-6.1-sol", "model_record_id": "openai:gpt-6.1-sol:de