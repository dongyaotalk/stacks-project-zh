{"schema_version": 2, "unit_id": "tag:01NS:prose-0003", "parent_tag": "01NS", "chapter": "constructions", "node_kind": "paragraph", "risk_level": "R3", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_text": "\n\n<STRUCT_0001>\nSuppose <MATH_0001>. Consider the transformation of functors <MATH_0002>\nwhich assigns to the quadruple <MATH_0003> over\n<MATH_0004> the quadruple\n<MATH_0005>.\nOne of the implications of Lemma <REF_0001> is that the\ntransformation <MATH_0006> is injective!\nFor a quasi-compact scheme <MATH_0007> we define\n<MATH_0008>\nwith transition maps as explained above. This clearly defines a\ncontravariant functor on the category of quasi-compact schemes\nwith values in sets. For a general scheme\n<MATH_0009> we define\n<MATHSEG_0001> quasi-compact open<MATHSEG_0002>\nIn other words, an element <MATH_0010> of <MATH_0011> corresponds to a compatible system\nof choices of elements <MATH_0012> where <MATH_0013> ranges over the\nquasi-compact opens of <MATH_0014>.\nWe omit the definition of the pullback map <MATH_0015>\nfor a morphism <MATH_0016> of schemes.\nThus we have defined our functor\n<MATH_0017>\n\n", "source_status": "CURRENT", "placeholders": {"STRUCT_0001": "\\noindent", "MATH_0001": "$d' = ad$", "MATH_0002": "$F_d \\to F_{d'}$", "MATH_0003": "$(d, f, \\mathcal{L}, \\psi)$", "MATH_0004": "$T$", "MATH_0005": "$(d', f, \\mathcal{L}^{\\otimes a}, \\psi|_{f^*\\mathcal{A}^{(d')}})$", "REF_0001": "\\ref{lemma-equivalent-relative}", "MATH_0006": "$F_d \\to F_{d'}$", "MATH_0007": "$T$", "MATH_0008": "$$\nF(T) = \\bigcup\\nolimits_{d \\in \\mathbf{N}} F_d(T)\n$$", "MATH_0009": "$T$", "MATHSEG_0001": "$$\nF(T)\n=\n\\lim_{V \\subset T\\text{", "MATHSEG_0002": "}} F(V).\n$$", "MATH_0010": "$\\xi$", "MATH_0011": "$F(T)$", "MATH_0012": "$\\xi_V \\in F(V)$", "MATH_0013": "$V$", "MATH_0014": "$T$", "MATH_0015": "$F(T) \\to F(T')$", "MATH_0016": "$T' \\to T$", "MATH_0017": "\\begin{equation}\n\\label{equation-proj}\nF : \\Sch^{opp} \\longrightarrow \\textit{Sets}\n\\end{equation}"}, "render": {"prefix": "", "suffix": ""}, "math_text_regions": [{"region_id": "math/0001", "delimiter_kind": "display-dollar", "source": "$$\nF(T)\n=\n\\lim_{V \\subset T\\text{ quasi-compact open}} F(V).\n$$", "source_hash": "sha256:caccc0a412a6f94347ef80cb2f91bc81d678134c180acab17ec40e3c94a67c71", "source_byte_span": {"start": 640, "end": 703}, "pieces": [{"kind": "locked", "placeholder": "MATHSEG_0001"}, {"kind": "text", "slot_id": "math/0001/text/0001"}, {"kind": "locked", "placeholder": "MATHSEG_0002"}], "slots": [{"slot_id": "math/0001/text/0001", "source": " quasi-compact open", "command": "text", "policy_entry": "p0-frame-constructions-05", "slot_byte_span": {"start": 33, "end": 52}, "boundary_placeholders": ["MATHSEG_0001", "MATHSEG_0002"], "classification_witness": {"usage": "p0-locked-math-frame", "usage_source": {"before": "T", "after": "}", "environments": []}, "source_label": "constructions-section-morphisms-proj", "policy_hash": "sha256:71d3aca14a16ed05f2eb0827d4ff6e145236bad3cff1e9e685dc675c059dd357", "anchor": {"source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "file": "constructions.tex", "owner_tag": "01N4", "owner_label": "constructions-section-morphisms-proj", "kind": "section", "ordinal": 1, "matches": [{"container_byte_span": {"start": 98515, "end": 99531}, "container_hash": "sha256:fff35349c97362738755a9c83348446996201a7e855f67ba00caa6a5e2f3b452", "command_byte_span": {"start": 99191, "end": 99217}, "command_hash": "sha256:0138c440001a11c0416e418c2b3441f026684430881a9285a6f25a3d14dc1f0d"}, {"container_byte_span": {"start": 99787, "end": 100354}, "container_hash": "sha256:c8f7d4e4a28f929e2039e4b661fe91a0afa9ff266fbab015af49a24b6d0a1525", "command_byte_span": {"start": 100267, "end": 100293}, "command_hash": "sha256:0138c440001a11c0416e418c2b3441f026684430881a9285a6f25a3d14dc1f0d"}]}}}]}], "source_math_skeleton_hash": "sha256:ad137673b38acda7218abbfaf1f8034b39a3824d7ad309135880d8229d8c9c33