{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stacks-project-zh.invalid/schema/unit.schema.json",
  "title": "Stacks Project Chinese translation unit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "unit_id",
    "parent_tag",
    "chapter",
    "node_kind",
    "risk_level",
    "source_commit",
    "source_text",
    "source_text_hash",
    "source_structure_hash",
    "source_math_hash",
    "source_status",
    "placeholders",
    "render"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "unit_id": {"type": "string", "minLength": 1},
    "parent_tag": {"type": "string", "minLength": 4},
    "chapter": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "node_kind": {"type": "string", "minLength": 1},
    "risk_level": {"enum": ["R0", "R1", "R2", "R3"]},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_text": {"type": "string", "minLength": 1},
    "source_text_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_structure_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_math_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_status": {"enum": ["CURRENT", "STALE_TEXT", "STALE_MATH", "PARTIAL_STALE", "RETIRED"]},
    "placeholders": {
      "type": "object",
      "propertyNames": {"pattern": "^[A-Z][A-Z0-9]*_[0-9]{4}$"},
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prefix", "suffix"],
      "properties": {
        "prefix": {"type": "string"},
        "suffix": {"type": "string"}
      }
    }
  }
}
