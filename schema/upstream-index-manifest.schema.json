{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stacks-project-zh.invalid/schema/upstream-index-manifest.schema.json",
  "title": "Locked upstream index manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "commit",
    "commit_date",
    "permanent_tag_count",
    "tags_sha256",
    "chapters_sha256",
    "parser_version",
    "normalization_version"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "repository": {"type": "string", "minLength": 1},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "commit_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "permanent_tag_count": {"type": "integer"},
    "tags_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "chapters_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "parser_version": {"type": "string", "minLength": 1},
    "normalization_version": {"type": "string", "minLength": 1}
  }
}
