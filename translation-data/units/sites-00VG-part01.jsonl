{"chapter": "sites", "node_kind": "paragraph", "parent_tag": "00VG", "placeholders": {"STRUCT_0001": "\\noindent"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R2", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:700ad0f526519824a66166140fc4d055fb66f3c4e5b21f80672212b6479fee0e", "source_text": "\n\n<STRUCT_0001>\nOur notion of a site uses the following type of structures.\n\n", "source_text_hash": "sha256:9f946d9be951597801ffe84cd51eb6e372a8c2a1f17acda973291e5704c919eb", "unit_id": "tag:00VG:prose-0001"}
{"chapter": "sites", "node_kind": "definition", "parent_tag": "00VG", "placeholders": {"MATH_0001": "$\\mathcal{C}$", "MATH_0002": "$\\mathcal{C}$", "MATH_0003": "$U \\in \\Ob(\\mathcal{C})$", "MATH_0004": "$I$", "MATH_0005": "$i\\in I$", "MATH_0006": "$U_i \\to U$", "MATH_0007": "$\\mathcal{C}$", "MATH_0008": "$U$", "MATH_0009": "$\\{U_i \\to U\\}_{i\\in I}$", "REF_0001": "\\ref{conventions-section-categories}", "TEXTITCLOSE_0001": "}", "TEXTITOPEN_0001": "{\\it "}, "render": {"prefix": "\\begin{definition}\n\\label{definition-family-morphisms-fixed-target}\n", "suffix": "\\end{definition}"}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:35ce62fba4ff3e39619c9d73069dcff0ccd83f34438b7217f8a8fa45a7a94bca", "source_status": "CURRENT", "source_structure_hash": "sha256:f22be479c3b2266cde6c4552c392161efa7cbe67cd5070e0825ec25de97414e6", "source_text": "Let <MATH_0001> be a category, see\nConventions, Section <REF_0001>.\nA <TEXTITOPEN_0001>family of morphisms with fixed target<TEXTITCLOSE_0001> in <MATH_0002> is\ngiven by an object <MATH_0003>, a set <MATH_0004> and\nfor each <MATH_0005> a morphism <MATH_0006> of <MATH_0007> with target <MATH_0008>.\nWe use the notation <MATH_0009> to indicate this.\n", "source_text_hash": "sha256:f59ae85b2a8f66b2e2dfb36a62a9ab2614dabbbac71353db2b27e0de5a09e410", "unit_id": "tag:0396:statement"}
{"chapter": "sites", "node_kind": "paragraph", "parent_tag": "00VG", "placeholders": {"MATH_0001": "$I$", "STRUCT_0001": "\\noindent"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R2", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:9a80b8e053a9c661bf726ac93a9bcc9df4210acecea27e67ca4a1911fe77055c", "source_status": "CURRENT", "source_structure_hash": "sha256:6eabf4e0e9673212a4f1897a7a37d3951c5dcee2c58ce5210c3f3681f00622e9", "source_text": "\n\n<STRUCT_0001>\nIt can happen that the set <MATH_0001> is empty! This\nnotation is meant to suggest an open covering as in topology.\n\n", "source_text_hash": "sha256:632534a44a430bee1890f8b4aa24a0312f56f5dc7a515b4e5880f9bda490a37d", "unit_id": "tag:00VG:prose-0002"}
