          "node_kind": "proof",
          "risk_level": "R3",
          "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14",
          "source_text": "<STRUCT_0001>\nLet us construct the inverse to this functor. In\nFundamental Groups, Lemma <REF_0001>\nwe have seen that given a <MATH_0001>-set <MATH_0002> there exists an <ACCENT_0001>tale morphism\n<MATH_0003>\nsuch that <MATH_0004> is\nisomorphic to <MATH_0005> as a <MATH_0006>-set. Consider the sheaf\n<MATH_0007> on <MATH_0008> defined by\nthe rule <MATH_0009>. This is a sheaf as the <ACCENT_0002>tale\ntopology is subcanonical. Then we see that\n<MATH_0010>\nas <MATH_0011>-sets (details omitted). This gives the inverse of the functor and\nwe win.\n<STRUCT_0002>",
          "source_status": "CURRENT",
          "placeholders": {
            "STRUCT_0001": "\\begin{proof}",
            "REF_0001": "\\ref{pione-lemma-sheaves-point}",
            "MATH_0001": "$G$",
            "MATH_0002": "$M$",
            "ACCENT_0001": "\\'e",
            "MATH_0003": "$X \\to \\Spec(K)$",
            "MATH_0004": "$\\Mor_K(\\Spec(K^{sep}), X)$",
            "MATH_0005": "$M$",
            "MATH_0006": "$G$",
            "MATH_0007": "$\\mathcal{F}$",
            "MATH_0008": "$\\Spec(K)_\\etale$",
            "MATH_0009": "$U \\mapsto \\Mor_K(U, X)$",
            "ACCENT_0002": "\\'e",
            "MATH_0010": "$\\mathcal{F}_{\\overline{s}} = \\Mor_K(\\Spec(K^{sep}), X) = M$",
            "MATH_0011": "$G$",
            "STRUCT_0002": "\\end{proof}"
          },
