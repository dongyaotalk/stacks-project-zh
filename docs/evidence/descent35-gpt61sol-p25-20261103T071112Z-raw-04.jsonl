{"unit_id":"tag:02VV:prose-0001","translation":"<STRUCT_0001>事实上，fpqc-覆盖（coverings）的下降（descent）数据之间的拉回（pullback）函子（functor）是完全忠实的（fully faithful）。换言之，概形（schemes）的态射（morphisms）满足fpqc下降（descent）。本节的目标是证明这一点。鼓励读者自行证明这一点。关键在于使用引理<REF_0001>。","allowed_english":["fpqc-","fpqc"],"term_occurrences":[{"source_term":"coverings","target_term":"覆盖"},{"source_term":"descent","target_term":"下降"},{"source_term":"pullback","target_term":"拉回"},{"source_term":"functor","target_term":"函子"},{"source_term":"fully faithful","target_term":"完全忠实的"},{"source_term":"schemes","target_term":"概形"},{"source_term":"morphisms","target_term":"态射"},{"source_term":"descent","target_term":"下降"}],"unknown_terms":[{"source_term":"coverings","target_term":"覆盖","context":"fpqc覆盖；待批准"},{"source_term":"descent","target_term":"下降","context":"下降数据与态射下降；待批准"},{"source_term":"pullback","target_term":"拉回","context":"下降数据的拉回；待批准"},{"source_term":"functor","target_term":"函子","context":"拉回构造；待批准"},{"source_term":"fully faithful","target_term":"完全忠实的","context":"拉回函子的性质；待批准"},{"source_term":"schemes","target_term":"概形","context":"概形态射；待批准"},{"source_term":"morphisms","target_term":"态射","context":"fpqc下降的对象；待批准"}],"notes":[]}
