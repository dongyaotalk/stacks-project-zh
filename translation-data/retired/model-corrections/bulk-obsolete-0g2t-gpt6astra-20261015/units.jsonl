w{\\alpha} x\n$$", "source_byte_span": {"end": 1115, "start": 1020}, "source_hash": "sha256:5fa8094f1edcd1889c478ed99cc3d5db2ee041247f7ba995c41621b40d08d4fa"}], "node_kind": "lemma", "parent_tag": "0G2T", "placeholders": {"MATHSEG_0001": "$$\nx \\to x_1 \\to x_2 \\to \\ldots\n\\quad\\text{", "MATHSEG_0002": "}\\mathcal{X}\\text{", "MATHSEG_0003": "}\\quad\nU \\to U_1 \\to U_2 \\to \\ldots\n$$", "MATHSEG_0004": "$$\nx|_{U \\cap W} \\xrightarrow{\\text{", "MATHSEG_0005": "}x \\to x_n}\nx_n|_W \\xrightarrow{\\alpha} x\n$$", "MATH_0001": "$S$", "MATH_0002": "$\\mathcal{X}$", "MATH_0003": "$(\\Sch/S)_{fppf}$", "MATH_0004": "$x$", "MATH_0005": "$\\mathcal{X}$", "MATH_0006": "$U$", "MATH_0007": "$S$", "MATH_0008": "$u_n \\in U$", "MATH_0009": "$n \\geq 1$", "MATH_0010": "$x$", "MATH_0011": "$u_n$", "MATH_0012": "$n$", "MATH_0013": "$u_n$", "MATH_0014": "$S$", "MATH_0015": "$n$", "MATH_0016": "$U \\to U_n$", "MATH_0017": "$n$", "MATH_0018": "$$\n0 \\to \\kappa(u_n) \\to \\mathcal{O}_{U_n} \\to \\mathcal{O}_{U_{n - 1}} \\to 0\n$$", "MATH_0019": "$U_0 = U$", "MATH_0020": "$n = 1$", "MATH_0021": "$n$", "MATH_0022": "$(W, \\alpha)$", "MATH_0023": "$W \\subset U_n$", "MATH_0024": "$u_n$", "MATH_0025": "$\\alpha : x_n|_W \\to x$", "MATH_0026": "$x|_{U \\cap W} \\to x$", "STRUCT_0001": "\\begin{enumerate}", "STRUCT_0002": "\\item", "STRUCT_0003": "\\item", "STRUCT_0004": "\\item", "STRUCT_0005": "\\end{enumerate}", "TEXTBFCLOSE_0001": "}", "TEXTBFOPEN_0001": "{\\bf "}, "render": {"prefix": "\\begin{lemma}\n\\label{lemma-infinite-sequence}\n", "suffix": "\\end{lemma}"}, "risk_level": "R3", "schema_version": 2, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:ad8e8728b86d368ee5b4ac70df78e7e61c4229913c702e3597acd0696762c9c1", "source_math_skeleton_hash": "sha256:840ada154fbb81d1a6da46c342d32d9d737744c88284cab69a8808e6f5227b91", "source_status": "CURRENT", "source_structure_hash": "sha256:3fa32249f98bcc057cc4631464333301482a3c691d2386d9c59d4df746d1e6f7", "source_text": "Let <MATH_0001> be a locally Noetherian scheme. Let <MATH_0002> be a category\nfibred in groupoids over <MATH_0003> having (RS*).\nLet <MATH_0004> be an object of\n<MATH_0005> over an affine scheme <MATH_0006> of finite type over <MATH_0007>.\nLet <MATH_0008>, <MATH_0009> be pairwise distinct finite type points\nsuch that <MATH_0010> is not versal at <MATH_0011> for all <MATH_0012>. After replacing\n<MATH_0013> by a subsequence, there exist morphisms\n<MATHSEG_0001>in <MATHSEG_0002> lying over <MATHSEG_0003>\nover <MATH_0014> such that\n<STRUCT_0001>\n<STRUCT_0002> for each <MATH_0015> the morphism <MATH_0016> is a first order\nthickening,\n<STRUCT_0003> for each <MATH_0017> we have a short exact sequence\n<MATH_0018>\nwith <MATH_0019> for <MATH_0020>,\n<STRUCT_0004> for each <MATH_0021> there does <TEXTBFOPEN_0001>not<TEXTBFCLOSE_0001> exist a pair <MATH_0022>\nconsisting of an open neighbourhood <MATH_0023> of <MATH_0024>\nand a morphism <MATH_0025>\nsuch that the composition\n<MATHSEG_0004>restriction of <MATHSEG_0005>\nis the canonical morphism <MATH_0026>.\n<STRUCT_0005>\n", "source_text_hash": "sha256:cbc7b9746d19a699b46fe834c9f071548d147c4ce798ce966f9f3ef31a2dc5a4", "unit_id": "tag:0CXS:statement"}
{"chapter": "obsolete", "node_kind": "proof", "parent_tag": "0G2T", "placeholders": {"MATH_0001": "$u_n$", "MATH_0002": "$n \\geq 1$", "REF_0001": "\\ref{artin-lemma-SGE-implies-openness-versality}", "REF_0002": "\\ref{artin-lemma-infinite-sequence-pre}", "REF_0003": "\\ref{properties-lemma-thin-infinite-sequence}", "REF_0004": "\\ref{artin-lemma-infinite-sequence-pre}"}, "render": {"prefix": "\\begin{proof}\n", "suffix": "\\end{proof}"}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:336fccb96e82c1e046d86f84cea66c729f342c3741301a846d486e59e44c0873", "source_status": "CURRENT", "source_structure_hash": "sha256:6c6b1a79abc662857949103942731faa6cd15ff31f4fb9fb2de3b0859a6db317", "source_text": "This lemma was originally used in the proof of a criterion for\nopenness of versality\n(Artin's Axioms, Lemma <REF_0001>) but it\ngot replaced by Artin's Axioms, Lemma <REF_0002>\nfrom which it readily follows. Namely,\nafter replacing <MATH_0001>, <MATH_0002> by a subsequence we may and do\nassume that there are no specializations among these points, see\nProperties, Lemma <REF_0003>.\nThen we can apply\nArtin's Axioms, Lemma <REF_0004>\nto finish the proof.\n", "source_text_hash": "sha256:cfe42b896ad61262b2605f21ee2952afec7f4be76b4578614a471965c9e0f49d", "unit_id": "tag:0CXS:proof"}
