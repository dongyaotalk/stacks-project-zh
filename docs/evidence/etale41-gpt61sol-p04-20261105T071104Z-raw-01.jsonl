{"unit_id":"tag:06ND:prose-0004","translation":"\n\n<STRUCT_0001>\n上述拓扑（topological）结果将用于给出平展（<ACCENT_0001>tale）态射（morphisms）的函子性刻画（functorial characterization），类似于定理<REF_0001>。\n\n\n\n\n","allowed_english":[],"term_occurrences":[{"source_term":"topological","target_term":"拓扑"},{"source_term":"étale","target_term":"平展"},{"source_term":"morphisms","target_term":"态射"},{"source_term":"functorial characterization","target_term":"函子性刻画"}],"unknown_terms":[{"source_term":"topological","target_term":"拓扑","context":"前述结果所属的性质类别；译名待决。"},{"source_term":"étale","target_term":"平展","context":"随后需要刻画的态射性质；译名待决。"},{"source_term":"morphisms","target_term":"态射","context":"该刻画的对象；译名待决。"},{"source_term":"functorial characterization","target_term":"函子性刻画","context":"通过态射函子的性质给出的数学刻画；译名待决。"}],"notes":[]}
