{"chapter": "sites-cohomology", "node_kind": "lemma", "parent_tag": "03FA", "placeholders": {"MATH_0001": "$(\\mathcal{C}, \\mathcal{O})$", "MATH_0002": "$\\textit{PMod}(\\mathcal{O})$"}, "render": {"prefix": "\\begin{lemma}\n\\label{lemma-injective-module-injective-presheaf}\n", "suffix": "\\end{lemma}"}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:2e1ee1e4bd3f191c8f82a9843d7b6670d0801829b30ab41f19a2538fccb72afd", "source_status": "CURRENT", "source_structure_hash": "sha256:c3544133e57a6b19a74a20f4e9a2121db807f020ec9e992453bed14438c57c7c", "source_text": "Let <MATH_0001> be a ringed site.\nAn injective sheaf of modules is also injective as an\nobject in the category <MATH_0002>.\n", "source_text_hash": "sha256:ac332bb94205c5078947f6a0927c7dc207071640090360de2250d1893759d243", "unit_id": "tag:03FB:statement"}
