{"chapter": "sites-cohomology", "node_kind": "example", "parent_tag": "08RW", "placeholders": {"MATH_0001": "$u : \\mathcal{C}' \\to \\mathcal{C}$", "MATH_0002": "$\\mathcal{C}'$", "MATH_0003": "$\\mathcal{C}$", "MATH_0004": "$u$", "MATH_0005": "$\\mathcal{C}' \\to *$", "MATH_0006": "$\\mathcal{C} \\to *$", "MATH_0007": "$*$", "MATH_0008": "$g : \\Sh(\\mathcal{C}') \\to \\Sh(\\mathcal{C})$", "MATH_0009": "$\\pi' : \\Sh(\\mathcal{C}') \\to \\Sh(*)$", "MATH_0010": "$\\pi : \\Sh(\\mathcal{C}) \\to \\Sh(*)$", "MATH_0011": "$B$", "MATH_0012": "$*$", "MATH_0013": "$B$", "MATH_0014": "$\\mathcal{C}'$", "MATH_0015": "$\\mathcal{C}$", "MATH_0016": "$\\underline{B}$", "MATH_0017": "$$\n\\xymatrix{\n(\\Sh(\\mathcal{C}'), \\underline{B}) \\ar[rd]_{\\pi'} \\ar[rr]_g & &\n(\\Sh(\\mathcal{C}), \\underline{B}) \\ar[ld]^\\pi \\\\\n& (\\Sh(*), B)\n}\n$$", "MATH_0018": "$g$", "MATH_0019": "$g_!$", "MATH_0020": "$$\nH_n(\\mathcal{C}', \\mathcal{F}')\n\\longrightarrow\nH_n(\\mathcal{C}, \\mathcal{F})\n$$", "MATH_0021": "$\\mathcal{F}$", "MATH_0022": "$\\textit{Ab}(\\mathcal{C})$", "MATH_0023": "$\\mathcal{F}'$", "MATH_0024": "$\\textit{Ab}(\\mathcal{C}')$", "MATH_0025": "$t : \\mathcal{F}' \\to g^{-1}\\mathcal{F}$", "MATH_0026": "$$\nK_\\bullet(\\mathcal{F}') \\longrightarrow K_\\bullet(\\mathcal{F})\n$$", "MATH_0027": "$$\n(U'_n \\to \\ldots \\to U'_0, s') \\longmapsto\n(u(U'_n) \\to \\ldots \\to u(U'_0), t(s'))\n$$", "REF_0001": "\\ref{example-category-to-point}", "REF_0002": "\\ref{situation-morphism-fibred-categories}", "REF_0003": "\\ref{lemma-properties-lower-shriek-fibred-category}", "REF_0004": "\\ref{remark-morphism-fibred-categories}", "REF_0005": "\\ref{example-left-derived-colimits}"}, "render": {"prefix": "\\begin{example}\n\\label{example-morphism-categories}\n", "suffix": "\\end{example}"}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:d13dde252696594ed78a1ccb2da4fbd11ef50cea87d992e54e1618