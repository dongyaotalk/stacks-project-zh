ce, every <MATH_0016> has to\nbe the image of a morphism <MATH_0017>, and also every two\ndistinct morphisms <MATH_0018> have to give distinct\nmorphisms <MATH_0019>. This proves the lemma.\n<STRUCT_0002>", "source_text_hash": "sha256:4ee3289a6c88da83c446f3b99a2681eab45cc1a673945d60c28753c6c65cfc25", "unit_id": "inventory:categories:04Z7:proof/0001"}, "state": "READY"}}, "model_output": {"hash": "sha256:19558970d065ffffbccb7f35bc3819fa7ec52538f5b7487392ae8f22b69d890f", "path": "docs/evidence/categories-completion-p013-raw.jsonl", "record_hash": "sha256:952c4b9a388b8126d18043c8e094571fa3cb5f4387212c25599230a034e77745"}, "neighbor_unit_ids": ["tag:03YT:proof"], "policy_revision": "git:b33b9b37f1623d49d4030a11f1661dfc29fa2ce4", "prompt_version": "translator-v2", "read_context": {"citations": [], "neighbors": [{"context_id": "inventory:categories:04Z7:proof/0001", "relation": "before"}, {"context_id": "inventory:categories:03YT:proof/0001", "relation": "after"}], "references": [], "unit_id": "tag:03YT:statement"}, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_required_terms": {"catalog_hash": "sha256:899a668e50f3487b37dd8781e9b5a88e3e16d272ad91b4078ac6b9d847935c12", "occurrences": [{"concept": "category", "projection_end": 29, "projection_start": 21, "rule": "catalog", "source_term": "category"}, {"concept": "category", "projection_end": 73, "projection_start": 63, "rule": "catalog", "source_term": "categories"}, {"concept": "groupoid", "projection_end": 93, "projection_start": 84, "rule": "catalog", "source_term": "groupoids"}, {"concept": "equivalence", "projection_end": 169, "projection_start": 157, "rule": "catalog", "source_term": "equivalences"}, {"concept": "source-phrase-equivalence-of-categories", "projection_end": 236, "projection_start": 211, "rule": "catalog", "source_term": "equivalence of categories"}], "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_structure_hash": "sha256:2aac7f55ded0edbc712578ea49da03f4e0e2d5