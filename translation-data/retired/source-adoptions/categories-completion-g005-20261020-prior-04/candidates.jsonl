ate": "READY"}, "reference:categories-example-hom-functor": {"context_hash": "sha256:43f555ed4621c30e5022f752a3e258af86108cebe36c2a95afee05f72dcec8c0", "kind": "locked-English-reference", "location": {"byte_end": 19085, "byte_start": 18296, "file": "categories.tex", "fragment_hash": "sha256:d4ad7cd4198fc4efca8a37de87ca4f537f9e45615f8a3772cd39b28a605ef9ce", "line_end": 521, "line_start": 491}, "owner_tag": "001O", "parent_tag": "001L", "requested_label": "categories-example-hom-functor", "requested_tag": "001O", "semantic_path": "example/0001", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "categories", "node_kind": "example", "parent_tag": "001L", "placeholders": {"EMPHCLOSE_0001": "}", "EMPHOPEN_0001": "\\emph{", "LOCKED_0001": "\\label{example-hom-functor}", "MATH_0001": "$U\\in \\Ob(\\mathcal{C})$", "MATH_0002": "$$\n\\begin{matrix}\nh_U & : & \\mathcal{C}\n&\n\\longrightarrow\n&\n\\textit{Sets} \\\\\n& &\nX\n&\n\\longmapsto\n&\n\\Mor_\\mathcal{C}(X, U)\n\\end{matrix}\n$$", "MATH_0003": "$X$", "MATH_0004": "$\\Mor_\\mathcal{C}(X, U)$", "MATH_0005": "$h_U$", "MATH_0006": "$f : X\\to Y$", "MATH_0007": "$h_U(f) : \\Mor_\\mathcal{C}(Y, U)\\to \\Mor_\\mathcal{C}(X, U)$", "MATH_0008": "$\\phi$", "MATH_0009": "$\\phi\\circ f$", "MATH_0010": "$h_U : \\mathcal{C}^{opp} \\to \\textit{Sets}$", "MATH_0011": "$U$", "MATH_0012": "$\\mathcal{C}$", "MATH_0013": "$U$", "STRUCT_0001": "\\begin{example}", "STRUCT_0002": "\\end{example}", "TEXTITCLOSE_0001": "}", "TEXTITOPEN_0001": "{\\it "}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:3d10b7039aed038c11d0333703e7e8de20ec703effbe7d43b1f77542503e3968", "source_status": "CURRENT", "source_structure_hash": "sha256:b24b5221897408360f06092324539fc71c1fbcc3f080b875c97fd09f16bebac7", "source_text": "<STRUCT_0001>\n<LOCKED_0001>\nFunctor of points.\nFor any <MATH_0001> there is a contravariant\nfunctor\n<MATH_0002>\nwhich takes an object <MATH_0003> to the set\n<MATH_0004>. In other words <MATH_0005> is a presheaf.\nGiven a morphism <MATH_0006> the corresponding map\n<MATH_0007>\ntakes <MATH_0008> to <MATH_0009>. We will always denote\nthis presheaf <MATH_0010>.\nIt is called the <TEXTITOPEN_0001>representable presheaf<TEXTITCLOSE_0001> associated to <MATH_0011>.\nIf <MATH_0012> is the category of schemes this functor is\nsometimes referred to as the\n<EMPHOPEN_0001>functor of points<EMPHCLOSE_0001> of <MATH_0013>.\n<STRUCT_0002>", "source_text_hash": "sha256:6706795f223adc29c1835d0ee9fcb1e60be6d4a8dcd0c1ceb60373d44b1e65b4", "unit_id": "inventory:categories:001O:example/0001"}, "state": "READY"}, "reference:categories-example-presheaf": {"context_hash": "sha256:26c11bd670f457651f1df3f9e0efe3255cfd65246be005a421fd77912553a33f", "kind": "locked-English-reference", "location": {"byte_end": 288190, "byte_start": 286865, "file": "categories.tex", "fragment_hash": "sha256:5cbea948ea6cc1919aad53dd8e526c46892b0a684207a9994ba4328ec17f25ce", "line_end": 8057, "line_start": 8025}, "owner_tag": "04TM", "parent_tag": "0042", "requested_label": "categories-example-presheaf", "requested_tag": "04TM", "semantic_path": "example/0001", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "categories", "node_kind": "example", "parent_tag": "0042", "placeholders": {"LOCKED_0001": "\\label{example-presheaf}", "MATH_0001": "$F : \\mathcal{C}^{opp} \\to \\textit{Sets}$", "MATH_0002": "$f : V \\to U$", "MATH_0003": "$\\mathcal{C}$", "MATH_0004": "$F(f) = f^\\ast : F(U) \\to F(V)$", "MATH_0005": "$\\mathcal{S}_F$", "MATH_0006": "$\\mathcal{C}$", "MATH_0007": "$$\n\\Ob(\\mathcal{S}_F) =\n\\{(U, x) \\mid U \\in \\Ob(\\mathcal{C}), x \\in \\Ob(F(U))\\}.\n$$", "MATH_0008": "$(U, x), (V, y) \\in \\Ob(\\mathcal{S}_F)$", "MATH_0009": "\\begin{align*}\n\\Mor_{\\mathcal{S}_F}((V, y), (U, x))\n& =\n\\{f \\in \\Mor_\\mathcal{C}(V, U) \\mid f^*x = y\\}\n\\end{align*}", "MATH_0010": "$\\mathcal{C}$", "MATH_0011": "$g^\\ast \\circ f^\\ast = (f \\circ g)^\\ast$", "MATH_0012": "$\\mathcal{C}$", "MATH_0013": "$p_F : \\mathcal{S}_F \\to \\mathcal{C}$", "MATH_0014": "$(U, x) \\mapsto U$", "MATH_0015": "$\\mathcal{S}_{F, U}$", "MATH_0016": "$F(U)$", "MATH_0017": "$\\mathcal{S}_F$", "MATH_0018": "$\\mathcal{S}_F$", "REF_0001": "\\ref{example-functor-categories}", "REF_0002": "\\ref{example-functor-groupoids}", "REF_0003": "\\ref{example-functor-groupoids}", "STRUCT_0001": "\\begin{example}", "STRUCT_0002": "\\end{example}"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:d7af8716e436a51a1faf34d3e80f90f19ee24a9e9d2466b3b4fcca8fb9b07371", "source_status": "CURRENT", "source_structure_hash": "sha256:9e2d5b37af12676ce4e71c5689924c4efff4dad9159695f483e760d4ddb17760", "source_text": "<STRUCT_0001>\n<LOCKED_0001>\nThis example is the analogue of\nExamples <REF_0001> and\n<REF_0002>\nfor presheaves instead of ``presheaves of categories''.\nThe output will be a category fibred in sets instead of a fibred category.\nSuppose that <MATH_0001> is a presheaf.\nFor <MATH_0002> in <MATH_0003> we will\nsuggestively write <MATH_0004>.\nWe construct a category <MATH_0005> fibred in sets over <MATH_0006>\nas follows. Define\n<MATH_0007>\nFor <MATH_0008> we define\n<MATH_0009>\nComposition is inherited from composition in <MATH_0010>\nwhich works as <MATH_0011>\nfor a pair of composable morphisms of <MATH_0012>.\nThe functor <MATH_0013>\nis given by the rule <MATH_0014>.\nAs every fibre category <MATH_0015> is discrete with underlying\nset <MATH_0016> and we have already see in\nExample <REF_0003>\nthat <MATH_0017> is a category fibred in groupoids,\nwe conclude that <MATH_0018> is fibred in sets.\n<STRUCT_0002>", "source_text_hash": "sha256:20a5cdd29d7bff0cc32dc913394af9bc195b1003b3c316d418f61c1c75c63a0f", 