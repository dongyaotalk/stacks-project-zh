{"unit_id":"tag:039K:statement","translation":"设<MATH_0001>为局部诺特（locally Noetherian）概形（scheme）。设<MATH_0002>为一个态射（morphism），它平坦（flat）且局部有限型（locally of finite type）。则<MATH_0003>是（普遍（universally））开的（open）。\n","allowed_english":[],"term_occurrences":[{"source_term":"locally Noetherian","target_term":"局部诺特"},{"source_term":"scheme","target_term":"概形"},{"source_term":"morphism","target_term":"态射"},{"source_term":"flat","target_term":"平坦"},{"source_term":"locally of finite type","target_term":"局部有限型"},{"source_term":"universally","target_term":"普遍"},{"source_term":"open","target_term":"开的"}],"unknown_terms":[{"source_term":"locally Noetherian","target_term":"局部诺特","context":"底概形的性质，暂译待决。"},{"source_term":"scheme","target_term":"概形","context":"底几何对象，暂译待决。"},{"source_term":"morphism","target_term":"态射","context":"定理的态射，暂译待决。"},{"source_term":"flat","target_term":"平坦","context":"态射的平坦性，暂译待决。"},{"source_term":"locally of finite type","target_term":"局部有限型","context":"态射的有限型条件，暂译待决。"},{"source_term":"universally","target_term":"普遍","context":"开性对任意基变换的限定，暂译待决。"},{"source_term":"open","target_term":"开的","context":"结论中的开性，暂译待决。"}],"notes":[]}
