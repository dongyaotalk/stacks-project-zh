{"chapter": "artin", "node_kind": "paragraph", "parent_tag": "07T1", "placeholders": {"MATH_0001": "$S$", "REF_0001": "\\ref{algebraic-section-conventions}", "STRUCT_0001": "\\noindent"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R2", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:86ec2eecd570d0c8a4f479624baf284069e51967c1f2fc353abd21054aea9915", "source_status": "CURRENT", "source_structure_hash": "sha256:4083c26c1605ceac637b502499691396e4a5974878fb6b3c9ff0b5f6d075065b", "source_text": "\n\n<STRUCT_0001>\nThe conventions we use in this chapter are the same as those in the\nchapter on algebraic stacks, see\nAlgebraic Stacks, Section <REF_0001>.\nIn this chapter the base scheme <MATH_0001> will often be locally Noetherian\n(although we will always reiterate this condition when stating\nresults).\n\n\n\n\n\n", "source_text_hash": "sha256:8d77a6ff3f53b2526f125c31e05cd0f3a57121152fb39122fb3006f4bc50a930", "unit_id": "tag:07T1:prose-0001"}
