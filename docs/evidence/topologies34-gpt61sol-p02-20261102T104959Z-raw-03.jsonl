{"unit_id":"tag:020L:prose-0001","translation":"\n\n<STRUCT_0001>\n本文解释概形（schemes）的范畴（category）上各种拓扑（topologies）是什么。一些参考文献是<REF_0001>和<REF_0002>。在此之前，我们想指出，景（sites）（定义见《景（Sites）》定义<REF_0003>）有许多不同的选择，它们在底层范畴（underlying category）上给出相同的层（sheaf）概念。因此，我们的选择可能与参考文献中的选择略有不同，但最终得到相同的上同调群（cohomology groups）等。\n\n","allowed_english":[],"term_occurrences":[{"source_term":"schemes","target_term":"概形"},{"source_term":"category","target_term":"范畴"},{"source_term":"topologies","target_term":"拓扑"},{"source_term":"sites","target_term":"景"},{"source_term":"Sites","target_term":"景"},{"source_term":"underlying category","target_term":"底层范畴"},{"source_term":"sheaf","target_term":"层"},{"source_term":"cohomology groups","target_term":"上同调群"}],"unknown_terms":[{"source_term":"schemes","target_term":"概形","context":"对象术语，未批准"},{"source_term":"category","target_term":"范畴","context":"范畴术语，未批准"},{"source_term":"topologies","target_term":"拓扑","context":"本章主题，未批准"},{"source_term":"sites","target_term":"景","context":"景的选择，未批准"},{"source_term":"Sites","target_term":"景","context":"引用章名，未批准"},{"source_term":"underlying category","target_term":"底层范畴","context":"景的底层范畴，未批准"},{"source_term":"sheaf","target_term":"层","context":"景上的层，未批准"},{"source_term":"cohomology groups","target_term":"上同调群","context":"所得上同调群，未批准"}],"notes":[]}
