e83347d37fb92a16e12b5e9760452ad7d25b55c93b62133ebfe43a482e40a3fa", "path": "docs/evidence/p1-29-morphisms-p013-raw-01.jsonl", "record_hash": "sha256:a39d5009b317fedf1225f9b9e8df85d2731c0ad2be3bf019d779f79289db2e2b"}, "neighbor_unit_ids": [], "policy_revision": "git:c0c436b9d7ac86a6d277fd74ff439fd2389bdb84", "prior_generations": [], "prompt_version": "translator-v2", "source_adoption_id": "p1-29-morphisms-p013", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "style_guide_path": "config/style-guide.md", "turn_id": "01a21bb5-3fae-7131-a73e-1dcf0d7a9c66", "unit_id": "tag:01T9:prose-0004"}, "context_hash": "sha256:a6990da5d9281f0b722ab3bd699a3f8cb00061628d313643ca5f1761a8ce7483", "created_at": "2026-11-27T06:33:14.419Z", "glossary_revision": "git:c0c436b9d7ac86a6d277fd74ff439fd2389bdb84", "harness_id": "codex", "harness_version": "0.172.0", "model_id": "gpt-6.2-sol", "model_identity_confidence": "declared", "model_lane": "openai-gpt-6.2-sol", "model_record_id": "openai:gpt-6.2-sol:declared", "model_snapshot": null, "notes": [], "prompt_version": "translator-v2", "publication_status": "CANDIDATE", "qa_status": "PASS", "reasoning_effort": "high", "run_id": "run-p1-29-morphisms-p013", "schema_version": 2, "source_adoption_id": "p1-29-morphisms-p013", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_status": "CURRENT", "source_text_hash": "sha256:1a99546581702d476862ea89ad3581949058cdd556d65c0d39c81f223434b3cc", "stage": "STRUCTURE_OK", "term_occurrences": [{"source_term": "Topology", "target_term": "拓扑学"}, {"source_term": "closed points", "target_term": "闭点"}, {"source_term": "set", "target_term": "集合"}, {"source_term": "finite type", "target_term": "有限型"}, {"source_term": "set", "target_term": "集合"}, {"source_term": "Jacobson", "target_term": "雅各布森"}, {"source_term": "closed points", "target_term": "闭点"}, {"source_term": "finite type points", "target_term": "有限型点"}], "term_status": "DECISION_REQUIRED", "translation": "\n\n<STRUCT_0001>\n由此可知，拓扑学（Topology）一章第<REF_0001>节中的大部分内容仍然成立，只需将闭点（closed points）的集合（set）换成由有限型（finite type）点组成的集合（set）。事实上，若<MATH_0001>是雅各布森（Jacobson）的，则闭点（closed points）恰好就是有限型点（finite type points）。\n\n", "translation_hash": "sha256:0983e76a39995a718a72fb261c2fdf836c330ddd89814061b391833a912dd9ad", "unit_id": "tag:01T9:prose-0004", "unknown_terms": [{"context": "被引用的篇章标题。", "source_term": "Topology", "target_term": "拓扑学"}, {"context": "原集合由闭点组成。", "source_term": "closed points", "target_term": "闭点"}, {"context": "指闭点所成的集合。", "source_term": "set", "target_term": "集合"}, {"context": "修饰替换后集合中的点。", "source_term": "finite type", "target_term": "有限型"}, {"context": "指有限型点所成的集合。", "source_term": "set", "target_term": "集合"}, {"context": "第二句中保证两类点一致的条件。", "source_term": "Jacobson", "target_term": "雅各布森"}, {"context": "在所述条件下与有限型点一致。", "source_term": "closed points", "target_term": "闭点"}, {"context": "在所述条件下与闭点一致。", "source_term": "finite type points", "target_term": "有限型点"}]}
