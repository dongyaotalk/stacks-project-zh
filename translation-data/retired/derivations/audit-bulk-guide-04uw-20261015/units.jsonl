{"chapter": "guide", "node_kind": "paragraph", "parent_tag": "04UW", "placeholders": {"CITE_0001": "\\cite{ArtinVersal}"}, "render": {"prefix": "", "suffix": "\n\\begin{itemize}\n"}, "risk_level": "R1", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:f9581ace0f821f11e1c028f02e52e71417f57b54c0520a035ac0712bbff22e86", "source_text": "The first three papers by Artin do not contain anything on stacks but they contain powerful results with the first two papers being essential for <CITE_0001>.", "source_text_hash": "sha256:2d92287f1986b6a5463890817494faa0d4200606c16cbddd04e50035464ff081", "unit_id": "tag:04UW:p001"}
