ruction <MATH_0025>.\n\n<STRUCT_0006><STRUCT_0007>\nWe omit the verification that these constructions\nare mutually quasi-inverse functors. The final statements\n(1) and (2) follow from the constructions.\n<STRUCT_0008>", "source_text_hash": "sha256:8e7ccdb49683bfe2aeaaf19635d5265b0703d70c0720554be54500ecf1ded433", "unit_id": "inventory:descent:02W5:proof/0001"}}}, {"context_id": "reference:descent-lemma-descent-data-sheaves", "hash": "sha256:abf8463e5676d7b3b2020de467820ed8ae9b78f121a65f9851de76440ccc7f2e", "value": {"kind": "locked-English-reference", "location": {"byte_end": 351356, "byte_start": 350313, "file": "descent.tex", "fragment_hash": "sha256:b55a5b411ecd4bf41089699fd499d4127b894756bcd07b73e2bc0b96bfb6f31c", "line_end": 9366, "line_start": 9334}, "owner_tag": "02W5", "parent_tag": "02W4", "requested_label": "descent-lemma-descent-data-sheaves", "requested_tag": "02W5", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "descent", "node_kind": "lemma", "parent_tag": "02W4", "placeholders": {"FOOTNOTECLOSE_0001": "}", "FOOTNOTEOPEN_0001": "\\footnote{", "LOCKED_0001": "\\label{lemma-descent-data-sheaves}", "MATH_0001": "$\\tau \\in \\{Zariski, fppf, \\etale, smooth, syntomic\\}$", "MATH_0002": "$\\Sch_\\tau$", "MATH_0003": "$\\tau$", "MATH_0004": "$S \\in \\Ob(\\Sch_\\tau)$", "MATH_0005": "$\\{S_i \\to S\\}_{i \\in I}$", "MATH_0006": "$(\\Sch/S)_\\tau$", "MATH_0007": "$$\n\\left\\{\n\\begin{matrix}\n\\text{descent data }(X_i, \\varphi_{ii'})\\text{ such that}\\\\\n\\text{each }X_i \\in \\Ob((\\Sch/S)_\\tau)\n\\end{matrix}\n\\right\\}\n\\leftrightarrow\n\\left\\{\n\\begin{matrix}\n\\text{sheaves }F\\text{ on }(\\Sch/S)_\\tau\\text{ such that}\\\\\n\\text{each }h_{S_i} \\times F\\text{ is representable}\n\\end{matrix}\n\\right\\}.\n$$", "MATH_0008": "$h_{S_i} \\times F$", "MATH_0009": "$X_i$", "MATH_0010": "$F$", "MATH_0011": "$(X_i, \\varphi_{ii'})$", "REF_0001": "\\ref{topologies-section-fpqc}", "STRUCT_0001": "\\begin{