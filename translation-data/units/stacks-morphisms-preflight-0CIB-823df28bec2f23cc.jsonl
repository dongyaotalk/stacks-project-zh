\in |\\mathcal{X}|\n}\n}\n$$", "MATH_0001": "$f : \\mathcal{X} \\to \\mathcal{Y}$", "MATH_0002": "$x \\in |\\mathcal{X}|$", "MATH_0003": "$U$", "MATH_0004": "$V$", "MATH_0005": "$b$", "MATH_0006": "$(a, h) : U \\to \\mathcal{X} \\times_\\mathcal{Y} V$", "MATH_0007": "$h$", "MATH_0008": "$u$", "MATH_0009": "$h$", "MATH_0010": "$u$", "STRUCT_0001": "\\begin{enumerate}", "STRUCT_0002": "\\item", "STRUCT_0003": "\\item", "STRUCT_0004": "\\end{enumerate}"}, "render": {"prefix": "\\begin{lemma}\n\\label{lemma-flat-at-point}\n", "suffix": "\\end{lemma}"}, "risk_level": "R3", "schema_version": 2, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:ff39300c17cfc93e02141f25b75b2c927a35ef7499037584b269e452944ef470", "source_math_skeleton_hash": "sha256:449bad6701647645f3f758a36b29575bbd3473325ccea81e95cfb76b92a966c3", "source_status": "CURRENT", "source_structure_hash": "sha256:2f77884a69eb963ba1336ff9ffbe36043dfbd1d60d54bc12d091a828bb19d05d", "source_text": "Let <MATH_0001> be a morphism of algebraic stacks.\nLet <MATH_0002>. Consider commutative diagrams\n<MATHSEG_0001>with points<MATHSEG_0002>\nwhere <MATH_0003> and <MATH_0004> are algebraic spaces, <MATH_0005> is flat, and\n<MATH_0006>\nis flat. The following are equivalent\n<STRUCT_0001>\n<STRUCT_0002> <MATH_0007> is flat at <MATH_0008> for one diagram as above,\n<STRUCT_0003> <MATH_0009> is flat at <MATH_0010> for every diagram as above.\n<STRUCT_0004>\n", "source_text_hash": "sha256:09049eb252549612eb8b641c1759f9437e6f993477db613cc28f2d99c53953bb", "unit_id": "tag:0CIC:statement"}
{"chapter": "stacks-morphisms", "node_kind": "proof", "parent_tag": "0CIB", "placeholders": {"MATH_0001": "$U', V', u', a', b', h'$", "MATH_0002": "$$\n\\xymatrix{\nU \\ar[d] & U \\times_\\mathcal{X} U' \\ar[l] \\ar[d] \\ar[r] & U' \\ar[d] \\\\\nV & V \\times_\\mathcal{Y} V' \\ar[l] \\ar[r] & V'\n}\n$$", "MATH_0003": "$u'' \\in |U \\times_\\mathcal{X} U'|$", "MATH_0004": "$u$", "MATH_0005": "$u'$", "MATH_0006": "$h$", "MATH_0007": "$u$", "MATH_0008": "$U \\times_V (V \\times_\\mathcal{Y} V') \\to V \\times_\\mathcal{Y} V'$", "MATH_0009": "$u$", "MATH_0010": "$$\nU \\times_\\mathcal{X} U' \\to\nU \\times_\\mathcal{X} (\\mathcal{X} \\times_\\mathcal{Y} V') =\nU \\times_\\mathcal{Y} V' =\nU \\times_V (V \\times_\\mathcal{Y} V')\n$$", "MATH_0011": "$(a', h')$", "MATH_0012": "$U \\times_\\mathcal{X} U' \\to V \\times_\\mathcal{Y} V'$", "MATH_0013": "$u''$", "MATH_0014": "$V \\times_\\mathcal{Y} V' \\to V'$", "MATH_0015": "$U \\times_\\mathcal{X} U' \\to V'$", "MATH_0016": "$u''$", "MATH_0017": "$U \\times_\\mathcal{X} U' \\to U'$", "MATH_0018": "$u''$", "MATH_0019": "$u''$", "MATH_0020": "$u'$", "MATH_0021": "$U' \\to V'$", "MATH_0022": "$u'$", "REF_0001": "\\ref{stacks-properties-lemma-points-cartesian}", "REF_0002": "\\ref{spaces-morphisms-lemma-base-change-module-flat}", "REF_0003": "\\ref{lemma-base-change-flat}", "REF_0004": "\\ref{spaces-morphisms-lemma-composition-module-flat}", "REF_0005": "\\ref{spaces-morphisms-lemma-flat-permanence}"}, "render": {"prefix": "\\begin{proof}\n", "suffix": "\\end{proof}"}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:1a55fb2338d40d4cef2360f6ab21a2bbae53845b2ecf18708b67057e61c1b1c1", "source_status": "CURRENT", "source_structure_hash": "sha256:dd6e98708af70581225150d468fad984387ff321aac255ba053121352661395a", "source_text": "Suppose we are given a second diagram <MATH_0001> as\nin the lemma. Then we can consider\n<MATH_0002>\nBy Properties of Stacks, Lemma <REF_0001>\nthere is a point <MATH_0003> mapping\nto <MATH_0004> and <MATH_0005>. If <MATH_0006> is flat at <MATH_0007>, then the base change\n<MATH_0008>\nis flat at any point over <MATH_0009>, see\nMorphisms of Spaces, Lemma <REF_0002>.\nOn the other hand, the morphism\n<MATH_0010>\nis flat as a base change of <MATH_0011>, see Lemma <REF_0003>.\nComposing and using\nMorphisms of Spaces, Lemma <REF_0004>\nwe conclude that <MATH_0012>\nis flat at <MATH_0013>. Then we can use composition by the flat map\n<MATH_0014> to conclude that\n<MATH_0015> is flat at <MATH_0016>.\nFinally, since <MATH_0017> is flat\nat <MATH_0018> and <MATH_0019> maps to <MATH_0020> we conclude that\n<MATH_0021> is flat at <MATH_0022> by\nMorphisms of Spaces, Lemma <REF_0005>.\n", "source_text_hash": "sha256:d3e5daee58ad378bfbfe1f94e6d5ae93ddc399c4019ce430c36c9d269a2c2b60", "unit_id": "tag:0CIC:proof"}
