{"chapter": "categories", "node_kind": "paragraph", "parent_tag": "0042", "placeholders": {"STRUCT_0001": "\\noindent"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R2", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:e11e36da1276b2cd16e3e6b5120e5441fdb8649b1f30fdc93d9ed136d35b4812", "source_text": "\n\n<STRUCT_0001>\nA discrete category has only one interesting piece of information:\nits set of objects. Thus we sometime confuse discrete categories\nwith sets.\n\n", "source_text_hash": "sha256:495e6dde55945a6f4e51e092557c54c3211672100ae44491e58e591193b3564a", "unit_id": "tag:0042:prose-0001"}
