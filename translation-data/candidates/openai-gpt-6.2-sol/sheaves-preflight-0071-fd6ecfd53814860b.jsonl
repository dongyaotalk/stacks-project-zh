 underlying presheaf of sets is a sheaf, see\nExample <REF_0002>.\nHowever, if each <MATH_0008> has at least two elements, then\nthis is not a sheaf of topological spaces\naccording to Definition <REF_0003>.\nThe reader may check that putting the <TEXTITOPEN_0001>product topology<TEXTITCLOSE_0001> on\neach <MATH_0009> does lead to a sheaf\nof topological spaces over <MATH_0010>.\n<STRUCT_0002>", "source_text_hash": "sha256:fb2261dcacc88cf9d1d837667b67b3ed20a6aa2e9b9bec15c375aea9dd7935ad", "unit_id": "inventory:sheaves:0075:example/0001"}}}, {"context_id": "sha256:8f0ab0ebcba522752620faa71d0205e1aca0bb50dc427928153ef9d4ad6504d1", "hash": "sha256:8f0ab0ebcba522752620faa71d0205e1aca0bb50dc427928153ef9d4ad6504d1", "value": {"kind": "locked-English-reference", "location": {"byte_end": 19529, "byte_start": 18710, "file": "sheaves.tex", "fragment_hash": "sha256:90e7a4291238cb0fe8e5784fd2bf7ee21c45b936b75a3fa06ed0d11a2eb2a041", "line_end": 572, "line_start": 553}, "owner_tag": "006V", "parent_tag": "006S", "requested_label": "sheaves-example-basic-continuous-maps", "requested_tag": "006V", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "sheaves", "math_text_regions": [{"delimiter_kind": "display-dollar", "pieces": [{"kind": "locked", "placeholder": "MATHSEG_0001"}, {"kind": "text", "slot_id": "math/0001/text/0001"}, {"kind": "locked", "placeholder": "MATHSEG_0002"}], "region_id": "math/0001", "slots": [{"boundary_placeholders": ["MATHSEG_0001", "MATHSEG_0002"], "classification_witness": {"anchor": {"file": "sheaves.tex", "kind": "section", "matches": [{"command_byte_span": {"end": 18946, "start": 18925}, "command_hash": "sha256:f5e24371d0795f87360a307524954e28e186d91af192f73345e987a6fdd9ad23", "container_byte_span": {"end": 19529, "start": 18710}, "container_hash": "sha256:90e7a4291238cb0fe8e5784fd2bf7ee21c45b936b75a3fa06ed0d11a2eb2a041"}], "ordinal": 1, "owner_label": "sheaves-section-sheaves", "owner_tag": "006S", "source_commit": 