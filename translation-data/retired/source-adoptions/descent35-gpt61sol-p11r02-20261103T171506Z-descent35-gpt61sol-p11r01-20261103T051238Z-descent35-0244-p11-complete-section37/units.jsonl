{"chapter": "descent", "node_kind": "paragraph", "parent_tag": "0244", "placeholders": {"STRUCT_0001": "\\noindent"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R2", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:ad4ca37fe31df4e3d026886c5478c4ce3aadc645732f222962038059288e65c2", "source_text": "\n\n<STRUCT_0001>\nIn this section we show that\n``affine morphisms satisfy descent for fpqc-coverings''.\nHere is the formal statement.\n\n", "source_text_hash": "sha256:5eccd744500d44087c01f2fb98ab51f4d7b63399cd4488a699e189edd8dff27e", "unit_id": "tag:0244:prose-0001"}
