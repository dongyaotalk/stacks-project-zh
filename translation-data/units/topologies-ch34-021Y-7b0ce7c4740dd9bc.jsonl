{"chapter": "topologies", "node_kind": "paragraph", "parent_tag": "021Y", "placeholders": {"STRUCT_0001": "\\noindent"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R2", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:030abbc6ecdc114edec68dd307c0a7a43847d5de3d23c57d6a7a3507ea2b9b42", "source_text": "\n\n<STRUCT_0001>\nThus we define the corresponding standard coverings of affines as follows.\n\n", "source_text_hash": "sha256:c6fc6acd5442ae08d942785456938b46f7474665c094eb74d77f623a49f76092", "unit_id": "tag:021Y:prose-0003"}
