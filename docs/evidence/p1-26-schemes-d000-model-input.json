  "locked_english_contexts": [
    {
      "context_id": "sha256:258bb8e215cd7628e5d6b0565e40a23422b1ccfe9f88427750c69eeecd2a3def",
      "value": {
        "kind": "locked-English-neighbor",
        "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14",
        "source_unit": {
          "schema_version": 1,
