{"chapter": "categories", "node_kind": "paragraph", "parent_tag": "003D", "placeholders": {"MATH_0001": "$2$", "MATH_0002": "$2$"}, "render": {"prefix": "\\noindent\n", "suffix": "\n\n\\medskip\\noindent\n"}, "risk_level": "R2", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:30a9c1d9b4fa53bcc0a2a072b21e1b9b010a3af0ebe92482f9e839ef237579b5", "source_status": "CURRENT", "source_structure_hash": "sha256:7c691efd25197452959062eb3fd12eec5e927303e8bf53f903b3a003cf6f1beb", "source_text": "In this section we discuss some formal properties of the <MATH_0001>-category of categories. This will lead us to the definition of a (strict) <MATH_0002>-category later.", "source_text_hash": "sha256:8d8b9af34cb9cfb27abff32fba83b1876f26fea80040ce8bf1b49a4240995b45", "unit_id": "tag:003D:p001"}
