refix": "", "suffix": ""}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:bdbcf3bed9aa6bdc72ab37f0866277ac52d513e2f9afcd28a7b4edcdcdf5e60c", "source_status": "CURRENT", "source_structure_hash": "sha256:08c5bc50afc280e10362f1e424ae795e6f7e15a17164070f85b6d4332e5ea7d3", "source_text": "<STRUCT_0001>\n<LOCKED_0001>\nLet <MATH_0001> be a locally Noetherian scheme. Let <MATH_0002> be a category\nfibred in groupoids over <MATH_0003>. We say <MATH_0004>\nsatisfies <TEXTITOPEN_0001>condition (RS)<TEXTITCLOSE_0001> if for every pushout\n<MATH_0005>\nin the category of schemes over <MATH_0006> where\n<STRUCT_0002>\n<STRUCT_0003> <MATH_0007>, <MATH_0008>, <MATH_0009>, <MATH_0010> are spectra of local Artinian rings,\n<STRUCT_0004> <MATH_0011>, <MATH_0012>, <MATH_0013>, <MATH_0014> are of finite type over <MATH_0015>, and\n<STRUCT_0005> <MATH_0016> (and hence <MATH_0017>) is a closed immersion\n<STRUCT_0006>\nthe functor of fibre categories\n<MATH_0018>\nis an equivalence of categories.\n<STRUCT_0007>", "source_text_hash": "sha256:9f00745b583c1dcf7984dcf35fa7a2c1d0eecfc997a69f1e64aca3ae4b56787b", "unit_id": "inventory:artin:07WP:definition/0001"}}}, {"context_id": "sha256:405c313d2e6e38f4ca03f5a1b1d8966fe908f4b400cce7f0039610c3ab6a51f3", "hash": "sha256:405c313d2e6e38f4ca03f5a1b1d8966fe908f4b400cce7f0039610c3ab6a51f3", "value": {"kind": "locked-English-reference", "location": {"byte_end": 180290, "byte_start": 179852, "file": "artin.tex", "fragment_hash": "sha256:59bd6bfef71a89ec6d29c90d042e480a8e6b7b05aed687edee0e1a6cb89db406", "line_end": 4624, "line_start": 4612}, "owner_tag": "0GE3", "parent_tag": "0GE1", "requested_label": "artin-lemma-canonical-extension", "requested_tag": "0GE3", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "artin", "node_kind": "lemma", "parent_tag": "0GE1", "placeholders": {"LOCKED_0001": "\\label{lemma-canonical-extension}", "M