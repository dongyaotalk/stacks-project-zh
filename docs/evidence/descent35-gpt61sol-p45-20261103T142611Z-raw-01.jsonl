{"unit_id": "tag:08WJ:prose-0002", "translation": "\n\n<STRUCT_0001>\n设<MATH_0001>为环（ring）。回忆态射（morphism）<MATH_0002>（在<MATH_0003>中）称为<TEXTITOPEN_0001>普遍（universally）单射（injective）<TEXTITCLOSE_0001>，若对所有<MATH_0004>，态射（morphism）<MATH_0005>都是单射（injective）。参见代数（Algebra）定义<REF_0001>。\n\n", "allowed_english": [], "term_occurrences": [{"source_term": "ring", "target_term": "环"}, {"source_term": "morphism", "target_term": "态射"}, {"source_term": "universally", "target_term": "普遍"}, {"source_term": "injective", "target_term": "单射"}, {"source_term": "morphism", "target_term": "态射"}, {"source_term": "injective", "target_term": "单射"}, {"source_term": "Algebra", "target_term": "代数"}], "unknown_terms": [{"source_term": "ring", "target_term": "环", "context": "模的底环，词表未批准。"}, {"source_term": "morphism", "target_term": "态射", "context": "模范畴的态射，词表未批准。"}, {"source_term": "universally", "target_term": "普遍", "context": "张量积后均保持单射，词表未批准。"}, {"source_term": "injective", "target_term": "单射", "context": "模态射的单射性，词表未批准。"}, {"source_term": "Algebra", "target_term": "代数", "context": "章节名称，词表未批准。"}], "notes": []}
{"unit_id": "tag:08WL:statement", "translation": "环映射（ring map）<MATH_0001>称为<TEXTITOPEN_0001>普遍单射（universally injective）<TEXTITCLOSE_0001>，若它作为<MATH_0002>中的态射（morphism）是普遍单射（universally injective）的。\n", "allowed_english": [], "term_occurrences": [{"source_term": "ring map", "target_term": "环映射"}, {"source_term": "universally injective", "target_term": "普遍单射"}, {"source_term": "morphism", "target_term": "态射"}, {"source_term": "universally injective", "target_term": "普遍单射"}], "unknown_terms": [{"source_term": "ring map", "target_term": "环映射", "context": "本定义中的环映射，词表未批准。"}, {"source_term": "universally injective", "target_term": "普遍单射", "context": "将环映射视为模态射时的性质，词表未批准。"}, {"source_term": "morphism", "target_term": "态射", "context": "模范畴中的态射，词表未批准。"}], "notes": []}
