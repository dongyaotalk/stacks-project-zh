    {
      "context_id": "locked-English-reference:etale-cohomology:inventory:etale-cohomology:04JR:definition/0001:etale-cohomology-definition-galois-cohomology",
      "value": {
        "kind": "locked-English-reference",
        "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14",
        "source_unit": {
          "schema_version": 1,
          "unit_id": "inventory:etale-cohomology:04JR:definition/0001",
          "parent_tag": "0A2H",
          "chapter": "etale-cohomology",
          "node_kind": "definition",
          "risk_level": "R3",
          "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14",
          "source_text": "<STRUCT_0001>\n<LOCKED_0001>\nLet <MATH_0001> be a topological group. Let <MATH_0002> be a discrete <MATH_0003>-module\nwith continuous <MATH_0004>-action. In other words, <MATH_0005> is an object\nof the category <MATH_0006> introduced in\nDefinition <REF_0001>.\n<STRUCT_0002>\n<STRUCT_0003> The right derived functors <MATH_0007> of <MATH_0008> on the\ncategory <MATH_0009> are called the\n<TEXTITOPEN_0001>continuous group cohomology groups<TEXTITCLOSE_0001> of <MATH_0010>.\n<STRUCT_0004> If <MATH_0011> is an abstract group endowed with the discrete topology\nthen the <MATH_0012> are called the <TEXTITOPEN_0002>group cohomology groups<TEXTITCLOSE_0002> of <MATH_0013>.\n<STRUCT_0005> If <MATH_0014> is a Galois group, then the groups <MATH_0015> are called\nthe <TEXTITOPEN_0003>Galois cohomology groups<TEXTITCLOSE_0003> of <MATH_0016>.\n<STRUCT_0006> If <MATH_0017> is the absolute Galois group of a field <MATH_0018>, then the groups\n<MATH_0019> are sometimes called the <TEXTITOPEN_0004>Galois cohomology groups of <MATH_0020>\nwith coefficients in <MATH_0021><TEXTITCLOSE_0004>. In this case we sometimes write\n<MATH_0022> instead of <MATH_0023>.\n<STRUCT_0007>\n<STRUCT_0008>",
          "source_status": "CURRENT",
          "placeholders": {
            "STRUCT_0001": "\\begin{definition}",
            "LOCKED_0001": "\\label{definition-galois-cohomology}",
            "MATH_0001": "$G$",
            "MATH_0002": "$M$",
            "MATH_0003": "$G$",
            "MATH_0004": "$G$",
            "MATH_0005": "$M$",
            "MATH_0006": "$\\text{Mod}_G$",
            "REF_0001": "\\ref{definition-G-module-continuous}",
            "STRUCT_0002": "\\begin{enumerate}",
            "STRUCT_0003": "\\item",
            "MATH_0007": "$H^i(G, M)$",
            "MATH_0008": "$H^0(G, M)$",
            "MATH_0009": "$\\text{Mod}_G$",
            "TEXTITOPEN_0001": "{\\it ",
            "TEXTITCLOSE_0001": "}",
            "MATH_0010": "$M$",
            "STRUCT_0004": "\\item",
            "MATH_0011": "$G$",
            "MATH_0012": "$H^i(G, M)$",
            "TEXTITOPEN_0002": "{\\it ",
            "TEXTITCLOSE_0002": "}",
            "MATH_0013": "$M$",
            "STRUCT_0005": "\\item",
            "MATH_0014": "$G$",
            "MATH_0015": "$H^i(G, M)$",
            "TEXTITOPEN_0003": "{\\it ",
            "TEXTITCLOSE_0003": "}",
            "MATH_0016": "$M$",
            "STRUCT_0006": "\\item",
            "MATH_0017": "$G$",
            "MATH_0018": "$K$",
            "MATH_0019": "$H^i(G, M)$",
            "TEXTITOPEN_0004": "{\\it ",
