{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stacks-project-zh.invalid/schema/source-container-restoration.schema.json",
  "title": "Immutable complete locked-Git source-container restoration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "restoration_id",
    "derivation_id",
    "group_id",
    "source_commit",
    "created_at",
    "origin_commit",
    "tool",
    "selector",
    "fragment",
    "location",
    "blob_oid",
    "blob_hash",
    "macro_policy_hash",
    "layout",
    "input_unit_ids",
    "output_unit_ids",
    "new_units",
    "files",
    "reason",
    "boundary_witness"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "restoration_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "derivation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "group_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "origin_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "const": "stacks-zh-source-container"
        },
        "version": {
          "const": "source-container-v1"
        }
      }
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "owner_tag",
        "owner_label",
        "parent_tag",
        "kind",
        "ordinal"
      ],
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+\\.tex$"
        },
        "owner_tag": {
          "type": "string",
          "pattern": "^[0-9A-Z]{4}$"
        },
        "parent_tag": {
          "type": "string",
          "pattern": "^[0-9A-Z]{4}$"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "ordinal": {
          "type": "integer"
        },
        "owner_label": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:+-]+$"
        }
      }
    },
    "fragment": {
      "type": "string",
      "minLength": 1
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "byte_start",
        "byte_end",
        "line_start",
        "line_end",
        "fragment_hash"
      ],
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+\\.tex$"
        },
        "byte_start": {
          "type": "integer"
        },
        "byte_end": {
          "type": "integer"
        },
        "line_start": {
          "type": "integer"
        },
        "line_end": {
          "type": "integer"
        },
        "fragment_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "blob_oid": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "blob_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "macro_policy_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "layout": {
      "enum": [
        "whole",
        "split-title"
      ]
    },
    "input_unit_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "output_unit_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "new_units": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_units",
        "input_candidates"
      ],
      "properties": {
        "input_units": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "hash"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "input_candidates": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "hash"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "boundary_witness": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "before",
        "after"
      ],
      "properties": {
        "before": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "kind",
            "owner_tag",
            "ordinal"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 1
            },
            "owner_tag": {
              "type": "string",
              "pattern": "^[0-9A-Z]{4}$"
            },
            "ordinal": {
              "type": "integer"
            }
          }
        },
        "after": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "kind",
            "owner_tag",
            "ordinal"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 1
            },
            "owner_tag": {
              "type": "string",
              "pattern": "^[0-9A-Z]{4}$"
            },
            "ordinal": {
              "type": "integer"
            }
          }
        }
      }
    }
  }
}
