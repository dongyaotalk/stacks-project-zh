F_0001": "\\cite{LM-B}", "STRUCT_0001": "\\noindent"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R1", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:af44b7feac527af6577893f200e75ed7d76c576a86a0d1159fe68b1c9641e84e", "source_text": "<STRUCT_0001>\nThis is where we define algebraic stacks and make some very elementary\nobservations. The general philosophy will be to have no separation\nconditions whatsoever and add those conditions necessary to make lemmas,\npropositions, theorems true/provable. Thus the notions discussed here\ndiffer slightly from those in other places in the literature, e.g.,\n<REF_0001>.", "source_text_hash": "sha256:bc893ec88c9b1b8653b18d5ece73e7fdbba6c19f5f259d09d4e85eca6d3279da", "unit_id": "inventory:algebraic:026L:paragraph/0001"}}}, {"context_id": "locked-English-neighbor:algebraic:inventory:algebraic:026L:section_title/0001", "hash": "sha256:b945cb941c1d9af969aee7967469132dc8809763c817dcc22c1cee20ab13e32a", "value": {"kind": "locked-English-neighbor", "location": {"byte_end": 205, "byte_start": 154, "file": "algebraic.tex", "fragment_hash": "sha256:818b11324e818fe49df54475c6acdad873cdb21ec9d6e3fdc16fee24d3904974", "line_end": 18, "line_start": 17}, "owner_tag": "026L", "parent_tag": "026L", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "algebraic", "node_kind": "section_title", "parent_tag": "026L", "placeholders": {"LOCKED_0001": "\\label{section-introduction}", "TEXTCLOSE_0001": "}", "TEXTOPEN_0001": "\\section{"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R1", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash"