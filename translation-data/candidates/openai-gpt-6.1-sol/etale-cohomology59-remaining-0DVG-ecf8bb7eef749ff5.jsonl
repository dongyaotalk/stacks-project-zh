0e9e61b37dcdf6dc8d8926ebda8baff723a23e7d709041f2411b078a96e7c", "line_end": 8855, "line_start": 8836}, "owner_tag": "04JR", "parent_tag": "0A2H", "requested_label": "etale-cohomology-definition-galois-cohomology", "requested_tag": "04JR", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "etale-cohomology", "node_kind": "definition", "parent_tag": "0A2H", "placeholders": {"LOCKED_0001": "\\label{definition-galois-cohomology}", "MATH_0001": "$G$", "MATH_0002": "$M$", "MATH_0003": "$G$", "MATH_0004": "$G$", "MATH_0005": "$M$", "MATH_0006": "$\\text{Mod}_G$", "MATH_0007": "$H^i(G, M)$", "MATH_0008": "$H^0(G, M)$", "MATH_0009": "$\\text{Mod}_G$", "MATH_0010": "$M$", "MATH_0011": "$G$", "MATH_0012": "$H^i(G, M)$", "MATH_0013": "$M$", "MATH_0014": "$G$", "MATH_0015": "$H^i(G, M)$", "MATH_0016": "$M$", "MATH_0017": "$G$", "MATH_0018": "$K$", "MATH_0019": "$H^i(G, M)$", "MATH_0020": "$K$", "MATH_0021": "$M$", "MATH_0022": "$H^i(K, M)$", "MATH_0023": "$H^i(G, M)$", "REF_0001": "\\ref{definition-G-module-continuous}", "STRUCT_0001": "\\begin{definition}", "STRUCT_0002": "\\begin{enumerate}", "STRUCT_0003": "\\item", "STRUCT_0004": "\\item", "STRUCT_0005": "\\item", "STRUCT_0006": "\\item", "STRUCT_0007": "\\end{enumerate}", "STRUCT_0008": "\\end{definition}", "TEXTITCLOSE_0001": "}", "TEXTITCLOSE_0002": "}", "TEXTITCLOSE_0003": "}", "TEXTITCLOSE_0004": "}", "TEXTITOPEN_0001": "{\\it ", "TEXTITOPEN_0002": "{\\it ", "TEXTITOPEN_0003": "{\\it ", "TEXTITOPEN_0004": "{\\it "}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:78544bec79ec2c30bf62e6cb4173c69964b2f8c763cca6bd2e228794d8336020", "source_status": "CURRENT", "source_structure_hash": "sha256:8d93fc907c0f2d1ff52d8558990b77b0f0b5518bf6118aaf5c9eee569585fcff", "source_text": "<STRUCT_0001>\n<LOCKED_0001>\nLet <MATH_0001> be a topological group. Let <MATH_0002> be a discrete <MATH_0003>-module\nwith continuous <MATH_0004>-action. In other words, <MATH_0005> is an object\nof the category <MATH_0006> introduced in\nDefinition <REF_0001>.\n<STRUCT_0002>\n<STRUCT_0003> The right derived functors <MATH_0007> of <MATH_0008> on the\ncategory <MATH_0009> are called the\n<TEXTITOPEN_0001>continuous group cohomology groups<TEXTITCLOSE_0001> of <MATH_0010>.\n<STRUCT_0004> If <MATH_0011> is an abstract group endowed with the discrete topology\nthen the <MATH_0012> are called the <TEXTITOPEN_0002>group cohomology groups<TEXTITCLOSE_0002> of <MATH_0013>.\n<STRUCT_0005> If <MATH_0014> is a Galois group, then the groups <MATH_0015> are called\nthe <TEXTITOPEN_0003>Galois cohomology groups<TEXTITCLOSE_0003> of <MATH_0016>.\n<STRUCT_0006> If <MATH_0017> is the absolute Galois group of a field <MATH_0018>, then the groups\n<MATH_0019> are sometimes called the <TEXTITOPEN_0004>Galois cohomology groups of <MATH_0020>\nwith coefficients in <MATH_0021><TEXTITCLOSE_0004>. In this case we sometimes write\n<MATH_0022> instead of <MATH_0023>.\n<STRUCT_0007>\n<STRUCT_0008>", "source_text_hash": "sha256:e2b14b4a78ae977be3d0090471881e68a322e3d870a034f65270672be09ce5b0", "unit_id": "inventory:etale-cohomology:04JR:definition/0001"}}}, {"context_id": "locked-English-reference:homology:inventory:homology:010P:section_title/0001:homology-section-cohomological-delta-functor", "hash": "sha256:018caaeb21ca34a8f1a3d445f9c5e109568b1866c93f505c567244abd9077675", "value": {"kind": "locked-English-reference", "location": {"byte_end": 86752, "byte_start": 86670, "file": "homology.tex", "fragment_hash": "sha256:32964e2308adf9696d8ad326e32a39ecf3f6350975e3012690fa7895418ef961", "line_end": 2622, "line_start": 2621}, "owner_tag": "010P", "parent_tag": "010P", "requested_label": "homology-section-cohomological-delta-functor", "requested_tag": "010P", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "homology", "node_kind": "section_title"