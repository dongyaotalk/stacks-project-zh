{"chapter": "etale-cohomology", "node_kind": "paragraph", "parent_tag": "03QQ", "placeholders": {"ACCENT_0001": "\\'e", "STRUCT_0001": "\\noindent"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R2", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:2e8412c71a7703b21971b7339c241ab69355f20e0e519b8bb9bc7ec45f62cd4e", "source_text": "\n\n<STRUCT_0001>\nAs a consequence of the discussion in the preceding sections\nwe obtain the equivalence of <ACCENT_0001>tale cohomology of the spectrum of a\nfield with Galois cohomology.\n\n", "source_text_hash": "sha256:8492307a01430e806fc5e265644ede5c1251284e08a7a4a02a28bbbc5242593e", "unit_id": "tag:03QQ:prose-0001"}
