{"chapter": "stacks-morphisms", "node_kind": "paragraph", "parent_tag": "0CIS", "placeholders": {"MATH_0001": "$f$", "MATH_0002": "$\\mathcal{X}$", "MATH_0003": "$\\mathcal{Y}$", "STRUCT_0001": "\\noindent"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R2", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:74fdd50139366343beb7a101a9ff9ed9e9f5cbe165bc82491c813718d821485d", "source_status": "CURRENT", "source_structure_hash": "sha256:c1779c3f05b78b95144bd3f4555d6ac45ffb498ebfa57fe6c6f11e8e82fd8886", "source_text": "\n\n<STRUCT_0001>\nWe will use without further mention that this agrees with the already\nexisting notion of unramified morphisms in case <MATH_0001> is representable\nby algebraic spaces or if <MATH_0002> and <MATH_0003> are\nrepresentable by algebraic spaces.\n\n", "source_text_hash": "sha256:be0a9f68a6d965e293d81d4ebb69b1a850138b9f8ab0919bc0d06b6f9857390c", "unit_id": "tag:0CIS:prose-0002"}
