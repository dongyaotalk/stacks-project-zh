{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stacks-project-zh.invalid/schema/review.schema.json",
  "title": "Stacks Project Chinese human review record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_id",
    "unit_id",
    "candidate_hash",
    "run_id",
    "source_commit",
    "review_type",
    "reviewer",
    "reviewed_at",
    "decision",
    "issues_closed",
    "resulting_translation_hash",
    "notes"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "review_id": {"type": "string", "minLength": 1},
    "unit_id": {"type": "string", "minLength": 1},
    "candidate_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "run_id": {"type": "string", "minLength": 1},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "review_type": {"enum": ["language", "mathematics"]},
    "reviewer": {"type": "string", "minLength": 1},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "decision": {"enum": ["approved", "changes_requested", "rejected"]},
    "issues_closed": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "resulting_translation_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
