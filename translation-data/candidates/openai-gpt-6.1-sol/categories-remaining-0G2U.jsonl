466f624c9b25ea28c5fa47a2d332466", "line_end": 1370, "line_start": 1341}, "owner_tag": "002H", "parent_tag": "002D", "semantic_path": "remark/0001", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "categories", "node_kind": "remark", "parent_tag": "002D", "placeholders": {"LOCKED_0001": "\\label{remark-limit-colim}", "MATH_0001": "$\\lim_i M_i$", "MATH_0002": "$\\colim_i M_i$", "MATH_0003": "$\\lim_{i\\in \\mathcal{I}} M_i$", "MATH_0004": "$\\colim_{i\\in \\mathcal{I}} M_i$", "MATH_0005": "$\\mathcal{I}$", "MATH_0006": "$M : \\mathcal{I} \\to \\mathcal{C}$", "MATH_0007": "$\\lim_i M_i$", "MATH_0008": "$$\n\\Mor_\\mathcal{C}(W, \\lim_i M_i)\n=\n\\lim_i \\Mor_\\mathcal{C}(W, M_i)\n$$", "MATH_0009": "$\\colim_i M_i$", "MATH_0010": "$$\n\\Mor_\\mathcal{C}(\\colim_i M_i, W)\n=\n\\lim_{i \\in \\mathcal{I}^{opp}} \\Mor_\\mathcal{C}(M_i, W)\n$$", "REF_0001": "\\ref{section-limit-sets}", "STRUCT_0001": "\\begin{remark}", "STRUCT_0002": "\\begin{enumerate}", "STRUCT_0003": "\\item", "STRUCT_0004": "\\item", "STRUCT_0005": "\\end{enumerate}", "STRUCT_0006": "\\end{remark}"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:cad7bcd3f1eeeceec6de639aa8b493bcecf9276eb93759758a040928b88d8129", "source_status": "CURRENT", "source_structure_hash": "sha256:c5ae8bef985e5042c6abedf470c20f2e90f0bcff5404e86c877046e335dac1c1", "source_text": "<STRUCT_0001>\n<LOCKED_0001>\nWe often write <MATH_0001>, <MATH_0002>,\n<MATH_0003>, or <MATH_0004>\ninstead of the versions indexed by <MATH_0005>.\nUsing this notation, and using the description of\nlimits and colimits of sets in Section <REF_0001>\nbelow, we can say the following.\nLet <MATH_0006> be a diagram.\n<STRUCT_0002>\n<STRUCT_0003> The object <MATH_0007> if it exists satisfies the following property\n<MATH_0008>\nwhere the limit on the right takes place in the category of sets.\n<ST