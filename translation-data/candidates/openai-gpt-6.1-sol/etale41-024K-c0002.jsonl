20261106T050007Z.json"}, "model_output": {"hash": "sha256:4f460729597251f6355217b04337ce2be840293f60f49c71b9b33e1046e2fbfc", "path": "docs/evidence/etale41-gpt61sol-catalog-unlock-p01-20261106T050007Z-raw-01.jsonl", "record_hash": "sha256:0715d32eea5bdeaa4f336cb1f4d23afa420af29d481e873a5a2e230334e80cfc"}, "neighbor_unit_ids": ["tag:024K:title"], "policy_revision": "git:036c698422f981167cef3285c881546cf40b21c3", "prior_generations": [], "prompt_version": "translator-v2", "source_adoption_id": "etale41-gpt61sol-catalog-unlock-p01-20261106T050007Z", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "style_guide_path": "config/style-guide.md", "turn_id": "01a1af34-46e2-75d0-99b9-3f8571d1c0e4", "unit_id": "tag:024K:prose-0001"}, "context_hash": "sha256:98a092292dde29fab9e336708475d4083eec3d69b0be3b35a661f194229c8a9b", "created_at": "2026-11-06T05:00:52.990600+00:00", "glossary_revision": "git:036c698422f981167cef3285c881546cf40b21c3", "harness_id": "codex", "harness_version": "0.166.0", "model_id": "gpt-6.1-sol", "model_identity_confidence": "declared", "model_lane": "openai-gpt-6.1-sol", "model_record_id": "openai:gpt-6.1-sol:declared", "model_snapshot": null, "notes": [], "prompt_version": "translator-v2", "publication_status": "CANDIDATE", "qa_status": "PASS", "reasoning_effort": "high", "run_id": "run-etale41-gpt61sol-catalog-unlock-p01-20261106T050007Z", "schema_version": 2, "source_adoption_id": "etale41-gpt61sol-catalog-unlock-p01-20261106T050007Z", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_status": "CURRENT", "source_text_hash": "sha256:00e5c82dec9e5861b5c00c71f35aefc655a49ffce1599b3f1c53c61a74bf61a3", "stage": "STRUCTURE_OK", "term_occurrences": [{"source_term": "étale", "target_term": "平展"}, {"source_term": "morphisms", "target_term": "态射"}, {"source_term": "schemes", "target_term": "概形"}, {"source_term": "Noetherian", "target_term": "诺特"}, {"source_term": "commutative algebra", "target_term": "交换代数"}, {"source_term": "étale cohomology", "target_term": "平展上同调"}, {"source_term": "étale", "target_term": "平展"}, {"source_term": "topology", "target_term": "拓扑"}, {"source_term": "schemes", "target_term": "概形"}, {"source_term": "algebraic geometry", "target_term": "代数几何"}, {"source_term": "schemes", "target_term": "概形"}, {"source_term": "commutative algebra", "target_term": "交换代数"}], "term_status": "DECISION_REQUIRED", "translation": "\n\n<STRUCT_0001>\n本章讨论平展（<ACCENT_0001>tale）态射（morphisms），这里的对象是概形（schemes）。我们在诺特（Noetherian）情形下说明其中一些较为重要的概念。我们的主要目标是为读者汇集足够的交换代数（commutative algebra）结果，使读者能够开始阅读一部关于平展上同调（<ACCENT_0002>tale cohomology）的专著。另一个目标是提供足够的证据，使读者不再把“平展（<ACCENT_0003>tale）拓扑（topology）（概形（schemes）上的）”这一说法当作一番泛泛的空谈，倘若读者果真惯于说这等亵渎之语。\n\n<STRUCT_0002><STRUCT_0003>\n关于代数几何（algebraic geometry）的标准结果，我们将引用 Stacks 项目的其他章节（关于概形（schemes）和交换代数（commutative algebra）的章节）。对本章陈述的新结果，我们将给出详细证明。\n\n\n\n\n", "translation_hash": "sha256:3001dcd351cca29619eedd25d47e8ef436a505d8446637f5ee44e92a928fff68", "unit_id": "tag:024K:prose-0001", "unknown_terms": [{"context": "暂定译名，修饰概形之间的态射及其相关拓扑。", "source_term": "étale", "target_term": "平展"}, {"context": "暂定译名，指概形之间的映射结构。", "source_term": "morphisms", "target_term": "态射"}, {"context": "暂定译名，指本章研究的代数几何对象。", "source_term": "schemes", "target_term": "概形"}, {"context": "暂定译名，标明本章举例时使用的诺特情形。", "source_term": "Noetherian", "target_term": "诺特"}, {"context": "暂定译名，指本章汇集所需结果的数学领域。", "source_term": "commutative algebra", "target_term": "交换代数"}, {"context": "暂定译名，指读者随后可学习的上同调理论。", "source_term": "étale cohomology", "target_term": "平展上同调"}, {"context": "暂定译名，指引言所述概形上的平展拓扑。", "source_term": "topology", "target_term": "拓扑"}, {"context": "暂定译名，指作为本章前置知识的数学领域。", "source_term": "algebraic geometry", "target_term": "代数几何"}]}
