ue": {"kind": "locked-English-neighbor", "location": {"byte_end": 78417, "byte_start": 78263, "file": "moduli.tex", "fragment_hash": "sha256:d3938951df9b06f5652b96366d7d10090c725b6fa7fd69614f579396253b41d1", "line_end": 2052, "line_start": 2048}, "owner_tag": "0DPX", "parent_tag": "0DPV", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "moduli", "node_kind": "lemma", "parent_tag": "0DPV", "placeholders": {"LOCKED_0001": "\\label{lemma-complexes-qs-lfp}", "MATH_0001": "$\\Complexesstack_{X/B} \\to B$", "STRUCT_0001": "\\begin{lemma}", "STRUCT_0002": "\\end{lemma}"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:def74b01da1fd9a050ccf156fdb2adddf09779a3ffe7b03959f2aeadb2eb339a", "source_status": "CURRENT", "source_structure_hash": "sha256:df7a248076f2e4877aca721538d224d6689118f4f32153e89961af8cd80e9a35", "source_text": "<STRUCT_0001>\n<LOCKED_0001>\nThe morphism <MATH_0001> is quasi-separated and\nlocally of finite presentation.\n<STRUCT_0002>", "source_text_hash": "sha256:a10bf6bb3475d590151db756d7a78ba7c6208be2fde3b6a151f82e2d959df291", "unit_id": "inventory:moduli:0DPX:lemma/0001"}}}, {"context_id": "sha256:6b56f5e659ec0e1ae6d0eac30fb13b22034ee84bb7293713ea606a8baa992c2f", "hash": "sha256:6b56f5e659ec0e1ae6d0eac30fb13b22034ee84bb7293713ea606a8baa992c2f", "value": {"kind": "locked-English-reference", "location": {"byte_end": 76703, "byte_start": 76548, "file": "moduli.tex", "fragment_hash": "sha256:7db1e0bec67c47bb63fad3380be6152b7ef539c6a75169904c443e9085b86f75", "line_end": 2008, "line_start": 2004}, "owner_tag": "0DPW", "parent_tag": "0DPV", "requested_label": "moduli-lemma-complexes-diagonal-affine-fp", "requested_tag": "0DPW", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "moduli", "node_kind": "lemma", "parent_tag": "0DPV", "placeholders": {"LOCKED_0001": "\\