{"chapter": "guide", "node_kind": "quote", "parent_tag": "04V5", "placeholders": {"CITE_0001": "\\cite{iwanari_chow}", "MATH_0001": "$\\Delta$"}, "render": {"prefix": "", "suffix": "\n\\end{quote}\n"}, "risk_level": "R2", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:1d9bc952623d4380added7dd5387b165501ea55215ef65fb31ca1f6b594ea634", "source_status": "CURRENT", "source_structure_hash": "sha256:7f8f567353e8c8d652275d307c19e6cf165c2ec4b18d02ceb63b406c2afa849d", "source_text": "Generalizes Cox's <MATH_0001>-collections and Iwanari's paper <CITE_0001> to general smooth toric DM stacks.", "source_text_hash": "sha256:0204b5cd120aa287eedb23315e29fac194db357b025bfec97b8ddf9751062efe", "unit_id": "tag:04V5:item004-quote"}
