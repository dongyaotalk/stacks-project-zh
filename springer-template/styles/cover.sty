\newcommand*\edition[1]{\def\@edition{#1}}
\newcommand*\presslogo[1]{\def\@presslogo{#1}}
\newcommand*\pressname[1]{\def\@pressname{#1}}
\newcommand*\coverfooter[1]{\def\@coverfooter{#1}}
\def\@bookseries{}
\def\@edition{}
\def\@presslogo{}
\def\@pressname{}
\def\@coverfooter{}
