{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stacks-project-zh.invalid/schema/selection.schema.json",
  "title": "Maintainer candidate selection record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "selection_id",
    "unit_id",
    "source_commit",
    "run_id",
    "translation_hash",
    "decision",
    "decided_by",
    "decided_at",
    "reason"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "selection_id": {"type": "string", "minLength": 1},
    "unit_id": {"type": "string", "minLength": 1},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "run_id": {"type": "string", "minLength": 1},
    "translation_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "decision": {"enum": ["accept-candidate", "reject-candidate", "request-changes"]},
    "decided_by": {"type": "string", "minLength": 1},
    "decided_at": {"type": "string", "format": "date-time"},
    "reason": {"type": "string", "minLength": 1},
    "review_required": {
      "type": "array",
      "items": {"enum": ["language", "mathematics"]},
      "uniqueItems": true
    },
    "supersedes_selection_id": {"type": ["string", "null"]}
  }
}
