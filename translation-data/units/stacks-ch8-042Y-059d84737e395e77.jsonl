{"chapter": "stacks", "node_kind": "lemma", "parent_tag": "042Y", "placeholders": {"MATH_0001": "$\\mathcal{C}$", "MATH_0002": "$2$", "MATH_0003": "$\\mathcal{C}$", "REF_0001": "\\ref{categories-lemma-2-product-categories-over-C}"}, "render": {"prefix": "\\begin{lemma}\n\\label{lemma-2-product-stacks-in-setoids}\n", "suffix": "\\end{lemma}"}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:a09c24ec2d25cd681716b94fac9200b9048bae113080f6001113641b30bad3cf", "source_status": "CURRENT", "source_structure_hash": "sha256:1289d097c97d577219fbf5b660703da4761e2ab0c1862f5f0476bce84da427df", "source_text": "Let <MATH_0001> be a site.\nThe <MATH_0002>-category of stacks in setoids over <MATH_0003>\nhas 2-fibre products, and they are described as in\nCategories, Lemma <REF_0001>.\n", "source_text_hash": "sha256:6c15e2d335ddc1eec12cf8c3ffcb4a780221ee2af3bf1a4bf3863eb2b0694ca5", "unit_id": "tag:0434:statement"}
