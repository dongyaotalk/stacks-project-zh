{"chapter": "morphisms", "node_kind": "lemma", "parent_tag": "01TZ", "placeholders": {}, "render": {"prefix": "\\begin{lemma}\n\\label{lemma-composition-open}\n", "suffix": "\\end{lemma}"}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:9317b7bfa8c3a78669f7a67de35bb2dfd42aed8c6650685438e863e88157c343", "source_text": "A composition of (universally) open morphisms is (universally) open.\n", "source_text_hash": "sha256:86b1cad316c6321d21e028573edd49242b86daa1535bf131f0bed275602c7764", "unit_id": "tag:02V2:statement"}
