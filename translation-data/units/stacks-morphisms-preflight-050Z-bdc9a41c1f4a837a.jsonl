{"chapter": "stacks-morphisms", "node_kind": "paragraph", "parent_tag": "050Z", "placeholders": {"REF_0001": "\\ref{stacks-properties-section-types-properties}", "STRUCT_0001": "\\noindent"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R2", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:18507843414c3546cd23f5042c5989806269c57cd46f480ddd96735b1608f9b9", "source_text": "\n\n<STRUCT_0001>\nWe have already defined locally Noetherian algebraic stacks in\nProperties of Stacks, Section <REF_0001>.\n\n", "source_text_hash": "sha256:597411f1ed93c5bd1066b273a1096ad92fd557068c0a1f157af5f3427a48c266", "unit_id": "tag:050Z:prose-0001"}
