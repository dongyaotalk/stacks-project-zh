{"chapter": "properties", "node_kind": "lemma", "parent_tag": "077K", "placeholders": {"MATH_0001": "$X$", "MATH_0002": "$\\kappa$", "MATH_0003": "$\\mathcal{F}$", "MATH_0004": "$\\kappa$"}, "render": {"prefix": "\\begin{lemma}\n\\label{lemma-colimit-kappa}\n", "suffix": "\\end{lemma}"}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:16b42095c0725dff725e228e3cdf8dee130c7f36e771cf908edcb514fb2c1039", "source_status": "CURRENT", "source_structure_hash": "sha256:e639aa22cdd6a8f13d49de09bc39c26ec877dd99b32de509f38d3344eeffc5db", "source_text": "Let <MATH_0001> be a scheme. There exists a cardinal <MATH_0002> such that\nevery quasi-coherent module <MATH_0003> is the directed colimit\nof its quasi-coherent <MATH_0004>-generated submodules.\n", "source_text_hash": "sha256:f78c56976c3bfcecddb1e1eef4afc50b63b35a3a2994c41b1f4c32ec92ccdcf5", "unit_id": "tag:077N:statement"}
