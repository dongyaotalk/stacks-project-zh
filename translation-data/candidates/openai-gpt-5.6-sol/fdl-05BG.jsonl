02>。", "translation_hash": "sha256:b524b8999528d3bcbafd4f80f4fb8dc1b22fafaeaec5a8bf006091955ba5bd64", "unit_id": "tag:05BG:p006", "unknown_terms": [{"context": "GNU FDL 定义的可修改机器可读副本。", "source_term": "Transparent", "target_term": "透明副本"}, {"context": "透明副本的基本技术条件。", "source_term": "machine-readable copy", "target_term": "机器可读副本"}, {"context": "透明格式须能提供输入的程序类别。", "source_term": "text formatters", "target_term": "文本格式化程序"}, {"context": "GNU FDL 对非透明副本的定义术语。", "source_term": "Opaque", "target_term": "非透明副本"}]}
