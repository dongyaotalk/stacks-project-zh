{"chapter": "sets", "node_kind": "paragraph", "parent_tag": "000F", "placeholders": {"MATH_0001": "$\\phi(x_1, \\ldots, x_n)$", "MATH_0002": "$\\phi$", "MATH_0003": "$x_1, \\ldots, x_n$"}, "render": {"prefix": "\\medskip\\noindent\n", "suffix": " "}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:29ee723fee7bb0296620f9a05fa8543574a5a0180ae7c495685240e61c4c4c89", "source_status": "CURRENT", "source_structure_hash": "sha256:3d50b24b215ceccef26a70e0fdafa7da1f99a423ca7050e3b1546148eb3a39c1", "source_text": "Let <MATH_0001> be a formula of set theory. Let us use the convention that this notation implies that all the free variables in <MATH_0002> occur among <MATH_0003>.", "source_text_hash": "sha256:cdbb717fd16c7a5d11c41165adeaa56bdf70ef051d15b3c7c937e190fd58e48d", "unit_id": "tag:000F:p001"}
