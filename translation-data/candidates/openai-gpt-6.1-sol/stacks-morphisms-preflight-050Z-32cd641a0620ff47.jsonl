64fca445617e", "unit_id": "tag:050Z:prose-0002"}, "context_hash": "sha256:a31fc75b15d1cd287168b2fe67ea816088926aaec3ba8567861513e0ffda6f17", "created_at": "2026-11-24T01:43:02.405451+00:00", "glossary_revision": "git:7c4e1984fe4e6b4ae37e01477744ca9f9a46294c", "harness_id": "codex", "harness_version": "0.171.0", "model_id": "gpt-6.1-sol", "model_identity_confidence": "declared", "model_lane": "openai-gpt-6.1-sol", "model_record_id": "openai:gpt-6.1-sol:declared", "model_snapshot": null, "notes": [], "prompt_version": "translator-v2", "publication_status": "CANDIDATE", "qa_status": "PASS", "reasoning_effort": "high", "run_id": "run-p0-101-stacks-morphisms-p037", "schema_version": 2, "source_adoption_id": "p0-101-stacks-morphisms-p037", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_status": "CURRENT", "source_text_hash": "sha256:991bffae7b0bae0cf40fd4c498ad509b12fab4d24ebc22414e8fc9353ae014ed", "stage": "STRUCTURE_OK", "term_occurrences": [{"source_term": "Noetherian", "target_term": "诺特"}, {"source_term": "algebraic stack", "target_term": "代数叠"}, {"source_term": "quasi-compact", "target_term": "拟紧"}, {"source_term": "locally Noetherian", "target_term": "局部诺特"}, {"source_term": "quasi-separated", "target_term": "拟分离"}, {"source_term": "structure morphism", "target_term": "结构态射"}, {"source_term": "algebraic stack", "target_term": "代数叠"}, {"source_term": "structure morphism", "target_term": "结构态射"}, {"source_term": "Noetherian", "target_term": "诺特"}, {"source_term": "locally Noetherian", "target_term": "局部诺特"}, {"source_term": "quasi-compact", "target_term": "拟紧"}, {"source_term": "algebraic stack", "target_term": "代数叠"}, {"source_term": "Noetherian", "target_term": "诺特"}, {"source_term": "algebraic stack", "target_term": "代数叠"}, {"source_term": "finite type", "target_term": "有限型"}, {"source_term": "Noetherian", "target_term": "诺特"}], "term_status": "DECISION_REQUIRED", "translation": "\n\n<STRUCT_0001>\n注意，诺特（Noetherian）代数叠（algebraic stack）<MATH_0001>不仅是拟紧（quasi-compact）且局部诺特（locally Noetherian）的，而且还是拟分离（quasi-separated）的。用第<REF_0001>节的语言来说，若用<MATH_0002>表示“绝对”结构态射（structure morphism）（即将<MATH_0003>视为<MATH_0004>上的代数叠（algebraic stack）时的结构态射（structure morphism）），则\n<MATHSEG_0001>诺特（Noetherian）<MATHSEG_0002>局部诺特（locally Noetherian）且<MATHSEG_0003>拟紧（quasi-compact）<MATHSEG_0004>\n这在后文将意味着，一个代数叠（algebraic stack）在一个诺特（Noetherian）代数叠（algebraic stack）上为有限型（finite type）时，并不自动是诺特（Noetherian）的。\n\n", "translation_hash": "sha256:bf21523c8625f7db2814e01a7c5cf5e5386fdbcdd0d948e989a15914659e05e0", "unit_id": "tag:050Z:prose-0002", "unknown_terms": [{"context": "用于代数叠的诺特性质；所提供词表无已批准词条。", "source_term": "Noetherian", "target_term": "诺特"}, {"context": "本段讨论的几何对象；所提供词表无已批准词条。", "source_term": "algebraic stack", "target_term": "代数叠"}, {"context": "描述代数叠及态射的拟紧性质；所提供词表无已批准词条。", "source_term": "quasi-compact", "target_term": "拟紧"}, {"context": "描述代数叠及态射的局部诺特性质；所提供词表无已批准词条。", "source_term": "locally Noetherian", "target_term": "局部诺特"}, {"context": "诺特代数叠还须满足的分离性质；所提供词表无已批准词条。", "source_term": "quasi-separated", "target_term": "拟分离"}, {"context": "指代数叠的绝对结构态射；所提供词表无已批准词条。", "source_term": "structure morphism", "target_term": "结构态射"}, {"context": "描述一个代数叠在另一个代数叠上的有限型性质；所提供词表无已批准词条。", "source_term": "finite type", "target_term": "有限型"}]}
