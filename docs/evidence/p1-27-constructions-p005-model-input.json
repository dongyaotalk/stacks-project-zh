      "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14",
      "source_math_hash": "sha256:381487eb89dbdd17077e5a807e07f5373b1f80c252c334ceb248c05893ba07d7",
      "source_status": "CURRENT",
      "source_structure_hash": "sha256:0b3daef532cfe83ce86bd74b9fe6ce1d4cdbf2994625bb5e19538c29c057117a",
      "source_text": "\n\n<STRUCT_0001>\nIn algebraic geometry cones correspond to graded algebras. By our conventions\na graded ring or algebra <MATH_0001> comes with a grading\n<MATH_0002> by the nonnegative integers, see\nAlgebra, Section <REF_0001>.\n\n",
      "source_text_hash": "sha256:2cc49544f2e85f3767cff7c6d827d63cff977ba19bd30c4d3b217906fa484aed",
      "unit_id": "tag:062P:prose-0001"
