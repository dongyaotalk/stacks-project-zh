b2807b14", "source_status": "CURRENT", "source_text_hash": "sha256:9e28e5d74bc9701eab966f0e21649a00b4c663c3ec689fcfe8971f6fbdc2863f", "stage": "STRUCTURE_OK", "term_occurrences": [{"source_term": "graded ring", "target_term": "分次环"}, {"source_term": "structure sheaf", "target_term": "结构层"}, {"source_term": "of the homogeneous spectrum", "target_term": "齐次谱"}, {"source_term": "sheaf of rings", "target_term": "环层"}, {"source_term": "standard opens", "target_term": "标准开集"}, {"source_term": "basis", "target_term": "基"}, {"source_term": "locally ringed space", "target_term": "局部环化空间"}, {"source_term": "homogeneous spectrum", "target_term": "齐次谱"}, {"source_term": "sheaf", "target_term": "层"}, {"source_term": "modules", "target_term": "模"}, {"source_term": "extending", "target_term": "延拓"}, {"source_term": "opens", "target_term": "开集"}, {"source_term": "sheaf", "target_term": "层"}, {"source_term": "modules", "target_term": "模"}, {"source_term": "associated to", "target_term": "相伴"}, {"source_term": "sheaf", "target_term": "层"}], "term_status": "DECISION_REQUIRED", "translation": "设<MATH_0001>为分次环（graded ring）。\n<STRUCT_0001>\n<STRUCT_0002> <TEXTITOPEN_0001>结构层（structure sheaf）<MATH_0002>（所在的齐次谱（of the homogeneous spectrum）取自<MATH_0003>）<TEXTITCLOSE_0001>是唯一的环层（sheaf of rings）<MATH_0004>，它在标准开集（standard opens）所成的基（basis）上与<MATH_0005>一致。\n<STRUCT_0003> 局部环化空间（locally ringed space）<MATH_0006>称为<TEXTITOPEN_0002>齐次谱（homogeneous spectrum）<TEXTITCLOSE_0002>（取自<MATH_0007>），记为<MATH_0008>。\n<STRUCT_0004> 层（sheaf）（由<MATH_0009>-模（modules）构成）将<MATH_0010>延拓（extending）到<MATH_0011>的所有开集（opens）上，称为层（sheaf）（由<MATH_0012>-模（modules）构成，与<MATH_0013>相伴（associated to））。这个层（sheaf）也记为<MATH_0014>。\n<STRUCT_0005>\n", "translation_hash": "sha256:d752c65df42b6ef477823e2a1fb0eccadeb536452a227feb600c7bc0f63271e8", "unit_id": "tag:01M6:statement", "unknown_terms": [{"context": "定义齐次谱所用的环。", "source_term": "graded ring", "target_term": "分次环"}, {"context": "在齐次谱上由基上的环层确定的结构层。", "source_term": "structure sheaf", "target_term": "结构层"}, {"context": "说明结构层所在的谱，所属关系由句法表达。", "source_term": "of the homogeneous spectrum", "target_term": "齐次谱"}, {"context": "满足所述一致性条件的唯一环层。", "source_term": "sheaf of rings", "target_term": "环层"}, {"context": "构成检验一致性的基的开集。", "source_term": "standard opens", "target_term": "标准开集"}, {"context": "由标准开集构成的拓扑基。", "source_term": "basis", "target_term": "基"}, {"context": "此处定义为齐次谱的空间及其结构层。", "source_term": "locally ringed space", "target_term": "局部环化空间"}, {"context": "给定分次环所对应的空间。", "source_term": "homogeneous spectrum", "target_term": "齐次谱"}, {"context": "延拓给定对象的模层。", "source_term": "sheaf", "target_term": "层"}, {"context": "延拓所得层的取值类型。", "source_term": "modules", "target_term": "模"}, {"context": "将基上给定的对象延拓至全部开集。", "source_term": "extending", "target_term": "延拓"}, {"context": "模层延拓后所定义的全部开集。", "source_term": "opens", "target_term": "开集"}, {"context": "给出与指定对象相伴的层这一名称。", "source_term": "sheaf", "target_term": "层"}, {"context": "相伴层的取值类型。", "source_term": "modules", "target_term": "模"}, {"context": "所得模层与给定对象之间的关系。", "source_term": "associated to", "target_term": "相伴"}, {"context": "获得所给记号的模层。", "source_term": "sheaf", "target_term": "层"}]}
