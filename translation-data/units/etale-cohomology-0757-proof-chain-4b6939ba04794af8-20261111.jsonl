{"chapter": "etale-cohomology", "node_kind": "proof", "parent_tag": "0757", "placeholders": {"MATH_0001": "$\\mathcal{F}$", "MATH_0002": "$T_\\etale$", "MATH_0003": "$g : S' \\to S$", "MATH_0004": "$(\\Sch/S)_\\etale$", "MATH_0005": "$$\n\\xymatrix{\nT' \\ar[r]_{f'} \\ar[d]_{g'} & S' \\ar[d]^g \\\\\nT \\ar[r]^f & S\n}\n$$", "MATH_0006": "$$\n(f_{big, *}\\pi_T^{-1}\\mathcal{F})(S') =\n(\\pi_T^{-1}\\mathcal{F})(T') =\n((g'_{small})^{-1}\\mathcal{F})(T')  =\n(f'_{small, *}(g'_{small})^{-1}\\mathcal{F})(S')\n$$", "MATH_0007": "$$\n(\\pi_S^{-1}f_{small, *}\\mathcal{F})(S') =\n(g_{small}^{-1}f_{small, *}\\mathcal{F})(S')\n$$", "MATH_0008": "$\\pi_S^{-1}f_{small, *}\\mathcal{F} = f_{big, *}\\pi_T^{-1}\\mathcal{F}$", "MATH_0009": "$\\pi_S^{-1} \\circ f_{small, *} = f_{big, *} \\circ \\pi_T^{-1}$", "MATH_0010": "$\\pi_S^{-1}Rf_{small, *}K \\to Rf_{big, *}\\pi_T^{-1}K$", "MATH_0011": "$K$", "MATH_0012": "$D(T_\\etale)$", "MATH_0013": "$i_g : \\Sh(S'_\\etale) \\to \\Sh((\\Sch/S)_\\etale)$", "MATH_0014": "$g : S' \\to S$", "MATH_0015": "$(\\Sch/S)_\\etale$", "MATH_0016": "$T', g', f'$", "MATH_0017": "\\begin{align*}\ng_{small}^{-1}Rf_{small, *}K\n& =\ni_g^{-1}\\pi_S^{-1}Rf_{small, *}K \\\\\n& \\to\ni_g^{-1}Rf_{big, *}\\pi_T^{-1}K \\\\\n& =\nRf'_{small, *}(i_{g'}^{-1}\\pi_T^{-1}K) \\\\\n& =\nRf'_{small, *}((g'_{small})^{-1}K)\n\\end{align*}", "MATH_0018": "$\\pi_S \\circ i_g = g_{small}$", "MATH_0019": "$\\pi_T \\circ i_{g'} = g'_{small}$", "MATH_0020": "$K$", "MATH_0021": "$K$", "MATH_0022": "$f$", "MATH_0023": "$f_{small, *}$", "MATH_0024": "$f_{big, *}$", "MATH_0025": "$f_{small}$", "MATH_0026": "$f'$", "MATH_0027": "$f$", "MATH_0028": "$f_{big, *}$", "REF_0001": "\\ref{lemma-describe-pullback}", "REF_0002": "\\ref{lemma-describe-pullback}", "REF_0003": "\\ref{lemma-proper-base-change-f-star}", "REF_0004": "\\ref{sites-cohomology-remark-base-change}", "REF_0005": "\\ref{lemma-compare-higher-direct-image}", "REF_0006": "\\ref{lemma-proper-base-change}", "REF_0007": "\\ref{lemm