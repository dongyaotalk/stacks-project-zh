bra）引理<REF_0008>。\n", "allowed_english": ["a", "b", "c", "d", "e"], "term_occurrences": [{"source_term": "finite set", "target_term": "有限集"}, {"source_term": "generators", "target_term": "生成元"}, {"source_term": "finite free", "target_term": "有限自由"}, {"source_term": "module", "target_term": "模"}, {"source_term": "basis", "target_term": "基"}, {"source_term": "module map", "target_term": "模映射"}, {"source_term": "surjective", "target_term": "满射"}, {"source_term": "finitely presented", "target_term": "有限表现"}, {"source_term": "finitely generated", "target_term": "有限生成"}, {"source_term": "surjection", "target_term": "满射"}, {"source_term": "kernel", "target_term": "核"}, {"source_term": "exact", "target_term": "正合"}, {"source_term": "Algebra", "target_term": "代数"}, {"source_term": "kernel", "target_term": "核"}, {"source_term": "finite", "target_term": "有限"}, {"source_term": "module", "target_term": "模"}, {"source_term": "elements", "target_term": "元素"}, {"source_term": "images", "target_term": "像"}, {"source_term": "generate", "target_term": "生成"}, {"source_term": "kernel", "target_term": "核"}, {"source_term": "generated", "target_term": "生成"}, {"source_term": "submodule", "target_term": "子模"}, {"source_term": "finitely presented", "target_term": "有限表现"}, {"source_term": "module", "target_term": "模"}, {"source_term": "morphism", "target_term": "态射"}, {"source_term": "isomorphism", "target_term": "同构"}, {"source_term": "short exact sequence", "target_term": "短正合列"}, {"source_term": "right exact", "target_term": "右正合"}, {"source_term": "functor", "target_term": "函子"}, {"source_term": "surjective", "target_term": "满射"}, {"source_term": "map", "target_term": "映射"}, {"source_term": "injective", "target_term": "单射"}, {"source_term": "flat", "target_term": "平坦"}, {"source_term": "injective object", "target_term": "内射对象"}, {"source_term": "injection", "target_term": "单射"}, {"source_term": "split", "target_term": "分裂"}, {"source_term": "split", "target_term": "分裂"}, {"source_term": "