{"chapter": "stacks-morphisms", "node_kind": "lemma", "parent_tag": "06FR", "placeholders": {}, "render": {"prefix": "\\begin{lemma}\n\\label{lemma-base-change-finite-type}\n", "suffix": "\\end{lemma}"}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:7f1ca675e405f43ff06b7b8135c8d62bffdb831badf4756835e355a85f5ab92c", "source_text": "A base change of a finite type morphism is finite type.\nThe same holds for locally of finite type.\n", "source_text_hash": "sha256:d2cce72dc29f174023a6766bc2b0fb301a292ad246c29acd7a1c207369745713", "unit_id": "tag:06FU:statement"}
