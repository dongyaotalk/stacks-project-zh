{"chapter": "formal-defos", "node_kind": "proof", "parent_tag": "06JN", "placeholders": {"REF_0001": "\\ref{remark-infaut-lifting-equalities}", "REF_0002": "\\ref{lemma-Aut-functor-tangent-space}"}, "render": {"prefix": "\\begin{proof}\n", "suffix": "\\end{proof}"}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:dcd8e92dcea944fbc7212d2781b36df6c06de7ddbf05a4be7607ec0e0ceeb95e", "source_text": "The equality of sets is as in the end of\nRemark <REF_0001>\nand the statement about the vector space structure follows from\nLemma <REF_0002>.\n", "source_text_hash": "sha256:745edb0886ba4a8d775b8c1537ddb675c7e94afd3c6b6f24d78f30e93f2f2e30", "unit_id": "tag:06JX:proof"}
