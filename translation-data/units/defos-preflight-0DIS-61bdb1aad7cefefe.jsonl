{"chapter": "defos", "node_kind": "paragraph", "parent_tag": "0DIS", "placeholders": {"MATH_0001": "$\\mathcal{C}$", "MATH_0002": "$\\mathcal{D}$", "MATH_0003": "$\\mathcal{O}' \\to \\mathcal{O}$", "MATH_0004": "$\\mathcal{O} \\to \\mathcal{O}_0$", "REF_0001": "\\cite{lieblich-complexes}", "REF_0002": "\\ref{section-thickenings-ringed-topoi}", "STRUCT_0001": "\\noindent", "STRUCT_0002": "\\medskip", "STRUCT_0003": "\\noindent"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R2", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:f081ee17a1afb43b8340ea3c27aa45f4b899a061f1ed248be160d70d9a082724", "source_status": "CURRENT", "source_structure_hash": "sha256:f9edef6edd09c62f219bfa934eae97e6b48d6d08a0d7c7cc553bd465309e5cb4", "source_text": "\n\n<STRUCT_0001>\nThis material is taken from <REF_0001>.\n\n<STRUCT_0002><STRUCT_0003>\nThe material in this section works in the setting of a first order thickening\nof ringed topoi as defined in Section <REF_0002>.\nHowever, in order to simplify the notation we will assume the underlying\nsites <MATH_0001> and <MATH_0002> are the same.\nMoreover, the surjective homomorphism <MATH_0003>\nof sheaves of rings will be denoted <MATH_0004>\nas is perhaps more customary in the literature.\n\n", "source_text_hash": "sha256:362d40d8235551652de063f0d0fce1ca54894c15a5404f47642786219ef9b26f", "unit_id": "tag:0DIS:prose-0001"}
