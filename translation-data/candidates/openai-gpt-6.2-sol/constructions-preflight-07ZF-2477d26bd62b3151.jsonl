 analogue of Section <REF_0001>\nfor the relative Proj. Let <MATH_0001> be a scheme. A graded <MATH_0002>-algebra\nmap <MATH_0003> does not always give rise to a\nmorphism of associated relative Proj. The correct result is stated as follows.", "source_text_hash": "sha256:c69d0b7c3872478b06e1231b027a3b1becc987cf7ba8c0aab6d7aa6275728309", "unit_id": "inventory:constructions:07ZF:paragraph/0001"}}}, {"context_id": "sha256:a89a9e44227470ff5d0d83854ec782974e2f4d9f83e71daf4e5eb6eb12115c1f", "hash": "sha256:a89a9e44227470ff5d0d83854ec782974e2f4d9f83e71daf4e5eb6eb12115c1f", "value": {"kind": "locked-English-neighbor", "location": {"byte_end": 158195, "byte_start": 156890, "file": "constructions.tex", "fragment_hash": "sha256:fe7467f0909039023b9be4e4eb0291b8cb6e5708f4c777aa94859ccbd667e32a", "line_end": 4355, "line_start": 4318}, "owner_tag": "07ZG", "parent_tag": "07ZF", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "constructions", "node_kind": "lemma", "parent_tag": "07ZF", "placeholders": {"LOCKED_0001": "\\label{lemma-morphism-relative-proj}", "MATH_0001": "$S$", "MATH_0002": "$\\mathcal{A}$", "MATH_0003": "$\\mathcal{B}$", "MATH_0004": "$\\mathcal{O}_S$", "MATH_0005": "$p : X = \\underline{\\text{Proj}}_S(\\mathcal{A}) \\to S$", "MATH_0006": "$q : Y = \\underline{\\text{Proj}}_S(\\mathcal{B}) \\to S$", "MATH_0007": "$\\psi : \\mathcal{A} \\to \\mathcal{B}$", "MATH_0008": "$\\mathcal{O}_S$", "MATH_0009": "$U(\\psi) \\subset Y$", "MATH_0010": "$$\nr_\\psi :\nU(\\psi)\n\\longrightarrow\nX\n$$", "MATH_0011": "$S$", "MATH_0012": "$\\mathbf{Z}$", "MATH_0013": "$\\mathcal{O}_{U(\\psi)}$", "MATH_0014": "$$\n\\theta = \\theta_\\psi :\nr_\\psi^*\\left(\n\\bigoplus\\nolimits_{d \\in \\mathbf{Z}} \\mathcal{O}_X(d)\n\\right)\n\\longrightarrow\n\\bigoplus\\nolimits_{d \\in \\mathbf{Z}} \\mathcal{O}_{U(\\psi)}(d).\n$$", "MATH_0015": "$(U(\\psi), r_\\psi, \\theta)$", "MATH_0016": "$W \\subset S$", "MATH_0017": "$$\n(U(\\psi) \\cap p^{-1}W,\\qu