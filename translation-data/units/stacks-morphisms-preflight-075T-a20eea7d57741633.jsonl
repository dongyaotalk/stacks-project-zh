{"chapter": "stacks-morphisms", "node_kind": "lemma", "parent_tag": "075T", "placeholders": {}, "render": {"prefix": "\\begin{lemma}\n\\label{lemma-base-change-smooth}\n", "suffix": "\\end{lemma}"}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:e444573022288871c96ae7989d9f3618d495ab3d17ec4b6c68483dc858165727", "source_text": "A base change of a smooth morphism is smooth.\n", "source_text_hash": "sha256:86373d7914e682d43d67f43c5091147bb0d53d4dc70448c29da8a58bc0a060ba", "unit_id": "tag:075W:statement"}
