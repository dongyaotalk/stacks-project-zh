{"allowed_english": ["Constructions"], "context": {"approved_glossary_entries": [], "generation_contexts": [{"context_id": "sha256:5f41c2278f01c201d50bdd29b408dfff92e0efba123dfe96268147c66d8f9350", "hash": "sha256:5f41c2278f01c201d50bdd29b408dfff92e0efba123dfe96268147c66d8f9350", "value": {"kind": "locked-English-neighbor", "location": {"byte_end": 383831, "byte_start": 383396, "file": "morphisms.tex", "fragment_hash": "sha256:5cc79bd97896750a2067c8f94f0c080e73c979b88dd32b48d0a827f3095335db", "line_end": 10511, "line_start": 10503}, "owner_tag": "01W7", "parent_tag": "01W7", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "morphisms", "node_kind": "paragraph", "parent_tag": "01W7", "placeholders": {"REF_0001": "\\ref{lemma-projective-quasi-projective}", "REF_0002": "\\ref{lemma-quasi-projective-open-projective}", "REF_0003": "\\ref{more-morphisms-section-projective}", "STRUCT_0001": "\\noindent"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R1", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:89c7b0c123faa6821acd52e127d9b087b12ad0577647e47cdcd7d3afb809f7fc", "source_text": "<STRUCT_0001>\nAs expected, a projective morphism is quasi-projective, see\nLemma <REF_0001>.\nConversely, quasi-projective morphisms are often compositions\nof open immersions and projective morphisms, see\nLemma <REF_0002>.\nFor an overview of properties of projective morphisms over\na quasi-projective base, see\nMore on Morphisms, Section <REF_0003>.", "source_text_hash": "sha256:114daa117fed97e7018f663569aefbab10650b865b69d5467e8f5e30e6a50abb", "unit_id": "inventory:morphisms:01W7:paragraph/0002"}}}, {"context_id": "sha256:e76bf6aa51032f91a16753a248d9fbeb1e19f4d74fa7edcbc95daad266d57f1f", "hash": "sha256:e76bf6aa51032f91a16753a248d9fbeb1e19f4d74fa7edcbc95d