{"chapter": "etale-cohomology", "node_kind": "paragraph", "parent_tag": "06VW", "placeholders": {"ACCENT_0001": "\\'e", "REF_0001": "\\ref{sites-section-sites-enough-points}", "REF_0002": "\\ref{topologies-section-procedure}", "STRUCT_0001": "\\noindent"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R2", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:53dcd500d0b49943d7b419b077d40d12a340fcbb4e00217aac2c835ec508151b", "source_text": "\n\n<STRUCT_0001>\nIn this section we briefly discuss the existence of points for some\nsites other than the <ACCENT_0001>tale site of a scheme. We refer to\nSites, Section <REF_0001>\nand\nTopologies, Section <REF_0002> ff\nfor the terminology used in this section.\nAll of the geometric sites have enough points.\n\n", "source_text_hash": "sha256:c574ffce328c188d242dbd5d8525db8e5a83232e36211b1e74a7fae307947105", "unit_id": "tag:06VW:prose-0001"}
