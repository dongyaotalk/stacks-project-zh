{"schema_version": 1, "unit_id": "tag:02GH:prose-0004", "parent_tag": "02GH", "chapter": "morphisms", "node_kind": "paragraph", "risk_level": "R2", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_text": "\n\n<STRUCT_0001>\nThe following lemma says locally any <ACCENT_0001>tale morphism is standard <ACCENT_0002>tale.\nThis is actually kind of a tricky result to prove in complete generality.\nThe tricky parts are hidden in the chapter on commutative algebra.\nHence a standard <ACCENT_0003>tale morphism is a <TEXTITOPEN_0001>local model<TEXTITCLOSE_0001> for a general\n<ACCENT_0004>tale morphism.\n\n", "source_status": "CURRENT", "placeholders": {"STRUCT_0001": "\\noindent", "ACCENT_0001": "\\'e", "ACCENT_0002": "\\'e", "ACCENT_0003": "\\'e", "TEXTITOPEN_0001": "{\\it ", "TEXTITCLOSE_0001": "}", "ACCENT_0004": "\\'e"}, "render": {"prefix": "", "suffix": ""}, "source_text_hash": "sha256:2ba2d7705c1316300be5f68f2a55b39018cd70bebd3b109b2643ec7c16ddeb23", "source_structure_hash": "sha256:7c34ab9eef92db3c93b0dd36bd39d2ae3bf1759b044ccf92c118e78e45bf4f63", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a"}
