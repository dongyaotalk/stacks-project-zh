    {
      "context_id": "locked-English-reference:spaces-more-morphisms:inventory:spaces-more-morphisms:0D0Y:lemma/0001:spaces-more-morphisms-lemma-netherlander-quasi-coherent",
      "value": {
        "kind": "locked-English-reference",
        "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14",
        "source_unit": {
          "schema_version": 1,
          "unit_id": "inventory:spaces-more-morphisms:0D0Y:lemma/0001",
          "parent_tag": "0D0U",
          "chapter": "spaces-more-morphisms",
          "node_kind": "lemma",
          "risk_level": "R3",
          "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14",
          "source_text": "<STRUCT_0001>\n<LOCKED_0001>\nLet <MATH_0001> be a scheme. Let <MATH_0002> be a morphism of\nalgebraic spaces over <MATH_0003>. The cohomology sheaves\nof the complex <MATH_0004> are quasi-coherent, zero outside\ndegrees <MATH_0005>, <MATH_0006> and equal to <MATH_0007> in degree <MATH_0008>.\n<STRUCT_0002>",
          "source_status": "CURRENT",
          "placeholders": {
            "STRUCT_0001": "\\begin{lemma}",
            "LOCKED_0001": "\\label{lemma-netherlander-quasi-coherent}",
            "MATH_0001": "$S$",
            "MATH_0002": "$f : X \\to Y$",
            "MATH_0003": "$S$",
            "MATH_0004": "$\\NL_{X/Y}$",
            "MATH_0005": "$-1$",
            "MATH_0006": "$0$",
            "MATH_0007": "$\\Omega_{X/Y}$",
            "MATH_0008": "$0$",
            "STRUCT_0002": "\\end{lemma}"
          },
          "render": {
            "prefix": "",
            "suffix": ""
          },
