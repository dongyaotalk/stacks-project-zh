{"chapter": "stacks-morphisms", "node_kind": "lemma", "parent_tag": "06PV", "placeholders": {}, "render": {"prefix": "\\begin{lemma}\n\\label{lemma-base-change-flat}\n", "suffix": "\\end{lemma}"}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:39e8d0c26d87205728cab1fabbf8ccc846df1c9620bd52f016c219aa12353b92", "source_text": "A base change of a flat morphism is flat.\n", "source_text_hash": "sha256:7bacb2984b5c2494eadec6a87d71bf6de5b19afe4dd875a1160c0aebe20339af", "unit_id": "tag:06PY:statement"}
