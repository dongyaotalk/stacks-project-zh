{"allowed_english": ["J-2", "J-"], "context": {"approved_glossary_entries": [], "generation_contexts": [{"context_id": "sha256:6ff81d50078f9355e654304a3d287fea6779e1075ef442b23039232a20307b17", "hash": "sha256:6ff81d50078f9355e654304a3d287fea6779e1075ef442b23039232a20307b17", "value": {"kind": "locked-English-neighbor", "location": {"byte_end": 120846, "byte_start": 120328, "file": "morphisms.tex", "fragment_hash": "sha256:dd3d37211f383c4cbbb835ffe6fb6232306b2414798249e3a8421d1a7f12a718", "line_end": 3323, "line_start": 3309}, "owner_tag": "07R4", "parent_tag": "07R2", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "morphisms", "node_kind": "lemma", "parent_tag": "07R2", "placeholders": {"LOCKED_0001": "\\label{lemma-J}", "MATH_0001": "$X$", "MATH_0002": "$X$", "MATH_0003": "$X$", "MATH_0004": "$\\Spec(R) = U \\subset X$", "MATH_0005": "$R$", "MATH_0006": "$S = \\bigcup U_i$", "MATH_0007": "$\\mathcal{O}(U_i)$", "MATH_0008": "$i$", "MATH_0009": "$X$", "STRUCT_0001": "\\begin{lemma}", "STRUCT_0002": "\\begin{enumerate}", "STRUCT_0003": "\\item", "STRUCT_0004": "\\item", "STRUCT_0005": "\\item", "STRUCT_0006": "\\item", "STRUCT_0007": "\\end{enumerate}", "STRUCT_0008": "\\end{lemma}"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:df77cb9d5cb0828d2d45e95c71d55c9a0d0c58434f2d04b23b1030c38e4ccec3", "source_status": "CURRENT", "source_structure_hash": "sha256:5b616f7723a19196a61843e35d9abe47afcd4eae2dd4c5f30537c343e66e5bbb", "source_text": "<STRUCT_0001>\n<LOCKED_0001>\nLet <MATH_0001> be a locally Noetherian scheme. The following are equivalent\n<STRUCT_0002>\n<STRUCT_0003> <MATH_0002> is J-2,\n<STRUCT_0004> there exists an open covering of <MATH_0003> all of whose members are\nJ-2 schemes,\n<STRUCT_0005> for every affine open <MATH_0004> the ring\n<MATH_0005> is J-2, and\n<STRUCT_0006> there exists an affine open covering <MATH_0006> such\nthat each <MATH_0007> is J-2 for all <MATH_0008>.\n<STRUCT_0007>\nMoreover, in this case any scheme locally of finite type over <MATH_0009>\nis J-2 as well.\n<STRUCT_0008>", "source_text_hash": "sha256:1b717a41395debac1e5a15e5d0cac4b1cbf87198e450c59c6084403bfe881369", "unit_id": "inventory:morphisms:07R4:lemma/0001"}}}, {"context_id": "sha256:08728b1ae1eebb1ebaf40059a6282a926c3826dd6a9aec73394342eb6b6f5180", "hash": "sha256:08728b1ae1eebb1ebaf40059a6282a926c3826dd6a9aec73394342eb6b6f5180", "value": {"kind": "locked-English-neighbor", "location": {"byte_end": 122775, "byte_start": 122191, "file": "morphisms.tex", "fragment_hash": "sha256:74327ecab9ae5cd77dddc32393d57da3655934999536ba7fcbb01d6aa09642d5", "line_end": 3370, "line_start": 3356}, "owner_tag": "07R5", "parent_tag": "07R2", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "morphisms", "node_kind": "lemma", "parent_tag": "07R2", "placeholders": {"LOCKED_0001": "\\label{lemma-ubiquity-J-2}", "MATH_0001": "$\\mathbf{Z}$", "MATH_0002": "$1$", "MATH_0003": "$1$", "STRUCT_0001": "\\begin{lemma}", "STRUCT_0002": "\\begin{enumerate}", "STRUCT_0003": "\\item", "STRUCT_0004": "\\item", "STRUCT_0005": "\\item", "STRUCT_0006": "\\item", "STRUCT_0007": "\\item", "STRUCT_0008": "\\item", "STRUCT_0009": "\\item", "STRUCT_0010": "\\end{enumerate}", "STRUCT_0011": "\\end{lemma}"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:f196097d9e82b23ba50b6985e5fa7878f137b1e6d673ee4c5e1d08bd4a0f8d52", "source_status": "CURRENT", "source_structure_hash": "sha256:735f3b1fc102c50b88068fcc329dec9b231be084f56873aa4883d1ed16a2596a", "source_text": "<STRUCT_0001>\n<LOCKED_0001>\nThe following types of schemes are J-2.\n<STRUCT_0002>\n<STRUCT_0003> Any scheme locally of finite type over a field.\n<STRUCT_0004> Any scheme locally of finite type over a Noetherian complete local ring.\n<STRUCT_0005> Any scheme locally of finite type over <MATH_0001>.\n<STRUCT_0006> Any scheme locally of finite type over a Noetherian local ring\nof dimension <MATH_0002>.\n<STRUCT_0007> Any scheme locally of finite type over a Nagata ring of dimension <MATH_0003>.\n<STRUCT_0008> Any scheme locally of finite type over a Dedekind ring of\ncharacteristic zero.\n<STRUCT_0009> And so on.\n<STRUCT_0010>\n<STRUCT_0011>", "source_text_hash": "sha256:6cfc3cc5c91ff59ac2f5b61b6021c545f49f343a77af15339367604062f60305", "unit_id": "inventory:morphisms:07R5:lemma/0001"}}}, {"context_id": "sha256:d4a9876bd35f0ae8a785c3cae2286a2b2f9b2b51cb98de71dfdfc5b1b9d0304b", "hash": "sha256:d4a9876bd35f0ae8a785c3cae2286a2b2f9b2b51cb98de71dfdfc5b1b9d0304b", "value": {"kind": "locked-English-reference", "location": {"byte_end": 438485, "byte_start": 438088, "file": "more-algebra.tex", "fragment_hash": "sha256:5f37d9359ef2dbc91410fdd2961399026192d13dc8b9fb8a5620e8290f7bfb92", "line_end": 11593, "line_start": 11582}, "owner_tag": "07P7", "parent_tag": "07P6", "requested_label": "more-algebra-definition-J", "requested_tag": "07P7", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "more-algebra", "node_kind": "definition", "parent_tag": "07P6", "placeholders": {"LOCKED_0001": "\\label{definition-J}", "LOCKED_0002": "\\begin{reference}\n\\cite[(32.B)]{MatCA}\n\\end{reference}", "MATH_0001": "$R$", "MATH_0002": "$X = \\Spec(R)$", "MATH_0003": "$R$", "MATH_0004": "$\\text{Reg}(X)$", "MATH_0005": "$R$", "MATH_0006": "$\\text{Reg}(X)$", "MATH_0007": "$R$", "MATH_0008": "$R$", "STRUCT_0001": "\\begin{definition}", "STRUCT_0002": "\\begin{enumerate}", "STRUCT_0003": "\\item", "STRUCT_0004": "\\item", "STRUCT_0005": "\\item", "STRUCT_0006": "\\end{enumerate}", "STRUCT_0007": "\\end{definition}", "TEXTITCLOSE_0001": "}", "TEXTITCLOSE_0002": "}", "TEXTITCLOSE_0003": "}", "TEXTITOPEN_0001": "{\\it ", "TEXTITOPEN_0002": "{\\it ", "TEXTITOPEN_0003": "{\\it "}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:83750455c458b5702bb8d3cd695020b0bfa78d4f6a92047ee9023922d885d1fc", "source_status": "CURRENT", "source_structure_hash": "sha256:ead56a82a98d967bfd1b0f71d1a8c20639c4a1e2c3c711b0d5387fe86081d429", "source_text": "<STRUCT_0001>\n<LOCKED_0001>\n<LOCKED_0002>\nLet <MATH_0001> be a Noetherian ring. Let <MATH_0002>.\n<STRUCT_0002>\n<STRUCT_0003> We say <MATH_0003> is <TEXTITOPEN_0001>J-0<TEXTITCLOSE_0001> if <MATH_0004> contains a nonempty open.\n<STRUCT_0004> We say <MATH_0005> is <TEXTITOPEN_0002>J-1<TEXTITCLOSE_0002> if <MATH_0006> is open.\n<STRUCT_0005> We say <MATH_0007> is <TEXTITOPEN_0003>J-2<TEXTITCLOSE_0003> if any finite type <MATH_0008>-algebra is J-1.\n<STRUCT_0006>\n<STRUCT_0007>", "source_text_hash": "sha256:47577544f39ebecefe0cd2d30eec44dabb3af5c1da50e4a125d909ce2c305e6a", "unit_id": "inventory:more-algebra:07P7:definition/0001"}}}, {"context_id": "sha256:a2a6b57b9bef4a0ce5098154f166b46e451d7ceb88e8f251a59b0548a6f518f8", "hash": "sha256:a2a6b57b9bef4a0ce5098154f166b46e451d7ceb88e8f251a59b0548a6f518f8", "value": {"kind": "locked-English-reference", "location": {"byte_end": 99619, "byte_start": 99416, "file": "morphisms.tex", "fragment_hash": "sha256:cbb253d00e85b3deda13e556b981ca658a7a6c3838c19fff50390cc26b8628df", "line_end": 2714, "line_start": 2710}, "owner_tag": "01T3", "parent_tag": "01T0", "requested_label": "morphisms-lemma-composition-finite-type", "requested_tag": "01T3", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "morphisms", "node_kind": "lemma", "parent_tag": "01T0", "placeholders": {"LOCKED_0001": "\\label{lemma-composition-finite-type}", "STRUCT_0001": "\\begin{lemma}", "STRUCT_0002": "\\end{lemma}"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:d1983bb2a8a9a48804a03ae02a4d8102c001d0c56138dc20b80f4fe02c630754", "source_text": "<STRUCT_0001>\n<LOCKED_0001>\nThe composition of two morphisms which are locally of finite type is\nlocally of finite type. The same is true for morphisms of finite type.\n<STRUCT_0002>", "source_text_hash": "sha256:035c600136c71ed5439a929dd3cda7ca45d1d2f75350fa3fb17b5f967f34190c", "unit_id": "inventory:morphisms:01T3:lemma/0001"}}}, {"context_id": "sha256:768724dfa22b4185af563fa2fdd6ca2fc2fe449fdca6139b1839a14484c04994", "hash": "sha256:768724dfa22b4185af563fa2fdd6ca2fc2fe449fdca6139b1839a14484c04994", "value": {"kind": "locked-English-reference", "location": {"byte_end": 101295, "byte_start": 101148, "file": "morphisms.tex", "fragment_hash": "sha256:f3cf8f8d5ba0ab04dc869d6fca130d81eabe66171c88d1d8fe1b509768c4a935", "line_end": 2757, "line_start": 2753}, "owner_tag": "01T5", "parent_tag": "01T0", "requested_label": "morphisms-lemma-immersion-locally-finite-type", "requested_tag": "01T5", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "morphisms", "node_kind": "lemma", "parent_tag": "01T0", "placeholders": {"LOCKED_0001": "\\label{lemma-immersion-locally-finite-type}", "STRUCT_0001": "\\begin{lemma}", "STRUCT_0002": "\\end{lemma}"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "source_status": "CURRENT", "source_structure_hash": "sha256:f002a9646f6b34af61222662a4b33dbc7a00fdc459e8692f46c398a7cebe5ca9", "source_text": "<STRUCT_0001>\n<LOCKED_0001>\nA closed immersion is of finite type.\nAn immersion is locally of finite type.\n<STRUCT_0002>", "source_text_hash": "sha256:ee1e0b2c2ef0532da7b64d289c37f3e5702f9b78f45fc10f6cbc9ba7c6da43f3", "unit_id": "inventory:morphisms:01T5:lemma/0001"}}}, {"context_id": "sha256:bc9b3546c04b7a642b400d052f35a74ba3b3e2a293e183e829ecf09ba6c2b0d7", "hash": "sha256:bc9b3546c04b7a642b400d052f35a74ba3b3e2a293e183e829ecf09ba6c2b0d7", "value": {"kind": "locked-English-reference", "location": {"byte_end": 98744, "byte_start": 97717, "file": "morphisms.tex", "fragment_hash": "sha256:eb16d2d68198a986c40d6483df5da147b0641e4e81c874c90730042f6b7a105c", "line_end": 2693, "line_start": 2672}, "owner_tag": "01T2", "parent_tag": "01T0", "requested_label": "morphisms-lemma-locally-finite-type-characterize", "requested_tag": "01T2", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_unit": {"chapter": "morphisms", "node_kind": "lemma", "parent_tag": "01T0", "placeholders": {"LOCKED_0001": "\\label{lemma-locally-finite-type-characterize}", "MATH_0001": "$f : X \\to S$", "MATH_0002": "$f$", "MATH_0003": "$U \\subset X$", "MATH_0004": "$V \\subset S$", "MATH_0005": "$f(U) \\subset V$", "MATH_0006": "$\\mathcal{O}_S(V) \\to \\mathcal{O}_X(U)$", "MATH_0007": "$S = \\bigcup_{j \\in J} V_j$", "MATH_0008": "$f^{-1}(V_j) = \\bigcup_{i \\in I_j} U_i$", "MATH_0009": "$U_i \\to V_j$", "MATH_0010": "$j\\in J, i\\in I_j$", "MATH_0011": "$S = \\bigcup_{j \\in J} V_j$", "MATH_0012": "$f^{-1}(V_j) = \\bigcup_{i \\in I_j} U_i$", "MATH_0013": "$\\mathcal{O}_S(V_j) \\to \\mathcal{O}_X(U_i)$", "MATH_0014": "$j\\in J, i\\in I_j$", "MATH_0015": "$f$", "MATH_0016": "$U \\subset X$", "MATH_0017": "$V \\subset S$", "MATH_0018": "$f(U) \\subset V$", "MATH_0019": "$f|_U : U \\to V$", "STRUCT_0001": "\\begin{lemma}", "STRUCT_0002": "\\begin{enumerate}", "STRUCT_0003": "\\item", "STRUCT_0004": "\\item", "STRUCT_0005": "\\item", "STRUCT_0006": "\\item", "STRUCT_0007": "\\end{enumerate}", "STRUCT_0008": "\\end{lemma}"}, "render": {"prefix": "", "suffix": ""}, "risk_level": "R3", "schema_version": 1, "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_math_hash": "sha256:831157cffc4f322e7a359b1d2895997bfe94b41d1a431cf27d30599a8144b2c2", "source_status": "CURRENT", "source_structure_hash": "sha256:0218123e057093a78a07e68084062333b2df0bf56a0c2ed4bf1542917a07607b", "source_text": "<STRUCT_0001>\n<LOCKED_0001>\nLet <MATH_0001> be a morphism of schemes.\nThe following are equivalent\n<STRUCT_0002>\n<STRUCT_0003> The morphism <MATH_0002> is locally of finite type.\n<STRUCT_0004> For all affine opens <MATH_0003>, <MATH_0004>\nwith <MATH_0005> the ring map\n<MATH_0006> is of finite type.\n<STRUCT_0005> There exist an open covering <MATH_0007>\nand open coverings <MATH_0008> such\nthat each of the morphisms <MATH_0009>, <MATH_0010>\nis locally of finite type.\n<STRUCT_0006> There exist an affine open covering <MATH_0011>\nand affine open coverings <MATH_0012> such\nthat the ring map <MATH_0013> is\nof finite type, for all <MATH_0014>.\n<STRUCT_0007>\nMoreover, if <MATH_0015> is locally of finite type then for\nany open subschemes <MATH_0016>, <MATH_0017> with <MATH_0018>\nthe restriction <MATH_0019> is locally of finite type.\n<STRUCT_0008>", "source_text_hash": "sha256:55c242e73d7a650acaf990e82351ca7bdd16df05861339677d22048fdeee409f", "unit_id": "inventory:morphisms:01T2:lemma/0001"}}}], "input_freeze": {"hash": "sha256:947ef7c6bf86aff6d3204275a507e2241d2ffdb8e5bf191e18b2cf24c4ed0218", "path": "translation-data/source-adoption-inputs/p1-29-morphisms-d009.json"}, "model_output": {"hash": "sha256:649c65a714de7d5e8d9ebb206908fb366cf5a67aeaa2219f723d2ac7ac7a14d8", "path": "docs/evidence/p1-29-morphisms-d009-raw-01.jsonl", "record_hash": "sha256:abd0abc43775b1da1510c9a0ec8d632a08b4a8c51e9d91b8af367c8d96627f05"}, "neighbor_unit_ids": [], "policy_revision": "git:b753f6444727f8fc4aa34d05b8523e6abff18b21", "prior_generations": [], "prompt_version": "translator-v2", "source_adoption_id": "p1-29-morphisms-d009", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "style_guide_path": "config/style-guide.md", "turn_id": "01a21dd6-e974-7de1-8ef6-8eac22f99e64", "unit_id": "tag:07R4:proof"}, "context_hash": "sha256:e6c154740d5784bd38a1a71fef538d1b23635c515cc9bd291d82f595884f1530", "created_at": "2026-11-27T16:29:14.852Z", "glossary_revision": "git:b753f6444727f8fc4aa34d05b8523e6abff18b21", "harness_id": "codex", "harness_version": "0.172.0", "model_id": "gpt-6.2-sol", "model_identity_confidence": "declared", "model_lane": "openai-gpt-6.2-sol", "model_record_id": "openai:gpt-6.2-sol:declared", "model_snapshot": null, "notes": [], "prompt_version": "translator-v2", "publication_status": "CANDIDATE", "qa_status": "PASS", "reasoning_effort": "high", "run_id": "run-p1-29-morphisms-d009", "schema_version": 2, "source_adoption_id": "p1-29-morphisms-d009", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_status": "CURRENT", "source_text_hash": "sha256:0ccacc5472b421d02a334d68fd365e97fa302a8ac22a3a12ad70c153176bf6e9", "stage": "STRUCTURE_OK", "term_occurrences": [{"source_term": "open immersion", "target_term": "开浸入"}, {"source_term": "locally of finite type", "target_term": "局部有限型"}, {"source_term": "composition", "target_term": "复合"}, {"source_term": "morphisms", "target_term": "态射"}, {"source_term": "locally of finite type", "target_term": "局部有限型"}, {"source_term": "locally of finite type", "target_term": "局部有限型"}, {"source_term": "open", "target_term": "开子概形"}, {"source_term": "scheme", "target_term": "概形"}, {"source_term": "locally of finite type", "target_term": "局部有限型"}, {"source_term": "finite type", "target_term": "有限型"}, {"source_term": "algebra", "target_term": "代数"}, {"source_term": "scheme", "target_term": "概形"}, {"source_term": "regular locus", "target_term": "正则点集"}, {"source_term": "open", "target_term": "开集"}, {"source_term": "Algebra", "target_term": "代数"}, {"source_term": "morphism", "target_term": "态射"}, {"source_term": "locally of finite type", "target_term": "局部有限型"}, {"source_term": "affine open", "target_term": "仿射开"}, {"source_term": "covering", "target_term": "覆盖"}, {"source_term": "maps", "target_term": "映射"}, {"source_term": "ring map", "target_term": "环映射"}, {"source_term": "finite type", "target_term": "有限型"}, {"source_term": "regular locus", "target_term": "正则点集"}, {"source_term": "open", "target_term": "开集"}, {"source_term": "open", "target_term": "开集"}], "term_status": "DECISION_REQUIRED", "translation": "由引理<REF_0001>可知，开浸入（open immersion）是局部有限型（locally of finite type）的。若作复合（composition）的各态射（morphisms）都是局部有限型（locally of finite type）的，所得结果也是局部有限型（locally of finite type）的（引理<REF_0002>）。因此，若<MATH_0001>是 J-2，则显然<MATH_0002>的任意开子概形（open）都是 J-2，其上的任意概形（scheme）只要是局部有限型（locally of finite type）的，也都是 J-2。这就证明了该引理的最后一个陈述。\n\n<STRUCT_0001><STRUCT_0002>\n若<MATH_0003>是 J-2，则对每个有限型（finite type）<MATH_0004>-代数（algebra）<MATH_0005>，概形（scheme）<MATH_0006>的正则点集（regular locus）都是开集（open）。所以按定义，<MATH_0007>是 J-2（见《代数（Algebra）续论》的定义<REF_0003>）。结合前面的论述可知，（1）推出（3），（2）推出（4）。当然，（1）<MATH_0008>（2）和（3）<MATH_0009>（4）都是显然的。\n\n<STRUCT_0003><STRUCT_0004>\n为完成证明，我们说明（4）推出（1）。设（4）成立，并令<MATH_0010>为态射（morphism），且是局部有限型（locally of finite type）的。我们可以找到一个仿射开（affine open）覆盖（covering）<MATH_0011>，使每个<MATH_0012>都映射（maps）到某个<MATH_0013>中。由引理<REF_0004>可知，诱导的环映射（ring map）<MATH_0014>是有限型（finite type）的。因此，<MATH_0015>的正则点集（regular locus）是开集（open）。由于<MATH_0016>，可知<MATH_0017>是开集（open），这正是所要证明的。\n", "translation_hash": "sha256:b56ed8f124c5f4177c23085297706a35971491615b6805a72066f220440ac608", "unit_id": "tag:07R4:proof", "unknown_terms": [{"context": "首句所述的浸入类型。", "source_term": "open immersion", "target_term": "开浸入"}, {"context": "首句中开浸入满足的性质。", "source_term": "locally of finite type", "target_term": "局部有限型"}, {"context": "第二句所述的态射运算。", "source_term": "composition", "target_term": "复合"}, {"context": "第二句中参与复合的对象。", "source_term": "morphisms", "target_term": "态射"}, {"context": "第二句中参与复合的各态射的性质。", "source_term": "locally of finite type", "target_term": "局部有限型"}, {"context": "第二句中复合所得结果的性质。", "source_term": "locally of finite type", "target_term": "局部有限型"}, {"context": "首段中名词性用法，指该概形的开子概形。", "source_term": "open", "target_term": "开子概形"}, {"context": "首段中位于给定概形之上的对象。", "source_term": "scheme", "target_term": "概形"}, {"context": "首段中对给定概形之上的概形的限定。", "source_term": "locally of finite type", "target_term": "局部有限型"}, {"context": "第二段中对代数的限定。", "source_term": "finite type", "target_term": "有限型"}, {"context": "第二段中带有所给基底的代数结构。", "source_term": "algebra", "target_term": "代数"}, {"context": "第二段中取正则点集的对象。", "source_term": "scheme", "target_term": "概形"}, {"context": "第二段中由该概形的正则点所成的集合。", "source_term": "regular locus", "target_term": "正则点集"}, {"context": "第二段中所述正则点集的开性。", "source_term": "open", "target_term": "开集"}, {"context": "引用章名《代数续论》中的学科名。", "source_term": "Algebra", "target_term": "代数"}, {"context": "末段中在条件（4）下取定的态射。", "source_term": "morphism", "target_term": "态射"}, {"context": "末段中对所取态射的条件。", "source_term": "locally of finite type", "target_term": "局部有限型"}, {"context": "末段中限定覆盖的各成员。", "source_term": "affine open", "target_term": "仿射开"}, {"context": "末段中所取的仿射开覆盖。", "source_term": "covering", "target_term": "覆盖"}, {"context": "末段中描述各成员映射到指定成员内的动词。", "source_term": "maps", "target_term": "映射"}, {"context": "末段中由态射诱导的环间映射。", "source_term": "ring map", "target_term": "环映射"}, {"context": "末段中诱导环映射的性质。", "source_term": "finite type", "target_term": "有限型"}, {"context": "末段中由相应对象的正则点所成的集合。", "source_term": "regular locus", "target_term": "正则点集"}, {"context": "末段中相应正则点集的开性。", "source_term": "open", "target_term": "开集"}, {"context": "末句所要推出的开性。", "source_term": "open", "target_term": "开集"}]}
