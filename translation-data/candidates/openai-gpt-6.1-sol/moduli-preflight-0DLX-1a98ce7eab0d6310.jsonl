<MATH_0008>\nis a numerical polynomial in <MATH_0009> of total degree at\nmost the dimension of the scheme theoretic support of <MATH_0010>.\n<STRUCT_0002>", "source_text_hash": "sha256:79e4791872930609c2886e51a12d2a2f40a52bc10b36b33db326835832a63067", "unit_id": "inventory:spaces-over-fields:0DN4:lemma/0001"}}}], "input_freeze": {"hash": "sha256:7183c35fb4fd81223361f908ac331ecc6330629761701d1707d1e5735516b59a", "path": "translation-data/source-adoption-inputs/p0-108-moduli-p011.json"}, "model_output": {"hash": "sha256:9a365a760fd3adc4b52feac82f7d11fbc3b68766ca5699c10014640c8d5ab0ec", "path": "docs/evidence/p0-108-moduli-p011-raw-01.jsonl", "record_hash": "sha256:61ad2ca89665af37ce766be13a7807aa45c189b91c8029d557971e5efd0f3ca7"}, "neighbor_unit_ids": [], "policy_revision": "git:e2a27853a60ffaabb479bb0faf8eb1b49b7af540", "prior_generations": [], "prompt_version": "translator-v2", "source_adoption_id": "p0-108-moduli-p011", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "style_guide_path": "config/style-guide.md", "turn_id": "01a20431-fdbf-7512-b6cd-b1eb24ec5abf", "unit_id": "tag:0DNF:statement"}, "context_hash": "sha256:607c453e3773867af43c3fd697cdc5ab74ff01e0ee8ab4b249a0ae9f2583a24d", "created_at": "2026-11-22T16:58:38.647634+00:00", "glossary_revision": "git:e2a27853a60ffaabb479bb0faf8eb1b49b7af540", "harness_id": "codex", "harness_version": "0.171.0", "model_id": "gpt-6.1-sol", "model_identity_confidence": "declared", "model_lane": "openai-gpt-6.1-sol", "model_record_id": "openai:gpt-6.1-sol:declared", "model_snapshot": null, "notes": [], "prompt_version": "translator-v2", "publication_status": "CANDIDATE", "qa_status": "PASS", "reasoning_effort": "high", "run_id": "run-p0-108-moduli-p011", "schema_version": 2, "source_adoption_id": "p0-108-moduli-p011", "source_commit": "a04446e57ec1fbc252a871afcec7752fb2807b14", "source_status": "CURRENT", "source_text_hash": "sha256:8a8e58439d6f610b1886664d8bc45837b96a276eaea5dd705f79df4896dc8778", "stage": "STRUC