{"unit_id":"tag:03PE:statement","translation":"环映射（ring map）<MATH_0001>是平展（<ACCENT_0001>tale）的，在素理想（prime）<MATH_0002>处，当且仅当存在<MATH_0003>、<MATH_0004>使得<MATH_0005>标准平展（<ACCENT_0002>tale），定义于<MATH_0006>上。\n","allowed_english":[],"term_occurrences":[{"source_term":"ring map","target_term":"环映射"},{"source_term":"étale","target_term":"平展"},{"source_term":"prime","target_term":"素理想"},{"source_term":"étale","target_term":"平展"}],"unknown_terms":[{"source_term":"ring map","target_term":"环映射","context":"暂定译法。"},{"source_term":"prime","target_term":"素理想","context":"环中素理想。"},{"source_term":"étale","target_term":"平展","context":"暂定译法。"}],"notes":[]}
