            "MATH_0001": "$\\Spec(K)_\\etale$",
            "MATH_0002": "$X$",
            "ACCENT_0001": "\\'e",
            "MATH_0003": "$\\Spec(K)$",
            "REF_0003": "\\ref{sites-definition-representable-sheaf}",
            "MATH_0004": "$\\Spec(K)_\\etale$",
            "ACCENT_0002": "\\'e",
            "MATH_0005": "$\\Spec(K)$",
            "MATH_0006": "$\\Spec(K)_\\etale$",
            "STRUCT_0002": "\\end{remark}"
          },
          "render": {
            "prefix": "",
            "suffix": ""
          },
          "source_text_hash": "sha256:1125463bccb4a84947920d482fbc049a20b4407bf3053cf36e3fbbbeedd4ae60",
          "source_structure_hash": "sha256:da323a9ed2a75aec7fd9bcdf8c91add29ec2286f7c698b9c6e12e330e7d3b3bd",
